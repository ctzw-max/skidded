local function thick_raycast(origin, direction, distance, width, height, ray_params)
    local best_result
    local best_distance = math.huge
    local samples = 3
    local up = Vector3.new(0, 1, 0)
    if math.abs(direction:Dot(up)) > 0.99 then up = Vector3.new(1, 0, 0) end
    local right = direction:Cross(up).Unit
    local local_up = direction:Cross(right).Unit
    for x = 0, samples - 1 do
        for y = 0, samples - 1 do
            local offset = right * (-width * 0.5 + x * width / (samples - 1)) + local_up * (-height * 0.5 + y * height / (samples - 1))
            local result = workspace:Raycast(origin + offset, direction * distance, ray_params)
            if result then
                local current_distance = (result.Position - origin).Magnitude
                if current_distance < best_distance then
                    best_distance = current_distance
                    best_result = result
                end
            end
        end
    end
    return best_result
end
function game_support.reload(tool)
    if not tool or not is_gun(tool) then return end
    local char = local_player.Character
    if not char or tool.Parent ~= char then return end
    local cur = game_support.get_current()
    local main_event = replicated_storage:FindFirstChild("MainEvent")
    if not main_event and cur and cur.remote then
        main_event = replicated_storage:FindFirstChild(cur.remote)
    end
    if main_event and main_event:IsA("RemoteEvent") then
        pcall(function() main_event:FireServer("Reload", tool) end)
        pcall(function() main_event:FireServer("Reload") end)
        pcall(function() main_event:FireServer("Reload", tool.Name) end)
    end
    local deshood = replicated_storage:FindFirstChild("GameRemotes") and replicated_storage.GameRemotes:FindFirstChild("MainGameEvent")
    if deshood and deshood:IsA("RemoteEvent") then
        pcall(function() deshood:FireServer("Reload", tool) end)
        pcall(function() deshood:FireServer("Reload") end)
    end
    local tool_remote = tool:FindFirstChild("RemoteEvent") or tool:FindFirstChild("Reload")
    if tool_remote and tool_remote:IsA("RemoteEvent") then
        pcall(function() tool_remote:FireServer("Reload") end)
        pcall(function() tool_remote:FireServer("Reload", tool) end)
    end
    local mbe = replicated_storage:FindFirstChild("MainBindedEvent")
    if mbe and mbe:IsA("BindableEvent") then
        pcall(function() mbe:Fire("Reload", tool) end)
        pcall(function() mbe:Fire("Reload") end)
    end
    local script_folder = tool:FindFirstChild("Script")
    if script_folder and script_folder:FindFirstChild("CAN_RELOAD") then
        pcall(function() script_folder.CAN_RELOAD.Value = true end)
    end
    local be = char:FindFirstChild("BodyEffects")
    if be then
        local r_flag = be:FindFirstChild("Reload") or be:FindFirstChild("Reloading")
        if r_flag and r_flag:IsA("BoolValue") and not r_flag.Value then
            pcall(function()
                r_flag.Value = true
                task.delay(1.5, function()
                    if r_flag and r_flag.Parent then
                        r_flag.Value = false
                    end
                end)
            end)
        end
    end
    if game_support.uses("hoodcustoms") then
        pcall(function()
            tool.Enabled = true
            task.delay(0.1, function()
                if tool and tool.Parent == char then
                    tool.Enabled = false
                end
            end)
        end)
    end
end
track_connection(user_input_service.InputBegan:Connect(function(input, gpe)
    if gpe or user_input_service:GetFocusedTextBox() then return end
    if input.KeyCode == Enum.KeyCode.R then
        local char = local_player.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        if tool and is_gun(tool) then
            game_support.reload(tool)
        end
    end
end))
local function clean_scripts(tool)
    if not tool or not is_gun(tool) then return end
    local cur = game_support.get_current()
    if cur and (cur.updater or cur.rewrite_gun == false) then return end
    local name = tool.Name:lower()
    if name:find("knife", 1, true) or name:find("katana", 1, true) then return end
    local client_scripts = {
        GunClient = true,
        GunClientShotgun = true,
        GunClientAutomaticShotgun = true,
        GunClientBurst = true,
        GunClientAutomatic = true,
    }
    for _, child in ipairs(tool:GetChildren()) do
        if client_scripts[child.Name] then
            pcall(function() child.Disabled = true end)
            pcall(function() child:Destroy() end)
        end
    end
    track_connection(tool.ChildAdded:Connect(function(child)
        if client_scripts[child.Name] then
            task.defer(function()
                pcall(function() child.Disabled = true end)
                pcall(function() child:Destroy() end)
            end)
        end
    end))
end
local cached_animation_character
local cached_shoot_animation
local cached_aim_shoot_animation
local delayed_guns = {
    ["[Shotgun]"] = true,
    ["[Drum-Shotgun]"] = true,
    ["[Rifle]"] = true,
    ["[TacticalShotgun]"] = true,
    ["[AR]"] = true,
    ["[AUG]"] = true,
    ["[AK47]"] = true,
    ["[LMG]"] = true,
    ["[SilencerAR]"] = true,
}
local function play_tool_animation(tool)
    if not tool then return end
    local character = local_player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
    if not animator then return end
    local animations = replicated_storage:FindFirstChild("Animations") or replicated_storage:FindFirstChild("ClientAnimations")
    local gun_combat = animations and animations:FindFirstChild("GunCombat")
    if not gun_combat then return end
    if cached_animation_character ~= character then
        cached_animation_character = character
        cached_shoot_animation = nil
        cached_aim_shoot_animation = nil
        local shoot = gun_combat:FindFirstChild("Shoot")
        local aim_shoot = gun_combat:FindFirstChild("AimShoot")
        if shoot and shoot:IsA("Animation") then
            cached_shoot_animation = animator:LoadAnimation(shoot)
        end
        if aim_shoot and aim_shoot:IsA("Animation") then
            cached_aim_shoot_animation = animator:LoadAnimation(aim_shoot)
        end
    end
    if cached_shoot_animation then cached_shoot_animation:Stop(0) end
    if cached_aim_shoot_animation then cached_aim_shoot_animation:Stop(0) end
    local track = delayed_guns[tool.Name] and cached_aim_shoot_animation or cached_shoot_animation
    if track then track:Play() end
end
local function is_character_alive(char)
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead then
        return false
    end
    local body_effects = char:FindFirstChild("BodyEffects")
    if body_effects then
        local ko = body_effects:FindFirstChild("K.O") or body_effects:FindFirstChild("KO")
        if ko and (ko.Value == true or ko.Value == 1) then return false end
        local grabbed = body_effects:FindFirstChild("Grabbed")
        if grabbed and grabbed.Value == true then return false end
        local dead = body_effects:FindFirstChild("Dead")
        if dead and dead.Value == true then return false end
    end
    if char:FindFirstChild("GRABBING_CONSTRAINT") then return false end
    return true
end
local function is_self_knocked()
    local char = local_player.Character
    if not char then return true end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead or hum.PlatformStand then
        return true
    end
    local be = char:FindFirstChild("BodyEffects")
    if be then
        local ko = be:FindFirstChild("K.O") or be:FindFirstChild("KO")
        if ko and (ko.Value == true or ko.Value == 1) then return true end
        local grabbed = be:FindFirstChild("Grabbed")
        if grabbed and (grabbed.Value == true or grabbed.Value == 1) then return true end
        local dead = be:FindFirstChild("Dead")
        if dead and (dead.Value == true or dead.Value == 1) then return true end
    end
    if char:FindFirstChild("GRABBING_CONSTRAINT") then return true end
    return false
end
local function resolve_body_effect(player, effect_name)
    if not player or not effect_name then return nil end
    local char = player.Character
    local body_effects = char and char:FindFirstChild("BodyEffects")
    local effect = body_effects and body_effects:FindFirstChild(effect_name)
    return effect and effect.Value or nil
end
local ammo_peak = setmetatable({}, { __mode = "k" })
local function infinite_ammo_enabled()
    if game_support.is("da hood") then return false end
    local game_ex = config["Game Specific"] or {}
    local das_cfg = game_ex["Das Hood"] or {}
    local cfg = das_cfg["Infinite Ammo"] or das_cfg["infinite_ammo"] or {}
    if cfg["Enabled"] == true or cfg["enabled"] == true then return true end
    local weapon_mods = config["Weapon Modifications"] or {}
    local fallback = weapon_mods["Infinite Ammo"] or {}
    return fallback["Enabled"] == true or fallback["enabled"] == true
end
local function find_ammo_value(tool)
    if not tool then return nil end
    local ammo = tool:FindFirstChild("Ammo") or tool:FindFirstChild("AMMO")
    if not ammo then
        local script_folder = tool:FindFirstChild("Script")
        local ammo_folder = script_folder and (script_folder:FindFirstChild("Ammo") or script_folder:FindFirstChild("AMMO"))
        ammo = ammo_folder and ammo_folder:FindFirstChild("CLIENT") or nil
    end
    if ammo and ammo:IsA("ValueBase") then return ammo end
    return nil
end
local function apply_infinite_ammo(tool)
    if not tool or not infinite_ammo_enabled() then return end
    local ammo = find_ammo_value(tool)
    if not ammo then return end
    local current = tonumber(ammo.Value)
    if not current then return end
    local peak = ammo_peak[tool]
    if not peak or current > peak then
        peak = current
        ammo_peak[tool] = peak
    end
    if peak < 1 then peak = 1 end
    if current < peak then
        pcall(function()
            ammo.Value = peak
        end)
    end
end
local function can_shoot_check(char, ignore_cooldown)
    if not char or is_self_knocked() then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead or hum.PlatformStand then return false end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool or not tool:FindFirstChild("Handle") then return false end
    if not game_support.is("da hood") then
        local ammo = tool:FindFirstChild("Ammo") or tool:FindFirstChild("ammo")
        if ammo and ammo.Value <= 0 and not infinite_ammo_enabled() then return false end
        if not ignore_cooldown and tool:GetAttribute("Cooldown") then return false end
        local be = char:FindFirstChild("BodyEffects")
        if be and be:FindFirstChild("Reloading_CLIENT") and be.Reloading_CLIENT.Value == true then return false end
        return true
    end
    if char:FindFirstChild("FORCEFIELD") or char:FindFirstChild("ForceField") then return false end
    if char:FindFirstChild("GRABBING_CONSTRAINT") then return false end
    local body_effects = char:FindFirstChild("BodyEffects")
    if body_effects then
        if body_effects:FindFirstChild("Cuff") and body_effects.Cuff.Value then return false end
        local ko = body_effects:FindFirstChild("K.O") or body_effects:FindFirstChild("KO")
        if ko and ko.Value then return false end
        if body_effects:FindFirstChild("Grabbed") and body_effects.Grabbed.Value then return false end
        local reload = body_effects:FindFirstChild("Reload")
        if reload and reload.Value == true then return false end
        local reloading = body_effects:FindFirstChild("Reloading") or body_effects:FindFirstChild("Reloading_CLIENT")
        if reloading and reloading.Value == true then return false end
        local dead = body_effects:FindFirstChild("Dead")
        if dead and dead.Value then return false end
    end
    if not ignore_cooldown then
        if tool:GetAttribute("Cooldown") then return false end
        local last_shot = char:GetAttribute("LastGunShot")
        local is_sg = shotguns[tool.Name] or false
        if last_shot ~= tool.Name and char:GetAttribute("ShotgunDebounce") then
            return false
        end
    end
    return true
end
local function can_shoot(char)
    if not can_shoot_check(char) then return false end
    local tool = char:FindFirstChildOfClass("Tool")
    local is_sg = tool and shotguns[tool.Name] or false
    if is_sg and not char:GetAttribute("ShotgunDebounce") then
        char:SetAttribute("ShotgunDebounce", true)
        task.delay(0.65, function()
            char:SetAttribute("ShotgunDebounce", nil)
        end)
    end
    if tool then char:SetAttribute("LastGunShot", tool.Name) end
    return true
end
local function get_muzzle_position(tool)
    local handle = tool:FindFirstChild("Handle")
    if not handle then return nil end
    local default = tool:FindFirstChild("Default")
    if default then
        local mesh = default:FindFirstChild("Mesh")
        if mesh and mesh:FindFirstChild("Muzzle") then
            return mesh.Muzzle.WorldPosition
        end
    end
    if handle:FindFirstChild("Muzzle") then
        return handle.Muzzle.WorldPosition
    end
    local is_sg = shotguns[tool.Name] or false
    local default_offset = is_sg and CFrame.new(0, 0.25, -2.5) or CFrame.new(0, 0.4, 1.8)
    local offset = muzzles[tool.Name] or default_offset
    return (handle.CFrame * offset).Position
end
local function closest_point_on_part(part, origin, direction, scale)
    local along = math.max((part.Position - origin):Dot(direction), 0)
    local local_pos = part.CFrame:PointToObjectSpace(origin + direction * along)
    local half = part.Size * 0.5 * (scale or 1)
    local clamped = Vector3.new(
        math.clamp(local_pos.X, -half.X, half.X),
        math.clamp(local_pos.Y, -half.Y, half.Y),
        math.clamp(local_pos.Z, -half.Z, half.Z)
    )
    return part.CFrame:PointToWorldSpace(clamped)
end
local function get_closest_point(target_char, scale)
    local mouse_pos = user_input_service:GetMouseLocation()
    local ray = camera:ViewportPointToRay(mouse_pos.X, mouse_pos.Y)
    local origin, direction = ray.Origin, ray.Direction.Unit
    local best_point = nil
    local best_dist = math.huge
    for _, part in ipairs(target_char:GetChildren()) do
        if part:IsA("BasePart") then
            local point = closest_point_on_part(part, origin, direction, scale)
            local offset = point - origin
            local dist = (offset - direction * offset:Dot(direction)).Magnitude
            if dist < best_dist then
                best_dist = dist
                best_point = point
            end
        end
    end
    return best_point
end
local function resolve_hit_position(target_char, hit_location_cfg, nearest_point_cfg)
    if not target_char then return nil end
    local loc = hit_location_cfg or "Nearest Part"
    local hrp = target_char:FindFirstChild("HumanoidRootPart")
    if loc == "Closest Point" or loc == "Nearest Point" then
        local scale = nearest_point_cfg and nearest_point_cfg["Scale"] or 1
        local pt = get_closest_point(target_char, scale)
        if pt then return pt end
    elseif loc == "Nearest Part" or loc == "Closest Part" then
        local mouse_pos = user_input_service:GetMouseLocation()
        local best_part = nil
        local best_dist = math.huge
        for _, part in ipairs(target_char:GetChildren()) do
            if part:IsA("BasePart") then
                local screen_pos, on_screen = camera:WorldToViewportPoint(part.Position)
                if on_screen then
                    local dist = (Vector2.new(screen_pos.X, screen_pos.Y) - mouse_pos).Magnitude
                    if dist < best_dist then
                        best_dist = dist
                        best_part = part
                    end
                end
            end
        end
        if best_part then return best_part.Position end
    elseif type(loc) == "string" and target_char:FindFirstChild(loc) then
        return target_char[loc].Position
    end
    local head = target_char:FindFirstChild("Head")
    return head and head.Position or (hrp and hrp.Position)
end
local function get_future_offset(tool_name)
    return Vector3.new(0, 0, 0)
end
local DamageModifierLib = nil
do
    local DamageModifier = {}
    DamageModifier.DefaultConfig = {
        Enabled = true,
        Weapons = {
            Shotguns = { Enabled = true, Mode = "half" },
            Pistols = { Enabled = true, Mode = "full" },
            Others = { Enabled = true, Mode = "full" }
        }
    }
    DamageModifier.ShotgunWeapons = {
        ["[Double-Barrel SG]"] = true,
        ["[TacticalShotgun]"] = true,
        ["[Tactical Shotgun]"] = true,
        ["[Tactical-Shotgun]"] = true,
        ["[Shotgun]"] = true,
        ["[Drum-Shotgun]"] = true
    }
    DamageModifier.PistolWeapons = {
        ["[Revolver]"] = true,
        ["[Silencer]"] = true,
        ["[Glock]"] = true,
        ["[Deagle]"] = true
    }
    function DamageModifier.GetWeaponClass(toolName)
        if not toolName then return "Others" end
        if DamageModifier.ShotgunWeapons[toolName] or DamageModifier.ShotgunWeapons["[" .. toolName:gsub("%[", ""):gsub("%]", "") .. "]"] then
            return "Shotguns"
        end
        if DamageModifier.PistolWeapons[toolName] or DamageModifier.PistolWeapons["[" .. toolName:gsub("%[", ""):gsub("%]", "") .. "]"] then
            return "Pistols"
        end
        return "Others"
    end
    function DamageModifier.GetOverridePart(character, mode)
        if not character then return nil end
        local m = tostring(mode or "full"):lower()
        if m == "full" or m == "max" or m == "head" then
            return character:FindFirstChild("Head")
        end
        if m == "half" or m == "hrp" or m == "torso" then
            return character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
        end
        if m == "min" or m == "leg" or m == "foot" then
            return character:FindFirstChild("RightFoot") or character:FindFirstChild("Right Leg") or character:FindFirstChild("RightLeg") or character:FindFirstChild("RightLowerLeg")
        end
        return nil
    end
    function DamageModifier.GetConfig(cfg)
        return cfg or DamageModifier.DefaultConfig
    end
    function DamageModifier.Apply(toolName, hitPosition, hitInstance, hitNormal, cfg, getWeaponClass)
        local resolved_cfg = nil
        if type(cfg) == "table" then
            if cfg["Damage Modifier"] and type(cfg["Damage Modifier"]) == "table" then
                resolved_cfg = cfg["Damage Modifier"]
            elseif cfg["Silent Aim"] and type(cfg["Silent Aim"]) == "table" and cfg["Silent Aim"]["Damage Modifier"] and type(cfg["Silent Aim"]["Damage Modifier"]) == "table" then
                resolved_cfg = cfg["Silent Aim"]["Damage Modifier"]
            elseif cfg["Weapon Modifications"] and type(cfg["Weapon Modifications"]) == "table" and cfg["Weapon Modifications"]["Damage Modifier"] and type(cfg["Weapon Modifications"]["Damage Modifier"]) == "table" then
                resolved_cfg = cfg["Weapon Modifications"]["Damage Modifier"]
            elseif cfg["Modifications"] and type(cfg["Modifications"]) == "table" and cfg["Modifications"]["Das Hood"] and cfg["Modifications"]["Das Hood"]["Damage Modifier"] then
                resolved_cfg = cfg["Modifications"]["Das Hood"]["Damage Modifier"]
            else
                resolved_cfg = cfg
            end
        end
        if not resolved_cfg or resolved_cfg["Enabled"] ~= true or not hitInstance or not hitInstance.Parent then
            return hitPosition, hitInstance, hitNormal
        end
        local weapons = resolved_cfg["Weapons"]
        if weapons and type(weapons["Data"]) == "table" then
            weapons = weapons["Data"]
        end
        local resolveWeaponClass = getWeaponClass or DamageModifier.GetWeaponClass
        local weaponClass = resolveWeaponClass(toolName)
        local weaponConfig = (weapons and (weapons[toolName] or weapons[weaponClass] or weapons[toolName:gsub("%[", ""):gsub("%]", "")])) or { Enabled = true, Mode = (weaponClass == "Shotguns" and "half" or "full") }
        if weaponConfig["Enabled"] == false then
            return hitPosition, hitInstance, hitNormal
        end
        local character = hitInstance:FindFirstAncestorOfClass("Model")
        if not character or not character:FindFirstChildOfClass("Humanoid") then
            return hitPosition, hitInstance, hitNormal
        end
        local override = DamageModifier.GetOverridePart(character, weaponConfig["Mode"] or weaponConfig["mode"])
        if not override or override == hitInstance then
            return hitPosition, hitInstance, hitNormal
        end
        if game_support.is("da hood") then
            local origin = local_player.Character and local_player.Character:FindFirstChild("Head") and local_player.Character.Head.Position or hitPosition
            local p = RaycastParams.new()
            p.FilterType = Enum.RaycastFilterType.Include
            p.FilterDescendantsInstances = {override}
            local dir = (override.Position - origin)
            local res = workspace:Raycast(origin, dir.Unit * (dir.Magnitude + override.Size.Magnitude), p)
            if res and res.Instance == override then
                return res.Position, override, res.Normal
            end
            return hitPosition, hitInstance, hitNormal
        end
        return override.Position, override, hitNormal
    end
    DamageModifierLib = DamageModifier
end
local function apply_damage_modifier(tool_name, hit_position, hit_instance, hit_normal, allowed_target)
    local raw_cfg = (config and (config["Silent Aim"] and config["Silent Aim"]["Damage Modifier"] or config["Damage Modifier"] or config["Weapon Modifications"] and config["Weapon Modifications"]["Damage Modifier"] or config["Modifications"] and config["Modifications"]["Das Hood"] and config["Modifications"]["Das Hood"]["Damage Modifier"])) or {}
    if DamageModifierLib and type(DamageModifierLib.Apply) == "function" then
        return DamageModifierLib.Apply(tool_name, hit_position, hit_instance, hit_normal, raw_cfg, DamageModifierLib.GetWeaponClass)
    end
    return hit_position, hit_instance, hit_normal
end
local function get_prediction_value(pred_cfg)
    if not pred_cfg or pred_cfg["Enabled"] == false then return Vector3.new(0, 0, 0) end
    local px, py, pz = 0.1, 0.1, 0.1
    if pred_cfg["Auto Prediction"] and pred_cfg["Auto Prediction"]["Enabled"] then
        local ping = get_ping()
        local factor = (ping / 1000) + 0.037
        px, py, pz = factor, factor, factor
    elseif pred_cfg["Values"] then
        px = pred_cfg["Values"]["X"] or 0.1
        py = pred_cfg["Values"]["Y"] or 0.1
        pz = pred_cfg["Values"]["Z"] or 0.1
    end
    local y_mode = pred_cfg["Y Axis"] or "Full"
    if y_mode == "Half" then
        py = py * 0.5
    elseif y_mode == "Legit" then
        py = py * 0.25
    elseif y_mode == "Very Legit" then
        py = py * 0.1
    end
    return Vector3.new(px, py, pz)
end
local function ease_circular_in_out(t)
    if t < 0.5 then
        return (1 - math.sqrt(1 - 4 * t * t)) * 0.5
    else
        return (math.sqrt(1 - (-2 * t + 2) * (-2 * t + 2)) + 1) * 0.5
    end
end
local function resolve_range_check(feature_cfg, tool)
    local rc = feature_cfg and (feature_cfg["Range-Check"] or feature_cfg["range_check"])
    if not rc then return math.huge end
    if not (rc["Enabled"] == true or rc["enabled"] == true) then return math.huge end
    local data = rc["Data"] or rc["data"] or {}
    local weapon_name = tool and tool.Name or ""
    local val = tonumber(data[weapon_name])
    if val and val > 0 then return val end
    if tool then
        local range_inst = tool:FindFirstChild("Range")
        if range_inst then
            local gun_range = tonumber(range_inst.Value)
            if gun_range and gun_range > 0 then return gun_range end
        end
    end
    return math.huge
end
local function is_range_check_enabled(feature_cfg)
    if not feature_cfg then return false end
    local rc = feature_cfg["Range-Check"] or feature_cfg["range_check"]
    if not rc then return false end
    return rc["Enabled"] == true or rc["enabled"] == true
end
local function get_best_player(max_dist, check_fov, fov_size, fov_3d)
    local best_player = nil
    local best_dist = math.huge
    local mouse_pos = user_input_service:GetMouseLocation()
    local local_char = local_player.Character
    local local_hrp = local_char and local_char:FindFirstChild("HumanoidRootPart")
    for _, player in ipairs(players:GetPlayers()) do
        if player ~= local_player and player.Character and is_character_alive(player.Character) then
            local char = player.Character
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local world_dist = local_hrp and (hrp.Position - local_hrp.Position).Magnitude or (hrp.Position - camera.CFrame.Position).Magnitude
                if world_dist <= (max_dist or math.huge) then
                    local rank = nil
                    if check_fov and fov_3d then
                        local off = camera.CFrame:PointToObjectSpace(hrp.Position)
                        if math.abs(off.X) <= (fov_3d.X or math.huge)
                            and math.abs(off.Y) <= (fov_3d.Y or math.huge)
                            and off.Z > 0 and off.Z <= (fov_3d.Z or math.huge) then
                            rank = world_dist
                        end
                    else
                        local screen_pos, on_screen = camera:WorldToViewportPoint(hrp.Position)
                        if on_screen and screen_pos.Z > 1 then
                            local screen_dist = (Vector2.new(screen_pos.X, screen_pos.Y) - mouse_pos).Magnitude
                            if (not check_fov) or screen_dist <= (fov_size or math.huge) then
                                rank = screen_dist
                            end
                        end
                    end
                    if rank and rank < best_dist then
                        best_dist = rank
                        best_player = player
                    end
                end
            end
        end
    end
    return best_player
end
local function get_silent_fov_args()
    local fov_cfg = config["Silent Aim"] and config["Silent Aim"]["FOV"]
    if type(fov_cfg) ~= "table" or fov_cfg["Enabled"] ~= true then
        return nil, nil, nil
    end
    if tostring(fov_cfg["Mode"] or "2D"):lower() == "3d" then
        local f3 = fov_cfg["3D"]
        if type(f3) == "table" then
            return true, nil, {
                X = tonumber(f3["X"]),
                Y = tonumber(f3["Y"]),
                Z = tonumber(f3["Z"]),
            }
        end
    end
    local f2 = fov_cfg["2D"]
    local radius = (tonumber(f2 and f2["X"]) or 8350) * 0.05
    return true, radius, nil
end
local function get_feature_checks(feature_config)
    return feature_config and (feature_config["Checks"] or feature_config["checks"]) or nil
end
local function get_targeting_mode()
    local val = get_bind_value("General", "Targeting")
    if val == nil and config["General"] then
        val = config["General"]["Targeting"]
    end
    return tostring(val or "Target"):lower()
end
local passes_target_conditions
local function get_feature_target(max_dist, ignore_walls, ignore_self_status)
    local targeting_mode = get_targeting_mode()
    if targeting_mode == "target" then
        local current = state.current_target
        if not current or not current.Parent or not current.Character or not is_character_alive(current.Character) then
            state.current_target = nil
            return nil
        end
        local current_root = current.Character:FindFirstChild("HumanoidRootPart")
        local self_root = local_player.Character and local_player.Character:FindFirstChild("HumanoidRootPart")
        if max_dist and max_dist < math.huge and current_root and self_root then
            if (current_root.Position - self_root.Position).Magnitude > max_dist then
                return nil
            end
        end
        return current
    end
    local best = get_best_player(max_dist, get_silent_fov_args())
    if not best and state.current_target and state.current_target.Parent and state.current_target.Character and is_character_alive(state.current_target.Character) then
        return state.current_target
    end
    return best
end
passes_target_conditions = function(player, checks, ignore_walls, ignore_self_status)
    local self_character = local_player.Character
    local self_effects = self_character and self_character:FindFirstChild("BodyEffects")
    local self_knocked = self_effects and (self_effects:FindFirstChild("K.O") or self_effects:FindFirstChild("KO"))
    local self_grabbed = self_effects and self_effects:FindFirstChild("Grabbed")
    if not ignore_self_status then
        if self_knocked and self_knocked.Value then return false end
        if self_grabbed and self_grabbed.Value then return false end
    end
    if not player or not player.Character or not is_character_alive(player.Character) then return false end
    checks = checks or {}
    local targeting_checks = config["Targeting Checks"] or {}
    local function check_enabled(name)
        if checks and checks[name] ~= nil then return checks[name] == true end
        if targeting_checks[name] ~= nil then return targeting_checks[name] == true end
        return false
    end
    local character = player.Character
    local body_effects = character:FindFirstChild("BodyEffects")
    local knocked = body_effects and (body_effects:FindFirstChild("K.O") or body_effects:FindFirstChild("KO"))
    local grabbed = body_effects and body_effects:FindFirstChild("Grabbed")
    if check_enabled("Gun Check") then
        local equipped = self_character and self_character:FindFirstChildOfClass("Tool")
        if not is_gun(equipped) then return false end
    end
    if check_enabled("Knocked") and knocked and knocked.Value then return false end
    if check_enabled("Grabbed") and grabbed and grabbed.Value then return false end
    if not ignore_walls and check_enabled("On Screen") then
        local root = character:FindFirstChild("HumanoidRootPart")
        local head = character:FindFirstChild("Head")
        if not root and not head then return false end
        local on_screen = false
        if root then
            local screen_position, root_on = camera:WorldToViewportPoint(root.Position)
            if root_on and screen_position.Z > 0 then on_screen = true end
        end
        if not on_screen and head then
            local screen_position, head_on = camera:WorldToViewportPoint(head.Position)
            if head_on and screen_position.Z > 0 then on_screen = true end
        end
        if not on_screen then return false end
    end
    if check_enabled("Vehicle") and character:FindFirstChildOfClass("VehicleSeat") then return false end
    if check_enabled("Knife") then
        local held_tool = character:FindFirstChildOfClass("Tool")
        if held_tool and knife_tools[held_tool.Name] then return false end
    end
    if not ignore_walls and check_enabled("Visible") then
        local root = character:FindFirstChild("HumanoidRootPart")
        local head = character:FindFirstChild("Head")
        local upper = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
        if not root and not head and not upper then return false end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        local filter = {local_player.Character, camera}
        local ignored_folder = workspace:FindFirstChild("Ignored")
        if ignored_folder then table.insert(filter, ignored_folder) end
        local bush_folder = workspace:FindFirstChild("Bush") or (ignored_folder and ignored_folder:FindFirstChild("Bush"))
        if bush_folder then table.insert(filter, bush_folder) end
        params.FilterDescendantsInstances = filter
        params.IgnoreWater = true
        local visibility_mode = "viewport"
        local visibility_cfg = config["Visibility Check Mode"] or {}
        if type(visibility_cfg) == "table" then
            visibility_mode = tostring(visibility_cfg["Mode"] or visibility_cfg["mode"] or "Viewport"):lower()
        end
        local origin = camera.CFrame.Position
        if visibility_mode == "muzzle" then
            local self_char = local_player.Character
            local equipped = self_char and self_char:FindFirstChildOfClass("Tool")
            local handle = equipped and equipped:FindFirstChild("Handle")
            if handle and handle:IsA("BasePart") then origin = handle.Position end
        end
        local points = {}
        if root then points[#points + 1] = root end
        if head then points[#points + 1] = head end
        if upper then points[#points + 1] = upper end
        local blocked = true
        for _, part in ipairs(points) do
            local result = workspace:Raycast(origin, part.Position - origin, params)
            if not result or result.Instance:IsDescendantOf(character) then
                blocked = false
                break
            end
        end
        if blocked then
            local wallbang_open = wallbang.hittable(origin, character, 400) ~= nil
            if wallbang_open and (wallbang.fire_on_wallbang() or not (checks and checks["Visible"] == true)) then
                return true
            end
            return false
        end
    end
    return true
end
local function get_trigger_delay(tool, trigger_config)
    local weapon_delay = gun_modifier_lib.get_cooldown(tool)
    local configured_delay = tonumber(trigger_config and trigger_config["Cooldown"]) or 0
    return math.max(weapon_delay, configured_delay)
end
local applied_skins = {}
local knife_data = {}
local skin_assets = nil
local skin_modules = nil
local skin_data = nil
local get_skin_info = nil
local load_skin_data = nil
local function find_gun_beam_folder(container, name)
    if not container or not name or name == "" then return nil end
    local clean = name:lower():gsub(" ", ""):gsub("-", ""):gsub("%[", ""):gsub("%]", "")
    for _, child in ipairs(container:GetChildren()) do
        local child_clean = child.Name:lower():gsub(" ", ""):gsub("-", ""):gsub("%[", ""):gsub("%]", "")
        if child.Name == name or child_clean == clean then
            return child
        end
    end
    return nil
end
local function evalColorSequence(seq, t)
    if not seq or not seq.Keypoints or #seq.Keypoints == 0 then return Color3.new(1, 1, 1) end
    if t <= 0 then return seq.Keypoints[1].Value end
    if t >= 1 then return seq.Keypoints[#seq.Keypoints].Value end
    for i = 1, #seq.Keypoints - 1 do
        local k1 = seq.Keypoints[i]
        local k2 = seq.Keypoints[i + 1]
        if k1.Time <= t and t <= k2.Time then
            local alpha = (k2.Time == k1.Time) and 0 or ((t - k1.Time) / (k2.Time - k1.Time))
            return Color3.new(
                (k2.Value.R - k1.Value.R) * alpha + k1.Value.R,
                (k2.Value.G - k1.Value.G) * alpha + k1.Value.G,
                (k2.Value.B - k1.Value.B) * alpha + k1.Value.B
            )
        end
    end
    return seq.Keypoints[#seq.Keypoints].Value
end
local undead_beam_colors = {
    Color3.fromRGB(248, 147, 255),
    Color3.fromRGB(255, 160, 64),
    Color3.fromRGB(76, 255, 82),
    Color3.fromRGB(110, 149, 255),
}
local equip_skins_cache_raw = nil
local equip_skins_cache_decoded = nil
local function resolve_equip_skins_name(tool_name)
    if type(tool_name) ~= "string" or tool_name == "" then return nil end
    local ok, result = pcall(function()
        local data_folder = local_player:FindFirstChild("DataFolder")
        local info = data_folder and data_folder:FindFirstChild("Information")
        local equip_skins = info and info:FindFirstChild("EquipSkins")
        local raw = equip_skins and equip_skins.Value or nil
        if raw ~= equip_skins_cache_raw then
            equip_skins_cache_raw = raw
            equip_skins_cache_decoded = raw and http_service:JSONDecode(raw) or nil
        end
        return equip_skins_cache_decoded and equip_skins_cache_decoded[tool_name] or nil
    end)
    if not ok then return nil end
    return result
end
local function resolve_current_skin_name(handle, tool, tool_name)
    local skin_name = nil
    pcall(function()
        skin_name = handle and handle:GetAttribute("SkinName") or nil
    end)
    if type(skin_name) ~= "string" or skin_name == "" then
        pcall(function()
            skin_name = tool and tool:GetAttribute("SkinName") or nil
        end)
    end
    if type(skin_name) ~= "string" or skin_name == "" then
        pcall(function()
            local skins = config["skins"]
            skin_name = skins and skins[tool_name] or nil
        end)
    end
    if type(skin_name) ~= "string" or skin_name == "" then
        pcall(function()
            local skin_changer_config = config["Skin Changer"]
            if skin_changer_config and skin_changer_config["Enabled"] then
                skin_name = skin_changer_config["Weapons"] and skin_changer_config["Weapons"][tool_name] or nil
            end
        end)
    end
    if type(skin_name) ~= "string" or skin_name == "" then
        skin_name = resolve_equip_skins_name(tool_name)
    end
    if type(skin_name) ~= "string" or skin_name == "" then
        return nil
    end
    return skin_name
end
local equipped_beam_cache = { equipped_raw = nil, equipped = nil, inv_raw = nil, inv = nil }
local function resolve_equipped_beam_name(tool_name)
    if type(tool_name) ~= "string" or tool_name == "" then return nil end
    local result = nil
    pcall(function()
        local data_folder = local_player:FindFirstChild("DataFolder")
        if not data_folder then return end
        local equipped_value = data_folder:FindFirstChild("EquippedBulletBeams")
        local inventory_folder = data_folder:FindFirstChild("InventoryData")
        local inventory_value = inventory_folder and inventory_folder:FindFirstChild("BulletBeams")
        local equipped_raw = equipped_value and equipped_value.Value or nil
        local inv_raw = inventory_value and inventory_value.Value or nil
        if equipped_raw ~= equipped_beam_cache.equipped_raw then
            equipped_beam_cache.equipped_raw = equipped_raw
            equipped_beam_cache.equipped = equipped_raw and http_service:JSONDecode(equipped_raw) or nil
        end
        if inv_raw ~= equipped_beam_cache.inv_raw then
            equipped_beam_cache.inv_raw = inv_raw
            equipped_beam_cache.inv = inv_raw and http_service:JSONDecode(inv_raw) or nil
        end
        local equipped = equipped_beam_cache.equipped
        local inventory = equipped_beam_cache.inv
        local beam_id = equipped and (equipped[tool_name] or equipped["[" .. tool_name .. "]"]) or nil
        if type(beam_id) == "table" then beam_id = beam_id.id or beam_id.ID or beam_id.beam or nil end
        local entry = beam_id and inventory and (inventory[beam_id] or inventory[tostring(beam_id)]) or nil
        local beam_name = nil
        if entry and type(entry) == "table" then
            beam_name = entry.Name or entry.name or entry.DisplayName or entry.displayName
        end
        if not beam_name and type(beam_id) == "string" then
            beam_name = beam_id
        end
        if type(beam_name) == "string" and beam_name ~= "" and beam_name ~= "None" and beam_name ~= "none" then
            result = beam_name
        end
    end)
    return result
end
local function resolve_equipped_beam_template(tool_name)
    local beam_name = resolve_equipped_beam_name(tool_name)
    if not beam_name then return nil end
    local template = nil
    pcall(function()
        local candidates = { "BulletBeams", "BulletBeam", "GunBeam", "Bullet_Beams", "Beams" }
        for _, folder_name in ipairs(candidates) do
            local beam_folder = replicated_storage:FindFirstChild(folder_name)
            if beam_folder then
                local candidate = beam_folder:FindFirstChild(beam_name)
                if candidate then template = candidate; return end
            end
        end
        local direct = replicated_storage:FindFirstChild(beam_name)
        if direct then template = direct; return end
        local ignored_folder = workspace:FindFirstChild("Ignored")
        if ignored_folder then
            for _, folder_name in ipairs(candidates) do
                local beam_folder2 = ignored_folder:FindFirstChild(folder_name)
                if beam_folder2 then
                    local candidate = beam_folder2:FindFirstChild(beam_name)
                    if candidate then template = candidate; return end
                end
            end
            local direct2 = ignored_folder:FindFirstChild(beam_name)
            if direct2 then template = direct2; return end
        end
    end)
    if not template then return nil end
    if template:IsA("LuaSourceContainer") then return nil end
    if template:IsA("Beam") or template:IsA("BasePart") then return template end
    local inner_beam = template:FindFirstChildWhichIsA("Beam", true)
    if inner_beam then return inner_beam end
    local inner_part = template:FindFirstChildWhichIsA("BasePart", true)
    if inner_part then return inner_part end
    return nil
end
local function emit_muzzle_effect(tool, is_left_hand)
    if not tool then return end
    local handle = tool:FindFirstChild("Handle")
    local tool_name = tool.Name
    local skin_name = resolve_current_skin_name(handle, tool, tool_name) or ""
    local default = tool:FindFirstChild("Default")
    local mesh = default and default:FindFirstChild("Mesh")
    local muzzle_att = nil
    if is_left_hand and mesh and mesh:FindFirstChild("DualWieldLeftHandMesh") and mesh.DualWieldLeftHandMesh:FindFirstChild("LeftMuzzle") then
        muzzle_att = mesh.DualWieldLeftHandMesh.LeftMuzzle
    elseif is_left_hand and handle and handle:FindFirstChild("LeftMuzzle") then
        muzzle_att = handle.LeftMuzzle
    elseif mesh and mesh:FindFirstChild("Muzzle") then
        muzzle_att = mesh.Muzzle
    elseif default and default:FindFirstChild("Muzzle") then
        muzzle_att = default.Muzzle
    elseif handle and handle:FindFirstChild("Muzzle") then
        muzzle_att = handle.Muzzle
    else
        muzzle_att = handle
    end
    skin_assets = skin_assets or replicated_storage:FindFirstChild("SkinAssets")
    local skin_muzzles = skin_assets and skin_assets:FindFirstChild("GunSkinMuzzleParticle")
    if skin_muzzles then
        local muzzle_folder = nil
        if skin_name and skin_name ~= "" and skin_name ~= "Default" and skin_name ~= "None" then
            muzzle_folder = skin_muzzles:FindFirstChild(skin_name)
                or skin_muzzles:FindFirstChild(skin_name:gsub("-", " "))
                or skin_muzzles:FindFirstChild(skin_name:gsub(" ", ""))
        end
        if not muzzle_folder then
            muzzle_folder = skin_muzzles:FindFirstChild(tool_name)
                or skin_muzzles:FindFirstChild(tool_name:gsub("%[", ""):gsub("%]", ""))
        end
        if muzzle_folder and muzzle_att then
            local muzzle_key = is_left_hand and "LeftMuzzle" or "Muzzle"
            local sub_muzzle = muzzle_folder:FindFirstChild(muzzle_key) or muzzle_folder
            local target_source = sub_muzzle
            local diff_gun = sub_muzzle:FindFirstChild("Different_GunMuzzle") or muzzle_folder:FindFirstChild("Different_GunMuzzle")
            if diff_gun then
                local tool_clean = tool_name:gsub("%[", ""):gsub("%]", "")
                local diff_match = diff_gun:FindFirstChild(tool_name) or diff_gun:FindFirstChild("[" .. tool_clean .. "]") or diff_gun:FindFirstChild(tool_clean)
                if diff_match then
                    target_source = diff_match:FindFirstChild(muzzle_key) or diff_match
                end
            end
            local emitters = {}
            for _, child in ipairs(target_source:GetChildren()) do
                if child:IsA("ParticleEmitter") then
                    table.insert(emitters, child)
                end
            end
            if #emitters == 0 then
                for _, desc in ipairs(target_source:GetDescendants()) do
                    if desc:IsA("ParticleEmitter") then
                        table.insert(emitters, desc)
                    end
                end
            end
            if #emitters == 0 and muzzle_folder ~= target_source then
                for _, desc in ipairs(muzzle_folder:GetDescendants()) do
                    if desc:IsA("ParticleEmitter") then
                        table.insert(emitters, desc)
                    end
                end
            end
            for _, em in ipairs(emitters) do
                local clone = em:Clone()
                clone.Parent = muzzle_att
                clone.Enabled = true
                local emit_count = em:GetAttribute("EmitCount") or em:GetAttribute("Count") or 1
                clone:Emit(emit_count)
                clone.Enabled = false
                debris:AddItem(clone, math.max(clone.Lifetime.Max, 1.5))
            end
        end
    end
    local shoot_bb = (handle and handle:FindFirstChild("ShootBBGUI"))
        or (mesh and mesh:FindFirstChild("ShootBBGUI"))
        or (tool:FindFirstChild("Handle") and tool.Handle:FindFirstChild("ShootBBGUI"))
    if shoot_bb then
        local shoot_img = shoot_bb:FindFirstChild("Shoot") or shoot_bb:FindFirstChildOfClass("ImageLabel")
        if shoot_img then
            shoot_bb.Enabled = true
            shoot_img.Visible = true
            shoot_img.Size = UDim2.new(0, 0, 0, 0)
            shoot_img.ImageTransparency = 1
            local tw1 = tween_service:Create(shoot_img, TweenInfo.new(0.15, Enum.EasingStyle.Bounce, Enum.EasingDirection.In), {
                ImageTransparency = 0.4,
                Size = UDim2.new(1, 0, 1, 0)
            })
            tw1:Play()
            task.delay(0.15, function()
                local tw2 = tween_service:Create(shoot_img, TweenInfo.new(0.2, Enum.EasingStyle.Bounce, Enum.EasingDirection.In), {
                    ImageTransparency = 1,
                    Size = UDim2.new(1, 0, 1, 0)
                })
                tw2:Play()
                task.delay(0.2, function()
                    shoot_img.Visible = false
                end)
            end)
        end
    end
    if muzzle_att or handle then
        local flash_parent = muzzle_att or handle
        local light = Instance.new("PointLight")
        light.Brightness = 0.5
        light.Range = 15
        light.Shadows = false
        light.Color = Color3.fromRGB(255, 255, 255)
        light.Parent = flash_parent
        local light_tween = tween_service:Create(light, TweenInfo.new(0.3, Enum.EasingStyle.Bounce, Enum.EasingDirection.In), {
            Range = 0
        })
        light_tween:Play()
        task.delay(0.3, function()
            if light and light.Parent then light:Destroy() end
        end)
    end
end
local function play_weapon_sound(tool)
    if not tool then return end
    local handle = tool:FindFirstChild("Handle")
    local tool_name = tool.Name
    local skin_name = (handle and handle:GetAttribute("SkinName")) or (applied_skins[tool] and applied_skins[tool].skin_name) or ""
    skin_assets = skin_assets or replicated_storage:FindFirstChild("SkinAssets")
    if skin_assets and skin_name ~= "" and skin_name ~= "Default" and skin_name ~= "None" then
        local shoot_sounds = skin_assets:FindFirstChild("GunShootSounds")
        if shoot_sounds then
            local tool_folder = shoot_sounds:FindFirstChild(tool_name) or shoot_sounds:FindFirstChild(tool_name:gsub("%[", ""):gsub("%]", ""))
            if tool_folder then
                local sound_val = tool_folder:FindFirstChild(skin_name)
                if sound_val and sound_val:IsA("StringValue") and sound_val.Value ~= "" then
                    local custom_snd = Instance.new("Sound")
                    custom_snd.Name = "AdderallSkinShoot"
                    custom_snd.SoundId = sound_val.Value
                    custom_snd.Volume = 1
                    custom_snd.Parent = handle or tool
                    custom_snd:Play()
                    debris:AddItem(custom_snd, 3)
                    return
                end
            end
        end
    end
    local sound = tool:FindFirstChild("ShootSound", true) or (handle and handle:FindFirstChild("ShootSound")) or (handle and handle:FindFirstChild("Shoot"))
    if not sound then
        for _, descendant in ipairs(tool:GetDescendants()) do
            if descendant:IsA("Sound") and (descendant.Name == "Shoot" or descendant.Name == "ShootSound") then
                sound = descendant
                break
            end
        end
    end
    if sound and sound:IsA("Sound") then
        local clone = sound:Clone()
        clone.Name = "AdderallShotSound"
        clone.Parent = sound.Parent
        clone:Play()
        debris:AddItem(clone, 3)
    end
end
local function show_bullet_beam(start_pos, end_pos, tool, hit_instance, hit_normal)
    local cur = game_support.get_current()
    if cur and cur.rewrite_gun == false then return end
    local dist = (end_pos - start_pos).Magnitude
    if dist <= 0.05 then return end
    local ignored_folder = workspace:FindFirstChild("Ignored")
    local beam_parent = ignored_folder or workspace
    local siren = ignored_folder and ignored_folder:FindFirstChild("Siren")
    if siren and siren:FindFirstChild("Radius") then
        beam_parent = siren:FindFirstChild("Radius")
    end
    local cur_tool = tool or (local_player.Character and local_player.Character:FindFirstChildOfClass("Tool"))
    local handle = cur_tool and cur_tool:FindFirstChild("Handle")
    local tool_name = cur_tool and cur_tool.Name or ""
    local skin_name = resolve_current_skin_name(handle, cur_tool, tool_name) or "Default"
    local skin_info = (cur_tool and get_skin_info and get_skin_info(tool_name, skin_name)) or nil
    local beam_color = nil
    if skin_info and skin_info.BorderColor then
        if typeof(skin_info.BorderColor) == "table" then
            beam_color = skin_info.BorderColor[2] or skin_info.BorderColor[1]
        elseif typeof(skin_info.BorderColor) == "ColorSequence" or typeof(skin_info.BorderColor) == "Color3" then
            beam_color = skin_info.BorderColor
        end
    end
    local shooter_character = cur_tool and cur_tool.Parent or nil
    local shooter_player = shooter_character and players:GetPlayerFromCharacter(shooter_character) or nil
    local gun_fx = shooter_player and shooter_player:GetAttribute("GunFX") == true or false
    skin_assets = skin_assets or replicated_storage:FindFirstChild("SkinAssets")
    local gun_beam_template = replicated_storage:FindFirstChild("GunBeam")
    local left_beam_template = nil
    local impact_template = nil
    local skin_beams = skin_assets and skin_assets:FindFirstChild("GunBeam") or nil
    local skin_beam_folder = skin_beams and find_gun_beam_folder(skin_beams, skin_name) or nil
    if not gun_fx and skin_beam_folder then
        local skin_beam = skin_beam_folder:FindFirstChildOfClass("Beam")
        local part_beam = skin_beam_folder:FindFirstChildWhichIsA("BasePart")
        if skin_beam then
            local right_beam = skin_beam_folder:FindFirstChild("GunBeam")
            local left_beam = skin_beam_folder:FindFirstChild("LeftGunBeam")
            if right_beam and left_beam then
                gun_beam_template = right_beam
                left_beam_template = left_beam
            else
                gun_beam_template = skin_beam
            end
            impact_template = skin_beam_folder:FindFirstChild("Impact")
        elseif part_beam then
            local diff_folder = part_beam:FindFirstChild("Different_GunBeam")
            if diff_folder then
                local weapon_beam = diff_folder:FindFirstChild(tool_name)
                if weapon_beam then
                    local weapon_part = weapon_beam:FindFirstChildWhichIsA("BasePart")
                    local weapon_tracer = weapon_beam:FindFirstChildOfClass("Beam")
                    if weapon_part then
                        gun_beam_template = weapon_part
                        impact_template = weapon_part:FindFirstChild("Impact")
                    elseif weapon_tracer then
                        gun_beam_template = weapon_tracer
                        impact_template = weapon_beam:FindFirstChild("Impact")
                    end
                else
                    gun_beam_template = part_beam
                end
            else
                gun_beam_template = part_beam
                impact_template = part_beam:FindFirstChild("Impact")
            end
        end
    else
        local default_beams = skin_beams and skin_beams:FindFirstChild("Default") or nil
        if not gun_beam_template and default_beams then
            gun_beam_template = default_beams:FindFirstChildOfClass("Beam")
        end
    end
    if not gun_fx then
        local equipped_beam_template = resolve_equipped_beam_template(tool_name)
        if equipped_beam_template then
            gun_beam_template = equipped_beam_template
            left_beam_template = nil
            impact_template = equipped_beam_template:FindFirstChild("Impact")
        end
    else
        local equipped_beam_template = resolve_equipped_beam_template(tool_name)
        if equipped_beam_template then
            gun_beam_template = equipped_beam_template
            left_beam_template = nil
            impact_template = equipped_beam_template:FindFirstChild("Impact")
        end
    end
    if cur_tool then
        emit_muzzle_effect(cur_tool, false)
    end
    local cloned_beam = gun_beam_template and gun_beam_template:Clone() or nil
    local travel_time = dist / 725
    local bullet_part = Instance.new("Part")
    bullet_part.Name = "BULLET_RAYS"
    bullet_part.Anchored = true
    bullet_part.CanCollide = false
    bullet_part.CanTouch = false
    bullet_part.CanQuery = false
    bullet_part.Size = Vector3.new(0, 0, 0)
    bullet_part.Transparency = 1
    bullet_part.CFrame = CFrame.new(start_pos, end_pos)
    bullet_part.Parent = beam_parent
    pcall(function()
        bullet_part:SetAttribute("AdderallBeam", true)
    end)
    if cloned_beam and not cloned_beam:IsA("Beam") then
        debris:AddItem(bullet_part, travel_time + 5)
    else
        debris:AddItem(bullet_part, 0.5)
    end
    if cloned_beam then
        local start_attachment = Instance.new("Attachment")
        start_attachment.Name = "StartAttachment"
        start_attachment.Position = Vector3.new(0, 0, 0)
        start_attachment.Parent = bullet_part
        local end_attachment = Instance.new("Attachment")
        end_attachment.Name = "EndAttachment"
        end_attachment.Position = Vector3.new(0, 0, -dist)
        end_attachment.Parent = bullet_part
        if cloned_beam:IsA("Beam") then
            cloned_beam.Attachment0 = start_attachment
            cloned_beam.Attachment1 = end_attachment
            if beam_color then
                if typeof(beam_color) == "ColorSequence" then
                    cloned_beam.Color = beam_color
                elseif typeof(beam_color) == "Color3" then
                    cloned_beam.Color = ColorSequence.new(beam_color)
                end
            end
            cloned_beam.Parent = bullet_part
        elseif cloned_beam:IsA("BasePart") then
            cloned_beam.Anchored = true
            cloned_beam.CanCollide = false
            cloned_beam.CanQuery = false
            cloned_beam.CFrame = CFrame.new(start_pos, end_pos)
            local beam_end_cframe = cloned_beam.CFrame * CFrame.new(0, 0, -dist)
            cloned_beam.Parent = beam_parent
            debris:AddItem(cloned_beam, travel_time + 5)
            pcall(function()
                cloned_beam:SetAttribute("AdderallBeam", true)
                for _, tagged in ipairs(cloned_beam:GetDescendants()) do
                    if tagged:IsA("BasePart") then
                        tagged:SetAttribute("AdderallBeam", true)
                    end
                end
            end)
            if cloned_beam:GetAttribute("SpecialEffects") then
                for _, beam_descendant in ipairs(cloned_beam:GetDescendants()) do
                    if beam_descendant:IsA("Trail") then
                        local seq = beam_descendant:GetAttribute("ColorRandom")
                        if typeof(seq) == "ColorSequence" then
                            beam_descendant.Color = ColorSequence.new(evalColorSequence(seq, math.random()))
                        end
                    end
                end
            end
            if skin_name == "Undead" and tool_name == "[Revolver]" then
                cloned_beam.Color = undead_beam_colors[math.random(1, #undead_beam_colors)]
            end
            task.spawn(function()
                local initial_tween = tween_service:Create(cloned_beam, TweenInfo.new(0.05, Enum.EasingStyle.Linear), {
                    CFrame = cloned_beam.CFrame * CFrame.new(0, 0, -0.1)
                })
                initial_tween:Play()
                task.wait(0.05)
                if initial_tween.PlaybackState ~= Enum.PlaybackState.Completed then
                    initial_tween:Pause()
                end
                local travel_tween = tween_service:Create(cloned_beam, TweenInfo.new(travel_time, Enum.EasingStyle.Linear), {
                    CFrame = beam_end_cframe
                })
                travel_tween:Play()
                task.wait(travel_time)
                if cloned_beam:FindFirstChild("Impact") and hit_instance and hit_instance.Parent and hit_normal then
                    if travel_tween.PlaybackState ~= Enum.PlaybackState.Completed then
                        task.wait(0.05)
                    end
                    if not cloned_beam:FindFirstChild("NoNormal") then
                        cloned_beam.CFrame = CFrame.new(end_pos, end_pos - hit_normal)
                    end
                    for _, impact_child in ipairs(cloned_beam.Impact:GetChildren()) do
                        if impact_child:IsA("ParticleEmitter") then
                            impact_child:Emit(impact_child:GetAttribute("EmitCount") or 1)
                        end
                    end
                else
                    for _, beam_child in ipairs(cloned_beam:GetChildren()) do
                        if beam_child:IsA("BasePart") then
                            beam_child.Transparency = 1
                        end
                    end
                end
                for _, desc in ipairs(cloned_beam:GetDescendants()) do
                    if desc:IsA("ParticleEmitter") then
                        desc.Enabled = false
                    end
                end
            end)
        end
        if left_beam_template then
            local default = cur_tool and cur_tool:FindFirstChild("Default")
            local mesh = default and default:FindFirstChild("Mesh")
            local secondary_mesh = nil
            if mesh then
                for _, child in ipairs(mesh:GetChildren()) do
                    if child:IsA("BasePart") and child:GetAttribute("SecondaryMesh") then
                        secondary_mesh = child
                    end
                end
            end
            local left_muzzle = secondary_mesh
                and (secondary_mesh:FindFirstChild("LeftMuzzle") or secondary_mesh:FindFirstChildOfClass("Attachment"))
                or nil
            if left_muzzle then
                local left_muzzle_pos = left_muzzle.WorldPosition
                local left_beam_dist = (end_pos - left_muzzle_pos).Magnitude
                local left_travel_time = left_beam_dist / 725
                local left_part = Instance.new("Part")
                left_part.Name = "BULLET_RAYS"
                left_part.Anchored = true
                left_part.CanCollide = false
                left_part.CanTouch = false
                left_part.CanQuery = false
                left_part.Size = Vector3.new(0, 0, 0)
                left_part.Transparency = 1
                left_part.CFrame = CFrame.new(left_muzzle_pos, end_pos)
                left_part.Parent = beam_parent
                local left_clone = left_beam_template:Clone()
                if left_clone:IsA("Beam") then
                    local left_start = Instance.new("Attachment")
                    left_start.Parent = left_part
                    local left_end = Instance.new("Attachment")
                    left_end.Position = Vector3.new(0, 0, -left_beam_dist)
                    left_end.Parent = left_part
                    left_clone.Attachment0 = left_start
                    left_clone.Attachment1 = left_end
                    left_clone.Parent = left_part
                    debris:AddItem(left_part, 0.5)
                elseif left_clone:IsA("BasePart") then
                    left_clone.Anchored = true
                    left_clone.CanCollide = false
                    left_clone.CanQuery = false
                    left_clone.CFrame = CFrame.new(left_muzzle_pos, end_pos)
                    local left_end_cframe = left_clone.CFrame * CFrame.new(0, 0, -left_beam_dist)
                    left_clone.Parent = beam_parent
                    debris:AddItem(left_part, left_travel_time + 5)
                    debris:AddItem(left_clone, left_travel_time + 5)
                    task.spawn(function()
                        tween_service:Create(left_clone, TweenInfo.new(left_travel_time, Enum.EasingStyle.Linear), {
                            CFrame = left_end_cframe
                        }):Play()
                        task.wait(left_travel_time)
                        for _, desc in ipairs(left_clone:GetDescendants()) do
                            if desc:IsA("ParticleEmitter") then
                                desc.Enabled = false
                            end
                        end
                    end)
                end
                for _, child in ipairs(left_muzzle:GetChildren()) do
                    if child:IsA("ParticleEmitter") then
                        child:Emit(child:GetAttribute("EmitCount") or 1)
                    end
                end
            end
        end
        if impact_template and cloned_beam:IsA("Beam") and hit_instance and hit_instance.Parent then
            pcall(function()
                local bullet_hole = Instance.new("Part")
                bullet_hole.Transparency = 1
                bullet_hole.Name = "BULLETHOLE"
                bullet_hole.Size = Vector3.new(0.83, 0.731, 0.001)
                bullet_hole.Anchored = true
                bullet_hole.CanCollide = false
                bullet_hole.CanTouch = false
                bullet_hole.CanQuery = false
                local impact_clone = impact_template:Clone()
                impact_clone.Parent = bullet_hole
                local normal_offset = hit_normal and hit_normal * 0.1 or Vector3.new(0, 0, 0)
                bullet_hole.CFrame = CFrame.new(end_pos + normal_offset, end_pos + (hit_normal or Vector3.new(0, 1, 0)))
                if impact_clone:IsA("Part") then
                    impact_clone.CFrame = bullet_hole.CFrame
                end
                bullet_hole.Parent = beam_parent
                for _, desc in ipairs(bullet_hole:GetDescendants()) do
                    if desc:IsA("ParticleEmitter") then
                        desc:Emit(desc:GetAttribute("EmitCount") or 1)
                    end
                end
                debris:AddItem(bullet_hole, 5)
            end)
        end
    else
        local beam = Instance.new("Beam")
        local start_attachment = Instance.new("Attachment")
        start_attachment.Name = "StartAttachment"
        start_attachment.Position = Vector3.new(0, 0, 0)
        start_attachment.Parent = bullet_part
        local end_attachment = Instance.new("Attachment")
        end_attachment.Name = "EndAttachment"
        end_attachment.Position = Vector3.new(0, 0, -dist)
        end_attachment.Parent = bullet_part
        beam.Attachment0 = start_attachment
        beam.Attachment1 = end_attachment
        beam.FaceCamera = true
        beam.Segments = 1
        beam.Width0 = 0.08
        beam.Width1 = 0.08
        if beam_color then
            if typeof(beam_color) == "ColorSequence" then
                beam.Color = beam_color
            elseif typeof(beam_color) == "Color3" then
                beam.Color = ColorSequence.new(beam_color)
            else
                beam.Color = ColorSequence.new(Color3.fromRGB(255, 140, 38))
            end
        else
            beam.Color = ColorSequence.new(Color3.fromRGB(255, 140, 38))
        end
        beam.LightEmission = 1
        beam.LightInfluence = 0
        beam.Brightness = 1
        beam.Transparency = NumberSequence.new(0)
        beam.Parent = bullet_part
    end
end
local last_local_shot = 0
local function client_redirect_position(tool_name)
    local mods = config["Weapon Modifications"] or {}
    local cfg = mods["Client Bullet Redirection"]
    if type(cfg) ~= "table" or cfg["Enabled"] ~= true then
        return nil
    end
    local weapons = cfg["Weapons"]
    if type(weapons) == "table" then
        local listed = false
        local clean = type(tool_name) == "string" and tool_name:lower():gsub("[^%w]", "") or ""
        for _, entry in ipairs(weapons) do
            if type(entry) == "string" and entry:lower():gsub("[^%w]", "") == clean then
                listed = true
                break
            end
        end
        if not listed then
            return nil
        end
    end
    local hit = mouse and mouse.Hit
    if hit and typeof(hit.Position) == "Vector3" then
        return hit.Position
    end
    return nil
end
local function create_bullet(handle, forced_origin, aim_position, real_position)
    if not forced_origin or not aim_position then return end
    local tool = handle and handle.Parent
    local dist = (aim_position - forced_origin).Magnitude
    if dist <= 0.05 then return end
    local drawn = aim_position
    if real_position then
        local redirect = real_position - forced_origin
        if redirect.Magnitude > 1e-4 then
            drawn = forced_origin + redirect.Unit * dist
        end
    end
    show_bullet_beam(forced_origin, drawn, tool, nil, nil)
end
local bullet_remote_hooked = false
local function hook_bullet_replication()
    if bullet_remote_hooked then return end
    if not game_support.is("da hood") then return end
    local remote = game_support.get_remote("MainEvent") or replicated_storage:FindFirstChild("MainEvent")
    if not (remote and remote:IsA("RemoteEvent")) then
        if not bullet_remote_hooked then
            bullet_remote_hooked = true
            task.delay(1, function()
                bullet_remote_hooked = false
                hook_bullet_replication()
            end)
        end
        return
    end
    bullet_remote_hooked = true
    track_connection(remote.OnClientEvent:Connect(function(kind, ...)
        if kind ~= "Bullets" and kind ~= "Shooting" and kind ~= "ShootEffect" then return end
        local args = { ... }
        local origin, aim
        for _, arg in ipairs(args) do
            if typeof(arg) == "Vector3" then
                if not origin then
                    origin = arg
                elseif not aim then
                    aim = arg
                end
            end
        end
        if not origin or not aim then return end
        local char = local_player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root and (origin - root.Position).Magnitude < 12 then
            return
        end
        if tick() - last_local_shot < 0.2 then
            return
        end
        pcall(create_bullet, nil, origin, aim, nil)
    end))
    local ignored_folder = workspace:FindFirstChild("Ignored")
    if ignored_folder then
        track_connection(ignored_folder.ChildAdded:Connect(function(child)
            if not child or not child:IsA("BasePart") then return end
            if child.Name ~= "BULLET_RAYS" then return end
            if child:GetAttribute("AdderallBeam") then return end
            if tick() - last_local_shot > 0.4 then return end
            local char = local_player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if not root then return end
            if (child.Position - root.Position).Magnitude > 14 then return end
            local mods = config["Weapon Modifications"] or {}
            local cfg = mods["Client Bullet Redirection"]
            if type(cfg) ~= "table" or cfg["Enabled"] ~= true then return end
            task.defer(function()
                if child and child.Parent and not child:GetAttribute("AdderallBeam") then
                    child:Destroy()
                end
            end)
        end))
    end
end
local bullet_tp = {
    standoff = 2.5,
    tolerance = 0.5,
    idle = 0.15,
    tool = nil,
    grip = nil,
    muzzle_local = nil,
    time = nil,
    hand_names = { "RightHand", "Right Arm" },
}
function bullet_tp.server_origin(muzzle_pos, hit_pos, weapon_range)
    local delta = hit_pos - muzzle_pos
    local dist = delta.Magnitude
    if dist <= weapon_range then
        return muzzle_pos
    end
    local dir = delta / dist
    local margin = math.clamp(weapon_range * 0.02, 0.25, 2)
    return hit_pos - dir * (weapon_range - margin)
end
function bullet_tp.find_grip_weld(char, handle)
    for _, name in ipairs(bullet_tp.hand_names) do
        local hand = char:FindFirstChild(name)
        local weld = hand and hand:FindFirstChild("RightGrip")
        if weld and weld:IsA("JointInstance") and weld.Part1 == handle and weld.Part0 then
            return weld
        end
    end
    return nil
end
function bullet_tp.restore()
    local t, g = bullet_tp.tool, bullet_tp.grip
    bullet_tp.tool, bullet_tp.grip, bullet_tp.muzzle_local, bullet_tp.time = nil, nil, nil, nil
    if not t or not g or not t.Parent then return end
    local char = local_player.Character
    local bp = local_player:FindFirstChild("Backpack")
    pcall(function()
        if char and t.Parent == char and bp then
            t.Parent = bp
            t.Grip = g
            t.Parent = char
        else
            t.Grip = g
        end
    end)
end
function bullet_tp.teleport(tool, char, aim_pos)
    if not game_support.uses("voidfalls") then return end
    if not tool or not char or not aim_pos then return end
    if bullet_tp.tool and bullet_tp.tool ~= tool then
        bullet_tp.restore()
    end
    local handle = tool:FindFirstChild("Handle")
    local bp = local_player:FindFirstChild("Backpack")
    if not handle or not bp or tool.Parent ~= char then return end
    local weld = bullet_tp.find_grip_weld(char, handle)
    if not weld then return end
    local hand = weld.Part0
    if not bullet_tp.tool then
        local muzzle = get_muzzle_position(tool)
        if not muzzle then return end
        bullet_tp.tool, bullet_tp.grip = tool, tool.Grip
        bullet_tp.muzzle_local = handle.CFrame:PointToObjectSpace(muzzle)
    end
    bullet_tp.time = os.clock()
    local to_aim = aim_pos - hand.Position
    local dist = to_aim.Magnitude
    if dist < 1e-3 then return end
    local standoff = aim_pos - to_aim / dist * math.min(bullet_tp.standoff, dist * 0.5)
    if (handle.CFrame:PointToWorldSpace(bullet_tp.muzzle_local) - standoff).Magnitude <= bullet_tp.tolerance then
        return
    end
    local hand_frame = hand.CFrame * weld.C0
    local natural = hand_frame * bullet_tp.grip:Inverse()
    local rot = natural - natural.Position
    local placed = CFrame.new(standoff - rot:VectorToWorldSpace(bullet_tp.muzzle_local)) * rot
    local new_grip = hand_frame:ToObjectSpace(placed):Inverse()
    pcall(function()
        tool.Parent = bp
        tool.Grip = new_grip
        tool.Parent = char
    end)
end
function bullet_tp.step()
    if not bullet_tp.tool then return end
    local game_ex = config["Game Specific"] or {}
    local vf_cfg = game_ex["Void Falls"] or {}
    local btp_cfg = vf_cfg["Bullet TP"] or {}
    if not (btp_cfg["Enabled"] == true or btp_cfg["enabled"] == true) or not bullet_tp.time or os.clock() - bullet_tp.time > bullet_tp.idle or bullet_tp.tool.Parent ~= local_player.Character then
        bullet_tp.restore()
    end
end
local range_extender = {
    limit = 14,
    margin = 3,
    send_delay = 0.035,
}
function range_extender.allowance(char, direction)
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local velocity = root and root.AssemblyLinearVelocity
    if not velocity then return range_extender.limit end
    local toward = direction and math.max(velocity:Dot(direction), 0) or velocity.Magnitude
    return math.max(range_extender.limit - toward * range_extender.send_delay, 0)
end
function range_extender.shift(char, muzzle, point, weapon_range, params)
    local offset = point - muzzle
    local distance = offset.Magnitude
    local excess = distance - (weapon_range - range_extender.margin)
    if excess <= 0 or distance <= 1e-3 then return muzzle end
    local direction = offset / distance
    local shift = math.min(excess, range_extender.allowance(char, direction))
    if shift <= 0 then return muzzle end
    if params then
        local hit = workspace:Raycast(muzzle, direction * shift, params)
        if hit then
            shift = math.max((hit.Position - muzzle).Magnitude - 0.5, 0)
        end
    end
    if shift <= 0 then return muzzle end
    return muzzle + direction * shift
end
local das_map_wallbang = { original = nil, moved = false }
local function update_das_wallbang()
    if is_real_da_hood() or game_support.is("da hood") or not game_support.is("das hood") then
        if das_map_wallbang.moved and das_map_wallbang.original then
            local ignored_folder = workspace:FindFirstChild("Ignored")
            local map = ignored_folder and ignored_folder:FindFirstChild("MAP")
            if map then map.Parent = das_map_wallbang.original end
            das_map_wallbang.moved = false
        end
        return
    end
    local game_ex = config["Game Specific"] or {}
    local das_cfg = game_ex["Das Hood"] or {}
    local wb_cfg = das_cfg["Wallbang"] or das_cfg["wallbang"] or {}
    local enabled = wb_cfg["Enabled"] == true or wb_cfg["enabled"] == true
    local ignored_folder = workspace:FindFirstChild("Ignored")
    if not ignored_folder then return end
    local map = workspace:FindFirstChild("MAP") or (das_map_wallbang.moved and ignored_folder:FindFirstChild("MAP"))
    if not map then return end
    if enabled then
        if das_map_wallbang.moved then return end
        das_map_wallbang.original = map.Parent
        map.Parent = ignored_folder
        das_map_wallbang.moved = true
    else
        if not das_map_wallbang.moved then return end
        map.Parent = das_map_wallbang.original or workspace
        das_map_wallbang.moved = false
    end
end
track_connection(run_service.Heartbeat:Connect(function()
    bullet_tp.step()
    update_das_wallbang()
end))
function game_support.update_der_hood()
    if not game_support.uses("derhood") then return end
    local char = local_player.Character
    local body_effects = char and char:FindFirstChild("BodyEffects")
    if not body_effects then return end
    local lock = body_effects:FindFirstChild("Lock")
    local silent_cfg = config["Silent Aim"] or {}
    if not (silent_cfg["Enabled"] == true) then
        if lock then lock:Destroy() end
        return
    end
    local tool = char:FindFirstChildOfClass("Tool")
    local target_player = get_feature_target(resolve_range_check(silent_cfg, tool), false, false)
    if not (target_player and target_player.Character and passes_target_conditions(target_player, get_feature_checks(silent_cfg), false, false)) then
        if lock then lock:Destroy() end
        return
    end
    local hit_loc = silent_cfg["Hit Location"] or "Head"
    local hit_pos = resolve_hit_position(target_player.Character, hit_loc, silent_cfg["Nearest Point"])
    if not hit_pos then
        local target_part = target_player.Character:FindFirstChild(hit_loc) or target_player.Character:FindFirstChild("Head") or target_player.Character:FindFirstChild("HumanoidRootPart")
        if target_part then hit_pos = target_part.Position end
    end
    if not hit_pos then
        if lock then lock:Destroy() end
        return
    end
    if not lock or not lock:IsA("CFrameValue") then
        if lock then lock:Destroy() end
        lock = Instance.new("CFrameValue")
        lock.Name = "Lock"
        lock.Parent = body_effects
    end
    lock.Value = CFrame.new(hit_pos)
end
track_connection(run_service.Heartbeat:Connect(game_support.update_der_hood))
local function emulatefire(tool)
    if not tool or not is_gun(tool) then return end
    local char = local_player.Character
    local weapon_mods = config["Weapon Modifications"] or {}
    local rage_active = is_rage_mode_active()
    local force_register = rage_active
    local always_hit = rage_active
    if not char or is_self_knocked() or not is_character_alive(char) or (not force_register and not can_shoot(char)) then return end
    local handle = tool:FindFirstChild("Handle")
    if not handle then return end
    local ammo = tool:FindFirstChild("Ammo")
    if not ammo and tool:FindFirstChild("Script") and tool.Script:FindFirstChild("Ammo") then
        ammo = tool.Script.Ammo:FindFirstChild("CLIENT")
    end
    if not ammo then
        ammo = tool:FindFirstChild("AMMO") or (tool:FindFirstChild("Script") and (tool.Script:FindFirstChild("AMMO") or tool.Script:FindFirstChild("Ammo")))
    end
    if ammo and ammo:IsA("ValueBase") and tonumber(ammo.Value) and tonumber(ammo.Value) <= 0 and not infinite_ammo_enabled() then
        game_support.reload(tool)
        return
    end
    local cur = game_support.get_current()
    if cur and cur.rewrite_gun == false then
        if game_support.uses("hoodcustoms") then return end
        local silent_cfg = config["Silent Aim"] or {}
        local target_player = get_feature_target(resolve_range_check(silent_cfg, tool), false, false)
        if not target_player and state.current_target and state.current_target.Parent and state.current_target.Character and is_character_alive(state.current_target.Character) then
            target_player = state.current_target
        end
        local has_target = target_player and target_player.Character and (target_player == state.current_target or passes_target_conditions(target_player, get_feature_checks(silent_cfg), false, false))
        if has_target then
            local hit_loc = silent_cfg["Hit Location"] or "Head"
            local hit_pos = resolve_hit_position(target_player.Character, hit_loc, silent_cfg["Nearest Point"])
            if not hit_pos then
                local target_part = target_player.Character:FindFirstChild(hit_loc) or target_player.Character:FindFirstChild("Head") or target_player.Character:FindFirstChild("HumanoidRootPart")
                if target_part then hit_pos = target_part.Position end
            end
            if hit_pos then
                local muzzle_pos = get_muzzle_position(tool) or (char:FindFirstChild("Head") and char.Head.Position) or camera.CFrame.Position
                local target_part = target_player.Character:FindFirstChild(hit_loc) or target_player.Character:FindFirstChild("Head")
                if game_support.uses("voidfalls") then
                    local game_ex = config["Game Specific"] or {}
                    local vf_cfg = game_ex["Void Falls"] or {}
                    local btp_cfg = vf_cfg["Bullet TP"] or {}
                    if btp_cfg["Enabled"] == true or btp_cfg["enabled"] == true then
                        bullet_tp.teleport(tool, char, hit_pos)
                    end
                end
                game_support.shoot(handle, muzzle_pos, hit_pos, target_part)
            end
        end
        pcall(function()
            if type(mouse1click) == "function" then
                mouse1click()
            elseif type(mouse1press) == "function" then
                mouse1press()
                task.delay(0.02, function()
                    if type(mouse1release) == "function" then
                        mouse1release()
                    end
                end)
            end
            tool:Activate()
        end)
        return
    end
    local muzzle_pos = get_muzzle_position(tool)
    if not muzzle_pos then return end
    play_weapon_sound(tool)
    play_tool_animation(tool)
    local cd = tool:FindFirstChild("ShootingCooldown")
    local original_cooldown = cd and cd.Value or 0.3
    local range_inst = tool:FindFirstChild("Range")
    local range_val = range_inst and tonumber(range_inst.Value) or 300
    local weapon_range = range_val
    local game_ex = config["Game Specific"] or {}
    local das_hood_cfg = game_ex["Das Hood"] or {}
    local infinite_range_cfg = das_hood_cfg["Infinite Range"] or {}
    local use_infinite_range = not is_real_da_hood() and not game_support.is("da hood") and game_support.is("das hood") and (infinite_range_cfg["Enabled"] == true)
    if use_infinite_range then
        range_val = 9e9
    end
    local das_wb_cfg = das_hood_cfg["Wallbang"] or {}
    local das_wallbang = not is_real_da_hood() and not game_support.is("da hood") and game_support.is("das hood") and (das_wb_cfg["Enabled"] == true)
    local is_sg = shotguns[tool.Name] or false
    local tool_remote = tool:FindFirstChild("RemoteEvent")
    local main_event = games.get_remote_for_current("MainEvent") or replicated_storage:FindFirstChild("MainEvent")
    local silent_cfg = config["Silent Aim"] or {}
    local target_dist = (force_register or always_hit or use_infinite_range) and math.huge or resolve_range_check(silent_cfg, tool)
    local silent_ignore_walls = force_register or always_hit or das_wallbang or not (silent_cfg["Checks"] and silent_cfg["Checks"]["Visible"] == true)
    local target_player = get_feature_target(target_dist, silent_ignore_walls, force_register or always_hit or das_wallbang)
    if not target_player and state.current_target and state.current_target.Parent and state.current_target.Character and is_character_alive(state.current_target.Character) then
        target_player = state.current_target
    end
    if (force_register or always_hit) and not target_player and get_targeting_mode() ~= "target" then
        local my_pos = (char and char:FindFirstChild("HumanoidRootPart") and char.HumanoidRootPart.Position) or (camera and camera.CFrame.Position) or Vector3.new(0, 0, 0)
        local best_cand = nil
        local best_cand_dist = math.huge
        for _, p in ipairs(players:GetPlayers()) do
            if p ~= local_player and p.Character and is_character_alive(p.Character) then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local d = (hrp.Position - my_pos).Magnitude
                    if d < best_cand_dist then
                        best_cand_dist = d
                        best_cand = p
                    end
                end
            end
        end
        target_player = best_cand
    end
    local has_target = target_player and target_player.Character and (force_register or always_hit or target_player == state.current_target or passes_target_conditions(target_player, get_feature_checks(silent_cfg), silent_ignore_walls, force_register or das_wallbang))
    if not has_target then
        target_player = nil
    end
    local shoot_ray_params = RaycastParams.new()
    shoot_ray_params.FilterType = Enum.RaycastFilterType.Exclude
    local filter_instances = {char, camera}
    local ignored_folder = workspace:FindFirstChild("Ignored")
    if ignored_folder then
        table.insert(filter_instances, ignored_folder)
    end
    local bush_folder = workspace:FindFirstChild("Bush") or (ignored_folder and ignored_folder:FindFirstChild("Bush"))
    if bush_folder then
        table.insert(filter_instances, bush_folder)
    end
    if das_wallbang then
        local map_folder = workspace:FindFirstChild("MAP")
        if map_folder then
            table.insert(filter_instances, map_folder)
        end
    end
    shoot_ray_params.FilterDescendantsInstances = filter_instances
    shoot_ray_params.IgnoreWater = true
    local aim_pos
    local wb_spot, wb_part
    if (silent_cfg["Enabled"] == true or force_register or always_hit or (target_player and target_player == state.current_target)) and has_target then
        local hit_loc = silent_cfg["Hit Location"] or "Head"
        local hit_pos = resolve_hit_position(target_player.Character, hit_loc, silent_cfg["Nearest Point"])
        if not hit_pos then
            local target_part = target_player.Character:FindFirstChild(hit_loc) or target_player.Character:FindFirstChild("Head") or target_player.Character:FindFirstChild("HumanoidRootPart")
            if target_part then hit_pos = target_part.Position end
        end
        if hit_pos then
            local backtrack_pos = get_backtrack_position(target_player, hit_loc)
            if backtrack_pos then hit_pos = backtrack_pos end
            local bt_cfg = config["Backtrack"] or {}
            local eb_cfg = bt_cfg["Emulated Backtrack"] or {}
            if bt_cfg["Enabled"] == true and eb_cfg["Enabled"] == true then
                local last = emulated_backtrack.last_hit[target_player]
                local now = tick()
                if last and now - last.time <= emulated_backtrack.max_age then
                    hit_pos = last.pos
                end
            end
            local root = target_player.Character:FindFirstChild("HumanoidRootPart")
            local vel = root and root.Velocity or Vector3.new(0, 0, 0)
            local pred = get_prediction_value(silent_cfg["Prediction"])
            local future_off = get_future_offset(tool.Name)
            local future_gun = future.gun_active(tool.Name)
            if future_gun and root then
                future_off = future.offset(target_player.Character, root, future.scale(future_gun))
            end
            local impact_pos = hit_pos + future_off + Vector3.new(vel.X * pred.X, vel.Y * pred.Y, vel.Z * pred.Z)
            if muzzle_pos and (wallbang.enabled() or (wallbang.fire_on_wallbang() and wallbang.blocked(muzzle_pos, target_player.Character))) then
                local found_pos, found_part = wallbang.search(muzzle_pos, target_player.Character, impact_pos, range_val)
                if found_pos then
                    wb_spot = found_pos
                    wb_part = found_part
                    impact_pos = found_pos
                end
            end
            aim_pos = impact_pos
        end
    end
    if (force_register or always_hit) and target_player and target_player.Character and not aim_pos then
        local target_part = target_player.Character:FindFirstChild(silent_cfg["Hit Location"] or "Head") or target_player.Character:FindFirstChild("Head") or target_player.Character:FindFirstChild("HumanoidRootPart")
        if target_part then
            aim_pos = target_part.Position
        end
    end
    if not aim_pos then
        local mouse_pos = user_input_service:GetMouseLocation()
        local mouse_ray = camera:ViewportPointToRay(mouse_pos.X, mouse_pos.Y)
        local fallback_ray = workspace:Raycast(mouse_ray.Origin, mouse_ray.Direction * range_val, shoot_ray_params)
        aim_pos = fallback_ray and fallback_ray.Position or (mouse_ray.Origin + mouse_ray.Direction * range_val)
    end
    local vf_cfg = game_ex["Void Falls"] or {}
    local bullet_tp_cfg = vf_cfg["Bullet TP"] or {}
    if game_support.uses("voidfalls") and (bullet_tp_cfg["Enabled"] == true) and aim_pos then
        bullet_tp.teleport(tool, char, aim_pos)
    end
    local range_cfg = weapon_mods["Range Extender"]
    local should_shift_origin = has_target and not use_infinite_range and range_cfg and (range_cfg["Enabled"] == true or range_cfg["enabled"] == true)
    if should_shift_origin then
        muzzle_pos = range_extender.shift(char, muzzle_pos, aim_pos, range_val, shoot_ray_params)
    end
    local spread_mult = force_register and 0 or gun_modifier_lib.get_spread_multiplier(tool.Name)
    local double_tap_count = gun_modifier_lib.get_shot_count(tool.Name)
    for tap = 1, double_tap_count do
        if ammo and ammo:IsA("ValueBase") and tonumber(ammo.Value) and tonumber(ammo.Value) <= 0 and not infinite_ammo_enabled() then break end
        local wants_server_time = (weapon_data[tool.Name] and weapon_data[tool.Name].server_time) or is_sg
        local server_time = wants_server_time and workspace:GetServerTimeNow() or nil
        if is_sg then
            local base_aim_dir = (aim_pos - muzzle_pos).Unit
            local legacy = is_legacy_shooting()
            local pattern, current_spread_counter = next_shotgun_spread(tool.Name, legacy)
            for pellet = 1, 5 do
                local spread_vec = (pattern and pattern[pellet]) or Vector3.new(0, 0, 0)
                if not pattern and not force_register and not has_target then
                    local spread_x = (math.random() > 0.5 and math.random() * 0.05 or -math.random() * 0.05) * (spread_mult == 0 and 1 or spread_mult)
                    local spread_y = (math.random() > 0.5 and math.random() * 0.1 or -math.random() * 0.1) * (spread_mult == 0 and 1 or spread_mult)
                    local spread_z = (math.random() > 0.5 and math.random() * 0.05 or -math.random() * 0.05) * (spread_mult == 0 and 1 or spread_mult)
                    spread_vec = Vector3.new(spread_x, spread_y, spread_z)
                end
                local pellet_dir = (base_aim_dir + spread_vec).Unit
                local ray_vec = pellet_dir * range_val
                local pellet_ray = workspace:Raycast(muzzle_pos, ray_vec, shoot_ray_params)
                local hit_position, hit_instance, hit_normal
                if wb_spot then
                    hit_position = wb_spot
                    hit_instance = wb_part or (target_player and target_player.Character and target_player.Character:FindFirstChild("Head"))
                    local away = muzzle_pos - wb_spot
                    hit_normal = away.Magnitude > 1e-4 and away.Unit or -pellet_dir
                elseif (force_register or always_hit or das_wallbang) and target_player and target_player.Character then
                    local target_char = target_player.Character
                    local hit_part_name = silent_cfg["Hit Location"] or "Head"
                    local target_part = target_char:FindFirstChild(hit_part_name) or target_char:FindFirstChild("Head") or target_char:FindFirstChild("HumanoidRootPart")
                    if target_part then
                        hit_position = target_part.Position
                        hit_instance = target_part
                        hit_normal = (muzzle_pos - hit_position).Unit
                    else
                        hit_position = pellet_ray and pellet_ray.Position or (muzzle_pos + ray_vec)
                        hit_instance = pellet_ray and pellet_ray.Instance or nil
                        hit_normal = pellet_ray and pellet_ray.Normal or -pellet_dir
                    end
                elseif has_target and target_player and target_player.Character then
                    local target_char = target_player.Character
                    local hit_part_name = silent_cfg["Hit Location"] or "Head"
                    local target_part = target_char:FindFirstChild(hit_part_name) or target_char:FindFirstChild("Head") or target_char:FindFirstChild("HumanoidRootPart")
                    if pellet_ray and pellet_ray.Instance and pellet_ray.Instance:IsDescendantOf(target_char) then
                        hit_position = pellet_ray.Position
                        hit_instance = pellet_ray.Instance
                        hit_normal = pellet_ray.Normal
                    elseif target_part then
                        hit_position = target_part.Position
                        hit_instance = target_part
                        hit_normal = pellet_ray and pellet_ray.Normal or -pellet_dir
                    else
                        hit_position = pellet_ray and pellet_ray.Position or (muzzle_pos + ray_vec)
                        hit_instance = pellet_ray and pellet_ray.Instance or nil
                        hit_normal = pellet_ray and pellet_ray.Normal or -pellet_dir
                    end
                else
                    hit_position = pellet_ray and pellet_ray.Position or (muzzle_pos + ray_vec)
                    hit_instance = pellet_ray and pellet_ray.Instance or nil
                    hit_normal = pellet_ray and pellet_ray.Normal or -pellet_dir
                end
                if hit_instance and target_player and hit_instance:IsDescendantOf(target_player.Character) and emulated_backtrack_feature_enabled() then
                    emulated_backtrack.last_hit[target_player] = {pos = hit_position, time = tick()}
                end
                hit_position, hit_instance, hit_normal = apply_damage_modifier(tool.Name, hit_position, hit_instance, hit_normal, target_player)
                if not game_support.is("da hood") then
                    hit_normal = (muzzle_pos - hit_position).Unit
                end
                if pellet == 1 then
                    local visual_origin = get_muzzle_position(tool) or muzzle_pos
                    create_bullet(handle, visual_origin, hit_position, client_redirect_position(tool.Name))
                    last_local_shot = tick()
                end
                local shoot_origin = use_infinite_range and bullet_tp.server_origin(muzzle_pos, hit_position, weapon_range) or muzzle_pos
                game_support.shoot(handle, shoot_origin, hit_position, hit_instance, hit_normal, server_time, pellet, current_spread_counter)
            end
        else
            local spread_vec = Vector3.new(0, 0, 0)
            if not force_register and spread_mult ~= 1 and not has_target then
                local spread_amount = 0.02 * spread_mult
                local sx = (math.random() > 0.5 and math.random() * spread_amount or -math.random() * spread_amount)
                local sy = (math.random() > 0.5 and math.random() * spread_amount or -math.random() * spread_amount)
                local sz = (math.random() > 0.5 and math.random() * spread_amount or -math.random() * spread_amount)
                spread_vec = Vector3.new(sx, sy, sz)
            end
            local aim_dir = (aim_pos - muzzle_pos).Unit
            if spread_vec ~= Vector3.zero then
                aim_dir = (aim_dir + spread_vec).Unit
            end
            local ray_vec = aim_dir * range_val
            local bullet_cfg = weapon_mods["Bullet Modification"]
            local bullet_size = bullet_cfg and (bullet_cfg["Size"] or bullet_cfg["size"]) or Vector2.new(0, 0)
            local use_thick = has_target and bullet_cfg and (bullet_cfg["Enabled"] == true or bullet_cfg["enabled"] == true)
            local ray_result = use_thick and thick_raycast(muzzle_pos, aim_dir, range_val, bullet_size.X, bullet_size.Y, shoot_ray_params) or workspace:Raycast(muzzle_pos, ray_vec, shoot_ray_params)
            local hit_position, hit_instance, hit_normal
            if wb_spot then
                hit_position = wb_spot
                hit_instance = wb_part or (target_player and target_player.Character and target_player.Character:FindFirstChild("Head"))
                local away = muzzle_pos - wb_spot
                hit_normal = away.Magnitude > 1e-4 and away.Unit or -aim_dir
            elseif (force_register or always_hit or das_wallbang) and target_player and target_player.Character then
                local target_char = target_player.Character
                local hit_part_name = silent_cfg["Hit Location"] or "Head"
                local target_part = target_char:FindFirstChild(hit_part_name) or target_char:FindFirstChild("Head") or target_char:FindFirstChild("HumanoidRootPart")
                if target_part then
                    hit_position = target_part.Position
                    hit_instance = target_part
                    hit_normal = (muzzle_pos - hit_position).Unit
                else
                    hit_position = ray_result and ray_result.Position or (muzzle_pos + ray_vec)
                    hit_instance = ray_result and ray_result.Instance or nil
                    hit_normal = ray_result and ray_result.Normal or -aim_dir
                end
            elseif has_target and target_player and target_player.Character then
                local target_char = target_player.Character
                local hit_part_name = silent_cfg["Hit Location"] or "Head"
                local target_part = target_char:FindFirstChild(hit_part_name) or target_char:FindFirstChild("Head") or target_char:FindFirstChild("HumanoidRootPart")
                if ray_result and ray_result.Instance and ray_result.Instance:IsDescendantOf(target_char) then
                    hit_position = ray_result.Position
                    hit_instance = ray_result.Instance
                    hit_normal = ray_result.Normal
                elseif target_part then
                    hit_position = target_part.Position
                    hit_instance = target_part
                    hit_normal = ray_result and ray_result.Normal or -aim_dir
                else
                    hit_position = ray_result and ray_result.Position or (muzzle_pos + ray_vec)
                    hit_instance = ray_result and ray_result.Instance or nil
                    hit_normal = ray_result and ray_result.Normal or -aim_dir
                end
            else
                hit_position = ray_result and ray_result.Position or (muzzle_pos + ray_vec)
                hit_instance = ray_result and ray_result.Instance or nil
                hit_normal = ray_result and ray_result.Normal or -aim_dir
            end
            if hit_instance and target_player and hit_instance:IsDescendantOf(target_player.Character) and emulated_backtrack_feature_enabled() then
                emulated_backtrack.last_hit[target_player] = {pos = hit_position, time = tick()}
            end
            hit_position, hit_instance, hit_normal = apply_damage_modifier(tool.Name, hit_position, hit_instance, hit_normal, target_player)
            if not game_support.is("da hood") then
                hit_normal = (muzzle_pos - hit_position).Unit
            elseif not hit_normal or hit_normal == Vector3.zero then
                hit_normal = -aim_dir
            end
            local visual_origin = get_muzzle_position(tool) or muzzle_pos
            create_bullet(handle, visual_origin, hit_position, client_redirect_position(tool.Name))
            last_local_shot = tick()
            local shoot_origin = use_infinite_range and bullet_tp.server_origin(muzzle_pos, hit_position, weapon_range) or muzzle_pos
            game_support.shoot(handle, shoot_origin, hit_position, hit_instance, hit_normal)
        end
        if tap < double_tap_count then
            task.wait(0.03)
        end
    end
end
local function hook_weapon(tool)
    if not tool:IsA("Tool") or hooked_tools[tool] or tool:GetAttribute("AdderallHooked") then return end
    if not is_gun(tool) then return end
    hooked_tools[tool] = true
    tool:SetAttribute("AdderallHooked", true)
    local cur = game_support.get_current()
    if cur and cur.rewrite_gun == false then
        if game_support.uses("hoodcustoms") then
            local gdata = hoodcustoms_gun_data[tool.Name]
            local cooldown = gdata and gdata.cooldown or 0.25
            local is_auto = gdata and gdata.auto or false
            local last_hc_fire = 0
            local hc_held = false
            tool.Enabled = false
            track_connection(tool:GetPropertyChangedSignal("Enabled"):Connect(function()
                if tool.Enabled and tool.Parent == local_player.Character then
                    tool.Enabled = false
                end
            end))
            local function fire_hc()
                local char = local_player.Character
                if not char or tool.Parent ~= char then return end
                if tick() - last_hc_fire < cooldown then return end
                if not gdata or tool.Name == "[Firework Launcher]" then return end
                if tool.Name == "[Flintlock]" and char.Parent == (workspace:FindFirstChild("Players") and workspace.Players:FindFirstChild("InBox")) then return end
                local body_effects = char:FindFirstChild("BodyEffects")
                local handle = tool:FindFirstChild("Handle")
                local upper_torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
                if not body_effects or not handle or not upper_torso then return end
                local reloading = body_effects:FindFirstChild("Reloading_CLIENT")
                if reloading and reloading.Value == true then return end
                local ammo = (tool:FindFirstChild("Script") and tool.Script:FindFirstChild("Ammo") and tool.Script.Ammo:FindFirstChild("CLIENT")) or tool:FindFirstChild("Ammo") or tool:FindFirstChild("AMMO")
                if not ammo or not ammo:IsA("ValueBase") or tonumber(ammo.Value) <= 0 then
                    hoodcustoms_empty_click(tool)
                    return
                end
                local rage_active = is_rage_mode_active()
                if not rage_active and not hoodcustoms_can_interact(body_effects) then return end
                local attacking = body_effects:FindFirstChild("Attacking_CLIENT")
                local shoot_sound = handle:FindFirstChild("Shoot")
                local movement_folder = char:FindFirstChild("Movement")
                if not attacking or not shoot_sound or not movement_folder then return end
                last_hc_fire = tick()
                local muzzle = get_muzzle_position(tool) or (handle and handle.Position) or (char:FindFirstChild("Head") and char.Head.Position) or camera.CFrame.Position
                local silent_cfg = config["Silent Aim"] or {}
                local target_player = get_feature_target(resolve_range_check(silent_cfg, tool), false, false)
                if not target_player and state.current_target and state.current_target.Parent and state.current_target.Character and is_character_alive(state.current_target.Character) then
                    target_player = state.current_target
                end
                local has_target = target_player and target_player.Character and (target_player == state.current_target or passes_target_conditions(target_player, get_feature_checks(silent_cfg), false, false))
                local aim
                if has_target then
                    local hit_loc = silent_cfg["Hit Location"] or "Head"
                    aim = resolve_hit_position(target_player.Character, hit_loc, silent_cfg["Nearest Point"])
                    if not aim then
                        local part = target_player.Character:FindFirstChild(hit_loc) or target_player.Character:FindFirstChild("Head") or target_player.Character:FindFirstChild("HumanoidRootPart")
                        if part then aim = part.Position end
                    end
                end
                if not aim then
                    local mouse_ray = mouse.UnitRay
                    local mres = workspace:Raycast(mouse_ray.Origin, mouse_ray.Direction * 1000)
                    aim = mres and mres.Position or (mouse_ray.Origin + mouse_ray.Direction * 1000)
                end
                local block_params = RaycastParams.new()
                block_params.FilterType = Enum.RaycastFilterType.Exclude
                block_params.FilterDescendantsInstances = { workspace:FindFirstChild("Players") or workspace, workspace:FindFirstChild("Ignored") or workspace }
                block_params.IgnoreWater = true
                local blocked = workspace:Raycast(upper_torso.Position, muzzle - upper_torso.Position, block_params)
                if blocked then
                    aim = blocked.Position
                end
                if (aim - muzzle).Magnitude < 0.05 then
                    aim = muzzle + camera.CFrame.LookVector * 10
                end
                local pellets = hoodcustoms_get_pellets(muzzle, aim, gdata.is_shotgun)
                local skin = tool:GetAttribute("SKIN") or "None"
                ammo.Value = ammo.Value - 1
                attacking.Value = true
                task.delay(cooldown, function()
                    if attacking then attacking.Value = false end
                end)
                pcall(function()
                    local mbe = replicated_storage:FindFirstChild("MainBindedEvent")
                    if mbe then mbe:Fire("GunFired") end
                end)
                local snd = shoot_sound:Clone()
                debris:AddItem(snd, 2)
                snd.Parent = handle
                snd:Play()
                local reduce_walk = Instance.new("NumberValue")
                debris:AddItem(reduce_walk, gdata.slowdown_time)
                reduce_walk.Name = "ReduceWalk"
                reduce_walk.Parent = movement_folder
                hoodcustoms_shot_index = hoodcustoms_shot_index + 1
                local index = hoodcustoms_shot_index
                local ray_filter = { workspace:FindFirstChild("Ignored") or workspace, char, camera }
                local ray_params = RaycastParams.new()
                ray_params.FilterType = Enum.RaycastFilterType.Exclude
                ray_params.FilterDescendantsInstances = ray_filter
                ray_params.IgnoreWater = true
                local hits = {}
                for pellet_index, direction in ipairs(pellets) do
                    local result = workspace:Raycast(muzzle, direction * 200, ray_params)
                    local end_pos = result and result.Position or (muzzle + direction * 200)
                    pcall(hoodcustoms_draw_tracer, muzzle, end_pos, skin)
                    if result and result.Instance then
                        local part = result.Instance
                        local model = part:FindFirstAncestorOfClass("Model")
                        if model and model:FindFirstChildOfClass("Humanoid") then
                            table.insert(hits, {
                                PELLET = pellet_index,
                                MODEL = model,
                                PART = part,
                                POSITION = end_pos
                            })
                            pcall(function()
                                local te = model:FindFirstChild("BodyEffects")
                                local deflected = te and te:FindFirstChild("BULLET_DEFLECT")
                                local sound_name = deflected and "BulletDeflect" or "HitSound"
                                local st = replicated_storage:FindFirstChild(sound_name)
                                if st then
                                    local s = st:Clone()
                                    debris:AddItem(s, 3)
                                    s.Parent = part
                                    s:Play()
                                end
                            end)
                        end
                    end
                end
                if rage_active and target_player and target_player.Character and #hits == 0 then
                    local target_part = target_player.Character:FindFirstChild("Head") or target_player.Character:FindFirstChild("HumanoidRootPart") or target_player.Character:FindFirstChildWhichIsA("BasePart")
                    if target_part then
                        table.insert(hits, {
                            PELLET = 1,
                            MODEL = target_player.Character,
                            PART = target_part,
                            POSITION = target_part.Position
                        })
                    end
                end
                local main_event = replicated_storage:FindFirstChild("MainEvent")
                if main_event then
                    main_event:FireServer("Shoot", { ORIGIN = muzzle, AIM = aim, INDEX = index, HITS = hits })
                end
                pcall(hoodcustoms_flash_muzzle, tool)
            end
            track_connection(user_input_service.InputBegan:Connect(function(input, gpe)
                if gpe or user_input_service:GetFocusedTextBox() then return end
                if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
                if tool.Parent ~= local_player.Character then return end
                hc_held = true
                fire_hc()
                if is_auto then
                    task.spawn(function()
                        while hc_held and tool.Parent == local_player.Character do
                            task.wait(cooldown)
                            if not hc_held or tool.Parent ~= local_player.Character then break end
                            fire_hc()
                        end
                    end)
                end
            end))
            track_connection(user_input_service.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    hc_held = false
                end
            end))
            track_connection(tool.Unequipped:Connect(function()
                hc_held = false
                tool.Enabled = true
                hooked_tools[tool] = nil
                tool:SetAttribute("AdderallHooked", nil)
            end))
            return
        end
        if game_support.uses("voidfalls") then
            track_connection(tool.Activated:Connect(function()
                local char = local_player.Character
                if not char or tool.Parent ~= char then return end
                if not is_character_alive(char) then return end
                local be = char:FindFirstChild("BodyEffects")
                if be then
                    local ko = be:FindFirstChild("K.O")
                    if ko and ko.Value == true then return end
                    local reloading = be:FindFirstChild("Reloading") or be:FindFirstChild("Reloading_CLIENT")
                    if reloading and reloading.Value == true then return end
                end
                local ammo = (tool:FindFirstChild("Script") and (tool.Script:FindFirstChild("AMMO") or tool.Script:FindFirstChild("Ammo"))) or tool:FindFirstChild("AMMO") or tool:FindFirstChild("Ammo")
                if ammo and ammo:IsA("ValueBase") and tonumber(ammo.Value) and tonumber(ammo.Value) <= 0 then
                    return
                end
                local silent_cfg = config["Silent Aim"] or {}
                local target_player = get_feature_target(resolve_range_check(silent_cfg, tool), false, false)
                if not target_player and state.current_target and state.current_target.Parent and state.current_target.Character and is_character_alive(state.current_target.Character) then
                    target_player = state.current_target
                end
                local has_target = target_player and target_player.Character and (target_player == state.current_target or passes_target_conditions(target_player, get_feature_checks(silent_cfg), false, false))
                if not has_target then return end
                local hit_loc = silent_cfg["Hit Location"] or "Head"
                local hit_pos = resolve_hit_position(target_player.Character, hit_loc, silent_cfg["Nearest Point"])
                if not hit_pos then
                    local target_part = target_player.Character:FindFirstChild(hit_loc) or target_player.Character:FindFirstChild("Head") or target_player.Character:FindFirstChild("HumanoidRootPart")
                    if target_part then hit_pos = target_part.Position end
                end
                if not hit_pos then return end
                local game_ex = config["Game Specific"] or {}
                local vf_cfg = game_ex["Void Falls"] or {}
                local btp_cfg = vf_cfg["Bullet TP"] or {}
                if btp_cfg["Enabled"] == true or btp_cfg["enabled"] == true then
                    bullet_tp.teleport(tool, char, hit_pos)
                end
                local remote = game_support.get_remote("voidfalls")
                if remote then
                    remote:FireServer("MOUSE", hit_pos)
                end
            end))
            return
        end
        track_connection(tool.Activated:Connect(function()
            local char = local_player.Character
            if not char or tool.Parent ~= char then return end
            local silent_cfg = config["Silent Aim"] or {}
            local target_player = get_feature_target(resolve_range_check(silent_cfg, tool), false, false)
            if not target_player and state.current_target and state.current_target.Parent and state.current_target.Character and is_character_alive(state.current_target.Character) then
                target_player = state.current_target
            end
            local has_target = target_player and target_player.Character and (target_player == state.current_target or passes_target_conditions(target_player, get_feature_checks(silent_cfg), false, false))
            if not has_target then return end
            local hit_loc = silent_cfg["Hit Location"] or "Head"
            local hit_pos = resolve_hit_position(target_player.Character, hit_loc, silent_cfg["Nearest Point"])
            if not hit_pos then
                local target_part = target_player.Character:FindFirstChild(hit_loc) or target_player.Character:FindFirstChild("Head") or target_player.Character:FindFirstChild("HumanoidRootPart")
                if target_part then hit_pos = target_part.Position end
            end
            if not hit_pos then return end
            local muzzle_pos = get_muzzle_position(tool) or (char:FindFirstChild("Head") and char.Head.Position) or camera.CFrame.Position
            local target_part = target_player.Character:FindFirstChild(hit_loc) or target_player.Character:FindFirstChild("Head")
            game_support.shoot(tool:FindFirstChild("Handle"), muzzle_pos, hit_pos, target_part)
        end))
        return
    end
    clean_scripts(tool)
    local last_fire = 0
    local firing = false
    local fire_token = 0
    local function stop_firing()
        firing = false
        state.is_shooting = false
    end
    local function get_tool_remote()
        return tool:FindFirstChild("RemoteEvent") or tool:FindFirstChild("Server") or tool:FindFirstChild("Shoot")
    end
    track_connection(tool.Activated:Connect(function()
        local char = local_player.Character
        if not char or tool.Parent ~= char then return end
        local weapon_mods = config["Weapon Modifications"] or {}
        local rage_active = is_rage_mode_active()
        local force_register = rage_active
        if not force_register and not can_shoot(char) then return end
        local category = (weapon_data[tool.Name] and weapon_data[tool.Name].category) or (autos[tool.Name] and "Auto") or (bursts[tool.Name] and "Burst") or "Single"
        local is_auto = category == "Auto" or category == "AutoShotgun"
        local is_burst = category == "Burst"
        local default_cooldown = gun_modifier_lib.get_cooldown(tool)
        local delay_cfg = weapon_mods["Delay Changer"] or (config["Combat"] and config["Combat"]["Delay Changer"])
        local delay_enabled = delay_cfg and (delay_cfg["Enabled"] == true or delay_cfg["enabled"] == true)
        local configured_delay = delay_enabled and gun_modifier_lib.get_value(delay_cfg, tool.Name) or nil
        if not game_support.supports_weapon_mods() then delay_enabled = false end
        local delay_scale = 1
        if delay_enabled and configured_delay then
            local percent = tonumber(configured_delay)
            if percent then delay_scale = math.clamp(percent / 100, 0, 1) end
        end
        local wdata = weapon_data[tool.Name]
        local fixed_gate = wdata and wdata.gate and (wdata.gate * delay_scale)
        local cooldown = tonumber(default_cooldown) or 0.2
        if cooldown ~= cooldown or math.abs(cooldown) == math.huge then cooldown = 0.2 end
        local gate = fixed_gate or (cooldown + 0.0095 + (wdata and wdata.gate_extra or 0))
        if is_auto then
            gate = fixed_gate or (cooldown + (wdata and wdata.gate_offset or 0.0095))
        elseif category == "AutoShotgun" then
            gate = fixed_gate or (cooldown * 1.5)
        elseif is_burst then
            local tol = tool:FindFirstChild("ToleranceCooldown")
            gate = tonumber(tol and tol.Value) or 0.3
        end
        local cd = tool:FindFirstChild("ShootingCooldown")
        local tool_remote = get_tool_remote()
        if is_auto then
            if firing then return end
            firing = true
            state.is_shooting = true
            fire_token = fire_token + 1
            local token = fire_token
            if tool_remote and tool_remote:IsA("RemoteEvent") then
                tool_remote:FireServer("Shoot")
            end
            task.spawn(function()
                while firing and token == fire_token and tool.Parent == char do
                    if not force_register and not can_shoot(char) then break end
                    local ammo = tool:FindFirstChild("Ammo") or tool:FindFirstChild("AMMO")
                    if ammo and ammo:IsA("ValueBase") and tonumber(ammo.Value) and tonumber(ammo.Value) <= 0 and not infinite_ammo_enabled() then break end
                    last_fire = tick()
                    emulatefire(tool)
                    task.wait(gate)
                end
                if token == fire_token then
                    stop_firing()
                end
                if tool_remote and tool_remote:IsA("RemoteEvent") then
                    tool_remote:FireServer()
                end
            end)
        elseif is_burst then
            local tolerance = gate
            if tick() - last_fire < tolerance then
                stop_firing()
                return
            end
            last_fire = tick()
            local burst_at = last_fire
            local burst_count = 3
            local ammo = tool:FindFirstChild("Ammo") or tool:FindFirstChild("AMMO")
            if ammo and ammo:IsA("ValueBase") and tonumber(ammo.Value) then
                burst_count = math.min(burst_count, tonumber(ammo.Value) or 3)
            end
            firing = true
            state.is_shooting = true
            if tool_remote and tool_remote:IsA("RemoteEvent") then
                tool_remote:FireServer("Shoot")
            end
            task.spawn(function()
                for _ = 1, burst_count do
                    if tool.Parent ~= char then break end
                    if not force_register and not can_shoot(char) then break end
                    emulatefire(tool)
                    task.wait(gate)
                end
                if not firing and last_fire == burst_at and tool.Parent == char then
                    state.is_shooting = false
                end
                if tool_remote and tool_remote:IsA("RemoteEvent") then
                    tool_remote:FireServer()
                end
            end)
            firing = false
        else
            if tick() - last_fire < gate then
                stop_firing()
                return
            end
            last_fire = tick()
            state.is_shooting = true
            if tool_remote and tool_remote:IsA("RemoteEvent") then
                tool_remote:FireServer("Shoot")
            end
            emulatefire(tool)
            if tool_remote and tool_remote:IsA("RemoteEvent") then
                tool_remote:FireServer()
            end
            firing = false
            local shot_at = last_fire
            task.delay(gate, function()
                if not firing and last_fire == shot_at and tool.Parent == char then
                    state.is_shooting = false
                end
            end)
        end
    end))
    track_connection(tool.Deactivated:Connect(function()
        firing = false
        state.is_shooting = false
    end))
end
local function sort_inventory()
    local char = local_player.Character
    local backpack = local_player:FindFirstChildOfClass("Backpack")
    if not backpack then return end
    local order = config["Game Utilities"]["Inventory Sorter"]["Order"]
    local temp_folder = Instance.new("Folder")
    temp_folder.Name = "SorterTemp"
    temp_folder.Parent = workspace
    for _, item in ipairs(backpack:GetChildren()) do
        if item:IsA("Tool") then
            item.Parent = temp_folder
        end
    end
    for _, name in ipairs(order) do
        local tool = temp_folder:FindFirstChild(name)
        if tool then
            tool.Parent = backpack
            task.wait(0.04)
        end
    end
    for _, item in ipairs(temp_folder:GetChildren()) do
        item.Parent = backpack
    end
    temp_folder:Destroy()
end
local fov_circle = Drawing and Drawing.new("Circle")
if fov_circle then
    fov_circle.Thickness = 1
    fov_circle.NumSides = 64
    fov_circle.Filled = false
    fov_circle.Visible = false
end
local trigger_fov_circle = Drawing and Drawing.new("Circle")
if trigger_fov_circle then
    trigger_fov_circle.Thickness = 1
    trigger_fov_circle.NumSides = 64
    trigger_fov_circle.Filled = false
    trigger_fov_circle.Visible = false
end
local panic_ground_cooldown = 0
local function run_panic_ground()
    local character = local_player.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root or not humanoid then return end
    if tick() - panic_ground_cooldown < 0.1 then return end
    panic_ground_cooldown = tick()
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character}
    params.IgnoreWater = true
    local origin = root.Position
    local result = workspace:Raycast(origin, Vector3.new(0, -500, 0), params)
    if not result then return end
    local velocity = root.AssemblyLinearVelocity
    root.AssemblyLinearVelocity = Vector3.new(velocity.X, 0, velocity.Z)
    root.CFrame = (root.CFrame - root.Position) + result.Position + Vector3.new(0, humanoid.HipHeight + root.Size.Y * 0.5, 0)
end

local Movement = {}
Movement.Saved = {}
Movement.RampTime = 0.15
Movement.Bypass = { Velocity = Vector3.zero, Restores = 0, Limit = 3 }
Movement.WallJumpsUsed = 0
Movement.WallJumpParams = RaycastParams.new()
Movement.WallJumpParams.FilterType = Enum.RaycastFilterType.Exclude
Movement.WallJumpFilter = {}
Movement.WallDetectRange = 3
Movement.WallMaxNormalY = 0.5
Movement.WallDirs = {}
Movement.WallDiagonal = 0.7071067811865476
Movement.CachedHumanoid = nil
Movement.CachedCharacter = nil
Movement.HumanoidStamp = 0
Movement.JumpPowerBound = setmetatable({}, { __mode = "k" })
Movement.JumpPowerPending = setmetatable({}, { __mode = "k" })
Movement.JumpPowerConns = setmetatable({}, { __mode = "k" })

function Movement:GetLocalHumanoid()
    local Character = local_player.Character
    if Movement.CachedCharacter == Character and Movement.CachedHumanoid and Movement.CachedHumanoid.Parent == Character then
        return Character, Movement.CachedHumanoid
    end
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    Movement.CachedCharacter = Character
    Movement.CachedHumanoid = Humanoid
    return Character, Humanoid
end

function Movement:Reset()
    table.clear(Movement.Saved)
    Movement.Ramp = nil
    Movement.Bypass.Velocity, Movement.Bypass.Restores = Vector3.zero, 0
end

function Movement:Toggled(Section, StateKey)
    local player_mods = config["Player Modifications"] or get_bind_value("Player Modifications")
    local Cfg = (player_mods and (player_mods[Section] or player_mods[tostring(Section):lower()])) or config[Section] or get_bind_value(Section)
    if type(Cfg) ~= "table" then return nil end
    local is_enabled = Cfg["Enabled"] == true or Cfg["enabled"] == true
    if not is_enabled then return nil end
    if StateKey and state[StateKey] ~= true then
        return nil
    end
    return Cfg
end

function Movement:Situation(Humanoid)
    if Humanoid.Health > 0 and Humanoid.Health <= 25 then
        return "Low Health"
    end
    local Tool = local_player.Character and local_player.Character:FindFirstChildOfClass("Tool")
    if Tool then
        local Ammo = Tool:FindFirstChild("Ammo") or Tool:FindFirstChild("AMMO")
        local Reloading = Tool:FindFirstChild("Reloading")
        if (Ammo and tonumber(Ammo.Value) == 0) or (Reloading and Reloading.Value == true) then
            return "Reload"
        end
    end
    local char = local_player.Character
    local body_effects = char and char:FindFirstChild("BodyEffects")
    if body_effects then
        for _, name in ipairs({ "Reload", "Reloading", "ReloadEvent" }) do
            local flag = body_effects:FindFirstChild(name)
            if flag and flag:IsA("ValueBase") and flag.Value == true then
                return "Reload"
            end
        end
    end
    if state.is_shooting then
        return "Shooting"
    end
    if Tool and knife_tools[Tool.Name] then
        return "Knife"
    end
    return "Normal"
end

function Movement:Multiplier(Cfg, Situation)
    local Mults = Cfg["Multipliers"] or Cfg["multipliers"]
    if type(Mults) == "table" then
        local entry = Mults[Situation]
        if type(entry) == "table" then
            return tonumber(entry["Multiplier"] or entry["multiplier"]) or 1
        elseif type(entry) == "number" then
            return entry
        end
        local normal_entry = Mults["Normal"] or Mults["normal"]
        if type(normal_entry) == "table" then
            return tonumber(normal_entry["Multiplier"] or normal_entry["multiplier"]) or 1
        elseif type(normal_entry) == "number" then
            return normal_entry
        end
    end
    return tonumber(Cfg["Multiplier"] or Cfg["multiplier"]) or 1
end

function Movement:Hold(Humanoid, Property, Value)
    if Movement.Saved[Property] == nil then
        Movement.Saved[Property] = Humanoid[Property]
    end
    if Humanoid[Property] ~= Value then
        Humanoid[Property] = Value
    end
end

function Movement:Restore(Humanoid, Property)
    local Previous = Movement.Saved[Property]
    if Previous == nil then return end
    Movement.Saved[Property] = nil
    if Humanoid and Humanoid.Parent and Humanoid[Property] ~= Previous then
        Humanoid[Property] = Previous
    end
end

function Movement:StepSpeed(Character, Humanoid, Cfg, Situation)
    if not Cfg then
        Movement.Ramp = nil
        Movement:Restore(Humanoid, "WalkSpeed")
        return
    end
    local mult = Movement:Multiplier(Cfg, Situation)
    local Speed = 16 * mult
    local mode = tostring(Cfg["Mode"] or Cfg["mode"] or "Walkspeed"):lower()
    local Ramp = Cfg["Ramp"]
    local Root = Character and Character:FindFirstChild("HumanoidRootPart")
    
    if mode == "velocity" and Root then
        Movement.Ramp = nil
        local current_velocity = Root.AssemblyLinearVelocity
        local move_direction = Humanoid.MoveDirection
        Root.AssemblyLinearVelocity = Vector3.new(move_direction.X * Speed, current_velocity.Y, move_direction.Z * Speed)
        return
    end
    
    if type(Ramp) == "table" and Ramp["Enabled"] == true and Root then
        local Now = os.clock()
        local Velocity = Root.AssemblyLinearVelocity
        local State = Movement.Ramp
        if not State then
            State = { Time = Now, X = Velocity.X, Z = Velocity.Z }
            Movement.Ramp = State
        end
        local Alpha = 1 - math.exp(-math.clamp(Now - State.Time, 0, 0.1) / Movement.RampTime)
        State.Time = Now
        local Move = Humanoid.MoveDirection
        State.X = State.X + (Move.X * Speed - State.X) * Alpha
        State.Z = State.Z + (Move.Z * Speed - State.Z) * Alpha
        Movement:Hold(Humanoid, "WalkSpeed", math.sqrt(State.X * State.X + State.Z * State.Z))
        Root.AssemblyLinearVelocity = Vector3.new(State.X, Velocity.Y, State.Z)
        return
    end
    
    Movement.Ramp = nil
    Movement:Hold(Humanoid, "WalkSpeed", Speed)
end

function Movement:StepJump(Humanoid, Cfg, Situation)
    if not Cfg then
        Movement:Restore(Humanoid, "JumpPower")
        return
    end
    Humanoid.UseJumpPower = true
    Movement:Hold(Humanoid, "JumpPower", 50 * Movement:Multiplier(Cfg, Situation))
end

function Movement:StepModifiers(Character, Humanoid)
    local Speed = Movement:Toggled("Speed", "speed_active")
    local Jump = Movement:Toggled("Jump", "jump_active")
    local Situation = (Speed or Jump) and Movement:Situation(Humanoid) or nil
    Movement:StepSpeed(Character, Humanoid, Speed, Situation)
    Movement:StepJump(Humanoid, Jump, Situation)
end

function Movement:Restrained(Character)
    local BodyEffects = Character:FindFirstChild("BodyEffects")
    if not BodyEffects then return false end
    local Knocked, Cuffed = BodyEffects:FindFirstChild("K.O"), BodyEffects:FindFirstChild("Cuff")
    return (Knocked and Knocked.Value == true) or (Cuffed and Cuffed.Value == true) or false
end

function Movement:StepBypass()
    local Bypass = Movement.Bypass
    local Cfg = Movement:Toggled("Speed", "speed_active")
    local BypassCfg = Cfg and Cfg["Bypass"]
    if type(BypassCfg) ~= "table" or BypassCfg["Enabled"] ~= true then
        Bypass.Velocity, Bypass.Restores = Vector3.zero, 0
        return
    end
    local Character, Humanoid = Movement:GetLocalHumanoid()
    local Root = Character and Character:FindFirstChild("HumanoidRootPart")
    if not Root or not Humanoid or Humanoid.Health <= 0 or Humanoid.Sit or Humanoid.PlatformStand or Movement:Restrained(Character) then
        Bypass.Velocity, Bypass.Restores = Vector3.zero, 0
        return
    end
    if type(_G.CurrentWS) == "number" and _G.CurrentWS < 16 then
        _G.CurrentWS = 22
    end
    local Velocity, Last = Root.AssemblyLinearVelocity, Bypass.Velocity
    if Velocity.Magnitude < 5 and Last.Magnitude > 16 and Humanoid.MoveDirection.Magnitude > 0 then
        if Bypass.Restores < Bypass.Limit then
            Bypass.Restores = Bypass.Restores + 1
            Root.AssemblyLinearVelocity = Last
            return
        end
        Bypass.Velocity, Bypass.Restores = Vector3.zero, 0
        return
    end
    Bypass.Velocity, Bypass.Restores = Velocity, 0
end

function Movement:RemoveJumpPower(Character)
    if not Character then return end
    local Humanoid = Character:FindFirstChildOfClass("Humanoid") or Character:WaitForChild("Humanoid", 10)
    if not Humanoid or Movement.JumpPowerBound[Character] then return end
    Movement.JumpPowerBound[Character] = true
    local LastJumpPower = Humanoid.JumpPower
    Movement.JumpPowerConns[Character] = track_connection(Humanoid:GetPropertyChangedSignal("JumpPower"):Connect(function()
        local player_mods = config["Player Modifications"] or get_bind_value("Player Modifications")
        if not (player_mods and player_mods["No Jump Cooldown"]) then return end
        if Humanoid.JumpPower ~= 0 then
            LastJumpPower = Humanoid.JumpPower
        else
            Humanoid.JumpPower = LastJumpPower
        end
    end))
end

function Movement:GetWall(Character, HRP)
    local Filter = Movement.WallJumpFilter
    local Count = 1
    Filter[1] = Character
    local ignored = workspace:FindFirstChild("Ignored")
    if ignored then
        Count = Count + 1
        Filter[Count] = ignored
    end
    local bush = workspace:FindFirstChild("Bush")
    if bush then
        Count = Count + 1
        Filter[Count] = bush
    end
    for i = Count + 1, #Filter do Filter[i] = nil end
    local Params = Movement.WallJumpParams
    Params.FilterDescendantsInstances = Filter
    local CF = HRP.CFrame
    local Look, Right = CF.LookVector, CF.RightVector
    local Dirs = Movement.WallDirs
    Dirs[1], Dirs[2], Dirs[3], Dirs[4] = Look, -Look, Right, -Right
    Dirs[5] = (Look + Right) * Movement.WallDiagonal
    Dirs[6] = (Look - Right) * Movement.WallDiagonal
    Dirs[7] = (Right - Look) * Movement.WallDiagonal
    Dirs[8] = (-Look - Right) * Movement.WallDiagonal
    local Origin = HRP.Position
    local Range = Movement.WallDetectRange
    local MaxNormalY = Movement.WallMaxNormalY
    for Index = 1, 8 do
        local Hit = workspace:Raycast(Origin, Dirs[Index] * Range, Params)
        if Hit and Hit.Instance and Hit.Instance.CanCollide and Hit.Instance.Transparency < 1 and math.abs(Hit.Normal.Y) <= MaxNormalY then
            return Hit
        end
    end
    return nil
end

function Movement:GetWallJumpPower(Character, Cfg)
    local Mults = Cfg["Multipliers"] or Cfg["multipliers"] or {}
    local Equipped = Character:FindFirstChildOfClass("Tool")
    if Equipped and knife_tools[Equipped.Name] then
        return 50 * (tonumber(Mults["Knife"] or (type(Mults["Knife"]) == "table" and Mults["Knife"].Multiplier)) or 1.4)
    end
    return 50 * (tonumber(Mults["Regular"] or (type(Mults["Regular"]) == "table" and Mults["Regular"].Multiplier)) or tonumber(Cfg["Multiplier"] or Cfg["multiplier"]) or 1.2)
end

function Movement:StepWallJumpReset()
    if Movement.WallJumpsUsed == 0 then return end
    local _, Humanoid = Movement:GetLocalHumanoid()
    if Humanoid and Humanoid.FloorMaterial ~= Enum.Material.Air then
        Movement.WallJumpsUsed = 0
    end
end

function Movement:WallJump()
    local player_mods = config["Player Modifications"] or get_bind_value("Player Modifications")
    local Cfg = player_mods and (player_mods["Wall Jump"] or player_mods["wall_jump"])
    if not Cfg or (Cfg["Enabled"] ~= true and Cfg["enabled"] ~= true) then return end
    local Character, Humanoid = Movement:GetLocalHumanoid()
    if not Humanoid or Humanoid:GetState() ~= Enum.HumanoidStateType.Freefall then return end
    local mode = Cfg["Mode"] or Cfg["mode"] or "Double"
    if mode == "Double" and Movement.WallJumpsUsed >= 1 then return end
    local HRP = Character:FindFirstChild("HumanoidRootPart")
    if not HRP or not Movement:GetWall(Character, HRP) then return end
    local Power = Movement:GetWallJumpPower(Character, Cfg)
    Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    HRP.AssemblyLinearVelocity = Vector3.new(HRP.AssemblyLinearVelocity.X, Power, HRP.AssemblyLinearVelocity.Z)
    Movement.WallJumpsUsed = Movement.WallJumpsUsed + 1
end

function Movement:StepSpiderman()
    local player_mods = config["Player Modifications"] or get_bind_value("Player Modifications")
    local Cfg = player_mods and (player_mods["Wall Jump"] or player_mods["wall_jump"])
    if not Cfg or (Cfg["Enabled"] ~= true and Cfg["enabled"] ~= true) then return end
    local mode = Cfg["Mode"] or Cfg["mode"]
    if mode ~= "Infinite" or Cfg["Spiderman"] ~= true then return end
    local Character, Humanoid = Movement:GetLocalHumanoid()
    if not Humanoid or Humanoid.Health <= 0 or Humanoid.FloorMaterial ~= Enum.Material.Air then return end
    local HRP = Character:FindFirstChild("HumanoidRootPart")
    if not HRP or not Movement:GetWall(Character, HRP) then return end
    local Power = Movement:GetWallJumpPower(Character, Cfg)
    HRP.AssemblyLinearVelocity = Vector3.new(HRP.AssemblyLinearVelocity.X, Power, HRP.AssemblyLinearVelocity.Z)
end

function Movement:Update()
    local Character, Humanoid = Movement:GetLocalHumanoid()
    if not Humanoid then
        Movement:Reset()
        return
    end
    Movement:StepModifiers(Character, Humanoid)
    local player_mods = config["Player Modifications"] or get_bind_value("Player Modifications")
    if player_mods and player_mods["Anti Trip"] and Humanoid:GetState() == Enum.HumanoidStateType.FallingDown then
        Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
    if player_mods and player_mods["Anti Stop"] and Humanoid.WalkSpeed < 16 and not state.speed_active then
        Humanoid.WalkSpeed = 16
    end
    if player_mods and player_mods["No Jump Cooldown"] and not Movement.JumpPowerBound[Character] and not Movement.JumpPowerPending[Character] then
        for old in pairs(Movement.JumpPowerBound) do
            if not old.Parent then Movement.JumpPowerBound[old] = nil end
        end
        Movement.JumpPowerPending[Character] = true
        task.spawn(function()
            Movement:RemoveJumpPower(Character)
            Movement.JumpPowerPending[Character] = nil
        end)
    end
end

track_connection(user_input_service.JumpRequest:Connect(function()
    Movement:WallJump()
end))

track_connection(run_service.Heartbeat:Connect(function()
    Movement:StepSpiderman()
    Movement:StepWallJumpReset()
    if game_support.uses("dahood") then
        Movement:StepBypass()
    end
end))
local fly_saved_walkspeed = nil
local function apply_velocity_fly(hum)
    local player_mods = config["Player Modifications"]
    if not player_mods then return end
    local fly_cfg = player_mods["Velocity Fly"] or player_mods["velocity_fly"]
    local enabled = fly_cfg and (fly_cfg["Enabled"] == true or fly_cfg["enabled"] == true)
    local char = hum and hum.Parent
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not (enabled and state.velocity_fly_active and root) then
        if fly_saved_walkspeed ~= nil and hum then
            hum.WalkSpeed = fly_saved_walkspeed
            fly_saved_walkspeed = nil
        end
        return
    end
    if fly_saved_walkspeed == nil then
        fly_saved_walkspeed = hum.WalkSpeed
    end
    hum.WalkSpeed = 0
    local fly_key = "Normal"
    local equipped = char:FindFirstChildOfClass("Tool")
    if hum.Health <= 25 then
        fly_key = "Low Health"
    elseif equipped and knife_tools[equipped.Name] then
        fly_key = "Knife"
    elseif state.is_shooting then
        fly_key = "Shooting"
    elseif equipped and equipped:FindFirstChild("Reloading") and equipped.Reloading.Value then
        fly_key = "Reload"
    end
    local mults = fly_cfg["Multipliers"] or fly_cfg["multipliers"] or {}
    local fly_entry = mults[fly_key]
    local fly_speed = tonumber(fly_entry and (fly_entry["Multiplier"] or fly_entry["multiplier"])) or 800
    local cam = workspace.CurrentCamera
    if not cam then return end
    local look = cam.CFrame.LookVector
    local right = cam.CFrame.RightVector
    local forward_input = 0
    local strafe_input = 0
    if user_input_service:IsKeyDown(Enum.KeyCode.W) then forward_input = 1 end
    if user_input_service:IsKeyDown(Enum.KeyCode.S) then forward_input = -1 end
    if user_input_service:IsKeyDown(Enum.KeyCode.A) then strafe_input = -1 end
    if user_input_service:IsKeyDown(Enum.KeyCode.D) then strafe_input = 1 end
    local horizontal = look * forward_input + right * strafe_input
    if horizontal.Magnitude > 0 then
        horizontal = horizontal.Unit * fly_speed
    end
    local vertical = 0
    if user_input_service:IsKeyDown(Enum.KeyCode.Space) then
        vertical = fly_speed
    elseif user_input_service:IsKeyDown(Enum.KeyCode.LeftControl) or user_input_service:IsKeyDown(Enum.KeyCode.RightControl) then
        vertical = -fly_speed
    end
    root.AssemblyLinearVelocity = horizontal + Vector3.new(0, vertical, 0)
end
track_connection(user_input_service.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    local target_bind = get_bind_value("General", "Keybinds", "Combat", "Target") or "C"
    local cam_bind = get_bind_value("General", "Keybinds", "Combat", "Camera Aimbot") or "C"
    local trig_bind = get_bind_value("General", "Keybinds", "Combat", "Trigger Bot") or "C"
    if input_matches_bind(input, target_bind) then
        local targeting_mode = get_targeting_mode()
        if targeting_mode == "target" then
            if state.current_target then
                state.current_target = nil
                if normalize_input_token(cam_bind) == normalize_input_token(target_bind) then
                    state.aim_assist_active = false
