local function is_knife_tool(tool_or_name)
    local name = type(tool_or_name) == "string" and tool_or_name or (tool_or_name and tool_or_name.Name)
    if not name then return false end
    if knife_tools[name] then return true end
    local lower = name:lower()
    return lower:find("knife", 1, true) ~= nil or lower:find("blade", 1, true) ~= nil or lower:find("karambit", 1, true) ~= nil or lower:find("tanto", 1, true) ~= nil
end
