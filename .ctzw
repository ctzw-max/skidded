local gun_modifier_lib = {}
function gun_modifier_lib.get_value(mod_config, tool_name)
    if type(mod_config) ~= "table" or mod_config["Enabled"] ~= true then return nil end
    if mod_config["Spread"] and type(mod_config["Spread"]) == "table" then
        mod_config = mod_config["Spread"]
    elseif mod_config["Delays"] and type(mod_config["Delays"]) == "table" then
        mod_config = mod_config["Delays"]
    elseif mod_config["Weapons"] and type(mod_config["Weapons"]) == "table" and mod_config["Weapons"]["Data"] and type(mod_config["Weapons"]["Data"]) == "table" then
        mod_config = mod_config["Weapons"]["Data"]
    end
    local whitelist = mod_config["Whitelist Tools"]
    if type(whitelist) == "table" and whitelist["Enabled"] == true then
        local tools = whitelist["Tools"]
        return type(tools) == "table" and tonumber(tools[tool_name]) or nil
    end
    if mod_config[tool_name] and type(mod_config[tool_name]) == "table" and mod_config[tool_name]["Value"] ~= nil then
        return tonumber(mod_config[tool_name]["Value"])
    end
    return tonumber(mod_config["Value"])
end
function gun_modifier_lib.get_spread_multiplier(tool_name)
    if not game_support.supports_weapon_mods() then return 1 end
    local spread_cfg = config["Weapon Modifications"] and config["Weapon Modifications"]["Spread Changer"] or config["Combat"] and config["Combat"]["Spread Modifier"]
    if type(spread_cfg) == "table" and (spread_cfg["Enabled"] == false or spread_cfg["enabled"] == false) then
        return 1
    end
    local value = gun_modifier_lib.get_value(spread_cfg, tool_name)
    if value == nil then return 1 end
    local num = tonumber(value) or 0
    if num > 1 then return math.max(num / 100, 0) end
    return math.max(num, 0)
end
function gun_modifier_lib.get_cooldown(tool)
    local cooldown_val = tool:FindFirstChild("ShootingCooldown")
    local original = cooldown_val and tonumber(cooldown_val.Value) or 0.3
    if not game_support.supports_weapon_mods() then
        return original, original
    end
    local delay_cfg = config["Weapon Modifications"] and config["Weapon Modifications"]["Delay Changer"] or config["Combat"] and config["Combat"]["Delay Changer"]
    local configured = gun_modifier_lib.get_value(delay_cfg, tool.Name)
    if configured ~= nil then
        return math.max(configured > 1 and configured / 100 or configured, 0.006), original
    end
    return original, original
end
function gun_modifier_lib.get_shot_count(tool_name)
    if not game_support.supports_weapon_mods() then return 1 end
    local dt_cfg = config["Combat"] and config["Combat"]["Double Tap"]
    if type(dt_cfg) ~= "table" or dt_cfg["Enabled"] ~= true then return 1 end
    local weapons = dt_cfg["Weapons"]
    if type(weapons) ~= "table" then return 1 end
    if weapons[tool_name] == true then return 2 end
    for _, w_name in next, weapons do
        if w_name == tool_name then return 2 end
    end
    return 1
end
