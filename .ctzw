local function web_quote(text)
    local out = tostring(text)
    out = out:gsub("\\", "\\\\"):gsub("\"", "\\\""):gsub("\n", "\\n"):gsub("\r", "\\r"):gsub("\t", "\\t")
    out = out:gsub("[%c]", function(c) return string.format("\\%d", string.byte(c)) end)
    return "\"" .. out .. "\""
end

local function web_serialize(value, indent)
    indent = indent or ""
    local inner = indent .. "    "
    local kind = type(value)
    if kind == "string" then return web_quote(value) end
    if kind == "boolean" then return tostring(value) end
    if kind == "nil" then return "nil" end
    if kind == "number" then
        if value ~= value then return "0/0" end
        if value == math.huge then return "math.huge" end
        if value == -math.huge then return "-math.huge" end
        if value == math.floor(value) then return string.format("%d", value) end
        return string.format("%.14g", value)
    end
    if kind == "table" then
        local keys = {}
        for k in pairs(value) do keys[#keys + 1] = k end
        table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)
        local parts = {}
        for _, k in ipairs(keys) do
            local key_text
            if type(k) == "string" then
                key_text = "[" .. web_quote(k) .. "]"
            elseif type(k) == "number" then
                key_text = "[" .. tostring(k) .. "]"
            else
                key_text = "[" .. web_quote(tostring(k)) .. "]"
            end
            parts[#parts + 1] = inner .. key_text .. " = " .. web_serialize(value[k], inner) .. ","
        end
        if #parts == 0 then return "{}" end
        return "{\n" .. table.concat(parts, "\n") .. "\n" .. indent .. "}"
    end
    if type(typeof) == "function" then
        local ok, name = pcall(typeof, value)
        if ok and name == "Color3" then
            return string.format("Color3.new(%.6f, %.6f, %.6f)", value.R, value.G, value.B)
        elseif ok and name == "Vector3" then
            return string.format("Vector3.new(%.6f, %.6f, %.6f)", value.X, value.Y, value.Z)
        elseif ok and name == "Vector2" then
            return string.format("Vector2.new(%.6f, %.6f)", value.X, value.Y)
        end
    end
    return web_quote(tostring(value))
end

local function web_executed_text()
    if exact_adderall_script_config and #exact_adderall_script_config > 10 then
        return exact_adderall_script_config
    end
    return nil
end

local function web_slim(text)
    if type(text) ~= "string" then return "" end
    return (text:gsub("%s+", ""))
end

local web_config = {
    url = nil,
    live = false,
    running = true,
    last_slim = nil,
    thread = nil,
    session = nil,
}

local function http_get_ok(url)
    local requester = get_http_requester()
    if requester then
        local ok, response = pcall(requester, {
            Url = url,
            Method = "GET",
            Headers = {
                ["Cache-Control"] = "no-cache",
                ["Pragma"] = "no-cache"
            }
        })
        if ok and type(response) == "table" and (response.StatusCode == 200 or response.Status == 200) then
            local body = response.Body or response.body
            return true, type(body) == "string" and body or ""
        end
    end
    if game and type(game.HttpGet) == "function" then
        local ok, body = pcall(game.HttpGet, game, url, true)
        if ok and type(body) == "string" then return true, body end
    end
    return false, nil
end

local function http_post_text(url, body)
    local requester = get_http_requester()
    if not requester then return false end
    local ok, response = pcall(requester, {
        Url = url,
        Method = "POST",
        Headers = {
            ["Content-Type"] = "text/plain; charset=utf-8",
            ["Cache-Control"] = "no-cache"
        },
        Body = body
    })
    if ok and type(response) == "table" then
        local code = response.StatusCode or response.Status
        if code == 200 or code == 201 or code == 204 then return true end
    end
    return false
end

function web_config.config_url()
    if type(web_config.session) ~= "string" then return nil end
    return web_base() .. "config/" .. web_config.session .. "?_t=" .. web_nonce()
end

function web_config.game_url()
    if type(web_config.session) ~= "string" then return nil end
    return web_base() .. "game/" .. web_config.session
end

function web_config.page_url()
    if type(web_config.session) ~= "string" then return nil end
    return web_base() .. "?session=" .. web_config.session
end

function web_config.publish_executed(force)
    local executed = web_executed_text()
    if not executed then return false end
    local url = web_config.config_url()
    if not url then return false end
    local ok, body = http_get_ok(url)
    if not ok then return false end
    local current = web_slim(body)
    local executed_slim = web_slim(executed)
    if #current > 10 then
        web_config.last_slim = current
        if current ~= executed_slim then
            config_apply_text(body, true)
        end
        return true
    end
    if http_post_text(url, executed) then
        web_config.last_slim = executed_slim
        return true
    end
    return false
end

function web_config.poll()
    local url = web_config.config_url()
    if not url then return end
    local ok, body = http_get_ok(url)
    if not ok then
        if web_config.live then
            web_config.live = false
            warn("[adderall] live sync lost, retrying")
        end
        return
    end
    if not web_config.live then
        web_config.live = true
        log_print("[adderall] live sync connected")
    end
    body = type(body) == "string" and body or ""
    local slim = web_slim(body)
    if #slim <= 10 or slim == web_config.last_slim then return end
    local applied, problem = config_apply_text(body, true)
    web_config.last_slim = slim
    if applied then
        log_print("[adderall] live config applied (" .. tostring(#body) .. " bytes)")
    else
        warn("[adderall] live config rejected: " .. tostring(problem))
    end
end

function web_config.start()
    adderall_web.url = web_base()
    local session, is_reused, pid = web_resolve_session()
    web_config.session = session
    web_register_teleport(session)

    if adderall_web.url:find("your-project", 1, true) or adderall_web.url:find("OWNER", 1, true) then
        warn("[adderall] website url is still the placeholder - set adderall_web.url (or getgenv().adderall_web_url)")
    end

    task.spawn(function()
        pcall(function()
            local game_name = nil
            pcall(function()
                game_name = game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name
            end)
            if type(game_name) ~= "string" or game_name == "" then
                pcall(function() game_name = game.Name end)
            end
            if type(game_name) ~= "string" or game_name == "" then game_name = "unknown" end
            http_post_text(web_config.game_url(), game_name)
        end)
        pcall(function() web_config.publish_executed(false) end)
    end)

    local target = web_config.page_url()
    web_config.url = target
    web_clipboard(target)
    print(target)
    if task and type(task.spawn) == "function" then
        task.spawn(function()
            task.wait(0.2)
            web_clipboard(target)
            task.wait(0.5)
            web_clipboard(target)
        end)
    end
    local opened = false
    if not is_reused then
        opened = web_open(target)
    end
    if is_reused then
        log_print("[adderall] reused active session across games (PID " .. tostring(pid or "same") .. "): " .. target)
    else
        log_print("[adderall] new session started (PID " .. tostring(pid or "new") .. "): " .. target)
    end
    log_print("[adderall] session: " .. web_config.session)
    log_print("[adderall] web console: " .. target)
    log_print("[adderall] config file: " .. web_base() .. "config/" .. web_config.session)
    if not opened and not is_reused then
        log_print("[adderall] open this url in your browser: " .. target)
    end

    local ok_spawn, thread_or_err = pcall(function()
        if type(task) ~= "table" or type(task.spawn) ~= "function" then return nil end
        return task.spawn(function()
            local ok_body, err = pcall(function()
                while web_config.running do
                    pcall(web_config.poll)
                    if type(task) == "table" and type(task.wait) == "function" then
                        task.wait(adderall_web.poll_interval)
                    else
                        break
                    end
                end
            end)
            if not ok_body then warn("[adderall] web console thread error: " .. tostring(err)) end
        end)
    end)
    if ok_spawn and type(thread_or_err) == "thread" then
        web_config.thread = thread_or_err
    end
end

function web_config.stop()
    if not web_config.running then return end
    web_config.running = false
    web_config.live = false
    if web_config.thread then
        pcall(task.cancel, web_config.thread)
        web_config.thread = nil
    end
end

web_config.start()


