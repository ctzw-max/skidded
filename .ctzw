                            local fov_x = tonumber(t_fov["2D"] and t_fov["2D"]["X"]) or 2350
                            local trigger_parts = { target_player.Character:FindFirstChild("HumanoidRootPart"), target_player.Character:FindFirstChild("Head") }
                            local cur_cam = workspace.CurrentCamera or camera
                            for _, part in ipairs(trigger_parts) do
