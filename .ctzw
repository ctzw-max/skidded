}
local function createProxy(globalNodeFunc, defaultNode)
    return setmetatable({}, {
        __index = function(t, key)
            local globalNode = globalNodeFunc and globalNodeFunc() or nil
            local translatedKey = _keyTranslation[key] or key
            local gVal = nil
            if type(globalNode) == "table" then
                gVal = globalNode[translatedKey]
            end
            local dVal = nil
            if type(defaultNode) == "table" then
                dVal = defaultNode[key]
            end
            if type(gVal) == "table" or type(dVal) == "table" then
                return createProxy(function()
                    local g = globalNodeFunc and globalNodeFunc() or nil
                    return type(g) == "table" and g[translatedKey] or nil
                end, dVal)
            end
            if gVal ~= nil then return gVal end
            return dVal
        end,
        __newindex = function(t, key, val)
            local globalNode = globalNodeFunc and globalNodeFunc() or nil
            local translatedKey = _keyTranslation[key] or key
            if type(globalNode) == "table" then
                globalNode[translatedKey] = val
            elseif type(defaultNode) == "table" then
                defaultNode[key] = val
            end
        end
    })
end
local function GetRootESPConfigNode()
    local global_private = getgenv().private or _G.private or private
    local club = config or (global_private and global_private.club) or (type(private) == "table" and private.club)
    if not club then return nil end
    local visuals = club['Visuals']
    local rageVisuals = club['Rage Mode'] and club['Rage Mode']['Visuals']
    local rageEsp = rageVisuals and (rageVisuals['Rage ESP'] or rageVisuals['ESP'])
    local baseEsp = (visuals and (visuals['Rage ESP'] or visuals['ESP'])) or build_esp_engine_view(visuals) or rageEsp or club['Rage ESP'] or club['ESP'] or {}
    return setmetatable({}, {
        __index = function(_, key)
            if key == "Font" and club and club['Font'] ~= nil then
                return club['Font']
            end
            if visuals and (key == "Health" or key == "Armor" or key == "Name") and visuals[key] ~= nil then
                return visuals[key]
            end
            if type(baseEsp) == "table" and baseEsp[key] ~= nil then
                return baseEsp[key]
            end
            if visuals and visuals[key] ~= nil then
                return visuals[key]
            end
            return nil
        end,
        __newindex = function(_, key, val)
            if key == "Font" and club then
                club['Font'] = val
            elseif visuals and (key == "Health" or key == "Armor" or key == "Name") and visuals[key] ~= nil then
                visuals[key] = val
            elseif type(baseEsp) == "table" then
                baseEsp[key] = val
            elseif visuals then
                visuals[key] = val
            end
        end
    })
end
local ESPConfig = createProxy(GetRootESPConfigNode, _actualESPConfig)
local function DeepCopy(tbl)
    if type(tbl) ~= "table" then
        return tbl
    end
    local copy = {}
    for key, value in pairs(tbl) do
        copy[key] = DeepCopy(value)
    end
    return copy
end
local function DeepMerge(base, override)
    if type(override) ~= "table" then
        return base
    end
    for key, value in pairs(override) do
        if type(value) == "table" and type(base[key]) == "table" then
            DeepMerge(base[key], value)
        else
            base[key] = value
        end
    end
    return base
end
local function to_title_case(s)
    if type(s) ~= "string" then return s end
    s = s:gsub("_", " "):gsub("(%a)(%a*)", function(first, rest)
        return first:upper() .. rest:lower()
    end)
    return s
end
local function normalize_keys_title_case(tbl, seen)
    if type(tbl) ~= "table" then return tbl end
    seen = seen or {}
    if seen[tbl] then return tbl end
    seen[tbl] = true
    for key, value in pairs(tbl) do
        local lower = type(key) == "string" and key:lower() or key
        if type(key) == "string" and lower ~= key then
            local titled = to_title_case(key)
            local existing = tbl[lower] or tbl[titled]
            if existing == nil then
                tbl[lower] = tbl[key]
                tbl[key] = nil
            elseif type(value) == "table" and type(existing) == "table" then
                DeepMerge(existing, value)
                tbl[key] = nil
            end
        end
        if type(value) == "table" then
            normalize_keys_title_case(value, seen)
        end
    end
    return tbl
end
local DefaultESPConfig = DeepCopy(_actualESPConfig)
config["Visuals"] = config["Visuals"] or {}
local user_esp = config["Visuals"]["ESP"] or config["ESP"] or {}
local engine_view = build_esp_engine_view(config["Visuals"])
normalize_keys_title_case(user_esp)
local merged_esp = DeepMerge(DeepMerge(DeepCopy(DefaultESPConfig), user_esp), engine_view or {})
_actualESPConfig = merged_esp
for k, v in pairs(merged_esp) do
    if user_esp[k] == nil then
        user_esp[k] = v
    end
end
if type(config["Visuals"]["ESP"]) == "table" then
    local esp_tbl = config["Visuals"]["ESP"]
    if esp_tbl["Enabled"] == nil then esp_tbl["Enabled"] = true end
    local function ensure_sub_default(key)
        if type(esp_tbl[key]) ~= "table" then return end
        if esp_tbl[key].Enabled == nil then esp_tbl[key].Enabled = true end
    end
    ensure_sub_default("Names")
    ensure_sub_default("Name")
    ensure_sub_default("Health")
    ensure_sub_default("Armor")
end
local function CompactTeamName(teamName)
    if type(teamName) ~= "string" or teamName == "" then
        return ""
    end
    local parts = {}
    for part in teamName:gmatch("[^%s%-_]+") do
        if part ~= "" then
            table.insert(parts, part)
        end
    end
    if #parts == 0 then
        return teamName
    end
    if #parts == 1 then
        local single = parts[1]
        if #single <= 4 then
            return single:upper()
        end
        return single:sub(1, 1):upper()
    end
    local compact = {}
    for _, part in ipairs(parts) do
        table.insert(compact, part:sub(1, 1):upper())
    end
    return table.concat(compact)
end
local function ColorToHex(color)
    local r = math.clamp(math.floor(color.R * 255 + 0.5), 0, 255)
    local g = math.clamp(math.floor(color.G * 255 + 0.5), 0, 255)
    local b = math.clamp(math.floor(color.B * 255 + 0.5), 0, 255)
    return string.format("#%02X%02X%02X", r, g, b)
end
local fonts = {
    default = Enum.Font.GothamBold,
