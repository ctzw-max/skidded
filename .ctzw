                if normalize_input_token(trig_bind) == normalize_input_token(target_bind) then
                    state.triggerbot_active = false
                end
            else
                local cand = get_best_player(1000, get_silent_fov_args())
                if cand then
                    state.current_target = cand
                    if normalize_input_token(cam_bind) == normalize_input_token(target_bind) then
                        state.aim_assist_active = true
                    end
                    if normalize_input_token(trig_bind) == normalize_input_token(target_bind) then
                        state.triggerbot_active = true
                    end
                else
                    state.current_target = nil
                    if normalize_input_token(cam_bind) == normalize_input_token(target_bind) then
                        state.aim_assist_active = false
                    end
                    if normalize_input_token(trig_bind) == normalize_input_token(target_bind) then
                        state.triggerbot_active = false
                    end
                end
            end
        end
    end
    if normalize_input_token(cam_bind) ~= normalize_input_token(target_bind) and input_matches_bind(input, cam_bind) then
        state.aim_assist_active = not state.aim_assist_active
        if state.aim_assist_active and not state.current_target then
            local cand = get_best_player(1000, get_silent_fov_args())
            if cand then
                state.current_target = cand
            else
                state.current_target = nil
            end
        end
    end
    if normalize_input_token(trig_bind) ~= normalize_input_token(target_bind) and input_matches_bind(input, trig_bind) then
        state.triggerbot_active = not state.triggerbot_active
    end
    local esp_bind = get_bind_value("General", "Keybinds", "Visuals", "ESP") or "H"
    if input_matches_bind(input, esp_bind) then
        local visuals = config["Visuals"] or get_bind_value("Visuals")
        local esp_root = visuals and visuals["ESP"] or config["ESP"] or get_bind_value("ESP")
        if esp_root then
            local esp_key = esp_root["Enabled"] ~= nil and "Enabled" or "enabled"
            esp_root[esp_key] = not esp_root[esp_key]
            state.esp_active = esp_root[esp_key]
        end
    end
    local panel_bind = get_bind_value("General", "Keybinds", "Visuals", "Panel") or "Y"
    if input_matches_bind(input, panel_bind) then
        local panel_node = get_bind_value("Visuals", "Panel") or (config["Visuals"] and config["Visuals"]["Panel"])
        if panel_node and type(panel_node) == "table" then
            if panel_node["Enabled"] ~= nil then
                panel_node["Enabled"] = not panel_node["Enabled"]
            elseif panel_node["enabled"] ~= nil then
                panel_node["enabled"] = not panel_node["enabled"]
            end
        end
    end
    local speed_bind = get_bind_value("General", "Keybinds", "Movement", "Speed") or "V"
    if input_matches_bind(input, speed_bind) then
        state.speed_active = not state.speed_active
    end
    local jump_bind = get_bind_value("General", "Keybinds", "Movement", "Jump") or "Z"
    if input_matches_bind(input, jump_bind) then
        state.jump_active = not state.jump_active
    end
    local fly_bind = get_bind_value("General", "Keybinds", "Movement", "Velocity Fly") or "T"
    if input_matches_bind(input, fly_bind) then
        state.velocity_fly_active = not state.velocity_fly_active
    end
    local panic_bind = get_bind_value("General", "Keybinds", "Movement", "Panic Ground") or "X"
    local panic_cfg = get_bind_value("Player Modifications", "Panic Ground") or (config["Player Modifications"] and config["Player Modifications"]["Panic Ground"])
    if panic_cfg and (panic_cfg["Enabled"] == true or panic_cfg["enabled"] == true) and input_matches_bind(input, panic_bind) then
        run_panic_ground()
    end
    local sorter_bind = get_bind_value("General", "Keybinds", "Utilities", "Inventory Sorter") or "F2"
    local sorter_cfg = get_bind_value("Game Utilities", "Inventory Sorter") or (config["Game Utilities"] and config["Game Utilities"]["Inventory Sorter"])
    if input_matches_bind(input, sorter_bind) then
        if sorter_cfg and (sorter_cfg["Enabled"] == true or sorter_cfg["enabled"] == true) then
            task.spawn(sort_inventory)
        end
    end
end))
local function update_camlock_step()
    local assist_cfg = config["Aim Assist"]
    if not assist_cfg or assist_cfg["Enabled"] ~= true or not state.aim_assist_active then return end
    local self_char = local_player.Character
    if not self_char or not is_character_alive(self_char) then return end
    local checks = get_feature_checks(assist_cfg)
    if checks and checks["Gun Check"] == true then
        local equipped = self_char:FindFirstChildOfClass("Tool")
        if not is_gun(equipped) then return end
    end
    local assist_target = state.current_target
    if not assist_target or not assist_target.Parent or not assist_target.Character or not is_character_alive(assist_target.Character) then
        if get_targeting_mode() ~= "target" then
            local assist_eq = local_player.Character and local_player.Character:FindFirstChildOfClass("Tool")
            local a_dist = resolve_range_check(assist_cfg, assist_eq)
            assist_target = get_best_player(a_dist, get_silent_fov_args())
        else
            return
        end
    end
    if not assist_target or not assist_target.Character or not is_character_alive(assist_target.Character) then return end
    local self_root = self_char:FindFirstChild("HumanoidRootPart")
    local target_root = assist_target.Character:FindFirstChild("HumanoidRootPart")
    if not self_root or not target_root then return end
    local weapon_mods = config["Weapon Modifications"] or {}
    local rage_active = is_rage_mode_active()
    local force_register = rage_active
    local always_hit = rage_active
    local ignore_walls = force_register or always_hit or not (checks and checks["Visible"] == true)
    if passes_target_conditions and not passes_target_conditions(assist_target, checks, ignore_walls, true) then
        return
    end
    local target_pos = resolve_hit_position(assist_target.Character, assist_cfg["Hit Location"], assist_cfg["Nearest Point"])
    if not target_pos then return end
    local root = assist_target.Character:FindFirstChild("HumanoidRootPart")
    local vel = root and root.Velocity or Vector3.new(0, 0, 0)
    local pred = get_prediction_value(assist_cfg["Prediction"])
    local predicted_pos = target_pos + Vector3.new(vel.X * pred.X, vel.Y * pred.Y, vel.Z * pred.Z)
    local cur_cam = workspace.CurrentCamera or camera
    if cur_cam then
        local cam_pos = cur_cam.CFrame.Position
        local target_cframe = CFrame.new(cam_pos, predicted_pos)
        local smooth_cfg = assist_cfg["Smoothness"]
        local smooth_val = 0
        if smooth_cfg and smooth_cfg["Enabled"] == true then
            smooth_val = tonumber(smooth_cfg["Value"]) or 0.047
        end
        local easing_cfg = assist_cfg["Easing"]
        local alpha = math.clamp(smooth_val, 0, 1)
        if easing_cfg and easing_cfg["Enabled"] then
            alpha = ease_circular_in_out(alpha)
        end
        cur_cam.CFrame = cur_cam.CFrame:Lerp(target_cframe, alpha)
    end
end
pcall(function()
    run_service:BindToRenderStep("adderall_camlock", Enum.RenderPriority.Camera.Value + 1, update_camlock_step)
end)
