local http_service = game:GetService("HttpService")
local user_override_cfg = nil
local default_adderall_config = shared["adderall"]
local final_adderall_config = default_adderall_config

local function find_table_key(tbl, key)
    if tbl[key] ~= nil then return key end
    local lower_key = tostring(key):lower()
    for k in pairs(tbl) do
        if tostring(k):lower() == lower_key then
            return k
        end
    end
    return key
end

local function config_merge(into_target, from_source)
    if type(from_source) ~= "table" or type(into_target) ~= "table" then
        return into_target
    end
    local stack = { { into_target, from_source } }
    while #stack > 0 do
        local entry = table.remove(stack)
        local into, from = entry[1], entry[2]
        if type(into) == "table" and type(from) == "table" then
            if #into > 0 or #from > 0 then
                for index in pairs(into) do
                    if type(index) == "number" and from[index] == nil then
                        into[index] = nil
                    end
                end
            end
            for name, value in pairs(from) do
                local target_key = find_table_key(into, name)
                if type(value) == "table" and type(into[target_key]) == "table" then
                    stack[#stack + 1] = { into[target_key], value }
                else
                    into[target_key] = value
                end
            end
        end
    end
    return into_target
end

local function config_publish()
    if type(shared) == "table" then
        shared["adderall"] = final_adderall_config
        shared["Adderall"] = final_adderall_config
        shared.adderall = final_adderall_config
        shared.Adderall = final_adderall_config
    end
    local g = (type(getgenv) == "function" and getgenv()) or _G
    if g then
        g.Adderall = final_adderall_config
        g.adderall = final_adderall_config
        if type(g.private) ~= "table" then g.private = {} end
        g.private.club = final_adderall_config
    end
end

local function config_parse(code)
    if type(code) ~= "string" or code == "" then
        return nil, "empty config"
    end
    if #code > 1048576 then
        return nil, "config too large"
    end
    if type(loadstring) ~= "function" then
        return nil, "loadstring unavailable"
    end
    local text = code:gsub("^\239\187\191", "")
    if text:match("^%s*{") then
        text = "return " .. text
    end
    local chunk, problem = loadstring("local shared, Color3, Vector3, Vector2, math, Enum = ...\n" .. text, "adderall_config")
    if not chunk then
        chunk, problem = loadstring(text, "adderall_config")
        if not chunk then
            return nil, tostring(problem)
        end
    end
    local sandbox = {}
    if type(setfenv) == "function" then
        pcall(function()
            local env = setmetatable({
                shared = sandbox,
                Color3 = Color3,
                Vector3 = Vector3,
                Vector2 = Vector2,
                math = math,
                Enum = Enum,
                table = table,
                string = string,
                tostring = tostring,
                tonumber = tonumber,
                pairs = pairs,
                ipairs = ipairs,
            }, {
                __index = (type(getfenv) == "function" and getfenv()) or _G or {}
            })
            setfenv(chunk, env)
        end)
    end
    local ok, result = pcall(chunk, sandbox, Color3, Vector3, Vector2, math, Enum)
    if not ok then
        return nil, tostring(result)
    end
    if result == nil then
        result = sandbox.adderall or sandbox.Adderall or sandbox.Prosper or shared["adderall"] or shared["Adderall"]
    end
    if type(result) ~= "table" then
        return nil, "invalid config table"
    end
    return result
end


local exact_adderall_script_config = nil

local function web_get_roblox_pid()
    for _, fn in ipairs({ getpid, get_pid, getprocessid, (getgenv and getgenv().getpid), (getgenv and getgenv().get_pid) }) do
        if type(fn) == "function" then
            local ok, val = pcall(fn)
            if ok and tonumber(val) and tonumber(val) > 0 then
                return tonumber(val)
            end
        end
    end
    local ok, res = pcall(function()
        local req = request or http_request or (syn and syn.request)
        if type(req) == "function" then
            local resp = req({
                Url = "http://localhost:9475",
                Method = "POST",
                Body = "getpid",
                Headers = { ["Content-Type"] = "text/plain" }
            })
            if resp and resp.Body and tonumber(resp.Body) and tonumber(resp.Body) > 0 then
                return tonumber(resp.Body)
            end
        end
        return nil
    end)
    if ok and res then return res end
    return nil
end

local function web_new_session()
    local chars = "abcdefghijklmnopqrstuvwxyz0123456789"
    local out = ""
    for i = 1, 10 do
        local n = math.random(1, #chars)
        out = out .. chars:sub(n, n)
    end
    return out .. "_" .. tostring(os.time())
end

local function web_resolve_session()
    local current_pid = web_get_roblox_pid()
    local session_file = "adderall_session.json"
    local json_service = HttpService or game:GetService("HttpService")

    if current_pid and isfile and readfile and isfile(session_file) then
        local ok, content = pcall(readfile, session_file)
        if ok and type(content) == "string" and #content > 0 then
            local ok_json, data = pcall(function() return json_service:JSONDecode(content) end)
            if ok_json and type(data) == "table" and data.pid == current_pid and type(data.session) == "string" and #data.session > 0 then
                return data.session, true, current_pid, data
            end
        end
    end

    if getgenv and type(getgenv()._adderall_teleport_session) == "string" and #getgenv()._adderall_teleport_session > 0 then
        local saved = getgenv()._adderall_teleport_session
        local saved_data = { pid = current_pid, session = saved, autoload_applied = (getgenv()._adderall_autoload_done == saved), time = os.time() }
        if current_pid and writefile then
            pcall(function()
                writefile(session_file, json_service:JSONEncode(saved_data))
            end)
        end
        return saved, true, current_pid, saved_data
    end

    local new_sess = web_new_session()
    local new_data = { pid = current_pid, session = new_sess, autoload_applied = false, time = os.time() }
    if current_pid and writefile then
        pcall(function()
            writefile(session_file, json_service:JSONEncode(new_data))
        end)
    end
    return new_sess, false, current_pid, new_data
end

local function web_register_teleport(session)
    if getgenv then
        getgenv()._adderall_teleport_session = session
        getgenv()._adderall_autoload_done = session
        getgenv()._adderall_teleport_applied_config = exact_adderall_script_config
    end
    local qot = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
    if type(qot) == "function" then
        pcall(qot, string.format("if getgenv then getgenv()._adderall_teleport_session = %q; getgenv()._adderall_autoload_done = %q end", session, session))
    end
end

local function config_apply_text(code, from_network)
    local data, problem = config_parse(code)
    if not data then
        return false, problem
    end
    config_merge(final_adderall_config, data)
    config_publish()
    if type(code) == "string" and #code > 10 then
        exact_adderall_script_config = code
        if web_config and web_slim then
            web_config.last_slim = web_slim(code)
        end
        if getgenv then
            getgenv()._adderall_teleport_applied_config = code
            if web_config and web_config.session then
                getgenv()._adderall_autoload_done = web_config.session
            end
        end
        pcall(function()
            local cur_pid = web_get_roblox_pid()
            local cur_session = (web_config and web_config.session) or (getgenv and getgenv()._adderall_teleport_session)
            if cur_pid and writefile and cur_session then
                local js = HttpService or game:GetService("HttpService")
                writefile("adderall_session.json", js:JSONEncode({
                    pid = cur_pid,
                    session = cur_session,
                    autoload_applied = true,
                    applied_config = code,
                    time = os.time()
                }))
            end
        end)
        if not from_network and web_config and type(web_config.config_url) == "function" then
            pcall(function()
                local url = web_config.config_url()
                if url then
                    http_post_text(url, code)
                end
            end)
        end
    end
    return true
end

script_key = (type(scriptkey) == "string" and scriptkey ~= "") and scriptkey or (type(script_key) == "string" and script_key ~= "" and script_key or "")
local current_session_id, current_session_reused, current_session_pid, current_session_data = web_resolve_session()
local session_autoload_done = current_session_reused
    or (getgenv and getgenv()._adderall_autoload_done == current_session_id)
    or (type(current_session_data) == "table" and current_session_data.autoload_applied == true)

if user_override_cfg == nil then
    if getgenv and getgenv()._INJECTED_DISCORD_CFG ~= nil then
        user_override_cfg = getgenv()._INJECTED_DISCORD_CFG
        getgenv()._INJECTED_DISCORD_CFG = nil
    elseif _G and _G._INJECTED_DISCORD_CFG ~= nil then
        user_override_cfg = _G._INJECTED_DISCORD_CFG
        _G._INJECTED_DISCORD_CFG = nil
    elseif not session_autoload_done then
        -- Autoload config ONLY gets applied ONCE per session
        local is_int = false
        local env_gen = (type(getgenv) == "function" and getgenv()) or _G
        if env_gen and (env_gen.adderall_internal or env_gen.is_internal) then
            is_int = true
        elseif type(identifyexecutor) == "function" then
            local exec_name = tostring(identifyexecutor()):lower()
            if exec_name:find("prosper") or exec_name:find("adderall") then
                is_int = true
            end
        end
        if is_int and type(readfile) == "function" then
            local ok_cfg, cached_cfg = pcall(readfile, ".cache/autoload.cfg")
            if not ok_cfg or not cached_cfg or cached_cfg == "" then
                ok_cfg, cached_cfg = pcall(readfile, "cache/autoload.cfg")
            end
            if ok_cfg and type(cached_cfg) == "string" and #cached_cfg > 10 then
                local data = config_parse(cached_cfg)
                if data then
                    user_override_cfg = data
                    exact_adderall_script_config = cached_cfg
                end
            end
        end
        if getgenv then
            getgenv()._adderall_autoload_done = current_session_id
        end
        if current_session_pid and writefile then
            pcall(function()
                local js = HttpService or game:GetService("HttpService")
                writefile("adderall_session.json", js:JSONEncode({
                    pid = current_session_pid,
                    session = current_session_id,
                    autoload_applied = true,
                    applied_config = exact_adderall_script_config,
                    time = os.time()
                }))
            end)
        end
    else
        -- Autoload already applied for this session; preserve the session's applied config across teleports
        local prev_cfg = (type(current_session_data) == "table" and current_session_data.applied_config)
            or (getgenv and getgenv()._adderall_teleport_applied_config)
        if type(prev_cfg) == "string" and #prev_cfg > 10 then
            local data = config_parse(prev_cfg)
            if data then
                user_override_cfg = data
                exact_adderall_script_config = prev_cfg
            end
        end
    end
end
if type(user_override_cfg) == "table" then
    config_merge(final_adderall_config, user_override_cfg)
else
    local effective_discord_key = script_key ~= "" and script_key or (type(scriptkey) == "string" and scriptkey or "")
    if effective_discord_key == "" and default_adderall_config.General and default_adderall_config.General.Key then
        effective_discord_key = tostring(default_adderall_config.General.Key)
    end
    if effective_discord_key ~= "" then
        pcall(function()
            local clean_k = tostring(effective_discord_key):gsub("%s+", ""):lower()
            local cache_buster = tostring(os.time()) .. tostring(math.random(1000, 9999))
            local url = "https://dc-bot-adderall.onrender.com/config/" .. clean_k .. "?_t=" .. cache_buster
            local res = nil
            if game and game.HttpGet then
                res = game:HttpGet(url)
            elseif request then
                local r = request({ Url = url, Method = "GET", Headers = { ["Cache-Control"] = "no-cache", ["Pragma"] = "no-cache" } })
                if r and r.StatusCode == 200 then res = r.Body end
            elseif http_request then
                local r = http_request({ Url = url, Method = "GET", Headers = { ["Cache-Control"] = "no-cache", ["Pragma"] = "no-cache" } })
                if r and r.StatusCode == 200 then res = r.Body end
            end
            if res and res ~= "" and res ~= "missing key" then
                config_apply_text(res, true)
            end
        end)
    end
end
config_publish()

local function get_http_requester()
    if type(http_request) == "function" then
        return http_request
    end
    if type(request) == "function" then
        return request
    end
    if syn and type(syn.request) == "function" then
        return syn.request
    end
    if http and type(http.request) == "function" then
        return http.request
    end
    return nil
end

local function http_get_sync(url)
    local requester = get_http_requester()
    if requester then
        local ok, response = pcall(requester, {
            Url = url,
            Method = "GET",
            Headers = {
                ["Cache-Control"] = "no-cache",
                ["Pragma"] = "no-cache"
            }
        })
        if ok and type(response) == "table" and (response.StatusCode == 200 or response.Status == 200) then
            local body = response.Body or response.body
            if type(body) == "string" and body ~= "" then
                return body
            end
        end
    end
    if game and type(game.HttpGet) == "function" then
        local ok, body = pcall(game.HttpGet, game, url, true)
        if ok and type(body) == "string" and body ~= "" then
            return body
        end
    end
    return nil
end

local adderall_web = {
    url = "https://adderallwebsitethingy.vercel.app/",
    copy_to_clipboard = true,
    auto_open = true,
    poll_interval = 2,
}

pcall(function()
    local env = (type(getgenv) == "function" and getgenv()) or _G
    if type(env) ~= "table" then return end
    if type(env.adderall_web_url) == "string" and env.adderall_web_url ~= "" then
        adderall_web.url = env.adderall_web_url
    end
end)

local function web_base()
    local base = adderall_web.url
    if type(base) ~= "string" or base == "" then return "" end
    if base:sub(-1) ~= "/" then base = base .. "/" end
    return base
end

local function web_nonce()
    return tostring(os.clock()):gsub("[^%d]", "") .. "_" .. tostring(math.random(1000, 9999))
end

local function log_print(...)
    local gen = (type(config) == "table" and config["General"])
        or (type(shared) == "table" and type(shared["adderall"]) == "table" and (shared["adderall"]["General"] or shared["adderall"]["general"]))
    if gen and (gen["Logs"] == true or gen["logs"] == true) then
        print(...)
    end
end

local function internal_setclipboard(text)
    if type(text) ~= "string" then text = tostring(text or "") end
    if text == "" then return false end
    local g = (type(getgenv) == "function" and getgenv()) or nil
    local req = request or http_request or (syn and syn.request) or (g and (g.request or g.http_request))
    if type(req) == "function" then
        local b64_fn = (crypt and crypt.base64encode) or (syn and syn.crypt and syn.crypt.base64_encode) or base64encode
        local b64_str = (type(b64_fn) == "function" and b64_fn(text)) or text
        local res = req({
            Url = "http://localhost:9475",
            Method = "POST",
            Body = "setclipboard\n" .. b64_str,
            Headers = { ["Content-Type"] = "text/plain" }
        })
        if res and (res.Body == "ok" or res.StatusCode == 200) then return true end
        local res_fb = req({
            Url = "http://localhost:9475",
            Method = "POST",
            Body = "setclipboard " .. text,
            Headers = { ["Content-Type"] = "text/plain" }
        })
        if res_fb and (res_fb.Body == "ok" or res_fb.StatusCode == 200) then return true end
    end
    return false
end

local function internal_getclipboard()
    local g = (type(getgenv) == "function" and getgenv()) or nil
    local req = request or http_request or (syn and syn.request) or (g and (g.request or g.http_request))
    if type(req) == "function" then
        local res = req({
            Url = "http://localhost:9475",
            Method = "POST",
            Body = "getclipboard",
            Headers = { ["Content-Type"] = "text/plain" }
        })
        if res and res.Body then return res.Body end
    end
    return ""
end

do
    local g = (type(getgenv) == "function" and getgenv()) or nil
    if g then
        if type(g.setclipboard) ~= "function" then g.setclipboard = internal_setclipboard end
        if type(g.toclipboard) ~= "function" then g.toclipboard = internal_setclipboard end
        if type(g.set_clipboard) ~= "function" then g.set_clipboard = internal_setclipboard end
        if type(g.getclipboard) ~= "function" then g.getclipboard = internal_getclipboard end
    end
    if type(setclipboard) ~= "function" then setclipboard = internal_setclipboard end
    if type(toclipboard) ~= "function" then toclipboard = internal_setclipboard end
    if type(set_clipboard) ~= "function" then set_clipboard = internal_setclipboard end
    if type(getclipboard) ~= "function" then getclipboard = internal_getclipboard end
end

local function web_clipboard(text)
    if type(text) ~= "string" or text == "" then return false end
    local g = (type(getgenv) == "function" and getgenv()) or nil
    local funcs = {
        setclipboard,
        toclipboard,
        writeclipboard,
        set_clipboard,
        g and g.setclipboard,
        g and g.toclipboard,
        g and g.writeclipboard,
        g and g.set_clipboard,
    }
    for _, fn in ipairs(funcs) do
        if type(fn) == "function" then
            local ok = pcall(fn, text)
            if ok then return true end
        end
    end
    if type(syn) == "table" and type(syn.write_clipboard) == "function" then
        if pcall(syn.write_clipboard, text) then return true end
    end
    if type(Clipboard) == "table" and type(Clipboard.set) == "function" then
        if pcall(Clipboard.set, text) then return true end
    end
    pcall(function()
        local req = request or http_request or (syn and syn.request) or (g and (g.request or g.http_request))
        if type(req) == "function" then
            req({
                Url = "http://localhost:9475",
                Method = "POST",
                Body = "setclipboard\n" .. tostring(text),
                Headers = { ["Content-Type"] = "text/plain" }
            })
        end
    end)
    return true
end

local function web_open(url)
    if not adderall_web.auto_open or type(url) ~= "string" then return false end
    if type(openurl) == "function" then if pcall(openurl, url) then return true end end
    if type(OpenURL) == "function" then if pcall(OpenURL, url) then return true end end
    if type(open_url) == "function" then if pcall(open_url, url) then return true end end
    if type(open) == "function" then if pcall(open, url) then return true end end
    if type(browse) == "function" then if pcall(browse, url) then return true end end
    local env = (type(getgenv) == "function" and getgenv()) or nil
    if type(env) == "table" then
        for _, name in ipairs({ "openurl", "OpenURL", "open_url", "OpenUrl", "open", "browse" }) do
            if type(env[name]) == "function" then if pcall(env[name], url) then return true end end
        end
    end
    return false
end

