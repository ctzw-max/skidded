local function is_gun(tool)
    if not tool or not tool:IsA("Tool") then return false end
    if not tool:FindFirstChild("Handle") then return false end
    if is_knife_tool(tool) then return false end
    local name = tool.Name:lower()
    for _, kw in ipairs(non_gun_names) do
        if name:find(kw, 1, true) then return false end
    end
    if valid_gun_names[name] or valid_gun_names[tool.Name] then return true end
    if shotguns[tool.Name] or autos[tool.Name] or bursts[tool.Name] or (hoodcustoms_gun_data and hoodcustoms_gun_data[tool.Name]) then return true end
    if tool:FindFirstChild("Ammo") or tool:FindFirstChild("ammo") or tool:FindFirstChild("AMMO") then return true end
    if tool:FindFirstChild("Script") and (tool.Script:FindFirstChild("Ammo") or tool.Script:FindFirstChild("AMMO")) then return true end
    if tool:FindFirstChild("ShootingCooldown") then return true end
    return false
end
local shooters = {}
function shooters.dahood(handle, muzzle_pos, hit_position, hit_instance, hit_normal, server_time, pellet_index, spread_counter)
    local remote = game_support.get_remote("MainEvent")
    if not remote then return end
    local tool = handle and handle.Parent
    local range_inst = tool and tool:FindFirstChild("Range")
    local range = tonumber(range_inst and range_inst.Value) or 300
    local delta = hit_position - muzzle_pos
    local distance = delta.Magnitude
    if distance > range + math.max(1e-4, range * 1e-6) then
        if not is_rage_mode_active() then
            hit_position = muzzle_pos + delta / distance * range
            hit_instance = nil
            hit_normal = nil
        end
    end
    if server_time and pellet_index then
        remote:FireServer("ShootGun", handle, muzzle_pos, hit_position, hit_instance, hit_normal, server_time, spread_counter or 1, pellet_index)
    elseif server_time then
        remote:FireServer("ShootGun", handle, muzzle_pos, hit_position, hit_instance, hit_normal, server_time)
    else
        remote:FireServer("ShootGun", handle, muzzle_pos, hit_position, hit_instance, hit_normal)
    end
    game_support.slow_walk(tool, 2)
end
function shooters.dashood(handle, muzzle_pos, hit_position, hit_instance, hit_normal, server_time)
    local remote = game_support.get_remote("MainEvent")
    if not remote then return end
    if not server_time then server_time = workspace:GetServerTimeNow() end
    remote:FireServer("ShootGun", handle, muzzle_pos, hit_instance, muzzle_pos, hit_position, server_time)
    game_support.slow_walk(handle and handle.Parent, 5)
end
function shooters.deshood(handle, muzzle_pos, hit_position, hit_instance, hit_normal)
    local remote = game_support.get_remote("DesHood")
    if not remote then return end
    local tool = handle and handle.Parent
    local range_inst = tool and tool:FindFirstChild("Range")
    local range = tonumber(range_inst and range_inst.Value) or 300
    local damage_inst = tool and tool:FindFirstChild("Damage")
    local damage = tonumber(damage_inst and damage_inst.Value) or 0
    local is_sg = false
    if tool then
        for _, name in ipairs({ "Double-Barrel SG", "TacticalShotgun", "Shotgun" }) do
            if tool.Name == "[" .. name .. "]" then is_sg = true break end
        end
    end
    if not is_sg then
        remote:FireServer("backdoor", handle, muzzle_pos, nil, hit_position, hit_instance, hit_normal, range, damage)
        return
    end
    local pellets = game_support.pending_pellets[tool]
    if not pellets then
        pellets = {}
        game_support.pending_pellets[tool] = pellets
    end
    pellets[#pellets + 1] = {
        AimPosition = muzzle_pos + (hit_position - muzzle_pos).Unit * range,
        Result1 = hit_position,
        Result2 = hit_instance,
        Result3 = hit_normal,
    }
    if #pellets >= 5 then
        game_support.pending_pellets[tool] = nil
        remote:FireServer("backdoor", handle, muzzle_pos, pellets, nil, nil, nil, range, damage)
    end
end
function shooters.derhood(handle, muzzle_pos, hit_position, hit_instance, hit_normal)
    local tool = handle and handle.Parent
    local remote = tool and (tool:FindFirstChild("RemoteEvent") or tool:FindFirstChild("Server"))
    if remote and remote:IsA("RemoteEvent") then
        remote:FireServer("Shoot", hit_position)
    end
end
