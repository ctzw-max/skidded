local function IsMeshChamArtifact(obj)
    if not obj then
        return false
    end
    if obj:GetAttribute("Adderall_MeshCham") == true then
        return true
    end
    if obj:IsA("Model") and obj.Name == "ChamShells" then
        return true
    end
    if obj:IsA("BasePart") and obj.Name:match("^ChamShell_") then
        return true
    end
    if obj:IsA("Highlight") and obj.Name == "ChamShellHighlight" then
        return true
    end
    return false
end
local function CleanupMeshChams(root)
    if not root then
        return
    end
    for _, obj in ipairs(root:GetDescendants()) do
        if IsMeshChamArtifact(obj) then
            pcall(function() obj:Destroy() end)
        end
    end
end
local function CleanupCharacterMeshChams(character)
    if not character then
        return
    end
    for _, child in ipairs(character:GetChildren()) do
        if IsMeshChamArtifact(child) then
            pcall(function() child:Destroy() end)
        end
    end
end
CleanupMeshChams(Workspace)
for _, player in ipairs(BootstrapPlayers:GetPlayers()) do
    CleanupCharacterMeshChams(player.Character)
end
local function EnsureRootInstances()
    if not ChamsContainer or not ChamsContainer.Parent then
        ChamsContainer = Instance.new("Folder")
        ChamsContainer.Name = "Adderall_Chams"
        ChamsContainer.Parent = UIContainer
    end
    if not MeshChamsFolder or not MeshChamsFolder.Parent then
        MeshChamsFolder = Instance.new("Folder")
        MeshChamsFolder.Name = "Adderall_MeshChams"
        MeshChamsFolder.Parent = Workspace
    end
    if not ScreenGui or not ScreenGui.Parent then
        ScreenGui = Instance.new("ScreenGui")
        ScreenGui.Name = "Adderall"
        ScreenGui.ResetOnSpawn = false
        ScreenGui.IgnoreGuiInset = true
        ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Global
        getgenv().Adderall_UI = ScreenGui
        local success = pcall(function()
            local target_parent = (type(gethui) == "function" and gethui()) or CoreGui
            ScreenGui.Parent = target_parent
        end)
        if not success or not ScreenGui.Parent then
            pcall(function()
                ScreenGui.Parent = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 2)
            end)
        end
    end
end
local labelStrokeMap = setmetatable({}, { __mode = "k" })
local PanelLabel
local PanelLines = {}
local wm_frame_count = 0
local wm_last_time = nil
local wm_fps = 0
local wm_busy_accum = 0
local wm_cpu = 0
local panel_draw_interval = 0.1
local last_panel_draw = 0
local ApplyFont = function(label, font_name, font_size)
    if fonts and fonts.apply then
        fonts.apply(label, font_name, font_size)
    end
end
local function PanelColorToHex(color)
    local r = math.clamp(math.floor(color.R * 255 + 0.5), 0, 255)
    local g = math.clamp(math.floor(color.G * 255 + 0.5), 0, 255)
    local b = math.clamp(math.floor(color.B * 255 + 0.5), 0, 255)
    return string.format("#%02X%02X%02X", r, g, b)
end
local function UpdatePanel()
    if not ScreenGui then return end
    local panel = config and config.Visuals and config.Visuals.Panel
    if type(panel) ~= "table" or panel.Enabled == false then
        if PanelLabel then PanelLabel.Visible = false end
        return
    end
    local panel_draw_now = os.clock()
    if panel_draw_now - last_panel_draw < panel_draw_interval then return end
    last_panel_draw = panel_draw_now
    if not PanelLabel or not PanelLabel.Parent then
        PanelLabel = Instance.new("TextLabel")
        PanelLabel.Name = "AdderallPanel"
        PanelLabel.BackgroundTransparency = 1
        PanelLabel.RichText = false
        PanelLabel.TextXAlignment = Enum.TextXAlignment.Left
        PanelLabel.TextYAlignment = Enum.TextYAlignment.Top
        PanelLabel.AnchorPoint = Vector2.new(0, 0.5)
        PanelLabel.Size = UDim2.new(0, 360, 0, 84)
        PanelLabel.Text = ""
        PanelLabel.Parent = ScreenGui
        for i = 1, 8 do
            local line = Instance.new("TextLabel")
            line.BackgroundTransparency = 1
            line.Text = ""
            line.Size = UDim2.new(1, 0, 0, 14)
            line.Position = UDim2.new(0, 0, 0, (i - 1) * 14)
            line.TextXAlignment = Enum.TextXAlignment.Left
            line.TextYAlignment = Enum.TextYAlignment.Top
            line.TextStrokeTransparency = 0
            line.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
            line.RichText = true
            pcall(ApplyFont, line, "Smallest Pixel-7")
            line.Parent = PanelLabel
            PanelLines[i] = line
        end
    end
    local placement = panel.Placement or panel.placement
    local place_x, place_y = 0, 0
    if type(placement) == "table" then
        place_x = tonumber(placement[1]) or 0
        place_y = tonumber(placement[2]) or 0
    end
    PanelLabel.Position = UDim2.new(0, place_x, 0.5, place_y)
    local textSize = tonumber(panel.Size) or 13
    local panel_font = panel.Font or panel.font or "Smallest Pixel-7"
    local colors = panel.Colors or {}
    local normalHex = PanelColorToHex(colors.Normal or Color3.fromRGB(255, 255, 255))
    local toggledHex = PanelColorToHex(colors.Toggled or Color3.fromRGB(134, 255, 150))
    local untoggledHex = PanelColorToHex(colors.Untoggled or Color3.fromRGB(255, 134, 134))
    local targetHex = PanelColorToHex(colors.Target or colors.Accent or Color3.fromRGB(168, 89, 255))
    local accentHex = PanelColorToHex(colors.Accent or Color3.fromRGB(168, 89, 255))
    local target = state and state.current_target
    if not target and get_targeting_mode() ~= "target" then
        local panel_eq = local_player.Character and local_player.Character:FindFirstChildOfClass("Tool")
        local panel_dist = resolve_range_check(config["Silent Aim"], panel_eq)
        target = get_best_player(panel_dist, get_silent_fov_args())
    end
    local targetName = target and (target.DisplayName or target.Name) or "none"
    targetName = tostring(targetName):lower()
    local bt_cfg = config["Backtrack"] or {}
    local eb_cfg = bt_cfg["Emulated Backtrack"] or {}
    local bt_enabled = (bt_cfg["Enabled"] == true or bt_cfg["enabled"] == true)
    local bt_active = false
    if bt_enabled and target then
        local history = backtrack_history[target]
        if history and #history > 0 then
            bt_active = true
        end
    end
    local bt_str = bt_active and "true" or "false"
    local bt_color = bt_active and toggledHex or untoggledHex
    local target_dist = 0
    if target and target.Character then
        local troot = target.Character:FindFirstChild("HumanoidRootPart")
        local sroot = local_player.Character and local_player.Character:FindFirstChild("HumanoidRootPart")
        if troot and sroot then
            target_dist = math.floor((troot.Position - sroot.Position).Magnitude + 0.5)
        end
    end
    local dist_str = tostring(target_dist)
    local cam = state and state.aim_assist_active
    local cam_str = cam and "on" or "off"
    local cam_color = cam and toggledHex or untoggledHex
    local trig = state and state.triggerbot_active
    local trig_str = trig and "on" or "off"
    local trig_color = trig and toggledHex or untoggledHex
    local wm_ping = 0
    pcall(function()
        local stats_service = game:GetService("Stats")
        wm_ping = math.floor(stats_service.Network.ServerStatsItem["Data Ping"]:GetValue() + 0.5)
    end)
    local wmText = tostring(panel.Watermark or panel.Text or "adderall.club")
    if (panel.OnTop or panel.ShowOnTop) and not wmText:find("on top") then
        wmText = wmText .. " on top"
    end
    local wmHtml
    local mainPart, extPart, restPart = wmText:match("^(.-)%.([^%s]+)(.*)$")
    if mainPart and extPart then
        wmHtml = string.format('<font color="%s">%s.</font><font color="%s">%s</font><font color="%s">%s</font>', normalHex, mainPart, accentHex, extPart, normalHex, restPart or "")
    else
        wmHtml = string.format('<font color="%s">%s</font>', accentHex, wmText)
    end
    local function setLine(index, text)
        local line = PanelLines[index]
        if not line then
            line = Instance.new("TextLabel")
            line.BackgroundTransparency = 1
            line.Text = ""
            line.Size = UDim2.new(1, 0, 0, 14)
            line.Position = UDim2.new(0, 0, 0, (index - 1) * 14)
            line.TextXAlignment = Enum.TextXAlignment.Left
            line.TextYAlignment = Enum.TextYAlignment.Top
            line.TextStrokeTransparency = 0
            line.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
            line.RichText = true
            pcall(ApplyFont, line, panel_font)
            line.Parent = PanelLabel
            PanelLines[index] = line
        end
        pcall(ApplyFont, line, panel_font)
        if line.TextSize ~= textSize then
            line.TextSize = textSize
        end
        if line.Text ~= text then
            line.Text = text
        end
        if not line.Visible then
            line.Visible = true
        end
    end
    local bt_label = (panel.BacktrackColon == true) and "backtrack:" or "backtrack"
    setLine(1, wmHtml)
    setLine(2, string.format('<font color="%s">CPU - </font><font color="%s">%s%%</font><font color="%s"> / Ping: </font><font color="%s">%sms</font>', normalHex, toggledHex, tostring(wm_cpu or 0), normalHex, toggledHex, tostring(wm_ping)))
    setLine(3, string.format('<font color="%s">target: </font><font color="%s">%s</font><font color="%s"> (%s </font><font color="%s">%s</font><font color="%s">, target distance: </font><font color="%s">%s</font><font color="%s">)</font>', normalHex, targetHex, targetName, normalHex, bt_label, bt_color, bt_str, normalHex, targetHex, dist_str, normalHex))
    setLine(4, string.format('<font color="%s">camera aimbot: </font><font color="%s">%s</font>', normalHex, cam_color, cam_str))
    setLine(5, string.format('<font color="%s">triggerbot: </font><font color="%s">%s</font>', normalHex, trig_color, trig_str))
    setLine(6, string.format('<font color="%s">emulated backtrack: </font><font color="%s">%s</font>', normalHex, toggledHex, tostring(eb_cfg and eb_cfg["Enabled"] or false)))
    for i = 7, #PanelLines do
        if PanelLines[i] then PanelLines[i].Visible = false end
    end
    PanelLabel.Visible = true
end
local DrawLine = LPHNoVirtualize(function(line, p1, p2, thickness, color)
    local diff = p2 - p1
    local dist = diff.Magnitude
    local angle = math.deg(math.atan2(diff.Y, diff.X))
    line.Size = UDim2.new(0, math.floor(dist + 0.5), 0, thickness)
    line.Position = UDim2.new(0, math.floor(p1.X + diff.X / 2 - dist / 2 + 0.5), 0,
        math.floor(p1.Y + diff.Y / 2 - thickness / 2 + 0.5))
    line.Rotation = angle
    line.BackgroundColor3 = color
    line.Visible = true
end)
local _actualESPConfig = {
