local embedded_skin_data = nil
local function try_embedded_skin_data()
    if embedded_skin_data == nil then
        local ok, result = pcall(get_embedded_skin_data)
        if ok and type(result) == 'table' and next(result) then
            embedded_skin_data = result
        else
            embedded_skin_data = false
        end
    end
    if embedded_skin_data then return embedded_skin_data end
    return nil
end

function load_skin_data()
    if skin_data and next(skin_data) then return skin_data end
    local embedded_result = try_embedded_skin_data()
    if embedded_result then
        skin_data = embedded_result
        return skin_data
    end
    if not is_da_hood_place then return nil end
    if os.time() < skin_data_retry_at then return nil end
    refresh_skin_containers()
    local container = skin_modules or skin_assets
    if container and container:IsA("ModuleScript") then
        local ok, result = pcall(require, container)
        if ok and type(result) == "table" then
            skin_data = result
            return skin_data
        end
        local ok_clone, result_clone = pcall(function()
            local clone = container:Clone()
            clone.Parent = replicated_storage
            local ok_req, data = pcall(require, clone)
            clone:Destroy()
            if ok_req then return data end
            return nil
        end)
        if ok_clone and type(result_clone) == "table" then
            skin_data = result_clone
            return skin_data
        end
    end
    local paths = {
        ".cache/skinmodules.lua",
        "cache/skinmodules.lua",
        "skinmodules.lua",
        "skinmodules.txt",
        ".cache/SkinModules.lua",
    }
    if type(listfiles) == "function" then
        collect_skin_paths(paths)
    end
    if type(readfile) == "function" then
        for _, path in ipairs(paths) do
            local ok, code = pcall(readfile, path)
            if ok and type(code) == "string" and #code > 10 then
                local result = evaluate_skin_code(code, container)
                if result then
                    skin_data = result
                    return skin_data
                end
            end
        end
    end
    local ok_http, code = pcall(function()
        return game:HttpGet(skin_data_url)
    end)
    if ok_http and type(code) == "string" and #code > 10 then
        local result = evaluate_skin_code(code, container)
        if result then
            skin_data = result
            return skin_data
        end
    end
    if not skin_data then
        local request_fn = (syn and syn.request) or (http and http.request) or http_request or request
        if type(request_fn) == "function" then
            local ok_req, response = pcall(request_fn, { Url = skin_data_url, Method = "GET" })
            if ok_req and type(response) == "table" then
                local body = response.Body or response.body
                local result = evaluate_skin_code(body, container)
                if result then
                    skin_data = result
                    return skin_data
                end
            end
        end
    end
    if type(shared) == "table" then
        for _, key in ipairs({ "skin_modules", "skinmodules", "SkinModules" }) do
            local value = shared[key]
            if type(value) == "table" and next(value) then
                skin_data = value
                return skin_data
            end
        end
    end
    if type(getgenv) == "function" then
        local ok_env, genv = pcall(getgenv)
        if ok_env and type(genv) == "table" then
            for _, key in ipairs({ "skin_modules", "skinmodules", "SkinModules" }) do
                local value = genv[key]
                if type(value) == "table" and next(value) then
                    skin_data = value
                    return skin_data
                end
            end
        end
    end
    skin_data_retry_at = os.time() + 2
    return skin_data
end
function get_skin_info(weapon_name, skin_name)
    local data = load_skin_data()
    if not data then return nil end
    local weapon_skins = data[weapon_name]
    if not weapon_skins then
        local bracket_name = "[" .. weapon_name:gsub("%[", ""):gsub("%]", "") .. "]"
        weapon_skins = data[bracket_name]
    end
    if not weapon_skins then return nil end
    local info = weapon_skins[skin_name]
    if not info then
        info = weapon_skins[skin_name:gsub("-", " ")]
    end
    if not info then
        info = weapon_skins[skin_name:gsub("-", "")]
    end
    return info
end
local function find_source_mesh_uncached(skin_name, mesh_ref, is_knife)
    local container = replicated_storage:FindFirstChild("SkinModules") or replicated_storage:FindFirstChild("SkinAssets")
    if not container then return nil end
    if is_knife then
        local clean_skin = skin_name:lower():gsub(" ", "")
        local knives_folder = (skin_modules and skin_modules:FindFirstChild("Knives")) or (skin_assets and (skin_assets:FindFirstChild("KnifeMeshes") or skin_assets:FindFirstChild("Knives")))
        if knives_folder then
            for _, child in next, knives_folder:GetChildren() do
                if child:IsA("MeshPart") then
                    local clean_name = child.Name:lower():gsub(" ", "")
                    if child.Name == skin_name or clean_name == clean_skin then
                        return child
                    end
                elseif child:IsA("Folder") or child:IsA("Model") then
                    local clean_name = child.Name:lower():gsub(" ", "")
                    if child.Name == skin_name or clean_name == clean_skin then
                        for _, sub in next, child:GetChildren() do
                            if sub:IsA("MeshPart") then
                                return sub
                            end
                        end
                    end
                end
            end
        end
        return nil
    end
    local meshes_folder = (skin_modules and skin_modules:FindFirstChild("Meshes")) or (skin_assets and skin_assets:FindFirstChild("GunMeshes"))
    if not meshes_folder then return nil end
    local folder_names = { skin_name, skin_name:gsub(" ", ""), skin_name:gsub(" ", "_") }
    for _, folder_name in next, folder_names do
        local skin_folder = meshes_folder:FindFirstChild(folder_name)
        if skin_folder then
            if mesh_ref then
                for _, child in next, skin_folder:GetChildren() do
                    if child:IsA("MeshPart") then
                        local clean_child = child.Name:lower():gsub(" ", ""):gsub("-", "")
                        local clean_ref = mesh_ref:lower():gsub(" ", ""):gsub("-", "")
                        if child.Name == mesh_ref or clean_child == clean_ref then
                            return child
                        end
                    end
                end
            end
            for _, child in next, skin_folder:GetChildren() do
                if child:IsA("MeshPart") then
                    return child
                end
            end
        end
    end
    return nil
end
local function find_source_mesh(skin_name, mesh_ref, is_knife)
    refresh_skin_containers()
    if not skin_modules and not skin_assets then return nil end
    local cache_key = tostring(is_knife) .. "|" .. skin_name .. "|" .. tostring(mesh_ref)
    local cached = source_mesh_cache[cache_key]
    if cached == nil then
        cached = find_source_mesh_uncached(skin_name, mesh_ref, is_knife)
        if cached then
            source_mesh_cache[cache_key] = cached
        end
    end
    return cached
end
local function get_shoot_sound_uncached(weapon_name, skin_name)
    local gun_shoot_sounds = skin_assets:FindFirstChild("GunShootSounds")
    if not gun_shoot_sounds then return nil end
    local weapon_folder = gun_shoot_sounds:FindFirstChild(weapon_name)
    if not weapon_folder then return nil end
    local sound_value = weapon_folder:FindFirstChild(skin_name)
    if sound_value and sound_value:IsA("StringValue") then
        return sound_value.Value
    end
    return nil
end
local function get_shoot_sound(weapon_name, skin_name)
    refresh_skin_containers()
    if not skin_assets then return nil end
    local cache_key = weapon_name .. "|" .. skin_name
    local cached = shoot_sound_cache[cache_key]
    if cached == nil then
        cached = get_shoot_sound_uncached(weapon_name, skin_name)
        if cached then
            shoot_sound_cache[cache_key] = cached
        end
    end
    return cached
end
local function remove_skin_from_tool(tool)
    if not tool or not applied_skins[tool] then return end
    clean_knife(tool)
    local original = applied_skins[tool]
    if original.connections then
        for _, connection in next, original.connections do
            if connection and connection.connected then
                connection:Disconnect()
            end
        end
    end
    for _, child in next, original.cloned_children or {} do
        if child and child.Parent then
            child:Destroy()
        end
    end
    if original.default and original.default.Parent then
        for _, child in next, original.default:GetChildren() do
            if child.Name == "\0" then
                child:Destroy()
            end
        end
        original.default.Transparency = original.original_transparency or 0
        original.default.TextureID = original.original_texture_id or ""
    end
    if original.shoot_sound and original.original_shoot_sound_id then
        original.shoot_sound.SoundId = original.original_shoot_sound_id
    end
    local handle = tool:FindFirstChild("Handle")
    if handle then
        handle:SetAttribute("SkinName", original.original_skin_name or "")
    end
    applied_skins[tool] = nil
end
local function apply_skin_to_tool(tool, skin_name)
    if not tool or type(skin_name) ~= "string" then return end
    refresh_skin_containers()
    if not skin_data and not load_skin_data() then return end
    if applied_skins[tool] and applied_skins[tool].skin_name == skin_name then return end
    local handle = tool:FindFirstChild("Handle")
    if not handle then return end
    local default = tool:FindFirstChild("Default")
    if default and not default:IsA("MeshPart") then
        default = nil
    end
    if not default then
        default = handle:FindFirstChildOfClass("MeshPart")
    end
    local shoot_sound = nil
    if default then
        for _, child in next, tool:GetDescendants() do
            if child:IsA("Sound") and (child.Name == "Shoot" or child.Name == "ShootSound") then
                shoot_sound = child
                break
            end
        end
    else
        for _, child in next, tool:GetDescendants() do
            if child:IsA("MeshPart") then
                if not default then
                    default = child
                end
            elseif child:IsA("Sound") and (child.Name == "Shoot" or child.Name == "ShootSound") then
                shoot_sound = child
            end
            if default and shoot_sound then break end
        end
    end
    if not default then return end
    if applied_skins[tool] then
        remove_skin_from_tool(tool)
    end
    applied_skins[tool] = {
        skin_name = skin_name,
        original_texture_id = default.TextureID,
        original_transparency = default.Transparency,
        original_skin_name = handle:GetAttribute("SkinName") or "",
        default = default,
        shoot_sound = shoot_sound,
        original_shoot_sound_id = shoot_sound and shoot_sound.SoundId or nil,
        cloned_children = {},
        connections = {},
    }
    handle:SetAttribute("SkinName", skin_name)
    local attr_conn = handle:GetAttributeChangedSignal("SkinName"):Connect(function()
        if handle:GetAttribute("SkinName") ~= skin_name then
            handle:SetAttribute("SkinName", skin_name)
        end
    end)
    table.insert(applied_skins[tool].connections, attr_conn)
    local is_knife = tool.Name:lower():find("knife") ~= nil or tool.Name == "[Knife]"
    local weapon_name = tool.Name:lower():sub(2, -2)
    local skin_info = get_skin_info(tool.Name, skin_name)
    local existing_fake = default:FindFirstChildOfClass("MeshPart")
    if existing_fake then
        existing_fake:Destroy()
    end
    local mesh = nil
    if is_knife then
        mesh = find_source_mesh(skin_name, nil, true)
    else
        if skin_info and skin_info.TextureID and typeof(skin_info.TextureID) == "Instance" and skin_info.TextureID:IsA("MeshPart") then
            mesh = skin_info.TextureID
        elseif skin_modules then
            local meshes_folder = skin_modules:FindFirstChild("Meshes")
            if meshes_folder then
                local skin_folder = meshes_folder:FindFirstChild(skin_name)
                    or meshes_folder:FindFirstChild(skin_name:gsub(" ", ""))
                    or meshes_folder:FindFirstChild(skin_name:gsub(" ", "_"))
                    or meshes_folder:FindFirstChild(skin_name:gsub("-", " "))
                    or meshes_folder:FindFirstChild(skin_name:gsub("-", ""))
                if skin_folder then
                    if skin_folder:IsA("MeshPart") then
                        mesh = skin_folder
                    else
                        mesh = skin_folder:GetChildren()
                    end
                end
            end
            if not mesh then
                local gun_models = skin_modules:FindFirstChild("GunModels")
                if gun_models then
                    local model = gun_models:FindFirstChild(skin_name)
                        or gun_models:FindFirstChild("[" .. skin_name .. "]")
                        or gun_models:FindFirstChild(skin_name:gsub("-", " "))
                        or gun_models:FindFirstChild(skin_name:gsub("-", ""))
                    if model then
                        if model:IsA("MeshPart") then
                            mesh = model
                        elseif model:IsA("Model") then
                            mesh = model:FindFirstChildOfClass("MeshPart")
                        end
                    end
                end
            end
        end
    end
    if mesh then
        local new_mesh = nil
        if typeof(mesh) == "Instance" and mesh:IsA("MeshPart") then
            new_mesh = mesh
        elseif type(mesh) == "table" then
            for _, child in next, mesh do
                if typeof(child) == "Instance" and child:IsA("MeshPart") then
                    local lowered = child.Name:lower()
                    if lowered:find("rpg") and weapon_name == "rpg" then
                        new_mesh = child; break
                    elseif lowered:find("aug") and weapon_name == "aug" then
                        new_mesh = child; break
                    elseif lowered:find("tac") and (weapon_name == "tacticalshotgun" or weapon_name == "tacticalshotgun") then
                        new_mesh = child; break
                    elseif lowered:find("rev") and weapon_name == "revolver" then
                        new_mesh = child; break
                    elseif (lowered:find("db") or lowered:find("double")) and (weapon_name == "double-barrel sg" or weapon_name == "double-barrelsg") then
                        new_mesh = child; break
                    elseif lowered:find("knife") and is_knife then
                        new_mesh = child; break
                    elseif lowered:find("rifle") and weapon_name == "rifle" then
                        new_mesh = child; break
                    elseif lowered:find("flame") and weapon_name == "flamethrower" then
                        new_mesh = child; break
                    elseif (lowered:find("silencer") or lowered:find("uzi") or lowered:find("glock")) and (weapon_name == "silencer" or weapon_name == "glock") then
                        new_mesh = child; break
                    elseif lowered:find("smg") and weapon_name == "smg" then
                        new_mesh = child; break
                    elseif lowered:find("lmg") and weapon_name == "lmg" then
                        new_mesh = child; break
                    elseif lowered:find("p90") and weapon_name == "p90" then
                        new_mesh = child; break
                    elseif lowered:find("ak") and weapon_name == "ak47" then
                        new_mesh = child; break
                    elseif (lowered:find("ar") or lowered:find("silencerar")) and (weapon_name == "ar" or weapon_name == "silencerar") then
                        new_mesh = child; break
                    elseif lowered:find("shotgun") and weapon_name == "shotgun" then
                        new_mesh = child; break
                    elseif lowered:find("drum") and (weapon_name == "drum-shotgun" or weapon_name == "drumgun") then
                        new_mesh = child; break
                    end
                end
            end
            if not new_mesh then
                for _, child in next, mesh do
                    if typeof(child) == "Instance" and child:IsA("MeshPart") then
                        new_mesh = child; break
                    end
                end
            end
        end
        if new_mesh and not is_knife then
            local new_fake = new_mesh:Clone()
            new_fake.Anchored = false
            new_fake.CanCollide = false
            new_fake.CFrame = default.CFrame
            local skin_cframe = (skin_info and skin_info.CFrame and typeof(skin_info.CFrame) == "CFrame") and skin_info.CFrame or CFrame.new()
            local weld = Instance.new("Weld")
            weld.Part0 = new_fake
            weld.Part1 = default
            weld.C0 = skin_cframe:Inverse()
            weld.Name = "\0"
            weld.Parent = new_fake
            new_fake.Name = "\0"
            new_fake.Parent = tool
            default.Transparency = 1
        end
    else
        if skin_info then
            local texture_value = skin_info.TextureID
            if texture_value then
                if typeof(texture_value) == "Instance" and texture_value:IsA("MeshPart") then
                    local clone = texture_value:Clone()
                    clone.Anchored = false
                    clone.CanCollide = false
                    clone.CFrame = default.CFrame
                    clone.Name = "\0"
                    clone.Parent = tool
                    local skin_cframe = (skin_info.CFrame and typeof(skin_info.CFrame) == "CFrame") and skin_info.CFrame or CFrame.new()
                    local weld = Instance.new("Weld")
                    weld.Part0 = clone
                    weld.Part1 = default
                    weld.C0 = skin_cframe:Inverse()
                    weld.Name = "\0"
                    weld.Parent = clone
                    default.Transparency = 1
                elseif type(texture_value) == "string" then
                    default.TextureID = texture_value
                    default.Transparency = 0
                end
            end
        end
    end
    for _, child in next, handle:GetChildren() do
        if #child.Name == 0 then
            child:Destroy()
        end
    end
    if skin_assets then
        local gun_handle_particle = skin_assets:FindFirstChild("GunHandleParticle")
        if gun_handle_particle then
            local particle_folder = gun_handle_particle:FindFirstChild(skin_name)
                or gun_handle_particle:FindFirstChild(skin_name:gsub("-", " "))
                or gun_handle_particle:FindFirstChild(skin_name:gsub("-", ""))
            if particle_folder then
                local emitter = particle_folder:FindFirstChildOfClass("ParticleEmitter")
                if emitter then
                    local cloned_particle = emitter:Clone()
                    cloned_particle.Parent = handle
                    cloned_particle.Name = "\0"
                    table.insert(applied_skins[tool].cloned_children, cloned_particle)
                end
            end
        end
    end
    if is_knife and skin_assets then
        local skin_scripts = skin_assets:FindFirstChild("SkinScripts")
        if skin_scripts then
            for _, folder in next, skin_scripts:GetChildren() do
                if folder.Name:lower():gsub(" ", "") == skin_name:lower():gsub(" ", "") then
                    local sound = folder:FindFirstChildOfClass("Sound")
                    if sound then
                        local cloned = sound:Clone()
                        cloned.Name = "\0"
                        cloned.Parent = handle
                        cloned:Play()
                        debris:AddItem(cloned, 3)
                    end
                    for _, obj in next, folder:GetDescendants() do
                        if obj:IsA("Sound") or obj:IsA("StringValue") then
                            local obj_lower = obj.Name:lower():gsub(" ", "")
                            if obj_lower == "equipsfx" or obj_lower == "sfx" or obj_lower == "equip" or obj_lower == "tantoequip" then
                                applied_skins[tool].knife_equip_sound = obj:IsA("Sound") and obj.SoundId or obj.Value
                            elseif obj_lower == "attacksfx" or obj_lower == "attack" then
                                applied_skins[tool].knife_attack_sound = obj:IsA("Sound") and obj.SoundId or obj.Value
                            end
                        end
                    end
                    break
                end
            end
        end
        local skin_scripts_storage = skin_assets:FindFirstChild("SkinScriptsStorage")
        if skin_scripts_storage then
            for _, folder in next, skin_scripts_storage:GetChildren() do
                if folder.Name:lower():gsub(" ", "") == skin_name:lower():gsub(" ", "") then
                    for _, anim in next, folder:GetDescendants() do
                        if anim:IsA("Animation") then
                            local anim_lower = anim.Name:lower():gsub(" ", "")
                            if anim_lower == "knife" or anim_lower == "equipknife" or anim_lower == "knifeequip" or anim_lower == "tantoequip" then
                                applied_skins[tool].knife_equip_anim = anim
                                break
                            end
                        end
                    end
                    break
                end
            end
        end
        local knife_skin_animation = skin_assets:FindFirstChild("KnifeSkinAnimation")
        if knife_skin_animation then
            for _, folder in next, knife_skin_animation:GetChildren() do
                if folder.Name:lower():gsub(" ", "") == skin_name:lower():gsub(" ", "") then
                    for _, anim in next, folder:GetDescendants() do
                        if anim:IsA("Animation") then
                            applied_skins[tool].knife_attack_anim = anim
                            break
                        end
                    end
                    break
                end
            end
        end
    end
    if is_knife and skin_name:lower():gsub(" ", "") == "goldenagetanto" then
        if not applied_skins[tool].knife_equip_anim then
            local anim = Instance.new("Animation")
            anim.AnimationId = "rbxassetid://13473404819"
            applied_skins[tool].knife_equip_anim = anim
        else
            applied_skins[tool].knife_equip_anim.AnimationId = "rbxassetid://13473404819"
        end
    end
    if is_knife and (skin_name:lower():gsub(" ", "") == "gpoknife" or skin_name:lower():gsub(" ", "") == "gpoknifeprestige") then
        if not applied_skins[tool].knife_equip_anim then
            local anim = Instance.new("Animation")
            anim.AnimationId = "rbxassetid://102007904524177"
            applied_skins[tool].knife_equip_anim = anim
        else
            applied_skins[tool].knife_equip_anim.AnimationId = "rbxassetid://102007904524177"
        end
    end
    local sound_id = get_shoot_sound(tool.Name, skin_name)
    if sound_id and applied_skins[tool].shoot_sound then
        applied_skins[tool].shoot_sound.SoundId = sound_id
    end
end
local function process_tool(tool)
    if not tool or not tool.Parent then return end
    if tool_registry[tool] then return end
    local skin_changer_cfg = (config and config["Skin Changer"])
        or (shared["Adderall"] and (shared["Adderall"]["Skin Changer"] or shared["Adderall"]["skin_changer"]))
        or shared.skinchanger or {}
    local is_enabled = skin_changer_cfg["Enabled"]
    if is_enabled == nil then is_enabled = skin_changer_cfg["enabled"] end
    if is_enabled == nil then is_enabled = true end
    if not is_enabled then return end
    local skins = skin_changer_cfg["Weapons"] or skin_changer_cfg["weapons"] or skin_changer_cfg["Skins"] or skin_changer_cfg["skins"] or skin_changer_cfg["options"] or {}
    local configured_skin = skins[tool.Name]
    if not configured_skin then
        local stripped = tool.Name:gsub("%[", ""):gsub("%]", "")
        configured_skin = skins["[" .. stripped .. "]"] or skins[stripped]
    end
    if not configured_skin or configured_skin == "" or configured_skin == "None" then return end
    if type(configured_skin) ~= "string" or configured_skin:lower() == "default" then return end
    if not load_skin_data() then return end
    local is_knife = tool.Name:lower():find("knife") ~= nil or tool.Name == "[Knife]"
    if is_knife and is_knife_skin(configured_skin) then
        apply_skin_to_tool(tool, configured_skin)
        if not applied_skins[tool] then return end
        local equip_conn
        equip_conn = tool.Equipped:Connect(function()
            if not applied_skins[tool] then
                if equip_conn then equip_conn:Disconnect() end
                return
            end
            local char = tool.Parent
            if char ~= local_player.Character then return end
            apply_knife(char, tool, configured_skin)
        end)
        table.insert(applied_skins[tool].connections, equip_conn)
        if local_player.Character and tool.Parent == local_player.Character then
            apply_knife(local_player.Character, tool, configured_skin)
        end
        if applied_skins[tool].knife_attack_anim or applied_skins[tool].knife_attack_sound then
            local attack_connection
            attack_connection = tool.Activated:Connect(function()
                local s_data = applied_skins[tool]
                if not s_data then
                    if attack_connection then attack_connection:Disconnect() end
                    return
                end
                if s_data.knife_attack_sound then
                    local sound = Instance.new("Sound")
                    sound.SoundId = s_data.knife_attack_sound
                    sound.Volume = 1
                    sound.Parent = tool:FindFirstChild("Handle") or tool
                    sound:Play()
                    debris:AddItem(sound, 3)
                end
                if s_data.knife_attack_anim then
                    local char = local_player.Character
                    if char then
                        local humanoid = char:FindFirstChildOfClass("Humanoid")
                        if humanoid then
                            local animator = humanoid:FindFirstChildOfClass("Animator")
                            if not animator then
                                animator = Instance.new("Animator")
                                animator.Parent = humanoid
                            end
                            local anim = Instance.new("Animation")
                            anim.AnimationId = s_data.knife_attack_anim.AnimationId
                            local track = animator:LoadAnimation(anim)
                            track.Priority = Enum.AnimationPriority.Action
                            track:Play()
                            anim:Destroy()
                        end
                    end
                end
            end)
            table.insert(applied_skins[tool].connections, attack_connection)
        end
    else
        apply_skin_to_tool(tool, configured_skin)
        local eq_conn = tool.Equipped:Connect(function()
            local char = tool.Parent
            if char ~= local_player.Character then return end
            apply_skin_to_tool(tool, configured_skin)
        end)
        if applied_skins[tool] then
            if not applied_skins[tool].connections then
                applied_skins[tool].connections = {}
            end
            table.insert(applied_skins[tool].connections, eq_conn)
        else
            eq_conn:Disconnect()
        end
        if local_player.Character and tool.Parent == local_player.Character then
            apply_skin_to_tool(tool, configured_skin)
        end
    end
    tool_registry[tool] = true
end
local char_conns = setmetatable({}, { __mode = "k" })
local function process_character(character)
    if not character then return end
    for _, child in next, character:GetChildren() do
        if child:IsA("Tool") then
            process_tool(child)
        end
    end
    if not char_conns[character] then
        local char_child_conn = character.ChildAdded:Connect(function(child)
            if child:IsA("Tool") then
                task.wait(0.1)
                process_tool(child)
            end
        end)
        char_conns[character] = char_child_conn
        table.insert(skinchanger_cleanups, function() char_child_conn:Disconnect() end)
        table.insert(script_connections, char_child_conn)
    end
end
local backpack_conns = setmetatable({}, { __mode = "k" })
local function process_backpack(backpack)
    if not backpack then return end
    for _, tool in next, backpack:GetChildren() do
        if tool:IsA("Tool") then
            process_tool(tool)
        end
    end
    if not backpack_conns[backpack] then
        local bp_child_conn = backpack.ChildAdded:Connect(function(tool)
            if tool:IsA("Tool") then
                task.wait(0.1)
                process_tool(tool)
            end
        end)
        backpack_conns[backpack] = bp_child_conn
        table.insert(skinchanger_cleanups, function() bp_child_conn:Disconnect() end)
        table.insert(script_connections, bp_child_conn)
    end
end
local function reload_skins()
    local to_reprocess = {}
    for tool in pairs(tool_registry) do
        table.insert(to_reprocess, tool)
    end
    for _, tool in ipairs(to_reprocess) do
        remove_skin_from_tool(tool)
        tool_registry[tool] = nil
        if tool.Parent then
            local handle = tool:FindFirstChild("Handle")
            if handle then
                for _, child in ipairs(handle:GetChildren()) do
                    if child.Name == "\0" or child.Name == "SkinMesh" then
                        pcall(function() child:Destroy() end)
                    end
                end
            end
            local default = tool:FindFirstChild("Default")
            if default then
                for _, child in ipairs(default:GetChildren()) do
                    if child.Name == "\0" or child:IsA("Model") then
                        pcall(function() child:Destroy() end)
                    end
                end
            end
        end
    end
    task.wait()
    local char = local_player.Character
    if char then
        for _, child in ipairs(char:GetChildren()) do
            if child:IsA("Tool") then process_tool(child) end
        end
    end
    local bp = local_player:FindFirstChildOfClass("Backpack")
    if bp then
        for _, child in ipairs(bp:GetChildren()) do
            if child:IsA("Tool") then process_tool(child) end
        end
    end
end
_G.AdderallReloadSkins = reload_skins
_G.adderall_reload_skins = reload_skins
local function init_skin_changer()
    pcall(load_skin_data)
    refresh_skin_containers()
    local char = local_player.Character or (local_player.CharacterAdded and local_player.CharacterAdded:Wait())
    local bp = local_player:FindFirstChildOfClass("Backpack") or (local_player.WaitForChild and local_player:WaitForChild("Backpack", 5))
    if char then pcall(process_character, char) end
    if bp then pcall(process_backpack, bp) end
    local ca_conn = local_player.CharacterAdded:Connect(function(new_char)
        task.wait(0.5)
        pcall(process_character, new_char)
        local new_bp = local_player:FindFirstChildOfClass("Backpack") or local_player:WaitForChild("Backpack", 5)
        if new_bp then pcall(process_backpack, new_bp) end
    end)
    table.insert(skinchanger_cleanups, function() ca_conn:Disconnect() end)
    table.insert(script_connections, ca_conn)
end
task.spawn(function()
    pcall(init_skin_changer)
end)
task.spawn(function()
    local waited = false
    for _ = 1, 120 do
        if skin_data then break end
        waited = true
        task.wait(0.5)
        if not skin_data then
            refresh_skin_containers()
            pcall(load_skin_data)
        end
    end
    if skin_data and waited then
        pcall(reload_skins)
    end
end)
task.spawn(function()
    local LastSignature = nil
    while true do
        task.wait(0.5)
        local Settings = config["Skin Changer"] or (shared["Adderall"] and shared["Adderall"]["Skin Changer"])
        if type(Settings) ~= "table" then
            continue
        end
        local Signature = tostring(Settings["Enabled"] or Settings["enabled"]) .. "|"
        for Key, Value in pairs(Settings["Weapons"] or Settings["weapons"] or Settings["Skins"] or Settings["skins"] or Settings["options"] or {}) do
            Signature = Signature .. tostring(Key) .. "=" .. tostring(Value) .. ";"
        end
        if LastSignature ~= nil and Signature ~= LastSignature then
            pcall(reload_skins)
        end
        LastSignature = Signature
    end
end)
local skinchanger_unload = function()
    Runtime.Alive = false
    pcall(function()
        for tool in pairs(tool_registry) do
            remove_skin_from_tool(tool)
        end
    end)
    for Index = #skinchanger_cleanups, 1, -1 do
        pcall(skinchanger_cleanups[Index])
        skinchanger_cleanups[Index] = nil
    end
end
local Avatar = {}
Avatar.CopyClasses = {
    Shirt = true,
    Pants = true,
    ShirtGraphic = true,
    Accessory = true,
    Hat = true,
    BodyColors = true,
    CharacterMesh = true,
}
Avatar.ScalingMetadataNames = { "OriginalSize", "OriginalPosition", "AvatarPartScaleType" }
Avatar.Requests = TrySetmetatable({}, { __mode = "k" })
Avatar.StableRigs = TrySetmetatable({}, { __mode = "k" })
Avatar.RagdollCleanup = WeakKeys()
Avatar.JointSyncCleanup = WeakKeys()
Avatar.HeadlessCleanup = WeakKeys()
Avatar.BodyRequests = TrySetmetatable({}, { __mode = "k" })
Avatar.OriginalAnimationIds = WeakKeys()
Avatar.DescriptionBackups = WeakKeys()
Avatar.AnimationStates = {
    idle = true,
    walk = true,
    run = true,
    jump = true,
    fall = true,
    climb = true,
    swim = true,
    swimidle = true,
    mood = true,
}
Avatar.DescriptionAnimationProps = {
    "IdleAnimation",
    "WalkAnimation",
    "RunAnimation",
    "JumpAnimation",
    "FallAnimation",
    "ClimbAnimation",
    "SwimAnimation",
    "MoodAnimation",
}
Avatar.SourceCache = {}
Avatar.DescriptionCache = {}
Avatar.UserIdCache = {}
Avatar.Pending = {}
Avatar.BodySizePresets = { Skinny = 0.5, Normal = 1, Fat = 1.25 }
Avatar.BodyScaleMap = {
    BodyTypeScale = "BodyTypeScale",
    DepthScale = "BodyDepthScale",
    HeadScale = "HeadScale",
    HeightScale = "BodyHeightScale",
    ProportionScale = "BodyProportionScale",
    WidthScale = "BodyWidthScale",
}
Avatar.AnimIdUrl = "rbxassetid://"
local function self_knocked()
    local character = Self.Character
    if not character then
        return false
    end
    local effects = character:FindFirstChild("BodyEffects")
    if not effects then
        return false
    end
    local knocked = effects:FindFirstChild("K.O") or effects:FindFirstChild("KO")
    return knocked ~= nil and knocked.Value == true
end
function Avatar:IsCopyClass(class_name)
    return Avatar.CopyClasses[class_name] == true
end
function Avatar:AwaitPending(key)
    local pending = Avatar.Pending[key]
    if not pending then
        return false
    end
    repeat
        Wait()
    until pending.Done
    return true
end
function Avatar:RunPending(key, fetch)
    local pending = { Done = false }
    Avatar.Pending[key] = pending
    local ok, first, second = Pcall(fetch)
    pending.Done = true
    if Avatar.Pending[key] == pending then
        Avatar.Pending[key] = nil
    end
    if not ok then
        error(first, 0)
    end
    return first, second
end
function Avatar:ResolveUserId(raw)
    if Type(raw) == "number" then
        return raw > 0 and raw or nil
    end
    if Type(raw) ~= "string" then
        return nil
    end
    local num = Tonumber(raw)
    if num and num > 0 then
        return num
    end
    local name = raw:lower()
    repeat
        local known = Avatar.UserIdCache[name]
        if known then
            return known
        end
    until not Avatar:AwaitPending(name)
    return Avatar:RunPending(name, function()
        local ok, id = Pcall(function()
            return Players:GetUserIdFromNameAsync(raw)
        end)
        if ok and Type(id) == "number" and id > 0 then
            Avatar.UserIdCache[name] = id
            return id
        end
        return nil
    end)
end
function Avatar:SourceVariant(options)
    if options.Own then
        return "own"
    end
    return options.Body and options.BodyType or "raw"
end
function Avatar:GetDescription(user_id)
    repeat
        local cached = Avatar.DescriptionCache[user_id]
        if cached then
            return cached
        end
    until not Avatar:AwaitPending(user_id)
    return Avatar:RunPending(user_id, function()
        local description = Players:GetHumanoidDescriptionFromUserIdAsync(user_id)
        Avatar.DescriptionCache[user_id] = description
        return description
    end)
end
function Avatar:GetSource(user_id, rig_type, options)
    local need_model = options.Body or options.Animations
    local key = user_id .. ":" .. Tostring(rig_type) .. ":" .. Avatar:SourceVariant(options)
    repeat
        local cached = Avatar.SourceCache[key]
        if cached and (cached.SourceModel or not need_model) then
            return cached.Description, cached.SourceModel
        end
    until not Avatar:AwaitPending(key)
    return Avatar:RunPending(key, function()
        local cached = Avatar.SourceCache[key]
        local description = cached and cached.Description
        if not description then
            description = Avatar:GetDescription(user_id):Clone()
            if options.Body and not options.Own then
                Avatar:PrepareDescription(description, options)
            end
            Avatar.SourceCache[key] = { Description = description }
        end
        local source_model = cached and cached.SourceModel
        if need_model and not source_model then
            source_model = Players:CreateHumanoidModelFromDescriptionAsync(description, rig_type)
            Avatar.SourceCache[key] = { Description = description, SourceModel = source_model }
        end
        return description, source_model
    end)
end
function Avatar:Prefetch(target, rig_type, options)
    Spawn(Pcall, function()
        local user_id = Avatar:ResolveUserId(target)
        if user_id then
            Avatar:GetSource(user_id, rig_type, options)
        end
    end)
end
function Avatar:Options(settings)
    local mode = settings.Mode or "Full"
    if mode ~= "Full" and mode ~= "Character" and mode ~= "Animations" and mode ~= "Emotes" then
        error("avatar: Invalid mode " .. Tostring(mode))
    end
    local body_type = settings["Body Type"] or (settings.Skinny and "Skinny" or "Normal")
    if body_type == "Target" or body_type == "Original" or body_type == "Classic" then
        body_type = "Normal"
    end
    if not Avatar.BodySizePresets[body_type] then
        error("avatar: Invalid body type " .. Tostring(body_type))
    end
    return {
        Body = mode == "Full" or mode == "Character",
        Animations = mode == "Full" or mode == "Animations",
        Emotes = mode == "Full" or mode == "Emotes",
        BodyType = body_type,
    }
end
function Avatar:PrepareDescription(description, options)
    Pcall(function()
        description.UseAvatarSettings = false
    end)
    local size = assert(Avatar.BodySizePresets[options.BodyType], "avatar: Invalid body size")
    description.WidthScale = size
    description.DepthScale = size
    description.HeightScale = 1
    description.HeadScale = 1
end
function Avatar:CaptureJointAnchors(character)
    local anchors, used, joints, constraints, links = {}, {}, {}, {}, {}
    for _, object in Ipairs(character:GetDescendants()) do
        if object:IsA("Motor6D") then
            joints[#joints + 1] = object
        elseif object:IsA("BallSocketConstraint") or object:IsA("HingeConstraint") then
            constraints[#constraints + 1] = object
        end
    end
    for index, joint in Ipairs(joints) do
        local part0, part1 = joint.Part0, joint.Part1
        for side = 0, 1 do
            local part = side == 0 and part0 or part1
            if not part or part.Parent ~= character then
                continue
            end
            local cf = side == 0 and joint.C0 or joint.C1
            local pivot = cf.Position
            local size = part.Size
            for _, attachment in Ipairs(part:GetChildren()) do
                if
                    attachment:IsA("Attachment")
                    and not attachment:IsA("Bone")
                    and not used[attachment]
                    and (attachment.Position - pivot).Magnitude < 0.01
                then
                    anchors[#anchors + 1] = {
                        Attachment = attachment,
                        Joint = joint,
                        Side = side,
                        Offset = cf:ToObjectSpace(attachment.CFrame),
                        Size = size,
                    }
                    used[attachment] = true
                end
            end
        end
        if part0 and part1 and part0.Parent == character and part1.Parent == character then
            local row = links[part0]
            if not row then
                row = {}
                links[part0] = row
            end
            if not row[part1] then
                row[part1] = index
            end
        end
    end
    for _, constraint in Ipairs(constraints) do
        local a0, a1 = constraint.Attachment0, constraint.Attachment1
        if not a0 or not a1 then
            continue
        end
        local parent0, parent1 = a0.Parent, a1.Parent
        if not parent0 or not parent1 then
            continue
        end
        local forward_index = links[parent0] and links[parent0][parent1]
        local reverse_index = links[parent1] and links[parent1][parent0]
        local index = forward_index and reverse_index and Min(forward_index, reverse_index) or forward_index or reverse_index
        if not index then
            continue
        end
        local joint = joints[index]
        local forward = parent0 == joint.Part0 and parent1 == joint.Part1
        for side = 0, 1 do
            local attachment = (side == 0) == forward and a0 or a1
            local cf = attachment.CFrame
            anchors[#anchors + 1] = { Attachment = attachment, Joint = joint, Side = side, Rotation = cf - cf.Position }
        end
    end
    return anchors
end
function Avatar:RestoreJointAnchors(anchors)
    for _, entry in Ipairs(anchors) do
        local attachment, joint = entry.Attachment, entry.Joint
        if not attachment.Parent or not joint.Parent then
            continue
        end
        if entry.Rotation then
            attachment.CFrame = entry.Rotation + (entry.Side == 0 and joint.C0 or joint.C1).Position
        else
            local size = attachment.Parent.Size
            local offset = Avatar:ScaleJointCFrame(
                entry.Offset,
                size.X / Max(entry.Size.X, 1e-6),
                size.Y / Max(entry.Size.Y, 1e-6),
                size.Z / Max(entry.Size.Z, 1e-6)
            )
            attachment.CFrame = (entry.Side == 0 and joint.C0 or joint.C1) * offset
        end
    end
end
function Avatar:WatchRagdoll(character, request)
    if Avatar.RagdollCleanup[character] then
        Avatar.RagdollCleanup[character]()
    end
    local pivots, constraints, connections = {}, {}, {}
    local function track(object)
        if
            object:IsA("Motor6D")
            and object.Part0
            and object.Part1
            and object.Part0.Parent == character
            and object.Part1.Parent == character
        then
            pivots[object.Part0] = pivots[object.Part0] or {}
            pivots[object.Part1] = pivots[object.Part1] or {}
            pivots[object.Part0][object.Part1] = { Joint = object, Flipped = false }
            pivots[object.Part1][object.Part0] = { Joint = object, Flipped = true }
            return true
        elseif object:IsA("BallSocketConstraint") or object:IsA("HingeConstraint") then
            constraints[object] = true
            return true
        end
        return false
    end
    for _, object in Ipairs(character:GetDescendants()) do
        track(object)
    end
    local function cleanup()
        for _, connection in Ipairs(connections) do
            connection:Disconnect()
        end
        table.clear(connections)
        if Avatar.RagdollCleanup[character] == cleanup then
            Avatar.RagdollCleanup[character] = nil
        end
    end
    Avatar.RagdollCleanup[character] = cleanup
    connections[#connections + 1] = Runtime:Connect("Avatar", character.DescendantAdded, function(object)
        if track(object) or not object:IsA("Motor6D") then
            return
        end
        Spawn(function()
            for _ = 1, 5 do
                Wait(0.05)
                if not object.Parent or Avatar.BodyRequests[character] ~= request then
                    return
                end
                if track(object) then
                    return
                end
            end
        end)
    end)
    connections[#connections + 1] = Runtime:Connect("Avatar", character.DescendantRemoving, function(object)
        constraints[object] = nil
    end)
    connections[#connections + 1] = Runtime:Connect("Avatar", RunService.PreSimulation, function()
        if Self.Character ~= character or not character.Parent or Avatar.BodyRequests[character] ~= request then
            cleanup()
            return
        end
        for constraint in Pairs(constraints) do
            local a0, a1 = constraint.Attachment0, constraint.Attachment1
            if not a0 or not a1 then
                continue
            end
            local row = pivots[a0.Parent]
            local pair = row and row[a1.Parent]
            local joint = pair and pair.Joint
            if joint and joint.Parent then
                local first, second = joint.C0.Position, joint.C1.Position
                if pair.Flipped then
                    first, second = second, first
                end
                local cf0, cf1 = a0.CFrame, a1.CFrame
                local position0, position1 = cf0.Position, cf1.Position
                if (position0 - first).Magnitude > 1e-5 then
                    a0.CFrame = (cf0 - position0) + first
                end
                if (position1 - second).Magnitude > 1e-5 then
                    a1.CFrame = (cf1 - position1) + second
                end
            end
        end
    end)
end
function Avatar:CopyScalingMetadata(local_object, source_object)
    for _, name in Ipairs(Avatar.ScalingMetadataNames) do
        local source_value = source_object:FindFirstChild(name)
        local local_value = local_object:FindFirstChild(name)
        if local_value then
            local_value:Destroy()
        end
        if source_value then
            source_value:Clone().Parent = local_object
        end
    end
end
function Avatar:SyncAttachments(local_part, source_part, old_size)
    if not local_part or not source_part then
        return
    end
    if old_size then
        local size = local_part.Size
        local ratio =
            Vector3New(size.X / Max(old_size.X, 1e-6), size.Y / Max(old_size.Y, 1e-6), size.Z / Max(old_size.Z, 1e-6))
        for _, attachment in Ipairs(local_part:GetChildren()) do
            if attachment:IsA("Attachment") and not attachment:IsA("Bone") then
                local cf = attachment.CFrame
                attachment.CFrame = (cf - cf.Position) + cf.Position * ratio
            end
        end
    end
    for _, source_att in Ipairs(source_part:GetChildren()) do
        if source_att:IsA("Attachment") and not source_att:IsA("Bone") then
            local local_att = local_part:FindFirstChild(source_att.Name)
            if local_att and local_att:IsA("Attachment") then
                Pcall(function()
                    local_att.CFrame = source_att.CFrame
                    Avatar:CopyScalingMetadata(local_att, source_att)
                end)
            elseif not local_att then
                source_att:Clone().Parent = local_part
            end
        end
    end
end
function Avatar:ScaleJointCFrame(joint, width, height, depth)
    local position = joint.Position
    return (joint - position) + Vector3New(position.X * width, position.Y * height, position.Z * depth)
end
function Avatar:SyncJoints(character, source_model)
    local sources = {}
    for _, joint in Ipairs(source_model:GetDescendants()) do
        if joint:IsA("Motor6D") and joint.Part0 and joint.Part1 then
            sources[joint.Name .. ":" .. joint.Part0.Name .. ":" .. joint.Part1.Name] = joint
        end
    end
    for _, joint in Ipairs(character:GetDescendants()) do
        if
            joint:IsA("Motor6D")
            and joint.Part0
            and joint.Part1
            and joint.Part0.Parent == character
            and joint.Part1.Parent == character
        then
            local source = sources[joint.Name .. ":" .. joint.Part0.Name .. ":" .. joint.Part1.Name]
            if source then
                joint.C0, joint.C1 = source.C0, source.C1
            end
        end
    end
    return sources
end
function Avatar:WatchJointSync(character, sources, request)
    if Avatar.JointSyncCleanup[character] then
        Avatar.JointSyncCleanup[character]()
    end
    local templates, connections = {}, {}
    for key, joint in Pairs(sources) do
        templates[key] = { C0 = joint.C0, C1 = joint.C1 }
    end
    local function sync(joint)
        if not joint:IsA("Motor6D") or not joint.Part0 or not joint.Part1 then
            return false
        end
        if joint.Part0.Parent ~= character or joint.Part1.Parent ~= character then
            return false
        end
        local template = templates[joint.Name .. ":" .. joint.Part0.Name .. ":" .. joint.Part1.Name]
        if not template then
            return false
        end
        joint.C0, joint.C1 = template.C0, template.C1
        return true
    end
    local function cleanup()
        for _, connection in Ipairs(connections) do
            connection:Disconnect()
        end
        table.clear(connections)
        if Avatar.JointSyncCleanup[character] == cleanup then
            Avatar.JointSyncCleanup[character] = nil
        end
    end
    Avatar.JointSyncCleanup[character] = cleanup
    connections[#connections + 1] = Runtime:Connect("Avatar", character.DescendantAdded, function(object)
        if not object:IsA("Motor6D") then
            return
        end
        Spawn(function()
            for _ = 1, 5 do
                if not object.Parent or Avatar.BodyRequests[character] ~= request then
                    return
                end
                if sync(object) then
                    return
                end
                Wait(0.05)
            end
        end)
    end)
    if Self.Character ~= character or not character.Parent or Avatar.BodyRequests[character] ~= request then
        cleanup()
        return
    end
    for _, joint in Ipairs(character:GetDescendants()) do
        sync(joint)
    end
end
function Avatar:RelinkJoints(character, old_part, new_part)
    for _, joint in Ipairs(old_part:GetChildren()) do
        if joint:IsA("JointInstance") or joint:IsA("WeldConstraint") or joint:IsA("NoCollisionConstraint") then
            Pcall(function()
                joint.Parent = new_part
            end)
        end
    end
    for _, joint in Ipairs(character:GetDescendants()) do
        if joint:IsA("JointInstance") or joint:IsA("WeldConstraint") or joint:IsA("NoCollisionConstraint") then
            Pcall(function()
                if joint.Part0 == old_part then
                    joint.Part0 = new_part
                end
                if joint.Part1 == old_part then
                    joint.Part1 = new_part
                end
            end)
        end
    end
end
function Avatar:SwapPart(character, local_part, source_part)
    if local_part.Name == "HumanoidRootPart" or local_part == character.PrimaryPart then
        return local_part
    end
    local cloned, new_part = Pcall(function()
        return source_part:Clone()
    end)
    if not cloned or not new_part then
        return local_part
    end
    new_part.Name = local_part.Name
    new_part.Anchored = false
    new_part.CFrame = local_part.CFrame
    Pcall(function()
        new_part.CanCollide = local_part.CanCollide
        new_part.CanTouch = local_part.CanTouch
        new_part.CanQuery = local_part.CanQuery
        new_part.Massless = local_part.Massless
        new_part.CustomPhysicalProperties = local_part.CustomPhysicalProperties
        new_part.Transparency = local_part.Transparency
        new_part.CollisionGroup = local_part.CollisionGroup
        new_part.AssemblyLinearVelocity = local_part.AssemblyLinearVelocity
        new_part.AssemblyAngularVelocity = local_part.AssemblyAngularVelocity
    end)
    local attributes = {}
    Pcall(function()
        attributes = local_part:GetAttributes()
    end)
    for name, value in Pairs(attributes) do
        Pcall(function()
            new_part:SetAttribute(name, value)
        end)
    end
    for _, child in Ipairs(new_part:GetChildren()) do
        if
            child:IsA("JointInstance")
            or child:IsA("WeldConstraint")
            or (child:IsA("Attachment") and not child:IsA("Bone"))
        then
            child:Destroy()
        end
    end
    new_part.Parent = character
    for _, child in Ipairs(local_part:GetChildren()) do
        if child:IsA("Attachment") and not child:IsA("Bone") then
            child.Parent = new_part
        elseif
            not (
                child:IsA("Attachment")
                or child:IsA("JointInstance")
                or child:IsA("WeldConstraint")
                or child:IsA("SpecialMesh")
                or child:IsA("Decal")
                or child:IsA("Texture")
                or child:IsA("SurfaceAppearance")
                or child:IsA("WrapTarget")
                or child.Name == "OriginalSize"
                or child.Name == "AvatarPartScaleType"
            )
        then
            Pcall(function()
                child.Parent = new_part
            end)
        end
    end
    Avatar:RelinkJoints(character, local_part, new_part)
    Pcall(function()
        local_part:Destroy()
    end)
    return new_part
end
function Avatar:CopySurfaceLayers(local_part, source_part)
    for _, child in Ipairs(local_part:GetChildren()) do
        if
            child:IsA("SurfaceAppearance")
            or child:IsA("WrapTarget")
            or child:IsA("Bone")
            or child:IsA("FaceControls")
            or child:IsA("Decal")
            or child:IsA("Texture")
        then
            child:Destroy()
        end
    end
    for _, child in Ipairs(source_part:GetChildren()) do
        if
            child:IsA("SurfaceAppearance")
            or child:IsA("WrapTarget")
            or child:IsA("Bone")
            or child:IsA("FaceControls")
            or child:IsA("Decal")
            or child:IsA("Texture")
        then
            Pcall(function()
                local clone = child:Clone()
                if clone then
                    clone.Parent = local_part
                end
            end)
        end
    end
end
function Avatar:CopyPartGeometry(character, local_part, source_part)
    local old_size = local_part.Size
    local source_is_mesh = source_part:IsA("MeshPart")
    if source_is_mesh ~= local_part:IsA("MeshPart") then
        local_part = Avatar:SwapPart(character, local_part, source_part)
        if local_part:IsA("MeshPart") ~= source_is_mesh then
            error("avatar: Body part replacement failed")
        end
    elseif source_is_mesh and not Pcall(function()
        local_part:ApplyMesh(source_part)
    end) then
        local previous = local_part
        local_part = Avatar:SwapPart(character, local_part, source_part)
        if local_part == previous then
            error("avatar: Mesh replacement failed")
        end
    end
    local source_mesh = source_part:FindFirstChildOfClass("SpecialMesh")
    local local_mesh = local_part:FindFirstChildOfClass("SpecialMesh")
    if local_mesh then
        local_mesh:Destroy()
    end
    if source_mesh then
        source_mesh:Clone().Parent = local_part
    end
    Avatar:CopySurfaceLayers(local_part, source_part)
    local_part.Size, local_part.Color, local_part.Material = source_part.Size, source_part.Color, source_part.Material
    if source_is_mesh then
        Pcall(function()
            if local_part.TextureID ~= source_part.TextureID then
                local_part.TextureID = source_part.TextureID
            end
        end)
    end
    Avatar:CopyScalingMetadata(local_part, source_part)
    Avatar:SyncAttachments(local_part, source_part, old_size)
    return local_part
end
function Avatar:CopyBody(character, source_model)
    for _, local_part in Ipairs(character:GetChildren()) do
        if local_part:IsA("BasePart") and local_part.Name ~= "Head" and local_part.Name ~= "HumanoidRootPart" then
            local source_part = source_model:FindFirstChild(local_part.Name)
            if source_part and source_part:IsA("BasePart") then
                Avatar:CopyPartGeometry(character, local_part, source_part)
            end
        end
    end
end
function Avatar:ClearCopyClasses(character)
    for _, child in Ipairs(character:GetChildren()) do
        if Avatar:IsCopyClass(child.ClassName) then
            Pcall(function()
                child:Destroy()
            end)
        end
    end
end
function Avatar:RetargetWeld(weld, character)
    local part0 = weld.Part0
    if part0 and not part0:IsDescendantOf(character) then
        local local_part = character:FindFirstChild(part0.Name)
        if local_part and local_part:IsA("BasePart") then
            weld.Part0 = local_part
        end
    end
    local part1 = weld.Part1
    if part1 and not part1:IsDescendantOf(character) then
        local local_part = character:FindFirstChild(part1.Name)
        if local_part and local_part:IsA("BasePart") then
            weld.Part1 = local_part
        end
    end
end
function Avatar:FitAccessories(character, source_model, accessories)
    for _, entry in Ipairs(accessories) do
        local handle = entry.Local:FindFirstChild("Handle")
        local source_handle = entry.Source:FindFirstChild("Handle")
        if not handle or not source_handle or source_handle:FindFirstChildOfClass("WrapLayer") then
            continue
        end
        local source_weld = source_handle:FindFirstChild("AccessoryWeld")
        local source_body = source_weld and source_weld.Part0
        local body = source_body and source_body.Parent == source_model and character:FindFirstChild(source_body.Name)
        if not body or not body:IsA("BasePart") then
            continue
        end
        local base_size, size = source_body.Size, body.Size
        local x, y, z = size.X / Max(base_size.X, 1e-6), size.Y / Max(base_size.Y, 1e-6), size.Z / Max(base_size.Z, 1e-6)
        local ratio = Vector3New(x, y, z)
        handle.Size = source_handle.Size * ratio
        local mesh, source_mesh =
            handle:FindFirstChildOfClass("SpecialMesh"), source_handle:FindFirstChildOfClass("SpecialMesh")
        if mesh and source_mesh then
            mesh.Scale, mesh.Offset = source_mesh.Scale * ratio, source_mesh.Offset * ratio
        end
        for _, attachment in Ipairs(source_handle:GetChildren()) do
            if attachment:IsA("Attachment") and not attachment:IsA("Bone") then
                local local_attachment = handle:FindFirstChild(attachment.Name)
                if local_attachment and local_attachment:IsA("Attachment") then
                    local_attachment.CFrame = Avatar:ScaleJointCFrame(attachment.CFrame, x, y, z)
                end
            end
        end
        local weld = handle:FindFirstChild("AccessoryWeld")
        if weld and weld:IsA("Weld") then
            weld.Part0, weld.Part1 = body, handle
            weld.C0 = Avatar:ScaleJointCFrame(source_weld.C0, x, y, z)
            weld.C1 = Avatar:ScaleJointCFrame(source_weld.C1, x, y, z)
            for _, attachment in Ipairs(source_handle:GetChildren()) do
                if attachment:IsA("Attachment") and not attachment:IsA("Bone") then
                    local body_attachment = body:FindFirstChild(attachment.Name)
                    local handle_attachment = handle:FindFirstChild(attachment.Name)
                    if body_attachment and body_attachment:IsA("Attachment") and handle_attachment then
                        weld.C0, weld.C1 = body_attachment.CFrame, handle_attachment.CFrame
                        break
                    end
                end
            end
            handle.CFrame = body.CFrame * weld.C0 * weld.C1:Inverse()
        end
    end
end
function Avatar:NumericId(raw_id)
    if raw_id == nil then
        return nil
    end
    local numeric = Tonumber(Tostring(raw_id):match("%d+"))
    if numeric and numeric > 0 then
        return numeric
    end
    return nil
end
function Avatar:ApplyHead(character, body_source)
    local head, source_head = character:FindFirstChild("Head"), body_source:FindFirstChild("Head")
    if head and source_head then
        Avatar:CopyPartGeometry(character, head, source_head)
    end
end
function Avatar:GetAnimMapFromAnimate(animate)
    local map = {}
    if not animate then
        return map
    end
    for _, child in Ipairs(animate:GetChildren()) do
        if Avatar.AnimationStates[child.Name] then
            local entry = { ByName = {}, Order = {} }
            local list = child:IsA("Animation") and { child } or child:GetDescendants()
            for _, animation in Ipairs(list) do
                if animation:IsA("Animation") then
                    local id = Avatar:NumericId(animation.AnimationId)
                    if id then
                        entry.Order[#entry.Order + 1] = id
                        if entry.ByName[animation.Name] == nil then
                            entry.ByName[animation.Name] = id
                        end
                    end
                end
            end
            if entry.Order[1] then
                map[child.Name] = entry
            end
        end
    end
    return map
end
function Avatar:GetTargetCharacterAnimate(user_id)
    local ok, target = Pcall(function()
        return Players:GetPlayerByUserId(Tonumber(user_id))
    end)
    if ok and target and target.Character then
        return target.Character:FindFirstChild("Animate")
    end
    return nil
end
function Avatar:BackupDescription(humanoid, hd)
    if Avatar.DescriptionBackups[humanoid] then
        return
    end
    local backup = { Props = {} }
    Pcall(function()
        backup.Emotes = hd:GetEmotes()
    end)
    Pcall(function()
        backup.Equipped = hd:GetEquippedEmotes()
    end)
    for _, prop in Ipairs(Avatar.DescriptionAnimationProps) do
        Pcall(function()
            backup.Props[prop] = hd[prop]
        end)
    end
    Avatar.DescriptionBackups[humanoid] = backup
end
function Avatar:RestoreDescription(humanoid, options)
    local backup = humanoid and Avatar.DescriptionBackups[humanoid]
    local hd = backup and humanoid:FindFirstChildOfClass("HumanoidDescription")
    if not hd then
        return
    end
    if not (options and options.Emotes) then
        if backup.Emotes then
            Pcall(function()
                hd:SetEmotes(backup.Emotes)
            end)
        end
        if backup.Equipped then
            Pcall(function()
                hd:SetEquippedEmotes(backup.Equipped)
            end)
        end
    end
    if not (options and options.Animations) then
        for prop, value in Pairs(backup.Props) do
            Pcall(function()
                hd[prop] = value
            end)
        end
    end
end
function Avatar:UpdateLocalHumanoidDescription(humanoid, target_description, options)
    local hd = humanoid:FindFirstChildOfClass("HumanoidDescription")
    if not hd then
        hd = humanoid:GetAppliedDescription()
        hd.Parent = humanoid
    end
    Avatar:BackupDescription(humanoid, hd)
    if options.Emotes then
        Pcall(function()
            hd:SetEmotes(target_description:GetEmotes())
        end)
        Pcall(function()
            hd:SetEquippedEmotes(target_description:GetEquippedEmotes())
        end)
    end
    if options.Animations then
        for _, prop in Ipairs(Avatar.DescriptionAnimationProps) do
            Pcall(function()
                hd[prop] = target_description[prop]
            end)
        end
    end
end
function Avatar:RestartAnimate(animate_script, request, extra_ids)
    local character = animate_script.Parent
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
    local function current()
        return animate_script.Parent == character and (request == nil or Avatar.Requests[character] == request)
    end
    local function stop_owned_tracks()
        if not animator then
            return
        end
        for _, track in Ipairs(animator:GetPlayingAnimationTracks()) do
            local animation = track.Animation
            if
                animation
                and (
                    animation:IsDescendantOf(animate_script)
                    or (extra_ids and extra_ids[Avatar:NumericId(animation.AnimationId)])
                )
            then
                track:Stop(0.1)
            end
        end
    end
    stop_owned_tracks()
    if animate_script.Disabled then
        return
    end
    animate_script.Disabled = true
    Delay(0.05, function()
        if animate_script.Parent == character then
            animate_script.Disabled = false
        end
        for _ = 1, 3 do
            Wait(0.3)
            if not current() or not humanoid or humanoid.Health <= 0 or not animator then
                return
            end
            local root = character:FindFirstChild("HumanoidRootPart")
            local velocity = root and root.AssemblyLinearVelocity or Vector3Zero
            local moving = Vector3New(velocity.X, 0, velocity.Z).Magnitude > 4
                and humanoid.MoveDirection.Magnitude > 0.1
            if not moving then
                return
            end
            for _, track in Ipairs(animator:GetPlayingAnimationTracks()) do
                local animation = track.Animation
                local group = animation and animation.Parent
                if
                    group
                    and animation:IsDescendantOf(animate_script)
                    and (group.Name == "walk" or group.Name == "run")
                then
                    return
                end
            end
            stop_owned_tracks()
            animate_script.Disabled = true
            Wait(0.05)
            if animate_script.Parent == character then
                animate_script.Disabled = false
            end
        end
    end)
end
function Avatar:ApplyAnimations(animate_script, movement_map, request)
    if not animate_script or not (movement_map and Next(movement_map)) then
        return
    end
    local replaced_ids = {}
    local changed = false
    for state, entry in Pairs(movement_map) do
        local state_obj = animate_script:FindFirstChild(state)
        if state_obj then
            local list = state_obj:IsA("Animation") and { state_obj } or state_obj:GetDescendants()
            local index = 0
            for _, animation in Ipairs(list) do
                if animation:IsA("Animation") then
                    index += 1
                    local id = entry.ByName[animation.Name] or entry.Order[index] or entry.Order[1]
                    local old_id = Avatar:NumericId(animation.AnimationId)
                    if id and old_id ~= id then
                        if Avatar.OriginalAnimationIds[animation] == nil then
                            Avatar.OriginalAnimationIds[animation] = animation.AnimationId
                        end
                        if old_id then
                            replaced_ids[old_id] = true
                        end
                        animation.AnimationId = Avatar.AnimIdUrl .. id
                        changed = true
                    end
                end
            end
        end
    end
    if changed then
        Avatar:RestartAnimate(animate_script, request, replaced_ids)
    end
end
function Avatar:RestoreAnimations(character)
    local animate_script = character and character:FindFirstChild("Animate")
    if not animate_script then
        return
    end
    local old_ids, changed = {}, false
    for _, animation in Ipairs(animate_script:GetDescendants()) do
        local original = animation:IsA("Animation") and Avatar.OriginalAnimationIds[animation]
        if original then
            local id = Avatar:NumericId(animation.AnimationId)
            if id then
                old_ids[id] = true
            end
            animation.AnimationId = original
            Avatar.OriginalAnimationIds[animation] = nil
            changed = true
        end
    end
    if changed then
        Avatar:RestartAnimate(animate_script, nil, old_ids)
    end
end
function Avatar:ApplyAppearance(character, user_id, options, request)
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local function current()
        return character == Self.Character
            and character.Parent
            and humanoid
            and humanoid.Parent == character
            and humanoid.Health > 0
            and Avatar.Requests[character] == request
    end
    if not current() then
        return false
    end
    user_id = Avatar:ResolveUserId(user_id)
    if not user_id then
        error("avatar: Invalid target user")
    end
    local description, source_model
    local saved_neck, saved_scaling, changed_rig
    local ok, result = Pcall(function()
        description, source_model = Avatar:GetSource(user_id, humanoid.RigType, options)
        if not current() then
            return false
        end
        local body_ok, body_result = true, nil
        if options.Body then
            body_ok, body_result = Pcall(function()
                local deadline = Clock() + 15
                while
                    current()
                    and (
                        humanoid.PlatformStand
                        or self_knocked()
                        or humanoid:GetState() == Enum.HumanoidStateType.Physics
                        or humanoid:GetState() == Enum.HumanoidStateType.Ragdoll
                    )
                do
                    if Clock() >= deadline then
                        error("avatar: Wait until your character leaves ragdoll, then retry")
                    end
                    Wait()
                end
                if not current() then
                    return false
                end
                Avatar.BodyRequests[character] = request
                if Avatar.JointSyncCleanup[character] then
                    Avatar.JointSyncCleanup[character]()
                end
                if Avatar.RagdollCleanup[character] then
                    Avatar.RagdollCleanup[character]()
                end
                local source_humanoid = source_model:FindFirstChildOfClass("Humanoid")
                if not source_humanoid or source_humanoid.RigType ~= humanoid.RigType then
                    error("avatar: Incompatible source rig")
                end
                local anchors = Avatar:CaptureJointAnchors(character)
                saved_neck, saved_scaling = humanoid.RequiresNeck, humanoid.AutomaticScalingEnabled
                changed_rig = true
                humanoid.RequiresNeck, humanoid.AutomaticScalingEnabled = false, false
                for key, name in Pairs(Avatar.BodyScaleMap) do
                    local value = humanoid:FindFirstChild(name)
                    if value and value:IsA("NumberValue") then
                        value.Value = description[key]
                    end
                end
                Avatar:CopyBody(character, source_model)
                Avatar:ApplyHead(character, source_model)
                local stale_headless = Avatar.HeadlessCleanup[character]
                if stale_headless then
                    Pcall(stale_headless)
                    Pcall(Avatar.FakeHeadless, Avatar, character)
                end
                if character:FindFirstChild("KorbloxMeshParts") then
                    Pcall(Avatar.FakeKorblox, Avatar, character)
                end
                local root, source_root =
                    character:FindFirstChild("HumanoidRootPart"), source_model:FindFirstChild("HumanoidRootPart")
                if root and source_root then
                    local old_size = root.Size
                    root.Size = source_root.Size
                    Avatar:CopyScalingMetadata(root, source_root)
                    Avatar:SyncAttachments(root, source_root, old_size)
                end
                local joint_sources = Avatar:SyncJoints(character, source_model)
                Avatar:RestoreJointAnchors(anchors)
                humanoid.HipHeight = source_humanoid.HipHeight
                Avatar:ClearCopyClasses(character)
                local accessories = {}
                for _, child in Ipairs(source_model:GetChildren()) do
                    if Avatar:IsCopyClass(child.ClassName) then
                        local clone = child:Clone()
                        clone.Parent = character
                        if child:IsA("Accessory") or child:IsA("Hat") then
                            accessories[#accessories + 1] = { Local = clone, Source = child }
                        end
                        for _, joint in Ipairs(clone:GetDescendants()) do
                            if joint:IsA("JointInstance") or joint:IsA("WeldConstraint") then
                                Avatar:RetargetWeld(joint, character)
                            end
                        end
                    end
                end
                humanoid.AutomaticScalingEnabled = saved_scaling
                humanoid.RequiresNeck = saved_neck
                changed_rig = false
                Avatar:FitAccessories(character, source_model, accessories)
                Wait(0.05)
                if not current() then
                    return false
                end
                Avatar:FitAccessories(character, source_model, accessories)
                Avatar:RestoreJointAnchors(anchors)
                if options.Own then
                    Avatar.BodyRequests[character] = nil
                else
                    Avatar:WatchJointSync(character, joint_sources, request)
                    Avatar:WatchRagdoll(character, request)
                end
                return nil
            end)
        end
        if not current() then
            return false
        end
        Avatar:UpdateLocalHumanoidDescription(humanoid, description, options)
        if options.Animations and source_model then
            local movement_map = Avatar:GetAnimMapFromAnimate(source_model:FindFirstChild("Animate"))
            local target_animate = Avatar:GetTargetCharacterAnimate(user_id)
            local target_humanoid = target_animate and target_animate.Parent:FindFirstChildOfClass("Humanoid")
            if target_humanoid and target_humanoid.RigType == humanoid.RigType then
                for state, entry in Pairs(Avatar:GetAnimMapFromAnimate(target_animate)) do
                    if movement_map[state] == nil then
                        movement_map[state] = entry
                    end
                end
            end
            Avatar:ApplyAnimations(character:FindFirstChild("Animate"), movement_map, request)
        end
        if current() and options.Body then
            Avatar:ApplyFakeCosmetics(character)
        end
        if not body_ok then
            error(body_result)
        end
        return current() and true or false
    end)
    if changed_rig and humanoid.Parent then
        Pcall(function()
            humanoid.AutomaticScalingEnabled = saved_scaling
        end)
        Pcall(function()
            humanoid.RequiresNeck = saved_neck
        end)
    end
    if not ok then
        error(result)
    end
    return result
end
function Avatar:ApplyToCharacter(character)
    if not character then
        return
    end
    local settings = Config.Values["Character"] and Config.Values["Character"]["Avatar Changer"] or {}
    local request = {}
    Avatar.Requests[character] = request
    local options = settings.Enabled and Avatar:Options(settings) or nil
    if not (options and options.Animations) then
        Avatar:RestoreAnimations(character)
    end
    Avatar:RestoreDescription(character:FindFirstChildOfClass("Humanoid"), options)
    local own_options
    if Avatar.BodyRequests[character] ~= nil and not (options and options.Body) then
        own_options = { Body = true, Animations = false, Emotes = false, BodyType = "Normal", Own = true }
    end
    if not options and not own_options then
        return
    end
    local user_id = settings.Target
    local function rig_signature()
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid or not character:FindFirstChild("HumanoidRootPart") or not character:FindFirstChild("Head") then
            return nil
        end
        local names = {}
        for _, joint in Ipairs(character:GetDescendants()) do
            if joint:IsA("Motor6D") then
                local part0, part1 = joint.Part0, joint.Part1
                if part0 and part1 and part0.Parent == character and part1.Parent == character then
                    names[#names + 1] = joint.Name .. ":" .. part0.Name .. ":" .. part1.Name
                elseif not (part0 and part1) then
                    local owner = joint.Parent
                    if owner and owner.Parent == character and owner:IsA("BasePart") then
                        return nil
                    end
                end
            end
        end
        if #names < (humanoid.RigType == Enum.HumanoidRigType.R15 and 15 or 6) then
            return nil
        end
        TableSort(names)
        return TableConcat(names, "|")
    end
    Spawn(function()
        Pcall(function()
            local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
            if not humanoid then
                return
            end
            if own_options then
                Avatar:Prefetch(Self.UserId, humanoid.RigType, own_options)
            end
            if options then
                Avatar:Prefetch(user_id, humanoid.RigType, options)
            end
            local known = Avatar.StableRigs[character]
            local deadline, last_signature, stable_samples = Clock() + 10, nil, 0
            while Self.Character == character and Avatar.Requests[character] == request and Clock() < deadline do
                local signature = Self:HasAppearanceLoaded() and rig_signature()
                if signature and (signature == last_signature or signature == known) then
                    stable_samples = signature == known and 3 or stable_samples + 1
                else
                    stable_samples = 0
                end
                last_signature = signature
                if stable_samples >= 3 then
                    break
                end
                Wait(0.1)
            end
            if stable_samples >= 3 then
                Avatar.StableRigs[character] = last_signature
            end
            if stable_samples >= 3 and own_options then
                for attempt = 1, 3 do
                    if Self.Character ~= character or Avatar.Requests[character] ~= request then
                        return
                    end
                    local applied, result = Pcall(function()
                        return Avatar:ApplyAppearance(character, Self.UserId, own_options, request)
                    end)
                    if applied and result then
                        break
                    end
                    if attempt < 3 then
                        Wait(attempt * 0.25)
                    end
                end
            end
            if not options then
                return
            end
            if stable_samples >= 3 then
                for attempt = 1, 3 do
                    if Self.Character ~= character or Avatar.Requests[character] ~= request then
                        return
                    end
                    local applied, result = Pcall(function()
                        return Avatar:ApplyAppearance(character, user_id, options, request)
                    end)
                    if applied and result then
                        return
                    end
                    if attempt < 3 then
                        Wait(attempt * 0.25)
                    end
                end
            end
            if options.Body and Self.Character == character and Avatar.Requests[character] == request then
                Avatar:ApplyFakeCosmetics(character)
            end
        end)
    end)
end
function Avatar:FakeHeadless(character)
    if not character then
        return
    end
    if Avatar.HeadlessCleanup[character] then
        Avatar.HeadlessCleanup[character](true)
    end
    local head = character:FindFirstChild("Head")
    if not head then
        return
    end
    local face = head:FindFirstChild("face") or head:FindFirstChild("Face")
    if face then
        face.Parent = nil
    end
    local mesh = head:FindFirstChildOfClass("SpecialMesh")
    if mesh then
        mesh.Parent = nil
    end
    local function enforce()
        if head.Transparency ~= 1 then
            head.Transparency = 1
        end
    end
    enforce()
    local connection = Runtime:Connect("Avatar", head:GetPropertyChangedSignal("Transparency"), enforce)
    Avatar.HeadlessCleanup[character] = function(restore)
        connection:Disconnect()
        Avatar.HeadlessCleanup[character] = nil
        if not restore then
            return
        end
        head.Transparency = 0
        if face and not (head:FindFirstChild("face") or head:FindFirstChild("Face")) then
            face.Parent = head
        end
        if mesh and not head:FindFirstChildOfClass("SpecialMesh") then
            mesh.Parent = head
        end
    end
end
function Avatar:FakeKorblox(character)
    if not character then
        return
    end
    local existing = character:FindFirstChild("KorbloxMeshParts")
    if existing then
        existing:Destroy()
    end
    local right_upper = character:FindFirstChild("RightUpperLeg")
    local right_lower = character:FindFirstChild("RightLowerLeg")
    local right_foot = character:FindFirstChild("RightFoot")
    local folder = InstanceNew("Folder")
    folder.Name = "KorbloxMeshParts"
    folder.Parent = character
    local function create_mesh_part(parent, mesh_id, texture_id)
        local part = InstanceNew("Part")
        part.Size = Vector3New(1, 1, 1)
        part.Transparency = 0
        part.CanCollide = false
        part.CanQuery = false
        part.CanTouch = false
        part.CastShadow = false
        part.Anchored = true
        part.CFrame = parent.CFrame
        part.Parent = folder
        local mesh = InstanceNew("SpecialMesh")
        mesh.MeshType = Enum.MeshType.FileMesh
        mesh.MeshId = mesh_id
        mesh.TextureId = texture_id
        mesh.Scale = Vector3New(0.6, 1.13, 0.6)
        mesh.Offset = Vector3New(0, 0.25, 0)
        mesh.Parent = part
        local conn
        conn = Runtime:Connect("Avatar", RunService.RenderStepped, function()
            if part.Parent and parent.Parent == character and character.Parent then
                part.CFrame = parent.CFrame
            else
                conn:Disconnect()
                if part.Parent then
                    part:Destroy()
                end
            end
        end)
    end
    if right_upper then
        right_upper.Transparency = 1
        create_mesh_part(
            right_upper,
            "http://www.roblox.com/asset/?id=902942096",
            "http://www.roblox.com/asset/?id=902843398"
        )
    end
    if right_lower then
        right_lower.Transparency = 1
    end
    if right_foot then
        right_foot.Transparency = 1
    end
end
function Avatar:ApplyFakeCosmetics(character)
    if not character then
        return
    end
    local cfg = Config.Values["Character"]
    if not cfg then
        return
    end
    local headless_enabled = cfg["Headless"]
    local korblox_enabled = cfg["Korblox"]
    Spawn(function()
        if not Runtime.Alive or Self.Character ~= character or not character.Parent then
            return
        end
        local current_cfg = Config.Values["Character"]
        if not (current_cfg and current_cfg["Headless"]) and Avatar.HeadlessCleanup[character] then
            Avatar.HeadlessCleanup[character](true)
        end
        if not (current_cfg and current_cfg["Korblox"]) then
            local folder = character:FindFirstChild("KorbloxMeshParts")
            if folder then
                folder:Destroy()
                for _, name in Ipairs({ "RightUpperLeg", "RightLowerLeg", "RightFoot" }) do
                    local leg = character:FindFirstChild(name)
                    if leg then
                        leg.Transparency = 0
                    end
                end
            end
        end
        if headless_enabled and current_cfg and current_cfg["Headless"] then
            local ok, head = Pcall(function()
                return character:WaitForChild("Head", 5)
            end)
            if ok and head and Self.Character == character and character.Parent then
                Wait(0.05)
                current_cfg = Config.Values["Character"]
                if
                    Runtime.Alive
                    and Self.Character == character
                    and character.Parent
                    and current_cfg
                    and current_cfg["Headless"]
                then
                    Avatar:FakeHeadless(character)
                end
            end
        end
        current_cfg = Config.Values["Character"]
        if korblox_enabled and current_cfg and current_cfg["Korblox"] then
            Pcall(function()
                character:WaitForChild("RightUpperLeg", 5)
            end)
            Pcall(function()
                character:WaitForChild("RightLowerLeg", 5)
            end)
            Pcall(function()
                character:WaitForChild("RightFoot", 5)
            end)
            Wait(0.05)
            current_cfg = Config.Values["Character"]
            if
                Runtime.Alive
                and Self.Character == character
                and character.Parent
                and current_cfg
                and current_cfg["Korblox"]
            then
                Avatar:FakeKorblox(character)
            end
        end
    end)
end
function Avatar:ConfigSignature()
    local cfg = Config.Values["Character"]
    if Type(cfg) ~= "table" then
        return "", ""
    end
    local spoofer = Type(cfg["Avatar Changer"]) == "table" and cfg["Avatar Changer"] or {}
    return TableConcat({
        Tostring(spoofer.Enabled),
        Tostring(spoofer.Target),
        Tostring(spoofer.Mode),
        Tostring(spoofer["Body Type"]),
    }, "|"),
        Tostring(cfg["Headless"]) .. "|" .. Tostring(cfg["Korblox"])
end
function Avatar:Apply(character)
    Avatar.AppliedSignature, Avatar.AppliedCosmetics = Avatar:ConfigSignature()
    local cfg = Config.Values["Character"]
    if not cfg then
        return
    end
    local spoofer = cfg["Avatar Changer"] or {}
    local mode = spoofer.Mode or "Full"
    local applied = Pcall(Avatar.ApplyToCharacter, Avatar, character)
    if not applied or not spoofer.Enabled or (mode ~= "Full" and mode ~= "Character") then
        Avatar:ApplyFakeCosmetics(character)
    end
end
function Avatar:Start()
    if Self.Character then
        Spawn(function()
            Avatar:Apply(Self.Character)
        end)
    end
    Runtime:Connect("Avatar", Self.CharacterAdded, function(character)
        Avatar:Apply(character)
    end)
    Runtime:Connect("Avatar", Self.CharacterRemoving, function(character)
        Avatar.Requests[character] = nil
        Avatar.BodyRequests[character] = nil
        Avatar.StableRigs[character] = nil
        if Avatar.RagdollCleanup[character] then
            Avatar.RagdollCleanup[character]()
        end
        if Avatar.JointSyncCleanup[character] then
            Avatar.JointSyncCleanup[character]()
        end
        if Avatar.HeadlessCleanup[character] then
            Avatar.HeadlessCleanup[character]()
        end
    end)
    task.spawn(function()
        while true do
            Wait(0.5)
            Pcall(function()
                local signature, cosmetics = Avatar:ConfigSignature()
                if signature == Avatar.AppliedSignature then
                    if cosmetics == Avatar.AppliedCosmetics then
                        return
                    end
                    Avatar.AppliedCosmetics = cosmetics
                    if Self.Character then
                        Avatar:ApplyFakeCosmetics(Self.Character)
                    end
                    return
                end
                if Self.Character then
                    Spawn(function()
                        Avatar:Apply(Self.Character)
                    end)
                end
            end)
        end
    end)
end
local function avatar_unload()
    table.clear(Avatar.Requests)
    for key, cached in Pairs(Avatar.SourceCache) do
        Avatar.SourceCache[key] = nil
        if cached.SourceModel then
            Pcall(function()
                cached.SourceModel:Destroy()
            end)
        end
    end
    local character = Self.Character
    if not character then
        return
    end
    Pcall(Avatar.RestoreAnimations, Avatar, character)
    Pcall(Avatar.RestoreDescription, Avatar, character:FindFirstChildOfClass("Humanoid"), nil)
    if Avatar.HeadlessCleanup[character] then
        Avatar.HeadlessCleanup[character](true)
    end
    local korblox = character:FindFirstChild("KorbloxMeshParts")
    if not korblox then
        return
    end
    korblox:Destroy()
    for _, name in Ipairs({ "RightUpperLeg", "RightLowerLeg", "RightFoot" }) do
        local part = character:FindFirstChild(name)
        if part then
            part.Transparency = 0
        end
    end
end
local function avatar_start()
    Avatar:Start()
end
task.spawn(function()
    pcall(avatar_start)
end)
local function full_unload()
    if getgenv().adderall_unloading then return end
    getgenv().adderall_unloading = true
    if fov_circle and fov_circle.Remove then
        pcall(function() fov_circle:Remove() end)
    end
    if trigger_fov_circle and trigger_fov_circle.Remove then
        pcall(function() trigger_fov_circle:Remove() end)
    end
    for _, conn in ipairs(script_connections) do
        if conn and conn.Disconnect then
            pcall(function() conn:Disconnect() end)
        end
    end
    table.clear(script_connections)
    pcall(skinchanger_unload)
    pcall(avatar_unload)
    pcall(bullet_tp.restore)
    pcall(function()
        if das_map_wallbang and das_map_wallbang.moved and das_map_wallbang.original then
            local ignored_folder = workspace:FindFirstChild("Ignored")
            local map = ignored_folder and ignored_folder:FindFirstChild("MAP")
            if map then map.Parent = das_map_wallbang.original end
        end
    end)
    pcall(function()
        run_service:UnbindFromRenderStep("adderall_camlock")
    end)
    pcall(function()
        if ESP and type(ESP.Unload) == "function" then
            ESP:Unload()
        end
    end)
    pcall(function()
        local web = (type(getgenv) == "function" and getgenv().adderall_web) or nil
        if web and type(web.stop) == "function" then
            web.stop()
        end
    end)
    getgenv().adderall_unloading = nil
end
getgenv().adderall_unload = full_unload
getgenv().Adderall_Unload = full_unload
task.spawn(function()
    ESP:Load()
    if LuaEngine and type(LuaEngine.LoadAll) == "function" then
        pcall(LuaEngine.LoadAll)
    end
end)
pcall(function() web_config.publish_executed(false) end)
return ESP
end)()
return ESP
