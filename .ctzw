}
function game_support.flatten(name)
    return (tostring(name or ""):lower():gsub(".", game_support.lookalikes):gsub("[^%a]", ""))
end
do
    local rule_names = {}
    for profile_name, _ in pairs(game_support.profiles) do
        table.insert(rule_names, profile_name)
    end
    for alias, target in pairs(game_support.aliases) do
        if game_support.profiles[target] then
            table.insert(rule_names, alias)
            game_support.profiles[alias] = game_support.profiles[target]
        end
    end
    table.sort(rule_names, function(a, b) return #a > #b end)
    for _, rn in ipairs(rule_names) do
        table.insert(game_support.rules, { flat = game_support.flatten(rn), key = rn })
    end
end
function game_support.detect()
    local place_key = game_support.place_ids[game.PlaceId]
    if place_key and game_support.profiles[place_key] then
        game_support.current = game_support.profiles[place_key]
        return game_support.current
    end
    if replicated_storage:FindFirstChild("MAINEVENT") then
        game_support.current = game_support.profiles["void falls"]
        return game_support.current
    end
    if replicated_storage:FindFirstChild("GameRemotes") and replicated_storage.GameRemotes:FindFirstChild("MainGameEvent") then
        game_support.current = game_support.profiles["des hood"]
        return game_support.current
    end
    if replicated_storage:FindFirstChild("MainBindedEvent") or workspace:FindFirstChild("Players") or (workspace:FindFirstChild("Ignored") and workspace.Ignored:FindFirstChild("Shop")) then
        game_support.current = game_support.profiles["hood customs"]
        return game_support.current
    end
    if replicated_storage:FindFirstChild("MainEvent") then
        game_support.current = game_support.profiles["da hood"]
        return game_support.current
    end
    local ok, info = pcall(function()
        return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
    end)
    if ok and type(info) == "table" and type(info.Name) == "string" then
        local flat = game_support.flatten(info.Name)
        if flat ~= "" then
            for _, rule in ipairs(game_support.rules) do
                if flat:find(rule.flat, 1, true) then
                    game_support.current = game_support.profiles[rule.key]
                    return game_support.current
                end
            end
        end
    end
    return nil
end
function game_support.get_current()
    if not game_support.current then
        game_support.detect()
    end
    return game_support.current or game_support.profiles["da hood"]
end
function game_support.is(name)
    local cur = game_support.get_current()
    local n = tostring(name or ""):lower()
    return cur ~= nil and (cur.name == n or cur.name:find(n, 1, true) ~= nil)
end
function game_support.uses(method)
    local cur = game_support.get_current()
    local m = tostring(method or ""):lower()
    if not cur then return false end
    if cur.method and cur.method:lower() == m then return true end
    if cur.category and cur.category:lower() == m then return true end
    return false
end
function game_support.supports_weapon_mods()
    local cur = game_support.get_current()
    if not cur then
        if replicated_storage:FindFirstChild("MainBindedEvent")
            or replicated_storage:FindFirstChild("MAINEVENT")
            or workspace:FindFirstChild("Players")
            or (workspace:FindFirstChild("Ignored") and workspace.Ignored:FindFirstChild("Shop"))
        then
            return false
        end
        return true
    end
    if cur.rewrite_gun == false then return false end
    if game_support.uses("hoodcustoms") or game_support.uses("voidfalls") then return false end
    if game_support.is("hood customs") or game_support.is("void falls") then return false end
    return true
end
function game_support.get_remote(name)
    local n = tostring(name or "")
    local nl = n:lower()
    if game_support.uses("voidfalls") and (nl == "voidfalls" or nl == "mainevent") then
        local vf = replicated_storage:FindFirstChild("MAINEVENT")
        if vf then return vf end
    end
    if game_support.uses("hoodcustoms") and (nl == "mainevent" or nl == "mainbindedevent") then
        local hc = replicated_storage:FindFirstChild("MainEvent") or replicated_storage:FindFirstChild("MainBindedEvent")
        if hc then return hc end
    end
    if nl == "deshood" or nl == "maingameevent" then
        local gr = replicated_storage:FindFirstChild("GameRemotes")
        if gr then
            local mg = gr:FindFirstChild("MainGameEvent")
            if mg then return mg end
        end
    end
    local r = replicated_storage:FindFirstChild(n)
    if r then return r end
    for _, child in ipairs(replicated_storage:GetChildren()) do
        if child.Name:lower() == nl then return child end
    end
    return nil
end
function game_support.slow_walk(tool, amount)
    local char = local_player.Character
    local effects = char and char:FindFirstChild("BodyEffects")
    local movement = effects and effects:FindFirstChild("Movement")
    if not movement then return end
    local cd = tool and tool:FindFirstChild("ShootingCooldown")
    local duration = tonumber(cd and cd.Value) or 0.3
    local value = Instance.new("NumberValue")
    value.Name = "ReduceWalk"
    value.Value = amount
    value.Parent = movement
    game:GetService("Debris"):AddItem(value, duration)
end
