        master_enabled = false
    end
    local boxes_cfg = (esp_cfg and esp_cfg["Boxes"]) or (rage_esp_cfg and rage_esp_cfg["Boxes"]) or ESPConfig.Boxes
    local distance_cfg = (esp_cfg and esp_cfg["Distance"]) or (rage_esp_cfg and rage_esp_cfg["Distance"]) or ESPConfig.Distance
    local weapon_cfg = (esp_cfg and esp_cfg["Weapon"]) or (rage_esp_cfg and rage_esp_cfg["Weapon"]) or ESPConfig.Weapon
    local font_cfg = (visuals and visuals["Fonts"]) or (club and club["Fonts"]) or (esp_cfg and esp_cfg["Font"]) or ESPConfig.Font
    ConfigCache.nameEnabled = master_enabled and name_cfg and name_cfg["Enabled"] == true
    ConfigCache.healthEnabled = master_enabled and health_cfg and health_cfg["Enabled"] == true
    ConfigCache.armorEnabled = master_enabled and armor_cfg and armor_cfg["Enabled"] == true
    ConfigCache.boxesEnabled = false
    ConfigCache.distanceEnabled = false
    ConfigCache.weaponEnabled = false
    ConfigCache.masterEspEnabled = master_enabled
    local numbers_flag = true
    if esp_cfg and esp_cfg["Numbers"] == false then
        numbers_flag = false
    elseif visuals and visuals["Numbers"] == false then
        numbers_flag = false
    elseif visuals and type(visuals["ESP"]) == "table" and visuals["ESP"]["Numbers"] == false then
        numbers_flag = false
    elseif health_cfg and health_cfg["Numbers"] == false then
        numbers_flag = false
    elseif esp_cfg and esp_cfg["Numbers"] == true then
        numbers_flag = true
    elseif visuals and visuals["Numbers"] == true then
        numbers_flag = true
    end
    ConfigCache.numbersEnabled = numbers_flag
    ConfigCache.esp_cfg = esp_cfg
    ConfigCache.visuals = visuals
    ConfigCache.rageEspEnabled = esp_enabled
    ConfigCache.nameCfg = name_cfg
    ConfigCache.healthCfg = health_cfg
    ConfigCache.armorCfg = armor_cfg
    ConfigCache.boxesCfg = boxes_cfg
    ConfigCache.distanceCfg = distance_cfg
    ConfigCache.weaponCfg = weapon_cfg
    ConfigCache.fontCfg = font_cfg
    ConfigCache.club = club
    ConfigCache.visuals = visuals
    ConfigCache.rageEspCfg = rage_esp_cfg
    ConfigCache.esp_cfg = esp_cfg
    return true
end
local function resolve_name_position()
    local name_cfg = ConfigCache.nameCfg
    local position = name_cfg and (name_cfg.Position or name_cfg.Side) or "Top"
    if tostring(position):lower() ~= "bottom" then position = "Top" else position = "Bottom" end
    resolvedStruct.NamePosition = position
    resolvedStruct.NameEnabled = ConfigCache.nameEnabled
end
local function resolve_name_size()
    local nameCfg = ConfigCache.nameCfg
    local fontCfg = ConfigCache.fontCfg or ESPConfig.Font
    local a = tonumber(fontCfg and (fontCfg.Size or fontCfg['Size']))
    local b = tonumber(fontCfg and fontCfg["ESP Names"] and type(fontCfg["ESP Names"]) == "table" and fontCfg["ESP Names"][3])
    local c = tonumber(nameCfg and (nameCfg.Size or nameCfg['Size']))
    resolvedStruct.NameSize = a or b or c or 13
end
local function resolve_name_style()
    local nameCfg = ConfigCache.nameCfg
    local fontCfg = ConfigCache.fontCfg or ESPConfig.Font
    local defaultFont = (type(fontCfg) == "string" and fontCfg) or (type(fontCfg) == "table" and (fontCfg.Value or (fontCfg["ESP Names"] and type(fontCfg["ESP Names"]) == "table" and fontCfg["ESP Names"][2]) or "Proggy Clean")) or "Proggy Clean"
    local nameFont = (nameCfg and (nameCfg.Font or nameCfg['Font'] or nameCfg.FontFace or nameCfg['FontFace'])) or (fontCfg and fontCfg["ESP Names"] and type(fontCfg["ESP Names"]) == "table" and fontCfg["ESP Names"][2]) or (fontCfg and (fontCfg.Value or fontCfg['Value'])) or "Proggy Clean"
    local gradT1 = (nameCfg and nameCfg.Gradient and nameCfg.Gradient.Target and (nameCfg.Gradient.Target['Color 1'] or nameCfg.Gradient.Target['Color1'])) or Color3.fromRGB(143, 174, 211)
    local gradT2 = (nameCfg and nameCfg.Gradient and nameCfg.Gradient.Target and (nameCfg.Gradient.Target['Color 2'] or nameCfg.Gradient.Target['Color2'])) or Color3.fromRGB(244, 217, 255)
    local gradN1 = (nameCfg and nameCfg.Gradient and nameCfg.Gradient.Neutral and (nameCfg.Gradient.Neutral['Color 1'] or nameCfg.Gradient.Neutral['Color1'])) or Color3.fromRGB(200, 200, 200)
    local gradN2 = (nameCfg and nameCfg.Gradient and nameCfg.Gradient.Neutral and (nameCfg.Gradient.Neutral['Color 2'] or nameCfg.Gradient.Neutral['Color2'])) or Color3.fromRGB(200, 200, 200)
    local name_colors = nameCfg and (nameCfg.Colors or nameCfg['Colors'])
    resolvedStruct.NameFont = nameFont
    resolvedStruct.NameMode = (nameCfg and (nameCfg.Mode or nameCfg['Mode'])) or "Static"
    resolvedStruct.NameStaticTarget = (nameCfg and nameCfg.Static and nameCfg.Static.Target and nameCfg.Static.Target.Color) or (name_colors and (name_colors['Target Color'] or name_colors.Target)) or Color3.fromRGB(255, 170, 200)
    resolvedStruct.NameStaticNeutral = (nameCfg and nameCfg.Static and nameCfg.Static.Neutral and nameCfg.Static.Neutral.Color) or (name_colors and (name_colors['Normal Color'] or name_colors.Normal)) or Color3.fromRGB(255, 255, 255)
    resolvedStruct.NameGradTarget = ColorSequence.new(gradT1, gradT2)
    resolvedStruct.NameGradNeutral = ColorSequence.new(gradN1, gradN2)
    resolvedStruct.NameTransparency = (nameCfg and (nameCfg.Transparency or nameCfg['Transparency'])) or 0
end
local function resolve_health()
    local healthCfg = ConfigCache.healthCfg
    local nameCfg = ConfigCache.nameCfg
    local esp_cfg = ConfigCache.esp_cfg
    local visuals = ConfigCache.visuals
    local fontCfg = ConfigCache.fontCfg or ESPConfig.Font
    local esp_size = (esp_cfg and esp_cfg["Size"]) or (visuals and visuals["Size"])
    local health_size = (healthCfg and healthCfg["Size"]) or (type(esp_size) == "table" and esp_size["Health"]) or (type(esp_size) == "table" and not esp_size["Health"] and not esp_size["Armor"] and esp_size) or nil
    local legacy_mode = (type(health_size) == "table" and health_size["Mode"]) or (healthCfg and healthCfg["Size Mode"]) or "Manual"
    local legacy_l = tostring(legacy_mode):lower()
    local legacy_auto = legacy_l == "automatic" or legacy_l == "auto"
    local tgt_mode_raw = (type(health_size) == "table" and (health_size["Target Mode"] or health_size["target mode"])) or (healthCfg and (healthCfg["Target Mode"] or healthCfg["target mode"])) or legacy_mode
    local nontgt_mode_raw = (type(health_size) == "table" and (health_size["Non Target Mode"] or health_size["non target mode"] or health_size["Non-Target Mode"])) or (healthCfg and (healthCfg["Non Target Mode"] or healthCfg["non target mode"] or healthCfg["Non-Target Mode"])) or legacy_mode
    local tgt_mode_l = tostring(tgt_mode_raw):lower()
    local nontgt_mode_l = tostring(nontgt_mode_raw):lower()
    local tgt_auto = tgt_mode_l == "automatic" or tgt_mode_l == "auto"
    local nontgt_auto = nontgt_mode_l == "automatic" or nontgt_mode_l == "auto"
    if legacy_auto and tgt_mode_raw == legacy_mode then tgt_auto = true end
    if legacy_auto and nontgt_mode_raw == legacy_mode then nontgt_auto = true end
    local tbl_cfg = (type(health_size) == "table" and health_size["Target Size"]) or (healthCfg and healthCfg["Target Size"]) or (esp_cfg and esp_cfg["Target Size"]) or (visuals and visuals["Target Size"]) or 75
    local nbl_cfg = (type(health_size) == "table" and health_size["Non Target Size"]) or (healthCfg and healthCfg["Non Target Size"]) or (esp_cfg and esp_cfg["Non Target Size"]) or (visuals and visuals["Non Target Size"]) or 30
    resolvedStruct.HealthTargetMode_flag = tgt_auto and "Automatic" or "Manual"
    resolvedStruct.HealthNonTargetMode_flag = nontgt_auto and "Automatic" or "Manual"
    resolvedStruct.HealthSizeMode = (tgt_auto and nontgt_auto) and "Automatic" or ((not tgt_auto and not nontgt_auto) and "Manual" or "Mixed")
    resolvedStruct.HealthTargetSize = tonumber(tbl_cfg) or 75.0
    resolvedStruct.HealthNonTargetSize = tonumber(nbl_cfg) or 30.0
    resolvedStruct.TargetBarLength = resolvedStruct.HealthTargetSize
    resolvedStruct.NonTargetBarLength = nontgt_auto and "auto" or resolvedStruct.HealthNonTargetSize
    local hpPos = tostring((healthCfg and (healthCfg.Position or healthCfg['Position'])) or "Left"):lower()
    if hpPos == "right" then hpPos = "Right" elseif hpPos == "top" then hpPos = "Top" elseif hpPos == "bottom" then hpPos = "Bottom" else hpPos = "Left" end
    local dyn1 = (healthCfg and healthCfg.Dynamic and (healthCfg.Dynamic.Color1 or healthCfg.Dynamic['Color 1'] or healthCfg.Dynamic['Color1'])) or (healthCfg and (healthCfg.Color1 or healthCfg['Color 1'] or healthCfg['Color1'])) or Color3.fromRGB(135, 252, 124)
    local dyn2 = (healthCfg and healthCfg.Dynamic and (healthCfg.Dynamic.Color2 or healthCfg.Dynamic['Color 2'] or healthCfg.Dynamic['Color2'])) or (healthCfg and (healthCfg.Color2 or healthCfg['Color 2'] or healthCfg['Color2'])) or Color3.fromRGB(255, 0, 0)
    local dyn3 = (healthCfg and healthCfg.Dynamic and (healthCfg.Dynamic.Color3 or healthCfg.Dynamic['Color 3'] or healthCfg.Dynamic['Color3'])) or (healthCfg and (healthCfg.Color3 or healthCfg['Color 3'] or healthCfg['Color3'])) or Color3.fromRGB(255, 255, 255)
    resolvedStruct.HealthEnabled = ConfigCache.healthEnabled
    resolvedStruct.HealthTargetMode = (healthCfg and (healthCfg.Target or healthCfg['Target'] or healthCfg.Mode)) or "All"
    resolvedStruct.HealthMaxDist = (healthCfg and healthCfg.All and tonumber(healthCfg.All.Distance or healthCfg.All['Distance'])) or nil
    resolvedStruct.HealthPos = hpPos
    resolvedStruct.HealthWidth = (healthCfg and (healthCfg.Width or healthCfg['Width'])) or 2
    resolvedStruct.HealthGap = (healthCfg and (healthCfg.Gap or healthCfg['Gap'])) or 2
    resolvedStruct.HealthType = (healthCfg and (healthCfg.Type or healthCfg['Type'])) or "Dynamic"
    resolvedStruct.HealthColor = (healthCfg and (healthCfg.Color or healthCfg['Color'])) or Color3.fromRGB(135, 252, 124)
    resolvedStruct.HealthDyn1 = dyn1
    resolvedStruct.HealthDyn2 = dyn2
    resolvedStruct.HealthDyn3 = dyn3
    local numbers_allowed = ConfigCache.numbersEnabled
    if numbers_allowed == false then
        resolvedStruct.HealthShowText = false
    else
        local show_text = true
        if healthCfg then
            if healthCfg["Numbers"] ~= nil then
                show_text = (healthCfg["Numbers"] == true)
            end
        end
        resolvedStruct.HealthShowText = show_text and (numbers_allowed ~= false)
    end
    resolvedStruct.HealthHideWhenFull = healthCfg and healthCfg.HideWhenFullHP == true
    resolvedStruct.HealthTextFollowBar = not healthCfg or healthCfg.TextFollowBar ~= false
    resolvedStruct.HealthFollowColorText = not healthCfg or healthCfg.FollowGradientColorText ~= false
    resolvedStruct.HealthTextSize = tonumber(healthCfg and healthCfg.TextSize) or tonumber(fontCfg and fontCfg.HealthSize) or tonumber(fontCfg and fontCfg["ESP Numbers"] and type(fontCfg["ESP Numbers"]) == "table" and fontCfg["ESP Numbers"][3]) or 9
    resolvedStruct.HealthFont = (healthCfg and healthCfg.Font) or (fontCfg and fontCfg.Health) or (fontCfg and fontCfg["ESP Numbers"] and type(fontCfg["ESP Numbers"]) == "table" and (fontCfg["ESP Numbers"][2] or "Smallest Pixel-7")) or "Smallest Pixel-7"
end
local function resolve_armor_and_extras()
    local armorCfg = ConfigCache.armorCfg
    local esp_cfg = ConfigCache.esp_cfg
    local visuals = ConfigCache.visuals
    local boxesCfg = ConfigCache.boxesCfg
    local distanceCfg = ConfigCache.distanceCfg
    local weaponCfg = ConfigCache.weaponCfg
    local fontCfg = ConfigCache.fontCfg or ESPConfig.Font
    local esp_size = (esp_cfg and esp_cfg["Size"]) or (visuals and visuals["Size"])
    local armor_size = (armorCfg and armorCfg["Size"]) or (type(esp_size) == "table" and esp_size["Armor"]) or (type(esp_size) == "table" and not esp_size["Health"] and not esp_size["Armor"] and esp_size) or nil
    local legacy_mode_a = (type(armor_size) == "table" and armor_size["Mode"]) or (armorCfg and armorCfg["Size Mode"]) or "Manual"
    local legacy_l_a = tostring(legacy_mode_a):lower()
    local legacy_auto_a = legacy_l_a == "automatic" or legacy_l_a == "auto"
    local tgt_mode_raw_a = (type(armor_size) == "table" and (armor_size["Target Mode"] or armor_size["target mode"])) or (armorCfg and (armorCfg["Target Mode"] or armorCfg["target mode"])) or legacy_mode_a
    local nontgt_mode_raw_a = (type(armor_size) == "table" and (armor_size["Non Target Mode"] or armor_size["non target mode"] or armor_size["Non-Target Mode"])) or (armorCfg and (armorCfg["Non Target Mode"] or armorCfg["non target mode"] or armorCfg["Non-Target Mode"])) or legacy_mode_a
    local tgt_mode_l_a = tostring(tgt_mode_raw_a):lower()
    local nontgt_mode_l_a = tostring(nontgt_mode_raw_a):lower()
    local tgt_auto_a = tgt_mode_l_a == "automatic" or tgt_mode_l_a == "auto"
    local nontgt_auto_a = nontgt_mode_l_a == "automatic" or nontgt_mode_l_a == "auto"
    if legacy_auto_a and tgt_mode_raw_a == legacy_mode_a then tgt_auto_a = true end
    if legacy_auto_a and nontgt_mode_raw_a == legacy_mode_a then nontgt_auto_a = true end
    local tbl_cfg = (type(armor_size) == "table" and armor_size["Target Size"]) or (armorCfg and armorCfg["Target Size"]) or (esp_cfg and esp_cfg["Target Size"]) or (visuals and visuals["Target Size"]) or 75
    local nbl_cfg = (type(armor_size) == "table" and armor_size["Non Target Size"]) or (armorCfg and armorCfg["Non Target Size"]) or (esp_cfg and esp_cfg["Non Target Size"]) or (visuals and visuals["Non Target Size"]) or 30
    resolvedStruct.ArmorTargetMode_flag = tgt_auto_a and "Automatic" or "Manual"
    resolvedStruct.ArmorNonTargetMode_flag = nontgt_auto_a and "Automatic" or "Manual"
    resolvedStruct.ArmorSizeMode = (tgt_auto_a and nontgt_auto_a) and "Automatic" or ((not tgt_auto_a and not nontgt_auto_a) and "Manual" or "Mixed")
    resolvedStruct.ArmorTargetSize = tonumber(tbl_cfg) or 75.0
    resolvedStruct.ArmorNonTargetSize = tonumber(nbl_cfg) or 30.0
    local numbers_allowed = ConfigCache.numbersEnabled
    if numbers_allowed == false then
        resolvedStruct.ArmorShowText = false
    else
        local armor_numbers = true
        if armorCfg then
            if armorCfg["Numbers"] ~= nil then
                armor_numbers = (armorCfg["Numbers"] == true)
            end
        end
        resolvedStruct.ArmorShowText = armor_numbers and (numbers_allowed ~= false)
    end
    local defaultFont = (type(fontCfg) == "string" and fontCfg) or (type(fontCfg) == "table" and (fontCfg.Value or (fontCfg["ESP Names"] and type(fontCfg["ESP Names"]) == "table" and fontCfg["ESP Names"][2]) or "Proggy Clean")) or "Proggy Clean"
    local armPos = tostring((armorCfg and (armorCfg.Position or armorCfg['Position'])) or "Left"):lower()
    if armPos == "right" then armPos = "Right" elseif armPos == "top" then armPos = "Top" elseif armPos == "bottom" then armPos = "Bottom" else armPos = "Left" end
    resolvedStruct.ArmorEnabled = ConfigCache.armorEnabled
    resolvedStruct.ArmorTargetMode = (armorCfg and (armorCfg.Target or armorCfg['Target'] or armorCfg.Mode)) or "All"
    resolvedStruct.ArmorMaxDist = (armorCfg and armorCfg.All and tonumber(armorCfg.All.Distance or armorCfg.All['Distance'])) or nil
    resolvedStruct.ArmorPos = armPos
    resolvedStruct.ArmorWidth = (armorCfg and (armorCfg.Width or armorCfg['Width'])) or 2
    resolvedStruct.ArmorGap = (armorCfg and (armorCfg.Gap or armorCfg['Gap'])) or 2
    resolvedStruct.ArmorColor = (armorCfg and (armorCfg.Color or armorCfg['Color'])) or Color3.fromRGB(0, 162, 255)
    resolvedStruct.BoxesEnabled = ConfigCache.boxesEnabled
    resolvedStruct.BoxesColor = (boxesCfg and boxesCfg.Color) or Color3.fromRGB(255, 255, 255)
    resolvedStruct.BoxFillEnabled = ConfigCache.boxesEnabled and boxesCfg and boxesCfg.Fill and boxesCfg.Fill.Enabled == true
    resolvedStruct.BoxFillColor = (boxesCfg and boxesCfg.Fill and boxesCfg.Fill.Color1) or Color3.fromRGB(255, 255, 255)
    resolvedStruct.BoxFillTransparency = (boxesCfg and boxesCfg.Fill and boxesCfg.Fill.Transparency1) or 0.8
    resolvedStruct.DistanceEnabled = ConfigCache.distanceEnabled
    resolvedStruct.DistanceColor = (distanceCfg and distanceCfg.Color) or Color3.fromRGB(255, 255, 255)
    resolvedStruct.DistanceSize = tonumber(fontCfg and (fontCfg.Size or fontCfg['Size'])) or tonumber(fontCfg and fontCfg["ESP Names"] and type(fontCfg["ESP Names"]) == "table" and fontCfg["ESP Names"][3]) or 12
    resolvedStruct.DistanceFont = (fontCfg and fontCfg["ESP Names"] and type(fontCfg["ESP Names"]) == "table" and fontCfg["ESP Names"][2]) or defaultFont
    resolvedStruct.DistanceTransparency = (distanceCfg and distanceCfg.Transparency) or 0
    resolvedStruct.WeaponEnabled = ConfigCache.weaponEnabled
    resolvedStruct.WeaponColor = (weaponCfg and weaponCfg.Color) or Color3.fromRGB(255, 255, 255)
    resolvedStruct.WeaponSize = tonumber(fontCfg and (fontCfg.Size or fontCfg['Size'])) or tonumber(fontCfg and fontCfg["ESP Names"] and type(fontCfg["ESP Names"]) == "table" and fontCfg["ESP Names"][3]) or 12
    resolvedStruct.WeaponFont = (fontCfg and fontCfg["ESP Names"] and type(fontCfg["ESP Names"]) == "table" and fontCfg["ESP Names"][2]) or defaultFont
    resolvedStruct.WeaponTransparency = (weaponCfg and weaponCfg.Transparency) or 0
    resolvedStruct.TextOutlineStyle = ESPConfig.Outlines and ESPConfig.Outlines.Style or "Full"
    resolvedStruct.TextOutlineColor = ESPConfig.Outlines and ESPConfig.Outlines.Color or Color3.fromRGB(0, 0, 0)
end
resolve_runtime_esp_config = function()
    resolve_name_position()
    resolve_name_size()
    resolve_name_style()
    resolve_health()
    resolve_armor_and_extras()
end
local function update_tracked_instance(data, inst, camPos)
    if not inst or not inst.Parent then
        if data.espObj then data.espObj:Destroy() end
        TrackedInstances[inst] = nil
        return
    end
    local humanoid = data.humanoid
    if humanoid == nil or (typeof(humanoid) == "Instance" and humanoid.Parent ~= inst) then
        humanoid = not data.NonHuman and (inst:FindFirstChildOfClass("Humanoid") or inst:FindFirstChild("Humanoid")) or nil
        data.humanoid = humanoid
    end
    if humanoid and humanoid.Health <= 0 then
        if data.espObj.Container and data.espObj.Container.Visible then
            data.espObj.Container.Visible = false
        end
        return
    end
    local rootPart = data.rootPart
    if rootPart == nil or (typeof(rootPart) == "Instance" and rootPart.Parent ~= inst) then
        rootPart = GetSafeRootPart(inst)
        data.rootPart = rootPart
    end
    if rootPart then
        if not data.bodyParts then
            data.bodyParts = {}
            local head = inst:FindFirstChild("Head")
            if head and head:IsA("BasePart") then data.bodyParts[#data.bodyParts + 1] = head end
            local torso = inst:FindFirstChild("UpperTorso") or inst:FindFirstChild("Torso")
            if torso and torso:IsA("BasePart") then data.bodyParts[#data.bodyParts + 1] = torso end
            local lower = inst:FindFirstChild("LowerTorso") or inst:FindFirstChild("HumanoidRootPart")
            if lower and lower:IsA("BasePart") then data.bodyParts[#data.bodyParts + 1] = lower end
            local foot_left = inst:FindFirstChild("LeftFoot") or inst:FindFirstChild("Left Leg")
            if foot_left and foot_left:IsA("BasePart") then data.bodyParts[#data.bodyParts + 1] = foot_left end
            local foot_right = inst:FindFirstChild("RightFoot") or inst:FindFirstChild("Right Leg")
            if foot_right and foot_right:IsA("BasePart") then data.bodyParts[#data.bodyParts + 1] = foot_right end
        end
        local onscreen, pos2d, size2d = Get2DBoundingBox(inst, rootPart, humanoid, data.bodyParts)
        if onscreen and pos2d and size2d then
            local distanceStuds = (camPos - rootPart.Position).Magnitude
            local ok_esp, esp_err = pcall(UpdateESPObj, data.espObj, pos2d, size2d, data.name, distanceStuds, inst, humanoid, rootPart, resolvedStruct)
            if not ok_esp then
                log_print("[adderall ESP Update Error]: " .. tostring(esp_err))
            end
        else
            if data.espObj.Container and data.espObj.Container.Visible then
                data.espObj.Container.Visible = false
            end
        end
    else
        if data.espObj.Container and data.espObj.Container.Visible then
            data.espObj.Container.Visible = false
        end
    end
end
local RuntimeStep = LPH_JIT_MAX(WYNF_JIT_MAX(function()
    local now = tick()
    local wm_now = os.clock()
    wm_frame_count = (wm_frame_count or 0) + 1
    if not wm_last_time then wm_last_time = wm_now end
    if wm_now - wm_last_time >= 0.5 then
        wm_fps = math.floor(wm_frame_count / (wm_now - wm_last_time) + 0.5)
        wm_cpu = math.clamp(math.floor(wm_busy_accum / (wm_now - wm_last_time) * 100 + 0.5), 0, 100)
        wm_frame_count = 0
        wm_busy_accum = 0
        wm_last_time = wm_now
    end
    UpdatePanel()
    local config_refreshed = UpdateConfigCache(now)
    if config_refreshed or resolvedStruct._resolved_once ~= true then
        resolve_runtime_esp_config()
        resolvedStruct._resolved_once = true
    end
    local nameEnabled = ConfigCache.nameEnabled
    local healthEnabled = ConfigCache.healthEnabled
    local armorEnabled = ConfigCache.armorEnabled
    local boxesEnabled = ConfigCache.boxesEnabled
    local distanceEnabled = ConfigCache.distanceEnabled
    local weaponEnabled = ConfigCache.weaponEnabled
    local masterEspEnabled = ConfigCache.masterEspEnabled
    local isAnyEspEnabled = masterEspEnabled and (healthEnabled or armorEnabled or nameEnabled or distanceEnabled or weaponEnabled or boxesEnabled)
    if not isAnyEspEnabled and masterEspEnabled then
        isAnyEspEnabled = true
    end
    if masterEspEnabled then
        isAnyEspEnabled = true
    end
    if not isAnyEspEnabled then
        if espWasVisible then
            for inst, data in pairs(TrackedInstances) do
                if data.espObj and data.espObj.Container and data.espObj.Container.Visible then
                    data.espObj.Container.Visible = false
                end
            end
            espWasVisible = false
        end
        return
    end
    espWasVisible = true
    if ESPConfig.LimitFPS and ESPConfig.LimitFPS > 0 then
        if now - lastRender < (1 / ESPConfig.LimitFPS) then return end
        lastRender = now
    end
    if now - lastScan > 1 then
        lastScan = now
        pcall(ScanDirectories, isAnyEspEnabled)
        if not next(TrackedInstances) and isAnyEspEnabled then
            pcall(function()
                for _, player in ipairs(Players:GetPlayers()) do
                    if player == LocalPlayer then continue end
                    local char = player.Character
                    if not char then continue end
                    local humanoid = char:FindFirstChildOfClass("Humanoid")
                    if not humanoid or humanoid.Health <= 0 then continue end
                    if not TrackedInstances[char] then
                        local name = player.DisplayName or player.Name
                        local ok, espObj = pcall(CreateESPObj, name)
                        if ok and espObj then
                            TrackedInstances[char] = { espObj = espObj, name = name }
                        end
                    end
                end
            end)
        end
    end
    local cam = Workspace.CurrentCamera or Camera
    local camPos = cam and cam.CFrame.Position or Vector3.zero
    for inst, data in pairs(TrackedInstances) do
        update_tracked_instance(data, inst, camPos)
    end
end))
function ESP:Unload()
    for inst, data in pairs(TrackedInstances) do
        if data.espObj then
            data.espObj:Destroy()
        end
        TrackedInstances[inst] = nil
    end
    if PlayerRemovingConnection then
        PlayerRemovingConnection:Disconnect()
        PlayerRemovingConnection = nil
    end
    if InputBeganConnection then
        InputBeganConnection:Disconnect()
        InputBeganConnection = nil
    end
    if getgenv().Adderall_Loop then
        getgenv().Adderall_Loop:Disconnect()
        getgenv().Adderall_Loop = nil
    end
    if ScreenGui then
        ScreenGui:Destroy()
        ScreenGui = nil
    end
    PanelLabel = nil
    if ChamsContainer then
        ChamsContainer:Destroy()
        ChamsContainer = nil
    end
    if MeshChamsFolder then
        MeshChamsFolder:Destroy()
        MeshChamsFolder = nil
    end
    CleanupMeshChams(Workspace)
    for _, player in ipairs(BootstrapPlayers:GetPlayers()) do
        CleanupCharacterMeshChams(player.Character)
    end
    getgenv().Adderall_UI = nil
end
function ESP:Load(custom_cfg)
    self:Unload()
    local target_cfg = custom_cfg or shared["Adderall"] or config or {}
    _actualESPConfig = DeepMerge(DeepMerge(DeepCopy(DefaultESPConfig), target_cfg), build_esp_engine_view(type(target_cfg) == "table" and (target_cfg["Visuals"] or {}) or {}) or {})
    ESPConfig = createProxy(GetRootESPConfigNode, _actualESPConfig)
    EnsureRootInstances()
    CurrentRunId = HttpService:GenerateGUID(false)
    lastScan = 0
    lastRender = 0
    PlayerRemovingConnection = Players.PlayerRemoving:Connect(function(player)
        for inst, data in pairs(TrackedInstances) do
            if Players:GetPlayerFromCharacter(inst) == player then
                data.espObj:Destroy()
                TrackedInstances[inst] = nil
            end
        end
    end)
    InputBeganConnection = UserInputService.InputBegan:Connect(function(input, gpe)
        if not gpe and ESPConfig.Keybind and ESPConfig.Keybind.Enabled and input.KeyCode == ESPConfig.Keybind.Key then
            local target = GetRootESPConfigNode()
            local newState = false
            if target then
                target['Enabled'] = not target['Enabled']
                newState = target['Enabled']
            else
                _actualESPConfig.Enabled = not _actualESPConfig.Enabled
                newState = _actualESPConfig.Enabled
            end
            if type(_actualESPConfig.Name) == "table" then _actualESPConfig.Name.Enabled = newState end
            if type(_actualESPConfig.Names) == "table" then _actualESPConfig.Names.Enabled = newState end
            if type(_actualESPConfig.Health) == "table" then _actualESPConfig.Health.Enabled = newState end
            if type(_actualESPConfig.Armor) == "table" then _actualESPConfig.Armor.Enabled = newState end
        end
    end)
    getgenv().Adderall_Loop = RunService.RenderStepped:Connect(function()
        local wm_step_start = os.clock()
        local ok, err = pcall(RuntimeStep)
        if not ok then
            log_print("[adderall ESP RuntimeStep Error]: " .. tostring(err))
        end
        wm_busy_accum = wm_busy_accum + (os.clock() - wm_step_start)
    end)
    track_connection(RunService.Stepped:Connect(function()
        local wm_step_start = os.clock()
        local char = local_player.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then apply_velocity_fly(hum) end
            local held_tool = char:FindFirstChildOfClass("Tool")
            if held_tool then apply_infinite_ammo(held_tool) end
        end
        wm_busy_accum = wm_busy_accum + (os.clock() - wm_step_start)
    end))
    pcall(ScanDirectories)
    return self
end
function ESP:GetConfig()
    return ESPConfig
end
return ESP
end)()
local avatar_changer = (function()
    local copy_classes = {
        Shirt = true,
        Pants = true,
        ShirtGraphic = true,
        Accessory = true,
        Hat = true,
        BodyColors = true,
        CharacterMesh = true,
    }
    local body_size_presets = { Skinny = 0.5, Normal = 1, Fat = 1.25 }
    local body_scale_map = {
        BodyTypeScale = "BodyTypeScale",
        DepthScale = "BodyDepthScale",
        HeadScale = "HeadScale",
        HeightScale = "BodyHeightScale",
        ProportionScale = "BodyProportionScale",
        WidthScale = "BodyWidthScale",
    }
    local user_id_cache = {}
    local description_cache = {}
    local source_cache = {}
    local headless_cleanup = setmetatable({}, { __mode = "k" })
    local applied_clones = setmetatable({}, { __mode = "k" })
    local korblox_conns = {}
    local applied_signature = nil
    local applied_cosmetics = nil
    local running = true
    local function get_settings()
        local char_cfg = config["Character"] or {}
        return char_cfg["Avatar Changer"] or {}, char_cfg
    end
    local function resolve_user_id(raw)
        if type(raw) == "number" then
            return raw > 0 and raw or nil
        end
        if type(raw) ~= "string" then
            return nil
        end
        local num = tonumber(raw)
        if num and num > 0 then
            return num
        end
        if raw == "" then
            return nil
        end
        local name = raw:lower()
        if user_id_cache[name] then
            return user_id_cache[name]
        end
        local ok, id = pcall(function()
            return players:GetUserIdFromNameAsync(raw)
        end)
        if ok and type(id) == "number" and id > 0 then
            user_id_cache[name] = id
            return id
        end
        return nil
    end
    local function get_description(user_id)
        if description_cache[user_id] then
            return description_cache[user_id]
        end
        local ok, description = pcall(function()
            return players:GetHumanoidDescriptionFromUserIdAsync(user_id)
        end)
        if ok and description then
            description_cache[user_id] = description
            return description
        end
        return nil
    end
    local function build_options(settings)
        local mode = settings["Mode"] or "Full"
        if mode ~= "Full" and mode ~= "Character" and mode ~= "Animations" and mode ~= "Emotes" then
            mode = "Full"
        end
        local body_type = settings["Body Type"] or "Normal"
        if not body_size_presets[body_type] then
            body_type = "Normal"
        end
        return {
            body = mode == "Full" or mode == "Character",
            animations = mode == "Full" or mode == "Animations" or mode == "Emotes",
            body_type = body_type,
        }
    end
    local function prepare_description(description, options)
        pcall(function()
            description.UseAvatarSettings = false
        end)
        local size = body_size_presets[options.body_type]
        description.WidthScale = size
        description.DepthScale = size
        description.HeightScale = 1
        description.HeadScale = 1
    end
    local function get_source(user_id, rig_type, options)
        local need_model = options.body or options.animations
        local key = user_id .. ":" .. tostring(rig_type) .. ":" .. options.body_type
        local cached = source_cache[key]
        if cached and (cached.source_model or not need_model) then
            return cached.description, cached.source_model
        end
        local description = cached and cached.description
        if not description then
            local base = get_description(user_id)
            if not base then
                return nil, nil
            end
            description = base:Clone()
            if options.body then
                prepare_description(description, options)
            end
            cached = { description = description }
            source_cache[key] = cached
        end
        local source_model = cached.source_model
        if need_model and not source_model then
            local ok, model = pcall(function()
                return players:CreateHumanoidModelFromDescriptionAsync(description, rig_type)
            end)
            if ok and model then
                source_model = model
                cached.source_model = source_model
            end
        end
        return description, source_model
    end
    local function sync_attachments(local_part, source_part, old_size)
        local ratio = Vector3.new(
            local_part.Size.X / math.max(old_size.X, 0.000001),
            local_part.Size.Y / math.max(old_size.Y, 0.000001),
            local_part.Size.Z / math.max(old_size.Z, 0.000001)
        )
        for _, child in ipairs(local_part:GetChildren()) do
            if child:IsA("Attachment") and not child:IsA("Bone") then
                local source_attachment = source_part:FindFirstChild(child.Name)
                if source_attachment and source_attachment:IsA("Attachment") then
                    child.CFrame = CFrame.new(
                        source_attachment.CFrame.Position.X * ratio.X,
                        source_attachment.CFrame.Position.Y * ratio.Y,
                        source_attachment.CFrame.Position.Z * ratio.Z
                    ) * (source_attachment.CFrame - source_attachment.CFrame.Position)
                end
            end
        end
    end
    local function copy_scaling_metadata(local_obj, source_obj)
        for _, name in ipairs({ "OriginalSize", "OriginalPosition", "AvatarPartScaleType" }) do
            local src = source_obj:FindFirstChild(name)
            local dst = local_obj:FindFirstChild(name)
            if src then
                local clone = src:Clone()
                if dst then dst:Destroy() end
                clone.Parent = local_obj
            end
        end
    end
    local function relink_joints(character, old_part, new_part)
        for _, joint in ipairs(character:GetDescendants()) do
            if joint:IsA("Motor6D") or joint:IsA("Weld") then
                if joint.Part0 == old_part then
                    joint.Part0 = new_part
                end
                if joint.Part1 == old_part then
                    joint.Part1 = new_part
                end
            elseif joint:IsA("WeldConstraint") then
                if joint.Part0 == old_part then
                    joint.Part0 = new_part
                elseif joint.Part1 == old_part then
                    joint.Part1 = new_part
                end
            end
        end
    end
    local function swap_part(character, local_part, source_part)
        if local_part.Name == "HumanoidRootPart" or local_part == character.PrimaryPart then
            return local_part
        end
        local ok, new_part = pcall(function()
            return source_part:Clone()
        end)
        if not ok or not new_part then
            return local_part
        end
        new_part.Name = local_part.Name
        new_part.Anchored = false
        new_part.CFrame = local_part.CFrame
        pcall(function()
            new_part.CanCollide = local_part.CanCollide
            new_part.CanTouch = local_part.CanTouch
            new_part.CanQuery = local_part.CanQuery
            new_part.Massless = local_part.Massless
            new_part.Transparency = local_part.Transparency
        end)
        for _, child in ipairs(new_part:GetChildren()) do
            if
                child:IsA("JointInstance")
                or child:IsA("WeldConstraint")
                or (child:IsA("Attachment") and not child:IsA("Bone"))
            then
                child:Destroy()
            end
        end
        new_part.Parent = character
        for _, child in ipairs(local_part:GetChildren()) do
            if child:IsA("Attachment") and not child:IsA("Bone") then
                child.Parent = new_part
            elseif
                not (
                    child:IsA("Attachment")
                    or child:IsA("JointInstance")
                    or child:IsA("WeldConstraint")
                    or child:IsA("SpecialMesh")
                    or child:IsA("Decal")
                    or child:IsA("Texture")
                    or child:IsA("SurfaceAppearance")
                    or child:IsA("WrapTarget")
                    or child.Name == "OriginalSize"
                    or child.Name == "AvatarPartScaleType"
                )
            then
                pcall(function()
                    child.Parent = new_part
                end)
            end
        end
        relink_joints(character, local_part, new_part)
        pcall(function()
            local_part:Destroy()
        end)
        return new_part
    end
    local function copy_surface_layers(local_part, source_part)
        for _, child in ipairs(local_part:GetChildren()) do
            if
                child:IsA("SurfaceAppearance")
                or child:IsA("WrapTarget")
                or child:IsA("Bone")
                or child:IsA("FaceControls")
                or child:IsA("Decal")
                or child:IsA("Texture")
            then
                child:Destroy()
            end
        end
        for _, child in ipairs(source_part:GetChildren()) do
            if
                child:IsA("SurfaceAppearance")
                or child:IsA("WrapTarget")
                or child:IsA("FaceControls")
                or child:IsA("Decal")
                or child:IsA("Texture")
            then
                pcall(function()
                    child:Clone().Parent = local_part
                end)
            end
        end
    end
    local function copy_part_geometry(character, local_part, source_part)
        local old_size = local_part.Size
        local source_is_mesh = source_part:IsA("MeshPart")
        if source_is_mesh ~= local_part:IsA("MeshPart") then
            local_part = swap_part(character, local_part, source_part)
        elseif source_is_mesh and not pcall(function()
            local_part:ApplyMesh(source_part)
        end) then
            local_part = swap_part(character, local_part, source_part)
        end
        local source_mesh = source_part:FindFirstChildOfClass("SpecialMesh")
        local local_mesh = local_part:FindFirstChildOfClass("SpecialMesh")
        if local_mesh then
            local_mesh:Destroy()
        end
        if source_mesh then
            source_mesh:Clone().Parent = local_part
        end
        copy_surface_layers(local_part, source_part)
        local_part.Size = source_part.Size
        local_part.Color = source_part.Color
        local_part.Material = source_part.Material
        if source_is_mesh then
            pcall(function()
                local_part.TextureID = source_part.TextureID
            end)
        end
        copy_scaling_metadata(local_part, source_part)
        sync_attachments(local_part, source_part, old_size)
        return local_part
    end
    local function copy_body(character, source_model)
        for _, local_part in ipairs(character:GetChildren()) do
            if local_part:IsA("BasePart") and local_part.Name ~= "HumanoidRootPart" then
                local source_part = source_model:FindFirstChild(local_part.Name)
                if source_part and source_part:IsA("BasePart") then
                    copy_part_geometry(character, local_part, source_part)
                end
            end
        end
    end
    local function clear_copy_classes(character)
        for _, child in ipairs(character:GetChildren()) do
            if copy_classes[child.ClassName] then
                pcall(function()
                    child:Destroy()
                end)
            end
        end
    end
    local function retarget_weld(weld, character)
        local part0 = weld.Part0
        if part0 and not part0:IsDescendantOf(character) then
            local local_part = character:FindFirstChild(part0.Name)
            if local_part and local_part:IsA("BasePart") then
                weld.Part0 = local_part
            end
        end
        local part1 = weld.Part1
        if part1 and not part1:IsDescendantOf(character) then
            local local_part = character:FindFirstChild(part1.Name)
            if local_part and local_part:IsA("BasePart") then
                weld.Part1 = local_part
            end
        end
    end
    local function fit_accessories(character, source_model, accessories)
        for _, entry in ipairs(accessories) do
            local handle = entry.clone:FindFirstChild("Handle")
            local source_handle = entry.source:FindFirstChild("Handle")
            if handle and source_handle and not source_handle:FindFirstChildOfClass("WrapLayer") then
                local source_weld = source_handle:FindFirstChild("AccessoryWeld")
                local source_body = source_weld and source_weld.Part0
                local body = source_body and source_body.Parent == source_model and character:FindFirstChild(source_body.Name)
                if body and body:IsA("BasePart") then
                    local base_size, size = source_body.Size, body.Size
                    local ratio = Vector3.new(
                        size.X / math.max(base_size.X, 0.000001),
                        size.Y / math.max(base_size.Y, 0.000001),
                        size.Z / math.max(base_size.Z, 0.000001)
                    )
                    handle.Size = source_handle.Size * ratio
                    local mesh = handle:FindFirstChildOfClass("SpecialMesh")
                    local source_mesh = source_handle:FindFirstChildOfClass("SpecialMesh")
                    if mesh and source_mesh then
                        mesh.Scale = source_mesh.Scale * ratio
                        mesh.Offset = source_mesh.Offset * ratio
                    end
                    local weld = handle:FindFirstChild("AccessoryWeld")
                    if weld and weld:IsA("Weld") then
                        weld.Part0, weld.Part1 = body, handle
                        handle.CFrame = body.CFrame * source_weld.C0 * source_weld.C1:Inverse()
                    end
                end
            end
        end
    end
    local function fake_headless(character)
        if not character then
            return
        end
        if headless_cleanup[character] then
            headless_cleanup[character](true)
        end
        local head = character:FindFirstChild("Head")
        if not head then
            return
        end
        local face = head:FindFirstChild("face") or head:FindFirstChild("Face")
        if face then
            face.Parent = nil
        end
        local mesh = head:FindFirstChildOfClass("SpecialMesh")
        if mesh then
            mesh.Parent = nil
        end
        local function enforce()
            if head.Parent and head.Transparency ~= 1 then
                head.Transparency = 1
                head.LocalTransparencyModifier = 1
            end
        end
        enforce()
        local conn
        conn = run_service.RenderStepped:Connect(enforce)
        table.insert(korblox_conns, conn)
        headless_cleanup[character] = function(restore)
            if conn then conn:Disconnect() end
            headless_cleanup[character] = nil
            if not restore then
                return
            end
            if head.Parent then
                head.Transparency = 0
                head.LocalTransparencyModifier = 0
                if face and not (head:FindFirstChild("face") or head:FindFirstChild("Face")) then
                    face.Parent = head
                end
                if mesh and not head:FindFirstChildOfClass("SpecialMesh") then
                    mesh.Parent = head
                end
            end
        end
    end
    local function fake_korblox(character)
        if not character then
            return
        end
        local existing = character:FindFirstChild("AvatarKorbloxParts")
        if existing then
            existing:Destroy()
        end
        local right_upper = character:FindFirstChild("RightUpperLeg")
        local right_lower = character:FindFirstChild("RightLowerLeg")
        local right_foot = character:FindFirstChild("RightFoot")
        local folder = Instance.new("Folder")
        folder.Name = "AvatarKorbloxParts"
        folder.Parent = character
        local function create_mesh_part(parent)
            local part = Instance.new("Part")
            part.Size = Vector3.new(1, 1, 1)
            part.Transparency = 0
            part.CanCollide = false
            part.CanQuery = false
            part.CanTouch = false
            part.CastShadow = false
            part.Anchored = false
            part.Massless = true
            part.CFrame = parent.CFrame
            part.Parent = folder
            local mesh = Instance.new("SpecialMesh")
            mesh.MeshType = Enum.MeshType.FileMesh
            mesh.MeshId = "http://www.roblox.com/asset/?id=902942096"
            mesh.TextureId = "http://www.roblox.com/asset/?id=902843398"
            mesh.Scale = Vector3.new(0.6, 1.13, 0.6)
            mesh.Offset = Vector3.new(0, 0.25, 0)
            mesh.Parent = part
            local weld = Instance.new("WeldConstraint")
            weld.Part0 = parent
            weld.Part1 = part
            weld.Parent = part
            table.insert(korblox_conns, part.Destroying:Connect(function() end))
        end
        if right_upper then
            right_upper.Transparency = 1
            create_mesh_part(right_upper)
        end
        if right_lower then
            right_lower.Transparency = 1
        end
        if right_foot then
            right_foot.Transparency = 1
        end
    end
    local function remove_korblox(character)
        local folder = character and character:FindFirstChild("AvatarKorbloxParts")
        if folder then
            folder:Destroy()
        end
        if character then
            for _, name in ipairs({ "RightUpperLeg", "RightLowerLeg", "RightFoot" }) do
                local part = character:FindFirstChild(name)
                if part then
                    part.Transparency = 0
                end
            end
        end
    end
    local function apply_fake_cosmetics(character)
        if not character then
            return
        end
        local _, char_cfg = get_settings()
        local headless_enabled = char_cfg["Headless"] == true
        local korblox_enabled = char_cfg["Korblox"] == true
        task.spawn(function()
            if local_player.Character ~= character or not character.Parent then
                return
            end
            local current_cfg = config["Character"]
            if not (current_cfg and current_cfg["Headless"]) and headless_cleanup[character] then
                headless_cleanup[character](true)
            end
            if not (current_cfg and current_cfg["Korblox"]) then
                remove_korblox(character)
            end
            if headless_enabled and current_cfg and current_cfg["Headless"] then
                local ok, head = pcall(function()
                    return character:WaitForChild("Head", 5)
                end)
                if ok and head and local_player.Character == character and character.Parent then
                    task.wait(0.05)
                    if config["Character"] and config["Character"]["Headless"] then
                        fake_headless(character)
                    end
                end
            end
            if korblox_enabled and current_cfg and current_cfg["Korblox"] then
                pcall(function()
                    character:WaitForChild("RightUpperLeg", 5)
                    character:WaitForChild("RightLowerLeg", 5)
                    character:WaitForChild("RightFoot", 5)
                end)
                task.wait(0.05)
                if config["Character"] and config["Character"]["Korblox"] then
                    fake_korblox(character)
                end
            end
        end)
    end
    local function config_signature()
        local cfg = config["Character"]
        if type(cfg) ~= "table" then
            return "", ""
        end
        local spoofer = type(cfg["Avatar Changer"]) == "table" and cfg["Avatar Changer"] or {}
        return table.concat({
            tostring(spoofer["Enabled"]),
            tostring(spoofer["Target"]),
            tostring(spoofer["Mode"]),
            tostring(spoofer["Body Type"]),
        }, "|"),
            tostring(cfg["Headless"]) .. "|" .. tostring(cfg["Korblox"])
    end
    local function apply_appearance(character, settings, options)
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not humanoid or not character.Parent or local_player.Character ~= character then
            return false
        end
        local user_id = resolve_user_id(settings["Target"])
        if not user_id then
            return false
        end
        local description, source_model = get_source(user_id, humanoid.RigType, options)
        if not description then
            return false
        end
        if options.body then
            if not source_model then
                return false
            end
            local source_humanoid = source_model:FindFirstChildOfClass("Humanoid")
            if not source_humanoid or source_humanoid.RigType ~= humanoid.RigType then
                return false
            end
            pcall(function()
                for key, name in pairs(body_scale_map) do
                    local value = humanoid:FindFirstChild(name)
                    if value and value:IsA("NumberValue") then
                        value.Value = description[key]
                    end
                end
            end)
            local saved_neck, saved_scaling = humanoid.RequiresNeck, humanoid.AutomaticScalingEnabled
            humanoid.RequiresNeck = false
            humanoid.AutomaticScalingEnabled = false
            copy_body(character, source_model)
            clear_copy_classes(character)
            local clones = {}
            for _, child in ipairs(source_model:GetChildren()) do
                if copy_classes[child.ClassName] then
                    local clone = child:Clone()
                    clone.Name = clone.Name .. "_AvatarClone"
                    clone.Parent = character
                    clones[#clones + 1] = { clone = clone, source = child }
                    for _, joint in ipairs(clone:GetDescendants()) do
                        if joint:IsA("JointInstance") or joint:IsA("WeldConstraint") then
                            retarget_weld(joint, character)
                        end
                    end
                end
            end
            applied_clones[character] = clones
            humanoid.AutomaticScalingEnabled = saved_scaling
            humanoid.RequiresNeck = saved_neck
            fit_accessories(character, source_model, clones)
            humanoid.HipHeight = source_humanoid.HipHeight
            if headless_cleanup[character] then
                headless_cleanup[character](false)
                if config["Character"] and config["Character"]["Headless"] then
                    fake_headless(character)
                end
            end
            if character:FindFirstChild("AvatarKorbloxParts") and config["Character"] and config["Character"]["Korblox"] then
                fake_korblox(character)
            end
        elseif options.animations and source_model then
            local animate = character:FindFirstChild("Animate")
            local source_animate = source_model:FindFirstChild("Animate")
            if animate and source_animate then
                for _, child in ipairs(source_animate:GetChildren()) do
                    local local_state = animate:FindFirstChild(child.Name)
                    if local_state then
                        for _, anim in ipairs(local_state:GetDescendants()) do
                            if anim:IsA("Animation") then
                                anim:Destroy()
                            end
                        end
                        for _, anim in ipairs(child:IsA("Animation") and { child } or child:GetDescendants()) do
                            if anim:IsA("Animation") then
                                anim:Clone().Parent = local_state
                            end
                        end
                    end
                end
            end
        end
        return true
    end
    local function apply(character)
        applied_signature, applied_cosmetics = config_signature()
        local settings, _ = get_settings()
        local mode = settings["Mode"] or "Full"
        local applied_ok = false
        if settings["Enabled"] == true then
            local options = build_options(settings)
            applied_ok = pcall(apply_appearance, character, settings, options)
        end
        if not applied_ok or not settings["Enabled"] or (mode ~= "Full" and mode ~= "Character") then
            apply_fake_cosmetics(character)
        end
    end
    local function remove_clones(character)
        local clones = applied_clones[character]
        if not clones then
            return
        end
        for _, entry in ipairs(clones) do
            if entry.clone and entry.clone.Parent then
                pcall(function()
                    entry.clone:Destroy()
                end)
            end
        end
        applied_clones[character] = nil
    end
    local function unload()
        running = false
        local character = local_player.Character
        for _, conn in ipairs(korblox_conns) do
            pcall(function()
                conn:Disconnect()
            end)
        end
        table.clear(korblox_conns)
        for cached in pairs(source_cache) do
            source_cache[cached] = nil
        end
        for _, cached in pairs({}) do end
        for key, cached in next, source_cache do
            source_cache[key] = nil
            if cached.source_model then
                pcall(function()
                    cached.source_model:Destroy()
                end)
            end
        end
        if not character then
            return
        end
        if headless_cleanup[character] then
            headless_cleanup[character](true)
        end
        remove_korblox(character)
        remove_clones(character)
    end
    local function start()
        task.spawn(function()
            while not local_player.Character do
                task.wait(0.25)
            end
            pcall(apply, local_player.Character)
        end)
        track_connection(local_player.CharacterAdded:Connect(function(character)
            task.wait(0.5)
            pcall(apply, character)
        end))
        track_connection(local_player.CharacterRemoving:Connect(function(character)
            if headless_cleanup[character] then
                headless_cleanup[character]()
            end
        end))
        while running do
            task.wait(0.5)
            local signature, cosmetics = config_signature()
            if signature ~= applied_signature then
                local character = local_player.Character
                if character then
                    remove_clones(character)
                    if headless_cleanup[character] then
                        headless_cleanup[character](true)
                    end
                    remove_korblox(character)
                    task.spawn(function()
                        pcall(apply, character)
                    end)
                end
            elseif cosmetics ~= applied_cosmetics then
                applied_cosmetics = cosmetics
                if local_player.Character then
                    apply_fake_cosmetics(local_player.Character)
                end
            end
        end
    end
    return {
        apply = apply,
        unload = unload,
        fake_headless = fake_headless,
        fake_korblox = fake_korblox,
    }
end)()
