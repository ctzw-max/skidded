        ["Proggy Clean"] = Enum.Font.SourceSans,
        ["ESP Names"] = Enum.Font.SourceSans,
        ["ESP Numbers"] = Enum.Font.SourceSans,
    },
    faces = {},
    failed = {},
    pending = {},
    enum_cache = {},
    cache = {},
    custom_capable = type(getcustomasset) == "function" and type(writefile) == "function",
    applied = setmetatable({}, { __mode = "k" }),
    keys = setmetatable({}, { __mode = "k" }),
    enforce_at = 0,
    magic = { ["\0\1\0\0"] = true, ["OTTO"] = true, ["true"] = true, ["ttcf"] = true },
}
function fonts.entry(key)
    local visuals = config and (config.Visuals or config.visuals)
    local cfg = (visuals and (visuals.Fonts or visuals.fonts)) or (config and (config.Fonts or config.fonts))
    local entry = type(cfg) == "table" and (cfg[key] or cfg[tostring(key):lower()])
    if type(entry) ~= "table" then
        local def_name = key
        if key == "ESP Names" or key == "esp_names" then def_name = "Proggy Clean"
        elseif key == "ESP Numbers" or key == "esp_numbers" then def_name = "Smallest Pixel-7" end
        return "Roblox", def_name, 12
    end
    local mode, name = entry[1], entry[2]
    if not name or name == "" then
        if key == "ESP Names" or key == "esp_names" then name = "Proggy Clean"
        elseif key == "ESP Numbers" or key == "esp_numbers" then name = "Smallest Pixel-7" end
    end
    if (mode ~= "Custom" and mode ~= "Roblox" and mode ~= "Drawing") or type(name) ~= "string" or name == "" then
        mode = "Roblox"
    end
    if mode == "Custom" and not fonts.downloads[name] then
        mode = "Roblox"
    elseif mode == "Roblox" and fonts.downloads[name] and fonts.custom_capable then
        mode = "Custom"
    end
    local size = tonumber(entry[3]) or 12
    return mode, name, size
end
function fonts.is_font(body)
    return type(body) == "string" and #body >= 256 and fonts.magic[body:sub(1, 4)] == true
end
function fonts.ensure_folder()
    if type(isfolder) ~= "function" or type(makefolder) ~= "function" then return end
    local path
    for segment in fonts.folder:gmatch("[^/]+") do
        path = path and path .. "/" .. segment or segment
        local ok, exists = pcall(isfolder, path)
        if not (ok and exists) then
            pcall(makefolder, path)
        end
    end
end
function fonts.register(name)
    local file = fonts.downloads[name]
    if not file then return nil end
    if not fonts.custom_capable then return nil end
    fonts.ensure_folder()
    local path = fonts.folder .. "/" .. file
    local ok, exists = pcall(isfile, path)
    local usable = ok and exists == true
    if usable and type(readfile) == "function" then
        local ok_read, saved = pcall(readfile, path)
        if ok_read and not fonts.is_font(saved) then
            usable = false
        end
    end
    if not usable then
        local body
        local urls = fonts.sources[name] or { fonts.host .. file }
        for _, url in ipairs(urls) do
            local ok_http, res = pcall(function() return game:HttpGet(url) end)
            if ok_http and fonts.is_font(res) then
                body = res
                break
            end
        end
        if not fonts.is_font(body) then
            return nil
        end
        local ok_write = pcall(writefile, path, body)
        if not ok_write then return nil end
    end
    local built, face = pcall(function()
        local desc = fonts.folder .. "/" .. name:gsub("%s+", "") .. ".font.json"
        writefile(
            desc,
            http_service:JSONEncode({
                name = name,
                faces = { { name = "Regular", weight = 400, style = "normal", assetId = getcustomasset(path) } },
            })
        )
        local f = Font.new(getcustomasset(desc), Enum.FontWeight.Regular)
        if typeof(f) == "Font" then return f end
        return Font.new(getcustomasset(desc), Enum.FontWeight.Regular, Enum.FontStyle.Normal)
    end)
    if not built or typeof(face) ~= "Font" then
        return nil
    end
    return face
end
function fonts.load(name)
    if fonts.faces[name] or fonts.pending[name] then return end
    if fonts.failed[name] and os.clock() - (fonts.failed[name] or 0) < 5 then return end
    fonts.pending[name] = true
    task.spawn(function()
        local ok, face = pcall(fonts.register, name)
        if ok and face then
            fonts.faces[name] = face
            fonts.failed[name] = nil
            if ESPFonts and ESPFonts.Loaded then
                ESPFonts.Loaded[name] = face
            end
            if name == "Smallest Pixel-7" then
                fonts.faces["ESP Numbers"] = face
                if ESPFonts and ESPFonts.Loaded then ESPFonts.Loaded["ESP Numbers"] = face end
            elseif name == "Proggy Clean" then
                fonts.faces["ESP Names"] = face
                if ESPFonts and ESPFonts.Loaded then ESPFonts.Loaded["ESP Names"] = face end
            elseif name == "Verdana" then
                fonts.faces["VerdanaBold"] = face
                fonts.faces["Verdana Bold"] = face
            elseif name == "TahomaBold" then
                fonts.faces["Tahoma Bold"] = face
                fonts.faces["Tahoma Modern Bold"] = face
            end
        else
            fonts.failed[name] = os.clock()
        end
        fonts.pending[name] = nil
        table.clear(fonts.cache)
    end)
end
function fonts.get_enum(name)
    if not name then return fonts.default end
    if name == "ESP Names" or name == "esp_names" then name = "Proggy Clean" end
    if name == "ESP Numbers" or name == "esp_numbers" then name = "Smallest Pixel-7" end
    local cached = fonts.enum_cache[name]
    if cached ~= nil then return cached end
    if fonts.map[name] then
        cached = fonts.map[name]
        fonts.enum_cache[name] = cached
        return cached
    end
    if fonts.downloads[name] then
        cached = Enum.Font.SourceSans
        fonts.enum_cache[name] = cached
        return cached
    end
    local ok, val = pcall(function() return Enum.Font[name] end)
    if not (ok and val) then
        local stripped = tostring(name):gsub("%s+", "")
        ok, val = pcall(function() return Enum.Font[stripped] end)
    end
    val = (ok and val) or fonts.default
    fonts.enum_cache[name] = val
    return val
end
function fonts.resolve(key, size)
    if not key then return size or 12, fonts.default, false end
    local mode, name, entry_size = fonts.entry(key)
    local effective_size = size or entry_size or 12
    local target_name = name or key
    if target_name == "ESP Names" or target_name == "esp_names" then
        target_name = "Proggy Clean"
    elseif target_name == "ESP Numbers" or target_name == "esp_numbers" then
        target_name = "Smallest Pixel-7"
    end
    if mode == "Drawing" and fonts.drawing_enums[target_name] then
        return effective_size, fonts.drawing_enums[target_name], false
    end
    local face = fonts.faces[target_name] or (ESPFonts and ESPFonts.Loaded and ESPFonts.Loaded[target_name])
    if face then
        return effective_size, face, true
    end
    if fonts.downloads[target_name] then
        fonts.load(target_name)
        local loaded = fonts.faces[target_name] or (ESPFonts and ESPFonts.Loaded and ESPFonts.Loaded[target_name])
        if loaded then return effective_size, loaded, true end
    end
    if target_name == "VerdanaBold" or target_name == "Verdana Bold" or tostring(target_name):lower():find("verdana", 1, true) then
        local ok_v, face_v = pcall(Font.fromName, "Verdana", Enum.FontWeight.Bold)
        if ok_v and face_v then
            fonts.faces[target_name] = face_v
            return effective_size, face_v, true
        end
    end
    local enum_val = fonts.get_enum(target_name)
    return effective_size, enum_val, false
end
function fonts.apply(label, font_name, font_size)
    if not label or not font_name then return end
    fonts.keys[label] = { name = font_name, size = font_size }
    local size, val, is_custom = fonts.resolve(font_name, font_size)
    local applied = fonts.applied[label]
    if applied and applied[1] == size and applied[2] == val then
        return
    end
    if not applied then
        applied = {}
        fonts.applied[label] = applied
    end
    applied[1], applied[2] = size, val
    if typeof(label) == "Instance" and label:IsA("TextLabel") then
        if size and label.TextSize ~= size then
            label.TextSize = size
        end
        if typeof(val) == "Font" then
            label.FontFace = val
        else
            local ff = fonts.enum_cache["_ff_" .. tostring(val)]
            if ff == nil then
                local s, res = pcall(Font.fromEnum, val)
                ff = (s and typeof(res) == "Font" and res) or false
                fonts.enum_cache["_ff_" .. tostring(val)] = ff
            end
            if ff and label.FontFace ~= ff then
                label.FontFace = ff
            elseif label.Font ~= val then
                label.Font = val
            end
        end
    elseif type(label) == "table" or typeof(label) == "Drawing" or typeof(label) == "userdata" then
        pcall(function()
            if size then label.Size = size end
            if typeof(val) == "Font" or typeof(val) == "EnumItem" then
                label.Font = 0
            else
                label.Font = tonumber(val) or 0
            end
        end)
    end
end
function fonts.enforce(now)
    if now < fonts.enforce_at then return end
    fonts.enforce_at = now + 0.2
    for label, info in pairs(fonts.keys) do
        local is_alive = false
        if typeof(label) == "Instance" then
            is_alive = label.Parent ~= nil
        else
            is_alive = true
        end
        if is_alive then
            local size, val, is_custom = fonts.resolve(info.name, info.size)
            if typeof(label) == "Instance" and label:IsA("TextLabel") then
                if is_custom and typeof(val) == "Font" then
                    if label.FontFace ~= val then
                        label.FontFace = val
                    end
                end
                if size and label.TextSize ~= size then
                    label.TextSize = size
                end
            end
        else
            fonts.keys[label] = nil
            fonts.applied[label] = nil
        end
    end
end
track_connection(run_service.Heartbeat:Connect(function()
    fonts.enforce(os.clock())
end))
local esp_fonts = { Loaded = fonts.faces, loaded = fonts.faces }
ESPFonts = esp_fonts
shared.AdderallFonts = fonts
ApplyFont = function(label, font_name, font_size)
    fonts.apply(label, font_name, font_size)
end
task.spawn(function()
    for name in pairs(fonts.downloads) do
        fonts.load(name)
