        flag.TextSize = 9
        ApplyFont(flag, "Smallest Pixel-7")
        flag.Visible = false
        espObj.FlagLabels[i] = flag
    end
    espObj.Bones = {}
    espObj.BoneOutlines = {}
    for i = 1, #SKELETON_BONE_DEFS do
        local outline = Instance.new("Frame")
        outline.BorderSizePixel = 0
        outline.Visible = false
        outline.ZIndex = 1
        outline.Parent = container
        espObj.BoneOutlines[i] = outline
        local bone = Instance.new("Frame")
        bone.BorderSizePixel = 0
        bone.Visible = false
        bone.ZIndex = 2
        bone.Parent = container
        espObj.Bones[i] = bone
    end
    local arrowInner = Instance.new("TextLabel")
    arrowInner.BackgroundTransparency = 1
arrowInner.Text = "▲"
    arrowInner.TextColor3 = Color3.fromRGB(255, 255, 255)
    arrowInner.TextSize = 13
    arrowInner.Font = Enum.Font.SourceSans
    arrowInner.Size = UDim2.new(0, 26, 0, 26)
    arrowInner.ZIndex = 100
    arrowInner.Visible = false
    arrowInner.Parent = ScreenGui
    espObj.ArrowInner = arrowInner
    local arrowOutline = Instance.new("TextLabel")
    arrowOutline.BackgroundTransparency = 1
arrowOutline.Text = "▲"
    arrowOutline.TextColor3 = Color3.fromRGB(0, 0, 0)
    arrowOutline.TextSize = 15
    arrowOutline.Font = Enum.Font.SourceSans
    arrowOutline.Size = UDim2.new(0, 30, 0, 30)
    arrowOutline.ZIndex = 99
    arrowOutline.Visible = false
    arrowOutline.Parent = ScreenGui
    espObj.ArrowOutline = arrowOutline
    local function makeArrowLabel()
        local l = Instance.new("TextLabel")
        l.BackgroundTransparency = 1
        l.Size = UDim2.new(0, 150, 0, 12)
        l.TextStrokeTransparency = 1
        l.ZIndex = 110
        l.TextColor3 = Color3.fromRGB(255, 255, 255)
        l.Visible = false
        l.Parent = ScreenGui
        local stroke = Instance.new("UIStroke")
        stroke.Parent = l
        labelStrokeMap[l] = stroke
        return l
    end
    espObj.ArrowName = makeArrowLabel()
    espObj.ArrowDist = makeArrowLabel()
    espObj.Adornments = {}
    espObj.Highlight = nil
    espObj.Destroy = function()
        container:Destroy()
        if espObj.Highlight then espObj.Highlight:Destroy() end
        if espObj.MeshShell then espObj.MeshShell:Destroy() end
        for _, a in pairs(espObj.Adornments) do a:Destroy() end
        if espObj.ArrowInner then espObj.ArrowInner:Destroy() end
        if espObj.ArrowOutline then espObj.ArrowOutline:Destroy() end
        if espObj.ArrowName then espObj.ArrowName:Destroy() end
        if espObj.ArrowDist then espObj.ArrowDist:Destroy() end
        if espObj.TargetLine then espObj.TargetLine:Destroy() end
    end
    return espObj
end)
local function GetSafeRootPart(inst)
    if not inst then return nil end
    if inst:IsA("BasePart") then return inst end
    if inst:IsA("Model") then
        return inst.PrimaryPart or inst:FindFirstChild("HumanoidRootPart") or inst:FindFirstChild("Torso") or inst:FindFirstChild("UpperTorso") or inst:FindFirstChildOfClass("BasePart")
    end
    return nil
end
local function ApplyTextOutline(label, style, color)
    if not label then return end
    if style == "None" then
        if label.TextStrokeTransparency ~= 1 then label.TextStrokeTransparency = 1 end
    else
        if label.TextStrokeTransparency ~= 0 then label.TextStrokeTransparency = 0 end
        local col = color or Color3.fromRGB(0, 0, 0)
        if label.TextStrokeColor3 ~= col then label.TextStrokeColor3 = col end
    end
    local stroke = labelStrokeMap[label]
    if stroke then
        stroke.Enabled = false
    end
end
local esp_plain_name_cache = setmetatable({}, { __mode = "k" })
local esp_name_measure_cache = setmetatable({}, { __mode = "k" })
local UpdateESPObj = LPH_NO_VIRTUALIZE(WYNF_NO_VIRTUALIZE(function(espObj, position, size, name, distanceStuds, instance, humanoid, rootPart, resolved)
    if not position or not size then
        if espObj.Container.Visible then espObj.Container.Visible = false end
        return
    end
    if not espObj.Container.Visible then espObj.Container.Visible = true end
    local x, y = position.X, position.Y
    local sx, sy = size.X, size.Y
    local px, py = math.floor(x), math.floor(y)
    if resolved.BoxesEnabled then
        local box_left = math.floor(x - sx * 0.5)
        local box_top = math.floor(y - sy * 0.5)
        local box_w = math.max(math.floor(sx), 1)
        local box_h = math.max(math.floor(sy), 1)
        local box_right = box_left + box_w
        local box_bottom = box_top + box_h
        local boxColor = resolved.BoxesColor
        espObj.Lines[1].Position = UDim2.new(0, box_left - 1, 0, box_top)
        espObj.Lines[1].Size = UDim2.new(0, box_w + 2, 0, 1)
        if espObj.Lines[1].BackgroundColor3 ~= boxColor then espObj.Lines[1].BackgroundColor3 = boxColor end
        if not espObj.Lines[1].Visible then espObj.Lines[1].Visible = true end
        espObj.Lines[2].Position = UDim2.new(0, box_left - 1, 0, box_bottom)
        espObj.Lines[2].Size = UDim2.new(0, box_w + 2, 0, 1)
        if espObj.Lines[2].BackgroundColor3 ~= boxColor then espObj.Lines[2].BackgroundColor3 = boxColor end
        if not espObj.Lines[2].Visible then espObj.Lines[2].Visible = true end
        espObj.Lines[3].Position = UDim2.new(0, box_left, 0, box_top - 1)
        espObj.Lines[3].Size = UDim2.new(0, 1, 0, box_h + 2)
        if espObj.Lines[3].BackgroundColor3 ~= boxColor then espObj.Lines[3].BackgroundColor3 = boxColor end
        if not espObj.Lines[3].Visible then espObj.Lines[3].Visible = true end
        espObj.Lines[4].Position = UDim2.new(0, box_right, 0, box_top - 1)
        espObj.Lines[4].Size = UDim2.new(0, 1, 0, box_h + 2)
        if espObj.Lines[4].BackgroundColor3 ~= boxColor then espObj.Lines[4].BackgroundColor3 = boxColor end
        if not espObj.Lines[4].Visible then espObj.Lines[4].Visible = true end
        for i = 1, 4 do
            local line = espObj.Lines[i]
            local outline = espObj.Outlines[i]
            if i <= 2 then
                outline.Position = UDim2.new(0, -1, 0, -1)
                outline.Size = UDim2.new(0, line.Size.X.Offset + 2, 0, 3)
            else
                outline.Position = UDim2.new(0, -1, 0, -1)
                outline.Size = UDim2.new(0, 3, 0, line.Size.Y.Offset + 2)
            end
            if not outline.Visible then outline.Visible = true end
        end
        if resolved.BoxFillEnabled then
            espObj.BoxFill.Position = UDim2.new(0, box_left + 1, 0, box_top + 1)
            espObj.BoxFill.Size = UDim2.new(0, math.max(box_w - 1, 1), 0, math.max(box_h - 1, 1))
            espObj.BoxFill.BackgroundColor3 = resolved.BoxFillColor
            espObj.BoxFill.BackgroundTransparency = resolved.BoxFillTransparency
            espObj.BoxFill.Visible = true
        else
            if espObj.BoxFill.Visible then espObj.BoxFill.Visible = false end
        end
    else
        for i = 1, 4 do
            local line = espObj.Lines[i]
            local outline = espObj.Outlines[i]
            if line and line.Visible then line.Visible = false end
            if outline and outline.Visible then outline.Visible = false end
        end
        if espObj.BoxFill.Visible then espObj.BoxFill.Visible = false end
    end
    local player = Players:GetPlayerFromCharacter(instance)
    local isTarget = player and player == state.current_target
    local armorVal = 0
    if humanoid and player then
        armorVal = resolve_armor_effect(player)
    end
    local maxArmor = math.max(200, armorVal)
    local armorPercent = math.clamp(armorVal / maxArmor, 0, 1)
    local hasArmor = resolved.ArmorEnabled and armorVal > 0 and humanoid
    if hasArmor then
        if resolved.ArmorTargetMode == "Target" then
            if not isTarget then hasArmor = false end
        else
            if resolved.ArmorMaxDist and resolved.ArmorMaxDist > 0 and distanceStuds > resolved.ArmorMaxDist then
                hasArmor = false
            end
        end
    end
    local healthEnabled = resolved.HealthEnabled and humanoid
    if healthEnabled then
        if resolved.HealthTargetMode == "Target" then
            if not isTarget then healthEnabled = false end
        else
            if resolved.HealthMaxDist and resolved.HealthMaxDist > 0 and distanceStuds > resolved.HealthMaxDist then
                healthEnabled = false
            end
        end
    end
    local health = humanoid and humanoid.Health or 0
    local maxHealth = humanoid and humanoid.MaxHealth or 100
    local healthPercent = math.clamp(health / maxHealth, 0, 1)
    local displayName = (player and player.DisplayName) or name
    local nameSize = resolved.NameSize
    local plain_key = tostring(displayName or "")
    local plainName = esp_plain_name_cache[plain_key]
    if plainName == nil then
        plainName = string.gsub(plain_key, "<[^>]+>", "")
        esp_plain_name_cache[plain_key] = plainName
    end
    local hpWidth = resolved.HealthWidth
    local hpSideGap = resolved.HealthGap
    local hpPos = resolved.HealthPos
    local armWidth = resolved.ArmorWidth
    local armGap = resolved.ArmorGap
    local armPos = resolved.ArmorPos
    local isHorizontal = (hpPos == "Top" or hpPos == "Bottom")
    local target_bar_len = tonumber(resolved.HealthTargetSize) or tonumber(resolved.TargetBarLength) or 75
    local health_tgt_auto = (resolved.HealthTargetMode_flag == "Automatic")
    local health_nontgt_auto = (resolved.HealthNonTargetMode_flag == "Automatic")
    local name_meas = (espObj.Text and espObj.Text.TextBounds and espObj.Text.TextBounds.X > 5 and math.ceil(espObj.Text.TextBounds.X))
    if not name_meas or name_meas <= 5 then
        local meas_entry = esp_name_measure_cache[plainName]
        if meas_entry and meas_entry.size == nameSize then
            name_meas = meas_entry.width
        else
            local ok_sz, res_sz = pcall(function()
                local f = (espObj.Text and espObj.Text.Font ~= Enum.Font.Legacy and espObj.Text.Font) or Enum.Font.SourceSansBold
                return TextService:GetTextSize(plainName, nameSize or 13, f, Vector2.new(1000, 100))
            end)
            name_meas = (ok_sz and res_sz and res_sz.X > 5 and math.ceil(res_sz.X)) or math.max(math.floor(#plainName * (nameSize or 13) * 0.62), 22)
            esp_name_measure_cache[plainName] = { size = nameSize, width = name_meas }
        end
    end
    local barLen
    if isTarget then
        if health_tgt_auto then
            barLen = math.max(name_meas or 0, 30)
        else
            barLen = tonumber(target_bar_len) or 75
        end
    else
        if health_nontgt_auto then
            barLen = math.max(name_meas or 0, 30)
        else
            barLen = tonumber(resolved.HealthNonTargetSize) or 30
        end
    end
    local barLeftX = math.floor(px - barLen * 0.5)
    espObj.HealthBarOutline.Visible = false
    espObj.ArmorBarOutline.Visible = false
    local sideOffsets = { Left = 0, Right = 0 }
    local healthColor = resolved.HealthColor
    if resolved.HealthType == "Dynamic" then
        if healthPercent > 0.5 then
            healthColor = resolved.HealthDyn1:Lerp(resolved.HealthDyn2, (1 - healthPercent) * 2)
        else
            healthColor = resolved.HealthDyn2:Lerp(resolved.HealthDyn3, (0.5 - healthPercent) * 2)
        end
    elseif resolved.HealthType == "Static" then
        healthColor = resolved.HealthColor
    end
    if espObj.HealthBar.BackgroundColor3 ~= healthColor then
        espObj.HealthBar.BackgroundColor3 = healthColor
    end
    if espObj.ArmorBar.BackgroundColor3 ~= resolved.ArmorColor then
        espObj.ArmorBar.BackgroundColor3 = resolved.ArmorColor
    end
    local topY = y - sy * 0.5 - 2
    local bottomY = y + sy * 0.5 + 2
    if healthEnabled and hpPos == "Top" then
        local barOutlineWidth = math.floor(barLen) + 2
        local barOutlineHeight = hpWidth + 2
        local barWidth = math.clamp(math.floor(barLen * healthPercent), 0, barLen)
        topY = topY - barOutlineHeight
        espObj.HealthBarOutline.Position = UDim2.new(0, barLeftX - 1, 0, topY)
        espObj.HealthBarOutline.Size = UDim2.new(0, barOutlineWidth, 0, barOutlineHeight)
        espObj.HealthBarOutline.Visible = true
        espObj.HealthBar.Size = UDim2.new(0, barWidth, 0, hpWidth)
        espObj.HealthBar.Position = UDim2.new(0, 1, 0, 1)
        espObj._HealthBarLeftX = barLeftX
        espObj._HealthBarLen = barLen
        espObj._HealthBarLocked = isTarget and true or false
        topY = topY - 1
    elseif hpPos ~= "Top" and not isHorizontal and healthEnabled then
        local barHeight = math.floor((sy + 1) * healthPercent)
        espObj.HealthBarOutline.Size = UDim2.new(0, hpWidth + 2, 0, sy + 3)
        espObj.HealthBarOutline.Visible = true
        local hpX = (hpPos == "Left") and (x - sx * 0.5 - hpSideGap - hpWidth - 1) or (x + sx * 0.5 + hpSideGap)
        espObj.HealthBarOutline.Position = UDim2.new(0, hpX, 0, y - sy * 0.5 - 1)
        espObj.HealthBar.Size = UDim2.new(0, hpWidth, 0, barHeight)
        espObj.HealthBar.Position = UDim2.new(0, 1, 1, -barHeight - 1)
        sideOffsets[hpPos] = sideOffsets[hpPos] + hpWidth + hpSideGap + 2
    elseif not (healthEnabled and hpPos == "Bottom") then
        if espObj.HealthBarOutline.Visible then espObj.HealthBarOutline.Visible = false end
    end
    if hasArmor and armPos == "Top" then
        local armor_tgt_auto = (resolved.ArmorTargetMode_flag == "Automatic")
        local armor_nontgt_auto = (resolved.ArmorNonTargetMode_flag == "Automatic")
        local armLen
        if isTarget then
            if armor_tgt_auto then
                armLen = math.max(name_meas or 0, 30)
            else
                armLen = tonumber(resolved.ArmorTargetSize) or 75
            end
        else
            if armor_nontgt_auto then
                armLen = math.max(name_meas or 0, 30)
            else
                armLen = tonumber(resolved.ArmorNonTargetSize) or 30
            end
        end
        local barOutlineWidth = math.floor(armLen) + 2
        local barOutlineHeight = armWidth + 2
        local barWidth = math.clamp(math.floor(armLen * armorPercent), 0, armLen)
        topY = topY - barOutlineHeight
