local hooked_tools = {}
local function clear_backtrack_player(player)
    local ghost = backtrack_ghosts[player]
    if ghost then ghost:Destroy() end
    backtrack_ghosts[player] = nil
    backtrack_history[player] = nil
end
local function record_backtrack()
    local cfg = config["Backtrack"]
    if type(cfg) ~= "table" or cfg["Enabled"] ~= true then return end
    local now = tick()
    local interval = 1 / math.max(tonumber(cfg["Record Rate"]) or 30, 1)
    if now - backtrack_last_record < interval then return end
    backtrack_last_record = now
    local max_frames = math.max(math.floor((tonumber(cfg["Length"]) or 0.2) * (tonumber(cfg["Record Rate"]) or 30)), 1)
    for _, player in ipairs(players:GetPlayers()) do
        if player ~= local_player and player.Character then
            local frame = {}
            for _, part in ipairs(player.Character:GetChildren()) do
                if part:IsA("BasePart") then frame[part.Name] = part.CFrame end
            end
            local history = backtrack_history[player] or {}
            history[#history + 1] = frame
            while #history > max_frames do table.remove(history, 1) end
            backtrack_history[player] = history
        end
    end
end
local function get_backtrack_position(player, part_name)
    local cfg = config["Backtrack"]
    if type(cfg) ~= "table" or cfg["Enabled"] ~= true or cfg["Aim At Backtrack"] ~= true then return nil end
    local history = backtrack_history[player]
    local frame = history and history[1]
    local part = frame and (frame[part_name] or frame["HumanoidRootPart"])
    return part and part.Position or nil
end
track_connection(run_service.RenderStepped:Connect(record_backtrack))
local emulated_backtrack = {
    last_hit = {},
    ghosts = {},
    ghost_folder = nil,
    max_age = 0.5,
}
local function emulated_backtrack_feature_enabled()
    local bt_cfg = config["Backtrack"]
    if type(bt_cfg) ~= "table" or bt_cfg["Enabled"] ~= true then return false end
    local eb_cfg = bt_cfg["Emulated Backtrack"]
    return eb_cfg and eb_cfg["Enabled"] == true or false
end
local function emulated_backtrack_ensure_folder()
    if not emulated_backtrack.ghost_folder then
        local f = workspace:FindFirstChild("Adderall_EmuBacktrackGhosts")
        if not f then
            f = Instance.new("Folder")
            f.Name = "Adderall_EmuBacktrackGhosts"
            f.Parent = workspace
        end
        emulated_backtrack.ghost_folder = f
    end
    return emulated_backtrack.ghost_folder
end
local function emulated_backtrack_update_ghosts()
    local bt_cfg = config["Backtrack"]
    local eb_cfg = bt_cfg and bt_cfg["Emulated Backtrack"] or {}
    local viz_cfg = bt_cfg and bt_cfg["Visualize"] or {}
    local show_ghosts = emulated_backtrack_feature_enabled()
        and viz_cfg["Enabled"] == true
    if not show_ghosts then
        for _, part in pairs(emulated_backtrack.ghosts) do
            if part then part:Destroy() end
        end
        table.clear(emulated_backtrack.ghosts)
        if not emulated_backtrack_feature_enabled() then
            table.clear(emulated_backtrack.last_hit)
        end
        return
    end
    local ghost_color = viz_cfg["Color"] or Color3.fromRGB(255, 0, 0)
    local ghost_transparency = tonumber(viz_cfg["Transparency"]) or 0.7
    local folder = emulated_backtrack_ensure_folder()
    local now = tick()
    for player, data in pairs(emulated_backtrack.last_hit) do
        if now - data.time > emulated_backtrack.max_age then
            emulated_backtrack.last_hit[player] = nil
            local part = emulated_backtrack.ghosts[player]
            if part then part:Destroy() end
            emulated_backtrack.ghosts[player] = nil
        else
            local part = emulated_backtrack.ghosts[player]
            if not part then
                part = Instance.new("Part")
                part.Anchored = true
                part.CanCollide = false
                part.CanQuery = false
                part.CanTouch = false
                part.Material = Enum.Material.Neon
                part.Size = Vector3.new(1, 1, 1)
                part.Parent = folder
                emulated_backtrack.ghosts[player] = part
            end
            if part.Color ~= ghost_color then part.Color = ghost_color end
            if part.Transparency ~= ghost_transparency then part.Transparency = ghost_transparency end
            part.CFrame = CFrame.new(data.pos)
        end
    end
    for player, part in pairs(emulated_backtrack.ghosts) do
        if not emulated_backtrack.last_hit[player] then
            if part then part:Destroy() end
            emulated_backtrack.ghosts[player] = nil
        end
    end
end
track_connection(run_service.RenderStepped:Connect(emulated_backtrack_update_ghosts))
