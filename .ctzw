local getgenv = getgenv or function() return _G end
local shared = shared or {}
local function get_active_config()
    local g = (type(getgenv) == "function" and getgenv()) or _G or {}
    if type(shared) == "table" then
        if type(shared["adderall"]) == "table" and shared["adderall"] ~= final_adderall_config then
            config_merge(final_adderall_config, shared["adderall"])
            shared["Adderall"] = final_adderall_config
            shared.adderall = final_adderall_config
            shared.Adderall = final_adderall_config
            return final_adderall_config
        end
        if type(shared["Adderall"]) == "table" and shared["Adderall"] ~= final_adderall_config then
            config_merge(final_adderall_config, shared["Adderall"])
            shared["adderall"] = final_adderall_config
            shared.adderall = final_adderall_config
            shared.Adderall = final_adderall_config
            return final_adderall_config
        end
    end
    if type(g) == "table" then
        if type(g.Adderall) == "table" and g.Adderall ~= final_adderall_config then
            config_merge(final_adderall_config, g.Adderall)
            return final_adderall_config
        end
        if type(g.adderall) == "table" and g.adderall ~= final_adderall_config then
            config_merge(final_adderall_config, g.adderall)
            return final_adderall_config
        end
    end
    local cfg = (type(shared) == "table" and type(shared["Adderall"]) == "table" and shared["Adderall"])
        or (type(shared) == "table" and type(shared.Adderall) == "table" and shared.Adderall)
        or (type(shared) == "table" and type(shared["adderall"]) == "table" and shared["adderall"])
        or (type(shared) == "table" and type(shared.adderall) == "table" and shared.adderall)
        or (type(g.Adderall) == "table" and g.Adderall)
        or (type(g.adderall) == "table" and g.adderall)
        or (type(g.private) == "table" and type(g.private.club) == "table" and g.private.club)
        or (type(_G) == "table" and type(_G.Adderall) == "table" and _G.Adderall)
        or final_adderall_config
        or default_adderall_config
    return cfg
end
local function get_bind_value(...)
    local cur = get_active_config()
    if not cur or type(cur) ~= "table" then return nil end
    local keys = {...}
    local node = cur
    for _, key in ipairs(keys) do
        if type(node) ~= "table" then return nil end
        local found = node[key]
        if found == nil then
            local lk = tostring(key):lower()
            for k, v in pairs(node) do
                if tostring(k):lower() == lk then
                    found = v
                    break
                end
            end
        end
        node = found
    end
    return node
end
local function normalize_input_token(val)
    if val == nil then return "" end
    if typeof and typeof(val) == "EnumItem" then
        return string.lower(val.Name)
    end
    local s = tostring(val):lower()
    s = s:gsub("^enum%.keycode%.", "")
    s = s:gsub("^enum%.userinputtype%.", "")
    s = s:gsub("^keycode%.", "")
    s = s:gsub("^userinputtype%.", "")
    s = s:gsub("%s+", "")
    if s == "mb1" or s == "leftclick" or s == "lmb" or s == "mouse1" then
        return "mousebutton1"
    elseif s == "mb2" or s == "rightclick" or s == "rmb" or s == "mouse2" then
        return "mousebutton2"
    elseif s == "mb3" or s == "middleclick" or s == "mmb" or s == "mouse3" then
        return "mousebutton3"
    end
    return s
end
local function input_matches_bind(input_obj, bind_val)
    if not input_obj or bind_val == nil then return false end
    local target = normalize_input_token(bind_val)
    if target == "" then return false end
    local key_name = input_obj.KeyCode and input_obj.KeyCode.Name
    if key_name and key_name ~= "Unknown" then
        if normalize_input_token(key_name) == target then return true end
    end
    local input_type = input_obj.UserInputType and input_obj.UserInputType.Name
    if input_type then
        if normalize_input_token(input_type) == target then return true end
    end
    return false
end
local raw_config = shared["Adderall"]
local config = setmetatable({}, {
    __index = function(_, k)
        local cur = get_active_config()
        if cur then
            if cur[k] ~= nil then return cur[k] end
            local lk = tostring(k):lower()
            for ck, cv in pairs(cur) do
                if tostring(ck):lower() == lk then return cv end
            end
        end
        return nil
    end,
    __newindex = function(_, k, v)
        local cur = get_active_config()
        if cur then
            cur[k] = v
        end
        if type(shared) == "table" and type(shared["Adderall"]) == "table" then
            shared["Adderall"][k] = v
        end
        local g = (type(getgenv) == "function" and getgenv()) or _G
        if g and type(g.Adderall) == "table" then
            g.Adderall[k] = v
        end
    end
})
