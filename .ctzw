local hoodcustoms_pellet_offsets = {}
do
    local tilt = math.rad(8)
    local cos_tilt, sin_tilt = math.cos(tilt), math.sin(tilt)
    for _, point in ipairs({
        Vector2.new(0, 0),
        Vector2.new(1.5, 0),
        Vector2.new(-1.5, 0),
        Vector2.new(0, 3),
        Vector2.new(0, -3),
    }) do
        table.insert(
            hoodcustoms_pellet_offsets,
            Vector2.new(math.tan(math.rad(point.X * cos_tilt - point.Y * sin_tilt)), math.tan(math.rad(point.X * sin_tilt + point.Y * cos_tilt)))
        )
    end
end
