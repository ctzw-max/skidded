    end
end))
local function setup_character(char)
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 10)
    if humanoid then
        track_connection(humanoid.StateChanged:Connect(function(_, new_state)
            local player_mods = config["Player Modifications"]
            if not player_mods or not player_mods["Anti Trip"] then return end
            if new_state == Enum.HumanoidStateType.FallingDown or new_state == Enum.HumanoidStateType.Ragdoll then
                humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
        end))
    end
    track_connection(char.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            hook_weapon(child)
        end
    end))
    track_connection(char.ChildRemoved:Connect(function(child)
        if child:IsA("Tool") then
            if game_support.uses("hoodcustoms") then
                child.Enabled = true
                hooked_tools[child] = nil
                child:SetAttribute("AdderallHooked", nil)
            end
        end
    end))
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") then
            hook_weapon(child)
        end
    end
end
local backpack = local_player:FindFirstChildOfClass("Backpack")
if backpack then
    track_connection(backpack.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            clean_scripts(child)
        end
    end))
    for _, child in ipairs(backpack:GetChildren()) do
        if child:IsA("Tool") then
            clean_scripts(child)
        end
    end
end
if local_player.Character then
    Movement.WallJumpsUsed = 0
    Movement:Reset()
    setup_character(local_player.Character)
end
track_connection(local_player.CharacterAdded:Connect(function(char)
    Movement.WallJumpsUsed = 0
    Movement:Reset()
    setup_character(char)
end))
