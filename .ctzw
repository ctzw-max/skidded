local Game = {}
function Game:Is(Name)
    local n = tostring(Name or ""):lower()
    if n == "da hood" then
        return game_support.is("da hood") or game_support.is("das hood") or game_support.is("der hood") or game_support.is("des hood") or (not game_support.uses("hoodcustoms") and not game_support.uses("voidfalls"))
    end
    return game_support.is(n)
end
function Game:Uses(Name)
    return game_support.uses(tostring(Name):lower())
end
local World = {
    Parents = { GunBeam = replicated_storage, SkinAssets = replicated_storage, Ignored = workspace, Bush = workspace },
    Cache = {},
}
function World:Get(Name)
    local Cached = World.Cache[Name]
    if Cached and Cached.Parent then
        return Cached
    end
    local Parent = World.Parents[Name]
    if not Parent then
        return nil
    end
    Cached = Parent:FindFirstChild(Name)
    World.Cache[Name] = Cached
    return Cached
end
