local box_project_cache = {}
local box_near_plane = 0.25
local Get2DBoundingBox = LPH_NO_VIRTUALIZE(WYNF_NO_VIRTUALIZE(function(instance, rootPart, humanoid, body_parts)
    rootPart = rootPart or GetSafeRootPart(instance)
    if not rootPart then return false, nil, nil end
    local cam = Workspace.CurrentCamera or Camera
    if not cam then return false, nil, nil end
    local position, onScreen = cam:WorldToViewportPoint(rootPart.Position)
    if not onScreen or position.Z <= 0 then return false, nil, nil end
    local viewport = cam.ViewportSize
    local clamp_x = math.max(viewport.X, 1) * 1.5
    local clamp_y = math.max(viewport.Y, 1) * 1.5
    humanoid = humanoid or (instance:IsA("Model") and (instance:FindFirstChildOfClass("Humanoid") or instance:FindFirstChild("Humanoid")))
    if humanoid and instance:IsA("Model") then
        if not body_parts then
            body_parts = {}
            local head = instance:FindFirstChild("Head")
            if head and head:IsA("BasePart") then body_parts[#body_parts + 1] = head end
            local torso = instance:FindFirstChild("UpperTorso") or instance:FindFirstChild("Torso")
            if torso and torso:IsA("BasePart") then body_parts[#body_parts + 1] = torso end
            local lower = instance:FindFirstChild("LowerTorso") or instance:FindFirstChild("HumanoidRootPart")
            if lower and lower:IsA("BasePart") then body_parts[#body_parts + 1] = lower end
            local foot_left = instance:FindFirstChild("LeftFoot") or instance:FindFirstChild("Left Leg")
            if foot_left and foot_left:IsA("BasePart") then body_parts[#body_parts + 1] = foot_left end
            local foot_right = instance:FindFirstChild("RightFoot") or instance:FindFirstChild("Right Leg")
            if foot_right and foot_right:IsA("BasePart") then body_parts[#body_parts + 1] = foot_right end
        end
        if #body_parts > 0 then
            local min_x, min_y, max_x, max_y = math.huge, math.huge, -math.huge, -math.huge
            local found = false
            for _, part in ipairs(body_parts) do
                local part_cf = part.CFrame
                local part_hs = part.Size * 0.5
                local part_ok = true
                for ci, corner_offset in ipairs(BOX_CORNER_OFFSETS) do
                    local corner_pos = cam:WorldToViewportPoint(part_cf * Vector3.new(part_hs.X * corner_offset[1], part_hs.Y * corner_offset[2], part_hs.Z * corner_offset[3]))
                    if corner_pos.Z <= box_near_plane then
                        part_ok = false
                        break
                    end
                    box_project_cache[ci] = corner_pos
                end
                if part_ok then
                    found = true
                    for ci = 1, 8 do
                        local corner_pos = box_project_cache[ci]
                        local screen_x = math.clamp(corner_pos.X, -clamp_x, clamp_x)
                        local screen_y = math.clamp(corner_pos.Y, -clamp_y, clamp_y)
                        if screen_x < min_x then min_x = screen_x end
                        if screen_x > max_x then max_x = screen_x end
                        if screen_y < min_y then min_y = screen_y end
                        if screen_y > max_y then max_y = screen_y end
                    end
                end
            end
            if found and max_x > min_x and max_y > min_y then
                local height = max_y - min_y
                local width = max_x - min_x
                local center_x = (min_x + max_x) * 0.5
                if width > height * 1.25 then
                    width = height * 0.6
                    center_x = position.X
                end
                if width < height * 0.35 then width = height * 0.35 end
                if height >= 2 and height < 4000 then
                    return true, Vector2.new(center_x, (min_y + max_y) * 0.5), Vector2.new(width, height)
                end
            end
        end
    end
    local cf, size
    if instance:IsA("Model") then
        cf, size = instance:GetBoundingBox()
    else
        cf, size = instance.CFrame, instance.Size
    end
    local min_x, min_y, max_x, max_y = math.huge, math.huge, -math.huge, -math.huge
    local hs = size / 2
    local corners = {
        cf * Vector3.new(hs.X, hs.Y, hs.Z),
        cf * Vector3.new(-hs.X, hs.Y, hs.Z),
        cf * Vector3.new(hs.X, -hs.Y, hs.Z),
        cf * Vector3.new(-hs.X, -hs.Y, hs.Z),
        cf * Vector3.new(hs.X, hs.Y, -hs.Z),
        cf * Vector3.new(-hs.X, hs.Y, -hs.Z),
        cf * Vector3.new(hs.X, -hs.Y, -hs.Z),
        cf * Vector3.new(-hs.X, -hs.Y, -hs.Z),
    }
    local any_valid = false
    for _, corner in ipairs(corners) do
        local screen_pos = cam:WorldToViewportPoint(corner)
        if screen_pos.Z > box_near_plane then
            any_valid = true
            local screen_x = math.clamp(screen_pos.X, -clamp_x, clamp_x)
            local screen_y = math.clamp(screen_pos.Y, -clamp_y, clamp_y)
            if screen_x < min_x then min_x = screen_x end
            if screen_x > max_x then max_x = screen_x end
            if screen_y < min_y then min_y = screen_y end
            if screen_y > max_y then max_y = screen_y end
        end
    end
    if not any_valid or max_x <= min_x or max_y <= min_y then return false, nil, nil end
    local height = max_y - min_y
    local width = max_x - min_x
    local center_x = (min_x + max_x) * 0.5
    if width > height * 1.25 then
        width = height * 0.6
        center_x = position.X
    end
    if width < height * 0.35 then width = height * 0.35 end
    if height < 2 or height >= 4000 then return false, nil, nil end
    return true, Vector2.new(center_x, (min_y + max_y) * 0.5), Vector2.new(width, height)
end))
local ScanDirectories = LPH_NO_VIRTUALIZE(WYNF_NO_VIRTUALIZE(function(isAnyEspEnabled)
    if isAnyEspEnabled == false then
        if next(TrackedInstances) then
            for inst, data in pairs(TrackedInstances) do
                if data.espObj then data.espObj:Destroy() end
                TrackedInstances[inst] = nil
            end
        end
        return
    end
    local newTracked = {}
    local targetMode = ESPConfig.Target and ESPConfig.Target.Value or "All"
    if targetMode ~= "Self only" then
        for _, player in ipairs(Players:GetPlayers()) do
            if player == LocalPlayer then continue end
            if player.Character then
                local humanoid = player.Character:FindFirstChildOfClass("Humanoid") or player.Character:FindFirstChild("Humanoid")
                local rootPart = GetSafeRootPart(player.Character)
                if humanoid and humanoid.Health > 0 and rootPart then
                    newTracked[player.Character] = { name = player.DisplayName or player.Name }
                end
            end
        end
    end
    if targetMode == "Self only" then
        if LocalPlayer.Character then
            local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid") or LocalPlayer.Character:FindFirstChild("Humanoid")
            local rootPart = GetSafeRootPart(LocalPlayer.Character)
            if humanoid and humanoid.Health > 0 and rootPart then
                newTracked[LocalPlayer.Character] = { name = LocalPlayer.DisplayName or LocalPlayer.Name }
            end
        end
    end
    for inst, data in pairs(newTracked) do
        if not TrackedInstances[inst] then
            TrackedInstances[inst] = {
                espObj = CreateESPObj(data.name),
                name = data.name,
            }
        else
            TrackedInstances[inst].name = data.name
        end
    end
    for inst, data in pairs(TrackedInstances) do
        if not newTracked[inst] or not inst.Parent then
            data.espObj:Destroy()
            TrackedInstances[inst] = nil
        end
    end
end))
