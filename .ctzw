                        if max_dist == math.huge then max_dist = 10000 end
                        local result = workspace:Raycast(mouse_ray.Origin, mouse_ray.Direction * max_dist, ray_params)
                        if result and result.Instance and (result.Instance:IsDescendantOf(target_player.Character) or result.Instance.Parent == target_player.Character) then
                            can_trigger = true
                        end
                    else
                        can_trigger = true
                    end
                end
            end
            if is_gun(tool) and can_trigger and not is_self_knocked() then
                state.last_trigger_fire = tick()
                pcall(function()
                    if is_self_knocked() or not is_character_alive(local_player.Character) then return end
