        ApplyFont(label, initFont)
        label.TextSize = 12
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        label.TextStrokeTransparency = 0
        label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        label.ZIndex = 3
        label.Parent = container
    end
    local nameText = Instance.new("TextLabel")
    SetupLabel(nameText)
    nameText.TextYAlignment = Enum.TextYAlignment.Bottom
    nameText.RichText = false
    nameText.Text = name
    nameText.Visible = false
    espObj.Text = nameText
    local nameGradient = Instance.new("UIGradient")
    nameGradient.Enabled = false
    nameGradient.Parent = nameText
    espObj.NameGradient = nameGradient
    espObj.TeamText = nil
    espObj.TeamTextStroke = nil
    espObj.FriendlyText = nil
    espObj.FriendlyTextStroke = nil
    local distText = Instance.new("TextLabel")
    SetupLabel(distText)
    distText.TextYAlignment = Enum.TextYAlignment.Top
    distText.Visible = false
    espObj.DistanceText = distText
    local weaponText = Instance.new("TextLabel")
    SetupLabel(weaponText)
    weaponText.TextYAlignment = Enum.TextYAlignment.Top
    weaponText.Visible = false
    espObj.WeaponText = weaponText
    local healthBarOutline = Instance.new("Frame")
    healthBarOutline.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    healthBarOutline.BorderSizePixel = 0
    healthBarOutline.Visible = false
    healthBarOutline.ZIndex = 1
    healthBarOutline.Parent = container
    espObj.HealthBarOutline = healthBarOutline
    local healthBar = Instance.new("Frame")
    healthBar.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    healthBar.BorderSizePixel = 0
    healthBar.ZIndex = 2
    healthBar.Parent = healthBarOutline
    espObj.HealthBar = healthBar
    local healthGradient = Instance.new("UIGradient")
    healthGradient.Enabled = false
    healthGradient.Parent = healthBar
    espObj.HealthGradient = healthGradient
    local armorBarOutline = Instance.new("Frame")
    armorBarOutline.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    armorBarOutline.BorderSizePixel = 0
    armorBarOutline.Visible = false
    armorBarOutline.ZIndex = 1
    armorBarOutline.Parent = container
    espObj.ArmorBarOutline = armorBarOutline
    local armorBar = Instance.new("Frame")
    armorBar.BackgroundColor3 = Color3.fromRGB(0, 162, 255)
    armorBar.BorderSizePixel = 0
    armorBar.ZIndex = 2
    armorBar.Parent = armorBarOutline
    espObj.ArmorBar = armorBar
    local armorText = Instance.new("TextLabel")
    SetupLabel(armorText)
    armorText.AnchorPoint = Vector2.new(0.5, 0.5)
    armorText.TextYAlignment = Enum.TextYAlignment.Center
    armorText.TextXAlignment = Enum.TextXAlignment.Center
    armorText.Visible = false
    armorText.Parent = container
    espObj.ArmorText = armorText
    local healthText = Instance.new("TextLabel")
    SetupLabel(healthText)
    healthText.AnchorPoint = Vector2.new(0.5, 0.5)
    healthText.TextYAlignment = Enum.TextYAlignment.Center
    healthText.ZIndex = 3
    healthText.Visible = false
    espObj.HealthText = healthText
    for i = 1, 5 do
        local flag = Instance.new("TextLabel")
