local function spread_hash(value)
    value = bit32.bxor(value, bit32.rshift(value, 16))
    value = (value * 13613 + value * 32747 % 65536 * 65536) % 4294967296
    value = bit32.bxor(value, bit32.rshift(value, 15))
    value = (value * 42635 + value * 33900 % 65536 * 65536) % 4294967296
    return bit32.bxor(value, bit32.rshift(value, 16))
end
local function get_spread_key()
    return tonumber(local_player:GetAttribute("ShotgunSpreadKey")) or 0
end
local function is_legacy_shooting()
    if not game_support.is("da hood") then return false end
    return local_player:GetAttribute("LegacyShooting") == true
end
local function roll_spread(key, counter, legacy, scale)
    local seed = spread_hash(bit32.bxor(key, counter))
    local function axis(index, amplitude)
        return (spread_hash(bit32.bxor(seed, index)) / 2147483648 - 1) * amplitude * scale
    end
    local function pellet(slot)
        return Vector3.new(axis(slot * 3, 0.05), axis(slot * 3 + 1, 0.1), axis(slot * 3 + 2, 0.05))
    end
    if legacy then
        local base = pellet(0)
        return { base, -base, base / 2, -base / 2, base * 0.7 }
    end
    return { pellet(0), pellet(1), pellet(2), pellet(3), pellet(4) }
end
local function next_shotgun_spread(tool_name, legacy)
    if not game_support.is("da hood") then return nil, nil end
    shotgun_spread.counter = shotgun_spread.counter + 1
    local s_scale = shotgun_spread.scale[tool_name] or 1
    return roll_spread(get_spread_key(), shotgun_spread.counter, legacy, s_scale), shotgun_spread.counter
end
