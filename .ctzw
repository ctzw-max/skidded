function game_support.shoot(handle, muzzle_pos, hit_position, hit_instance, hit_normal, server_time, pellet_index, spread_counter)
    local profile = game_support.current
    if not profile then
        shooters.dahood(handle, muzzle_pos, hit_position, hit_instance, hit_normal, server_time, pellet_index, spread_counter)
        return true
    end
    local shooter = shooters[profile.method]
    if not shooter then return false end
    if profile.server_time_for_all and not server_time then
        server_time = workspace:GetServerTimeNow()
    end
    shooter(handle, muzzle_pos, hit_position, hit_instance, hit_normal, server_time, pellet_index, spread_counter)
    return true
end
pcall(function() game_support.detect() end)
local function is_rage_mode_active()
    local rage_cfg = config["Rage Mode"] or {}
    local enabled = rage_cfg["Enabled"]
    if enabled ~= nil then return enabled == true end
    return rage_cfg["enabled"] == true
end
local function is_real_da_hood()
    local cur = game_support.get_current()
    if cur and (cur.name == "da hood" or cur.name == "da hood vc") then
        return true
    end
    if game.PlaceId == 2788229376 or game.PlaceId == 7213786345 or game.PlaceId == 16033173781 then
        return true
    end
    if game_support.is("da hood") and not game_support.is("das hood") then
        return true
    end
    return false
end
local function get_ping()
    local perf = stats:FindFirstChild("PerformanceStats")
    local ping_stat = perf and perf:FindFirstChild("Ping")
    if ping_stat then return ping_stat:GetValue() end
    local net = stats:FindFirstChild("Network")
    local s_item = net and net:FindFirstChild("ServerStatsItem")
    local data_ping = s_item and s_item:FindFirstChild("Data Ping")
    if data_ping then return data_ping:GetValue() end
    return 60
end
local wallbang = {
    reach = 24,
    cache_time = 0.1,
    miss_cache_time = 0.25,
    parts = { "Head", "UpperTorso", "Torso", "LowerTorso" },
    surface_offset = 0.1,
    rings = { 2, 4, 6, 8, 10, 13, 16, 20, 24 },
    spokes = 12,
    refine = 5,
    struck = setmetatable({}, { __mode = "k" }),
    cache = setmetatable({}, { __mode = "k" }),
    clear_params = RaycastParams.new(),
}
wallbang.clear_params.FilterType = Enum.RaycastFilterType.Exclude
wallbang.clear_params.IgnoreWater = true
function wallbang.supported()
    local cur = game_support.get_current()
    return cur ~= nil and not cur.updater and cur.rewrite_gun ~= false
end
function wallbang.enabled()
    if not wallbang.supported() then return false end
    local mods = config["Weapon Modifications"] or {}
    local wb = mods["Wallbang"] or {}
    return wb["Enabled"] == true or wb["enabled"] == true
end
function wallbang.fire_on_wallbang()
    if not wallbang.supported() then return false end
    local mods = config["Weapon Modifications"] or {}
    local wb = mods["Wallbang"] or {}
    return wb["Fire On Wallbang"] == true or wb["fire_on_wallbang"] == true
end
function wallbang.active()
    return wallbang.enabled() or wallbang.fire_on_wallbang()
end
function wallbang.limit(target_char)
    local root = target_char and target_char:FindFirstChild("HumanoidRootPart")
    local speed = root and root.AssemblyLinearVelocity.Magnitude or 0
    if speed ~= speed then speed = 0 end
    local ping = (get_ping() or 0) / 1000
    return math.max(wallbang.reach - math.min(speed, 60) * ping, wallbang.reach * 0.5)
end
function wallbang.probe(muzzle_pos, point, target_char)
    local hit = workspace:Raycast(muzzle_pos, point - muzzle_pos, wallbang.clear_params)
    if not hit then
        return point, true
    end
    local struck = hit.Instance
    local known = wallbang.struck
    local kind = known[struck]
    if kind == nil then
        if struck:IsDescendantOf(target_char) then
            kind = struck:IsA("BasePart") and struck.Parent == target_char and struck or true
        else
            local owner = struck:FindFirstAncestorOfClass("Model")
            kind = (owner and players:GetPlayerFromCharacter(owner)) and false or 0
        end
        known[struck] = kind
    end
    if kind == false then
        return nil, false
    end
    if kind == 0 then
        return hit.Position + hit.Normal * wallbang.surface_offset, false
    end
    return hit.Position, true, kind ~= true and kind or nil
end
function wallbang.search(muzzle_pos, target_char, impact, range, led)
    if not target_char or not impact then return nil, nil end
    local limit = led and wallbang.reach or wallbang.limit(target_char)
    wallbang.clear_params.FilterDescendantsInstances = { local_player.Character, workspace.CurrentCamera }
    table.clear(wallbang.struck)
    local back = muzzle_pos - impact
    if back.Magnitude <= 1e-4 then return nil, nil end
    back = back.Unit
    local side = back:Cross(Vector3.new(0, 1, 0))
    side = side.Magnitude > 1e-4 and side.Unit or Vector3.new(1, 0, 0)
    local up = side:Cross(back).Unit
    local best, best_gap, best_part, best_angle, best_ring
    local function consider(point, part, angle, ring)
        if not point or (range and (point - muzzle_pos).Magnitude > range) then return end
        local gap = (point - impact).Magnitude
        if gap <= limit and (not best_gap or gap < best_gap) then
            best, best_gap, best_part, best_angle, best_ring = point, gap, part, angle, ring
        end
    end
    local function spoke(angle)
        return up * math.cos(angle) + side * math.sin(angle)
    end
    local point, _, part = wallbang.probe(muzzle_pos, impact, target_char)
    consider(point, part)
    local step = 2 * math.pi / wallbang.spokes
    for ring, radius in ipairs(wallbang.rings) do
        if best_gap and best_gap <= radius then
            break
        end
        for index = 0, wallbang.spokes - 1 do
            local angle = index * step
            local spot, open, landed = wallbang.probe(muzzle_pos, impact + spoke(angle) * radius, target_char)
            consider(spot, landed, open and angle or nil, ring)
        end
    end
    if best_angle and best_ring then
        local angle, direction = best_angle, spoke(best_angle)
        local low, high = wallbang.rings[best_ring - 1] or 0, wallbang.rings[best_ring]
        for _ = 1, wallbang.refine do
            local mid = (low + high) * 0.5
            local spot, open, landed = wallbang.probe(muzzle_pos, impact + direction * mid, target_char)
            if open then
                high = mid
                consider(spot, landed, angle, best_ring)
            else
                low = mid
            end
        end
    end
    return best, best_part
end
function wallbang.blocked(muzzle_pos, target_char)
    if not muzzle_pos or not target_char then return false end
    wallbang.clear_params.FilterDescendantsInstances = { local_player.Character, workspace.CurrentCamera }
    local found = false
    for _, name in ipairs(wallbang.parts) do
        local part = target_char:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            found = true
            local result = workspace:Raycast(muzzle_pos, part.Position - muzzle_pos, wallbang.clear_params)
            if not result or result.Instance:IsDescendantOf(target_char) then
                return false
            end
        end
    end
    return found
end
function wallbang.hittable(muzzle_pos, target_char, range)
    if not wallbang.active() then return nil end
    if not target_char or not target_char.Parent or not muzzle_pos then return nil end
    local now = os.clock()
    local cached = wallbang.cache[target_char]
    if cached
        and (cached.range == range or math.abs(cached.range - range) < 1)
        and now >= cached.time
        and now - cached.time < (cached.part and wallbang.cache_time or wallbang.miss_cache_time)
    then
        return cached.part
    end
    wallbang.clear_params.FilterDescendantsInstances = { local_player.Character, workspace.CurrentCamera }
    local result = nil
    for _, part in ipairs(target_char:GetChildren()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and (part.Position - muzzle_pos).Magnitude <= range then
            local blocker = workspace:Raycast(muzzle_pos, part.Position - muzzle_pos, wallbang.clear_params)
            if not blocker or blocker.Instance:IsDescendantOf(target_char) then
                result = part
                break
            end
        end
    end
    if not result then
        for _, name in ipairs(wallbang.parts) do
            local part = target_char:FindFirstChild(name)
            if part and part:IsA("BasePart") and wallbang.search(muzzle_pos, target_char, part.Position, range) then
                result = part
                break
            end
        end
    end
    if not cached then
        cached = {}
        wallbang.cache[target_char] = cached
    end
    cached.range, cached.time, cached.part = range, now, result
    return result
end
local future = {
    motion = setmetatable({}, { __mode = "k" }),
    pings = {},
    ping_value = nil,
    ping_time = 0,
    frame_time = nil,
    ring_size = 48,
    tune = {
        send_delay = 0.04,
        ping_factor = 1.5,
        frame_factor = 1.0,
        max_lead_time = 0.5,
        short_window = 0.08,
        long_window = 0.16,
        max_speed = 1200,
        trust_speed = 300,
        max_accel = 300,
        max_turn = 9,
        turn_min = 0.6,
        min_speed = 3,
        arc_min_speed = 6,
        arc_limit = 0.4,
        max_correction = 6,
        conf_floor = 0.15,
        blend = 0.3,
    },
}

function future.ping()
    local now = os.clock()
    if not future.ping_time or now < future.ping_time or now - future.ping_time >= 0.1 then
        future.ping_time = now
        local ok, value = pcall(function()
            return stats.Network.ServerStatsItem["Data Ping"]:GetValue()
        end)
        if ok and tonumber(value) then
            table.insert(future.pings, tonumber(value) / 1000)
            while #future.pings > 9 do table.remove(future.pings, 1) end
            local sorted = {}
            for _, p in ipairs(future.pings) do table.insert(sorted, p) end
            table.sort(sorted)
            local n = #sorted
            local mid = math.floor(n / 2) + 1
            if n % 2 == 1 then
                future.ping_value = sorted[mid]
            else
                future.ping_value = (sorted[mid - 1] + sorted[mid]) * 0.5
            end
        end
    end
    return future.ping_value or 0
end

function future.lead(scale)
    local frame = future.frame_time or 1 / 60
    local base = future.tune.send_delay + future.tune.ping_factor * future.ping() + future.tune.frame_factor * frame
    return math.clamp(base * (tonumber(scale) or 1), 0, future.tune.max_lead_time)
end

function future.push(state, now, pos)
    local slot = future.ring_size > 0 and state.head % future.ring_size + 1 or 1
    state.head = slot
    local entry = state.ring[slot]
    if entry then
        entry.t = now
        entry.pos = pos
    else
        state.ring[slot] = { t = now, pos = pos }
    end
    if state.count < future.ring_size then
        state.count = state.count + 1
    end
end

function future.fit(state, now, window)
    local n = 0
    local sum_t, sum_tt = 0, 0
    local sum_p, sum_tp = Vector3.new(), Vector3.new()
    for i = 0, state.count - 1 do
        local idx = (state.head - 1 - i) % future.ring_size + 1
        local entry = state.ring[idx]
        if not entry then break end
        local age = now - entry.t
        if age < 0 or age > window then break end
        local dt = -age
        n = n + 1
        sum_t = sum_t + dt
        sum_tt = sum_tt + dt * dt
        sum_p = sum_p + entry.pos
        sum_tp = sum_tp + entry.pos * dt
    end
    if n < 2 then return nil, n, 0 end
    local den = n * sum_tt - sum_t * sum_t
    if den < 1e-7 then return nil, n, 0 end
    local vel = (sum_tp * n - sum_p * sum_t) / den
    if vel ~= vel then return nil, n, 0 end
    local anchor = (sum_p - vel * sum_t) / n
    local residual = 0
    for i = 0, state.count - 1 do
        local idx = (state.head - 1 - i) % future.ring_size + 1
        local entry = state.ring[idx]
        if not entry then break end
        local age = now - entry.t
        if age < 0 or age > window then break end
        local err = (entry.pos - (anchor - vel * age)).Magnitude
        if err > residual then residual = err end
    end
    return vel, n, residual
end

function future.reset(state, now, pos, vel)
    state.ring = {}
    state.head = 1
    state.count = 1
    state.ring[1] = { t = now, pos = pos }
    state.t = now
    state.pos = pos
    state.v = vel
    state.a = Vector3.new()
    state.w = 0
    state.conf = 1
    state.coh = 1
    state.vel_ema = Vector3.new(vel.X, 0, vel.Z)
    state.sp_ema = math.sqrt(vel.X * vel.X + vel.Z * vel.Z)
    state.turn_v = vel
    state.turn_t = now
    state.airborne = math.abs(vel.Y) > 8
end

function future.sample(root)
    if not root or not root.Parent then return end
    local now = os.clock()
    local pos = root.Position
    local raw = root.AssemblyLinearVelocity
    if pos ~= pos or raw ~= raw then return end
    local state = future.motion[root]
    if not state then
        state = {}
        future.motion[root] = state
        future.reset(state, now, pos, raw)
        return
    end
    local step = now - state.t
    if step < 0.008 then return end
    if step > 0.5 or (pos - state.pos).Magnitude > math.max(30, future.tune.trust_speed * step) then
        future.reset(state, now, pos, raw)
        return
    end
    future.push(state, now, pos)
    local short_v, short_n = future.fit(state, now, future.tune.short_window)
    local long_v, long_n = future.fit(state, now, future.tune.long_window)
    local vel
    if short_v and short_n >= 3 then
        vel = short_v
    elseif long_v and long_n >= 3 then
        vel = long_v
    elseif raw.Magnitude > 0.1 and raw.Magnitude < future.tune.max_speed then
        vel = raw
    else
        vel = (pos - state.pos) / step
    end
    local raw_speed = raw.Magnitude
    if raw_speed > 2 and raw_speed < future.tune.max_speed then
        local fit_speed = vel.Magnitude
        if fit_speed < raw_speed * 0.55 then
            vel = vel:Lerp(raw, 0.5)
        elseif fit_speed < raw_speed then
            vel = vel:Lerp(raw, 0.2)
        elseif fit_speed > raw_speed * 1.6 then
            vel = vel:Lerp(raw, 0.35)
        end
    end
    if vel.Magnitude > future.tune.max_speed then
        future.reset(state, now, pos, raw)
        return
    end
    local accel = Vector3.new()
    if short_v and long_v and short_n >= 3 and long_n >= 3 then
        local span = math.max(future.tune.long_window - future.tune.short_window, 0.02)
        accel = (short_v - long_v) / span
        local magnitude = accel.Magnitude
        if magnitude > future.tune.max_accel then
            accel = accel * (future.tune.max_accel / magnitude)
        end
    end
    local accel_err = (accel - state.a).Magnitude / future.tune.max_accel
    local flat = Vector3.new(vel.X, 0, vel.Z)
    local turn, turn_err = nil, 0
    local prev = state.turn_v
    if prev then
        local prev_flat = Vector3.new(prev.X, 0, prev.Z)
        local prev_speed, speed = prev_flat.Magnitude, flat.Magnitude
        if prev_speed > 2 and speed > 2 then
            local dot = prev_flat.X * flat.X + prev_flat.Z * flat.Z
            local cross = prev_flat.X * flat.Z - prev_flat.Z * flat.X
            local angle = math.atan2(cross, dot)
            local delta = math.max(now - state.turn_t, 0.001)
            turn = math.clamp(angle / delta, -future.tune.max_turn, future.tune.max_turn)
        end
    end
    if turn then
        turn_err = math.abs(turn - state.w) / future.tune.max_turn
        state.w = state.w + (turn - state.w) * future.tune.blend
    else
        state.w = state.w * (1 - future.tune.blend)
    end
    state.turn_v = vel
    state.turn_t = now
    state.a = state.a:Lerp(accel, future.tune.blend)
    local conf_target = math.clamp(1 - accel_err - turn_err, future.tune.conf_floor, 1)
    state.conf = state.conf + (conf_target - state.conf) * 0.25
    local blend = 1 - math.exp(-step / 0.1)
    state.vel_ema = state.vel_ema:Lerp(flat, blend)
    state.sp_ema = state.sp_ema + (flat.Magnitude - state.sp_ema) * blend
    if state.sp_ema > 0.1 then
        state.coh = math.clamp(state.vel_ema.Magnitude / state.sp_ema, 0, 1)
    else
        state.coh = 1
    end
    state.v = vel
    state.t = now
    state.pos = pos
    state.airborne = math.abs(raw.Y) > 8 or math.abs(vel.Y) > 8
end

function future.horizontal(state, lead)
    local vel = state.v
    local flat = Vector3.new(vel.X, 0, vel.Z)
    local speed = flat.Magnitude
    if speed < future.tune.min_speed then return Vector3.new() end
    local turn = state.w
    if speed >= future.tune.arc_min_speed and math.abs(turn) >= future.tune.turn_min and state.coh >= 0.5 then
        local span = math.clamp(lead, 0, future.tune.arc_limit)
        local tangent = flat / speed
        local normal = Vector3.new(-tangent.Z, 0, tangent.X)
        local sweep = turn * span
        return tangent * (speed * math.sin(sweep) / turn) + normal * (speed * (1 - math.cos(sweep)) / turn)
    end
    local accel = Vector3.new(state.a.X, 0, state.a.Z)
    return flat * lead + accel * 0.5 * lead * lead
end

function future.vertical(state, lead)
    local vel = state.v
    if state.airborne then
        local gravity = workspace.Gravity or 196.2
        return vel.Y * lead - 0.5 * gravity * lead * lead
    end
    return vel.Y * lead + math.clamp(state.a.Y * 0.5 * lead * lead, -8, 3)
end

function future.offset(character, root, scale)
    if not root or not character then return Vector3.new() end
    local now = os.clock()
    local state = future.motion[root]
    if not state or now - state.t > 0.12 then
        future.sample(root)
        state = future.motion[root]
    end
    if not state then return Vector3.new() end
    local lead = future.lead(scale)
    if lead <= 0.001 then return Vector3.new() end
    local vel = state.v
    local flat = Vector3.new(vel.X, 0, vel.Z)
    local speed = flat.Magnitude
    if speed < future.tune.min_speed and math.abs(vel.Y) < 2 then return Vector3.new() end
    if speed > future.tune.max_speed then return Vector3.new() end
    local predicted = future.horizontal(state, lead) + Vector3.new(0, future.vertical(state, lead), 0)
    local linear = Vector3.new(flat.X, vel.Y, flat.Z) * lead
    local correction = predicted - linear
    local confidence = math.clamp(state.conf * math.clamp(state.coh, 0.25, 1), 0, 1)
    correction = correction * confidence
    local cap = future.tune.max_correction * math.max(tonumber(scale) or 1, 0.25)
    if correction.Magnitude > cap then
        correction = correction.Unit * cap
    end
    local result = linear + correction
    if result ~= result then return Vector3.new() end
    if result.Magnitude < 0.05 then return Vector3.new() end
    return result
end

function future.gun_active(tool_name)
    local mods = config["Weapon Modifications"] or {}
    local fcfg = mods["Future"]
    if type(fcfg) ~= "table" then return nil end
    if not (fcfg["Enabled"] == true or fcfg["enabled"] == true) then return nil end
    local guns = fcfg["Guns"] or fcfg["guns"] or {}
    local gun = guns[tool_name]
    if type(gun) == "table" and (gun["Enabled"] == true or gun["enabled"] == true) then return gun end
    return nil
end

function future.scale(gun)
    return math.max(tonumber(gun and (gun["Scale"] or gun["scale"])) or 1, 0)
end

function future.intercept(target_player, root, hit_position, hit_part, tool)
    if not target_player or not target_player.Character or not root or not hit_position then return hit_position end
    local gun = future.gun_active(tool and tool.Name or "")
    if not gun then return hit_position end
    local offset = future.offset(target_player.Character, root, future.scale(gun))
    local final = hit_position + offset
    if hit_part then
        final = final:Lerp(hit_part.Position + offset, 0.3)
    end
    if final ~= final then return hit_position end
    return final
end

do
    local last_beat = os.clock()
    game:GetService("RunService").Heartbeat:Connect(function()
        local beat_now = os.clock()
        future.frame_time = math.clamp(beat_now - last_beat, 0, 0.25)
        last_beat = beat_now
        local mods = config["Weapon Modifications"] or {}
        local fcfg = mods["Future"]
        if type(fcfg) ~= "table" or not (fcfg["Enabled"] == true or fcfg["enabled"] == true) then return end
        for _, p in ipairs(players:GetPlayers()) do
            if p ~= local_player and p.Character then
                local root = p.Character:FindFirstChild("HumanoidRootPart")
                if root then future.sample(root) end
            end
        end
    end)
end
local function build_esp_engine_view(visuals)
    local esp = visuals and visuals["ESP"] or nil
    local fonts = visuals and visuals["Fonts"] or {}
    if type(esp) ~= "table" then return {} end
    local targeting = esp["Targeting"] or esp["targeting"] or {}
    local names = esp["Names"] or esp["names"] or esp["Name"] or esp["name"] or {}
    local health = esp["Health"] or esp["health"] or {}
    local armor = esp["Armor"] or esp["armor"] or {}
    local fn = fonts["ESP Names"] or fonts["esp_names"] or { "Custom", "Proggy Clean", 13 }
    local fnum = fonts["ESP Numbers"] or fonts["esp_numbers"] or { "Custom", "Smallest Pixel-7", 9 }
    local general = config["General"] or {}
    local mode = general["Targeting"] or "Target"
    local target_color = (mode == "Automatic") and (targeting["Automatic"] or targeting["automatic"] or Color3.fromRGB(255, 170, 200)) or (targeting["Target"] or targeting["target"] or Color3.fromRGB(255, 170, 200))
    local position_map = { left = "Left", right = "Right", top = "Top", bottom = "Bottom" }
    local h_mode = tostring(health["Mode"] or health["mode"] or "All"):lower()
    local a_mode = tostring(armor["Mode"] or armor["mode"] or "All"):lower()
    local name_position = position_map[tostring(names["Position"] or names["position"] or names["Side"] or names["side"] or "Top"):lower()] or "Top"
    local name_table = {
        Enabled = names["Enabled"] == true or names["enabled"] == true,
        Size = tonumber(fn[3]) or 13,
        Position = name_position,
        Side = name_position,
        Type = "DisplayName",
        Transparency = 0,
        Colors = {
            ["Normal Color"] = esp["Color"] or esp["color"] or Color3.fromRGB(255, 255, 255),
            ["Target Color"] = target_color,
        },
    }
    return {
        Enabled = esp["Enabled"] == true or esp["enabled"] == true,
        Numbers = esp["Numbers"] == true or esp["numbers"] == true,
        Target = { Value = "All" },
        Name = name_table,
        Names = name_table,
        Health = {
            Enabled = health["Enabled"] == true or health["enabled"] == true,
            Target = (h_mode == "current target") and "Current Target" or "All",
            All = { Distance = math.huge },
            Position = position_map[tostring(health["Position"] or health["position"] or "Left"):lower()] or "Left",
            Color = Color3.fromRGB(135, 252, 124),
            Type = "Dynamic",
            Dynamic = {
                ["Color 1"] = Color3.fromRGB(135, 252, 124),
                ["Color 2"] = Color3.fromRGB(255, 0, 0),
                ["Color 3"] = Color3.fromRGB(255, 255, 255),
                Color1 = Color3.fromRGB(135, 252, 124),
                Color2 = Color3.fromRGB(255, 0, 0),
                Color3 = Color3.fromRGB(255, 255, 255),
            },
            Color1 = Color3.fromRGB(135, 252, 124),
            Color2 = Color3.fromRGB(255, 0, 0),
            Color3 = Color3.fromRGB(255, 255, 255),
            ["Show Text"] = esp["Numbers"] == true or esp["numbers"] == true,
            ShowText = esp["Numbers"] == true or esp["numbers"] == true,
            TextSize = tonumber(fnum[3]) or 9,
            Font = fnum[2] or "Smallest Pixel-7",
            ["Non Target Size"] = health["Non Target Size"] or health["non target size"] or health["Non-Target Size"] or health["Non-Target Bar Length"] or health["NonTargetBarLength"] or 30,
            ["Target Size"] = tonumber(health["Target Size"] or health["target size"] or health["Target Bar Length"] or health["TargetBarLength"]) or 75,
            ["Target Bar Length"] = tonumber(health["Target Size"] or health["target size"] or health["Target Bar Length"] or health["TargetBarLength"]) or 75,
            ["Non-Target Bar Length"] = health["Non Target Size"] or health["non target size"] or health["Non-Target Size"] or health["Non-Target Bar Length"] or health["NonTargetBarLength"] or 30,
            Size = (health and (health.Size or health.size)) or (esp and esp.Size and (esp.Size.Health or esp.Size.health)) or {
                Mode = "Manual",
                ["Non Target Size"] = 30,
                ["Target Size"] = 75,
            },
        },
        Armor = {
            Enabled = armor["Enabled"] == true or armor["enabled"] == true,
            Target = (a_mode == "current target") and "Current Target" or "All",
            All = { Distance = math.huge },
            Position = position_map[tostring(armor["Position"] or armor["position"] or "Right"):lower()] or "Right",
            Color = Color3.fromRGB(0, 162, 255),
            Width = 2,
            Gap = 2,
            Size = (armor and (armor.Size or armor.size)) or (esp and esp.Size and (esp.Size.Armor or esp.Size.armor)) or {
                Mode = "Manual",
                ["Non Target Size"] = 30,
                ["Target Size"] = 75,
            },
        },
        Size = esp and (esp.Size or esp.size) or {
            Health = { Mode = "Manual", ["Non Target Size"] = 30, ["Target Size"] = 75 },
            Armor = { Mode = "Manual", ["Non Target Size"] = 30, ["Target Size"] = 75 },
        },
        Font = {
            Value = fn[2] or "Proggy Clean",
            Size = tonumber(fn[3]) or 13,
            Health = fnum[2] or "Smallest Pixel-7",
            ["Health Size"] = tonumber(fnum[3]) or 9,
        },
    }
end
local extras = { mod_checks = {} }
function extras.notify(title, text)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", { Title = title, Text = text, Duration = 5 })
    end)
end
function extras.mod_config()
    local ex = config["Extras"] or {}
    return ex["Mod Detector"] or ex["mod_detector"] or {}
end
function extras.report_config()
    local ex = config["Extras"] or {}
    return ex["Report Detector"] or ex["report_detector"] or {}
end
function extras.check_moderator(p)
    if not p or p == local_player or not p.Parent then return end
    if extras.mod_checks[p] ~= nil then return end
    local ok, is_mod = pcall(function()
        return p:IsInGroup(17215700)
    end)
    if not ok or not p.Parent then return end
    if is_mod ~= true then
        extras.mod_checks[p] = false
        return
    end
    extras.mod_checks[p] = true
    local cfg = extras.mod_config()
    local action = tostring(cfg["Action"] or cfg["action"] or ""):lower()
    if action == "kick" then
        local_player:Kick("moderator detected: " .. tostring(p.Name))
    elseif action == "notify" then
        extras.notify("mod detector", "moderator detected: " .. tostring(p.Name))
    end
end
function extras.setup()
    players.PlayerRemoving:Connect(function(p)
        extras.mod_checks[p] = nil
    end)
    task.spawn(function()
        while true do
            local cfg = extras.mod_config()
            if cfg["Enabled"] == true or cfg["enabled"] == true then
                for _, p in ipairs(players:GetPlayers()) do
                    pcall(function() extras.check_moderator(p) end)
                end
            end
            task.wait(3)
        end
    end)
    task.spawn(function()
        local data_folder = local_player:WaitForChild("DataFolder", 10)
        if not data_folder then return end
        local reporters = data_folder:WaitForChild("Reporters", 10)
        if not reporters then return end
        local main_event = replicated_storage:WaitForChild("MainEvent", 10)
        if not main_event then return end
        reporters.ChildAdded:Connect(function(child)
            if not child:IsA("StringValue") then return end
            local cfg = extras.report_config()
            if not (cfg["Enabled"] == true or cfg["enabled"] == true) then return end
            local user_id = tonumber(child.Name)
            local username = child.Value
            if (cfg["Report Back"] == true or cfg["report_back"] == true) and user_id then
                pcall(function()
                    main_event:FireServer("REPORT_PLAYER", user_id, "AimManipulation")
                end)
                extras.notify("report detector", "report sent")
            end
            local action = tostring(cfg["Action"] or cfg["action"] or ""):lower()
            if action == "kick" then
                local_player:Kick("you've been reported by: " .. tostring(username))
            elseif action == "notify" then
                extras.notify("report detector", tostring(username) .. " reported you")
            end
        end)
    end)
end
extras.setup()
local script_connections = {}
local function track_connection(conn)
    if conn then
        table.insert(script_connections, conn)
    end
    return conn
end
if not LPH_OBFUSCATED then
    LPH_JIT = LPH_JIT or function(...) return ... end
    LPH_JIT_MAX = LPH_JIT_MAX or function(...) return ... end
    LPH_NO_VIRTUALIZE = LPH_NO_VIRTUALIZE or function(...) return ... end
    LPH_ENCRYPT_STRINGS = LPH_ENCRYPT_STRINGS or function(...) return ... end
    LPH_CRASH = LPH_CRASH or function() end
end
if not WYNFUSCATED then
    WYNF_JIT = WYNF_JIT or function(...) return ... end
    WYNF_JIT_MAX = WYNF_JIT_MAX or function(...) return ... end
    WYNF_NO_VIRTUALIZE = WYNF_NO_VIRTUALIZE or function(...) return ... end
    WYNF_ENCRYPT_STRINGS = WYNF_ENCRYPT_STRINGS or function(...) return ... end
end
local games = {
    service_cache = {},
    registry = {},
    by_game_id = {},
    current_def = nil,
}
function games.get_service_cached(service_name)
    local cached = games.service_cache[service_name]
    if cached ~= nil then return cached end
    local ok, svc = pcall(game.GetService, game, service_name)
    if ok and svc then
        games.service_cache[service_name] = svc
        return svc
    end
    return nil
end
function games.resolve_root_token(token)
    if type(token) ~= "string" then return nil end
    local lower = string.lower(token)
    if lower == "game" or lower == "workspace" then return workspace end
    if lower == "players" then return players end
    return games.get_service_cached(token)
end
function games.resolve_path(root, segments, options)
    if not root or type(segments) ~= "table" then return nil, "bad_args" end
    local cur = root
    local step_timeout_default = (options and (options.Timeout or options.StepTimeout)) or 8
    for index, name in ipairs(segments) do
        if type(name) ~= "string" or name == "" then continue end
        local step_timeout = step_timeout_default
        if options and options.Timeouts and options.Timeouts[index] then
            step_timeout = options.Timeouts[index]
        end
        if options and options.Wait then
            cur = cur:WaitForChild(name, step_timeout)
        else
            cur = cur:FindFirstChild(name)
        end
        if not cur then return nil, name end
    end
    return cur, nil
end
function games.try_paths_from_spec(root_token, path_segments, options)
    local root = games.resolve_root_token(root_token or "ReplicatedStorage")
    if not root then return nil end
    return select(1, games.resolve_path(root, path_segments, options))
end
function games.get_remote(definition, logical_key, options)
    if not definition or type(definition.Remotes) ~= "table" then return nil end
    local spec = definition.Remotes[logical_key]
    if type(spec) ~= "table" or type(spec.Path) ~= "table" then return nil end
    local inst = games.try_paths_from_spec(spec.Root, spec.Path, {
        Wait = options and options.Wait,
        Timeout = (options and options.Timeout) or spec.Timeout or 10,
        Timeouts = options and options.Timeouts or spec.Timeouts
    })
    if not inst then return nil end
    if spec.ClassName and inst.ClassName ~= spec.ClassName then return nil end
    return inst
end
function games.register(definition)
    if type(definition) ~= "table" or type(definition.Name) ~= "string" then return false end
    table.insert(games.registry, definition)
    if type(definition.GameIds) == "table" then
        for _, id in ipairs(definition.GameIds) do
            if type(id) == "number" then
                games.by_game_id[id] = definition
            end
        end
    end
    return true
end
function games.resolve_game_definition()
    if games.current_def then return games.current_def end
    local cur_place_id = game.PlaceId
    local cur_game_id = game.GameId
    if cur_game_id and games.by_game_id[cur_game_id] then
        games.current_def = games.by_game_id[cur_game_id]
        return games.current_def
    end
    for _, def in ipairs(games.registry) do
        if type(def.PlaceIds) == "table" then
            for _, pid in ipairs(def.PlaceIds) do
                if pid == cur_place_id then
                    games.current_def = def
                    return def
                end
            end
        end
    end
    if game_support.current then
        for _, def in ipairs(games.registry) do
            if def.Name and def.Name:lower() == game_support.current.name:lower() then
                games.current_def = def
                return def
            end
        end
    end
    for _, def in ipairs(games.registry) do
        if def.Name == "Da Hood" then
            games.current_def = def
            return def
        end
    end
    return nil
end
function games.get_remote_for_current(logical_key, options)
    local def = games.resolve_game_definition()
    if not def then return nil end
    return games.get_remote(def, logical_key, options)
end
function games.get_shoot_gun_spec(definition)
    definition = definition or games.resolve_game_definition()
    if not definition or type(definition.ShootGun) ~= "table" then return nil end
    return definition.ShootGun
end
function games.should_emulate_gun(definition)
    local spec = games.get_shoot_gun_spec(definition)
    return spec ~= nil and spec.Emulate == true
end
function games.should_clean_tool_scripts(definition)
    local spec = games.get_shoot_gun_spec(definition)
    if not spec then return false end
    if spec.CleanLocalScripts ~= nil then return spec.CleanLocalScripts == true end
    return spec.Emulate == true
end
