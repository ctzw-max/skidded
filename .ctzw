                local local_root = local_player.Character and local_player.Character:FindFirstChild("HumanoidRootPart")
                if target_root and local_root then
                    target_in_range = (target_root.Position - local_root.Position).Magnitude <= trigger_max_dist
                end
            end
            if target_player and target_in_range and target_player.Character and is_character_alive(target_player.Character) then
                local trigger_checks = get_feature_checks(trigger_cfg)
                local wallbang_fire = false
                if wallbang.fire_on_wallbang() then
                    local handle = tool:FindFirstChild("Handle")
