                                    local screen_pos, on_screen = cur_cam:WorldToViewportPoint(part.Position)
                                    if on_screen then
                                        local dist = (Vector2.new(screen_pos.X, screen_pos.Y) - mouse_now).Magnitude
                                        if dist <= fov_x * 0.05 then
