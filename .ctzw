local function hoodcustoms_can_interact(body_effects)
    if not body_effects then return false end
    local parent = body_effects.Parent
    if not parent then return false end
    local attacking = body_effects:FindFirstChild("Attacking_CLIENT")
    local reloading = body_effects:FindFirstChild("Reloading_CLIENT")
    local frozen = body_effects:FindFirstChild("FROZEN")
    local knocked = body_effects:FindFirstChild("K.O")
    local grabbed = body_effects:FindFirstChild("Grabbed")
    if not (attacking and reloading and frozen and knocked and grabbed) then return false end
    if frozen.Value == true or knocked.Value == true then return false end
    if attacking.Value == true or reloading.Value == true then return false end
    if grabbed.Value ~= nil then return false end
    if parent:FindFirstChild("GRABBING_CONSTRAINT") then return false end
    local anticheat = body_effects:FindFirstChild("AnticheatEffects")
    local suspended = anticheat and anticheat:FindFirstChild("INTERACTION_SUSPENDED")
    if suspended and suspended.Value - workspace:GetServerTimeNow() > 0 then return false end
    local torso = parent:FindFirstChild("UpperTorso") or parent:FindFirstChild("Torso")
    if torso and torso:FindFirstChild("RootEffect") then return false end
    return true
end
local function hoodcustoms_empty_click(tool)
    if hoodcustoms_empty_debounce then return end
    hoodcustoms_empty_debounce = true
    local handle = tool and tool:FindFirstChild("Handle")
    local no_ammo = handle and handle:FindFirstChild("NoAmmo")
    if no_ammo then no_ammo:Play() end
    local main_event = replicated_storage:FindFirstChild("MainEvent")
    if main_event then main_event:FireServer("GunEmpty") end
    task.delay(0.5, function()
        hoodcustoms_empty_debounce = false
    end)
end
local function hoodcustoms_get_pellets(origin, aim, is_shotgun)
    if is_shotgun ~= true then
        return { (aim - origin).Unit }
    end
    local aim_cf = CFrame.new(origin, aim)
    local look, right, up = aim_cf.LookVector, aim_cf.RightVector, aim_cf.UpVector
    local pellets = {}
    for index, offset in ipairs(hoodcustoms_pellet_offsets) do
        pellets[index] = (look + right * offset.X + up * offset.Y).Unit
    end
    return pellets
end
local function hoodcustoms_draw_tracer(origin, end_pos, skin)
    local template = replicated_storage:FindFirstChild("BULLET_RAYS")
    if not template then return nil end
    local ray = template:Clone()
    ray.Position = origin
    local a0 = ray:FindFirstChild("START_ATTACHMENT")
    local a1 = ray:FindFirstChild("END_ATTACHMENT")
    if a0 then a0.WorldPosition = origin end
    if a1 then a1.WorldPosition = end_pos end
    local ignored = workspace:FindFirstChild("Ignored") or workspace
    ray.Parent = ignored
    local beam = ray:FindFirstChild("GunBeam")
    if beam and skin and hoodcustoms_beam_colors[skin] then
        beam.Color = hoodcustoms_beam_colors[skin]
    end
    debris:AddItem(ray, 0.4)
    return ray
end
local function hoodcustoms_flash_muzzle(tool)
    local handle = tool and tool:FindFirstChild("Handle")
    if not handle then return end
    local particles = handle:FindFirstChild("SHOOT_BBGUI_PARTICLE")
    if particles then
        for _, emitter in ipairs(particles:GetChildren()) do
            if emitter:IsA("ParticleEmitter") then
                emitter:Emit(emitter:GetAttribute("EmitCount") or 1)
            end
        end
    end
end
function shooters.hoodcustoms(handle, muzzle_pos, hit_position, hit_instance, hit_normal)
    local remote = game_support.get_remote("MainEvent")
    if not remote then return end
    hoodcustoms_shot_index = hoodcustoms_shot_index + 1
    local hits = {}
    if hit_instance then
        local model = hit_instance:IsA("Model") and hit_instance or (hit_instance.Parent and hit_instance.Parent:IsA("Model") and hit_instance.Parent or hit_instance:FindFirstAncestorOfClass("Model"))
        table.insert(hits, { PELLET = 1, MODEL = model, PART = hit_instance, POSITION = hit_position })
    end
    remote:FireServer("Shoot", { ORIGIN = muzzle_pos, AIM = hit_position, INDEX = hoodcustoms_shot_index, HITS = hits })
end
function shooters.voidfalls(handle, muzzle_pos, hit_position)
    local remote = game_support.get_remote("voidfalls")
    if not remote then return end
    remote:FireServer("MOUSE", hit_position or muzzle_pos)
